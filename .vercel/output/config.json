{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/upload/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/authors/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/authors/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/authors/?$",
			"dest": "_render"
		},
		{
			"src": "^/books/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/books/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/books/?$",
			"dest": "_render"
		},
		{
			"src": "^/categories/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/posts/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/posts/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/posts/?$",
			"dest": "_render"
		},
		{
			"src": "^/site/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}