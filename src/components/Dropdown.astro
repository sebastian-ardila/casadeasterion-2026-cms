---
// Custom dropdown that:
// - syncs to a hidden <input> so server-side form handling stays unchanged
// - opens a portal-positioned menu fixed to viewport (z-index above everything)
// - supports keyboard (↑↓ Enter Esc) and click-outside-to-close
// - degrades gracefully if JS is off (the hidden input is still submitted with `value`)

export interface DropdownOption {
  value: string;
  label: string;
  hint?: string;
  /** Optional thumbnail (URL). If omitted, a generic person icon is shown
   *  when `iconStyle` is "person", or no icon at all otherwise. */
  imageUrl?: string | null;
  /** "person" → round thumbnail with user fallback; "none" (default) → no thumb. */
  iconStyle?: "person" | "none";
}

interface Props {
  name: string;
  value?: string | null;
  options: DropdownOption[];
  placeholder?: string;
  disabled?: boolean;
  // When true, changing the dropdown auto-submits the parent form.
  submitOnChange?: boolean;
  // Optional class on the wrapper button.
  class?: string;
  id?: string;
  /** Force-show or hide the search input. Default: auto-show when there are 8+ options. */
  searchable?: boolean;
  searchPlaceholder?: string;
}

const {
  name,
  value,
  options,
  placeholder = "Selecciona…",
  disabled = false,
  submitOnChange = false,
  class: extraClass = "",
  id,
  searchable,
  searchPlaceholder = "Buscar…",
} = Astro.props;

const current = options.find((o) => o.value === value);
const buttonId = id ?? `dd-${name}-${Math.random().toString(36).slice(2, 8)}`;
const showSearch = searchable ?? options.length >= 8;

const PERSON_FALLBACK = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>`;
---

<div
  class={`cas-dd relative inline-block w-full ${extraClass}`}
  data-dropdown
  data-name={name}
  data-submit-on-change={submitOnChange ? "1" : "0"}
>
  <input type="hidden" name={name} value={value ?? ""} data-dd-input />
  <button
    type="button"
    id={buttonId}
    class="cas-dd-btn"
    disabled={disabled}
    aria-haspopup="listbox"
    aria-expanded="false"
    data-dd-button
  >
    <span class="cas-dd-label flex items-center gap-2 min-w-0" data-dd-display>
      {current ? (
        <>
          {current.iconStyle === "person" && (
            <span class="cas-dd-thumb shrink-0">
              {current.imageUrl ? (
                <img
                  src={current.imageUrl}
                  alt=""
                  referrerpolicy="no-referrer"
                  onerror={`this.parentElement.innerHTML='${PERSON_FALLBACK.replace(/'/g, "\\'")}';`}
                />
              ) : (
                <Fragment set:html={PERSON_FALLBACK} />
              )}
            </span>
          )}
          <span class="truncate">{current.label}</span>
        </>
      ) : (
        <span class="text-stone-400">{placeholder}</span>
      )}
    </span>
    <svg
      class="cas-dd-caret"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      aria-hidden="true"
    >
      <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div
    role="listbox"
    aria-labelledby={buttonId}
    class="cas-dd-menu hidden"
    data-dd-menu
    data-has-search={showSearch ? "1" : "0"}
  >
    {showSearch && (
      <div class="cas-dd-search-wrap">
        <svg class="cas-dd-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="text"
          class="cas-dd-search"
          data-dd-search
          placeholder={searchPlaceholder}
          autocomplete="off"
          spellcheck="false"
        />
      </div>
    )}
    <ul class="cas-dd-options" data-dd-options>
    {options.map((opt) => (
      <li data-dd-search-text={`${opt.label} ${opt.hint ?? ""}`.toLowerCase()}>
        <button
          type="button"
          role="option"
          aria-selected={opt.value === value ? "true" : "false"}
          data-dd-option
          data-value={opt.value}
          data-label={opt.label}
          data-image={opt.imageUrl ?? ""}
          data-icon-style={opt.iconStyle ?? "none"}
          class:list={[
            "cas-dd-option",
            opt.value === value && "cas-dd-option-selected",
          ]}
        >
          {opt.iconStyle === "person" && (
            <span class="cas-dd-thumb cas-dd-thumb-option shrink-0">
              {opt.imageUrl ? (
                <img
                  src={opt.imageUrl}
                  alt=""
                  referrerpolicy="no-referrer"
                  onerror={`this.parentElement.innerHTML='${PERSON_FALLBACK.replace(/'/g, "\\'")}';`}
                />
              ) : (
                <Fragment set:html={PERSON_FALLBACK} />
              )}
            </span>
          )}
          <span class="cas-dd-option-text">
            <span class="cas-dd-option-label">{opt.label}</span>
            {opt.hint && <span class="cas-dd-option-hint">{opt.hint}</span>}
          </span>
        </button>
      </li>
    ))}
    <li class="cas-dd-empty hidden" data-dd-empty>Sin resultados.</li>
    </ul>
  </div>
</div>

<style is:global>
  /* Plain CSS to avoid Tailwind 4 @apply scoping issues inside component styles. */
  .cas-dd-btn {
    width: 100%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d6d3d1; /* stone-300 */
    background: #fff;
    color: #1c1917; /* stone-900 */
    font-size: 0.875rem;
    text-align: left;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .cas-dd-btn:hover:not(:disabled) {
    border-color: #78716c; /* stone-500 */
  }
  .cas-dd-btn:focus-visible {
    outline: none;
    border-color: #1c1917;
    box-shadow: 0 0 0 1px #1c1917;
  }
  .cas-dd-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #fafaf9; /* stone-50 */
  }
  .cas-dd-btn[aria-expanded="true"] {
    border-color: #1c1917;
  }
  .cas-dd-label {
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cas-dd-caret {
    flex-shrink: 0;
    color: #78716c;
    transition: transform 0.15s;
  }
  .cas-dd-btn[aria-expanded="true"] .cas-dd-caret {
    transform: rotate(180deg);
  }

  /* Menu floats above all other UI. Position is set via JS at open time.
     The menu wrapper itself doesn't scroll — only the inner options list
     does. That keeps the optional search input pinned at the top. */
  .cas-dd-menu {
    position: fixed;
    z-index: 9999;
    max-height: 22rem;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #d6d3d1; /* stone-300 */
    box-shadow: 0 12px 32px -8px rgba(28, 25, 23, 0.18), 0 4px 12px -4px rgba(28, 25, 23, 0.1);
    min-width: 14rem;
    overflow: hidden;
  }
  .cas-dd-options {
    flex: 1 1 0%;
    overflow-y: auto;
    padding: 4px;
    margin: 0;
    list-style: none;
  }
  .cas-dd-menu li {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cas-dd-search-wrap {
    position: relative;
    flex-shrink: 0;
    border-bottom: 1px solid #e7e5e4; /* stone-200 */
    background: #fafaf9; /* stone-50 */
  }
  .cas-dd-search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #a8a29e; /* stone-400 */
    pointer-events: none;
  }
  .cas-dd-search {
    width: 100%;
    padding: 0.55rem 0.75rem 0.55rem 2rem;
    border: 0;
    background: transparent;
    font-size: 0.875rem;
    color: #1c1917;
    outline: none;
  }
  .cas-dd-search::placeholder {
    color: #a8a29e;
  }
  .cas-dd-empty {
    padding: 12px;
    text-align: center;
    font-size: 0.8rem;
    color: #78716c;
  }
  .cas-dd-empty.hidden { display: none; }
  .cas-dd-option {
    width: 100%;
    cursor: pointer;
    text-align: left;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: #1c1917;
    background: transparent;
    border: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background-color 0.1s;
  }
  .cas-dd-option-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 0%;
  }
  .cas-dd-option-label {
    font-weight: 500;
    line-height: 1.25;
  }
  .cas-dd-option-hint {
    font-size: 0.7rem;
    color: #78716c; /* stone-500 */
    margin-top: 2px;
    line-height: 1.3;
  }
  .cas-dd-option-selected .cas-dd-option-hint {
    color: #d6d3d1; /* stone-300 over dark bg */
  }
  .cas-dd-option:hover,
  .cas-dd-option:focus {
    background: #f5f5f4; /* stone-100 */
    outline: none;
  }
  .cas-dd-option-selected,
  .cas-dd-option-selected:hover,
  .cas-dd-option-selected:focus {
    background: #1c1917; /* stone-900 */
    color: #fff;
  }

  /* Thumbnails (used for "person" iconStyle dropdowns like the author selector) */
  .cas-dd-thumb {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    background: #f5f5f4;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #a8a29e;
    border: 1px solid #e7e5e4;
  }
  .cas-dd-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cas-dd-thumb svg {
    width: 14px;
    height: 14px;
  }
  .cas-dd-thumb-option {
    margin-right: 8px;
  }
  /* Selected option in the menu uses dark colors — invert the thumb fallback. */
  .cas-dd-option-selected .cas-dd-thumb {
    background: #292524;
    color: #d6d3d1;
    border-color: #44403c;
  }
</style>

<script is:inline>
  // Single global controller for all .cas-dd dropdowns. Idempotent so
  // hot-reloads / multiple imports don't double-bind.
  (() => {
    if (window.__casDdInit) return;
    window.__casDdInit = true;

    let openDd = null;

    const closeOpen = () => {
      if (!openDd) return;
      const { menu, button } = openDd;
      menu.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
      openDd = null;
    };

    const positionMenu = (button, menu) => {
      const rect = button.getBoundingClientRect();
      const menuWidth = Math.max(rect.width, 200);
      menu.style.minWidth = rect.width + "px";
      menu.style.width = menuWidth + "px";
      menu.style.left = rect.left + "px";

      // Decide above-or-below based on remaining space.
      const spaceBelow = window.innerHeight - rect.bottom;
      const spaceAbove = rect.top;
      // Show menu briefly to measure, then place it.
      menu.style.top = "0px";
      menu.classList.remove("hidden");
      const menuHeight = Math.min(menu.scrollHeight, 22 * 16);
      if (spaceBelow >= menuHeight + 8 || spaceBelow >= spaceAbove) {
        menu.style.top = rect.bottom + 4 + "px";
      } else {
        menu.style.top = Math.max(8, rect.top - menuHeight - 4) + "px";
      }
      // Clamp horizontally so it doesn't overflow viewport.
      const right = parseFloat(menu.style.left) + menuWidth;
      if (right > window.innerWidth - 8) {
        menu.style.left = Math.max(8, window.innerWidth - menuWidth - 8) + "px";
      }
    };

    const openMenu = (root) => {
      if (openDd && openDd.root === root) {
        closeOpen();
        return;
      }
      closeOpen();
      const button = root.querySelector("[data-dd-button]");
      const menu = root.querySelector("[data-dd-menu]");
      if (!button || !menu) return;
      positionMenu(button, menu);
      button.setAttribute("aria-expanded", "true");
      const search = menu.querySelector("[data-dd-search]");
      // Reset any previous filter so the next open shows everything.
      if (search) {
        search.value = "";
        applyFilter(menu, "");
      }
      openDd = { root, button, menu, search };
      // When there's a search input, focus it (so user can type immediately).
      // Otherwise focus the selected/first option for keyboard navigation.
      if (search) {
        search.focus();
      } else {
        const selected = menu.querySelector('[aria-selected="true"]');
        if (selected) selected.focus();
        else {
          const first = menu.querySelector("[data-dd-option]");
          if (first) first.focus();
        }
      }
    };

    const applyFilter = (menu, query) => {
      const q = query.trim().toLowerCase();
      const items = menu.querySelectorAll("[data-dd-search-text]");
      let visible = 0;
      items.forEach((li) => {
        const text = li.dataset.searchText || "";
        const match = !q || text.includes(q);
        li.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      const empty = menu.querySelector("[data-dd-empty]");
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    };

    const PERSON_FALLBACK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>';

    const escapeHtml = (s) =>
      String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    const setValue = (root, option) => {
      const input = root.querySelector("[data-dd-input]");
      const display = root.querySelector("[data-dd-display]");
      if (!input || !display) return;
      const previousValue = input.value;
      input.value = option.value;

      // Re-render the display to keep thumbnail (if iconStyle === "person").
      const iconStyle = option.iconStyle || "none";
      const label = option.label;
      const img = option.image;
      let thumbHtml = "";
      if (iconStyle === "person") {
        if (img) {
          thumbHtml = `<span class="cas-dd-thumb shrink-0"><img src="${escapeHtml(img)}" alt="" referrerpolicy="no-referrer" onerror="this.parentElement.innerHTML='${PERSON_FALLBACK.replace(/'/g, "\\'")}';"/></span>`;
        } else {
          thumbHtml = `<span class="cas-dd-thumb shrink-0">${PERSON_FALLBACK}</span>`;
        }
      }
      display.innerHTML = thumbHtml + `<span class="truncate">${escapeHtml(label)}</span>`;

      // Update aria-selected on options
      root.querySelectorAll("[data-dd-option]").forEach((o) => {
        const isSel = o.dataset.value === option.value;
        o.setAttribute("aria-selected", isSel ? "true" : "false");
        o.classList.toggle("cas-dd-option-selected", isSel);
      });
      input.dispatchEvent(new Event("change", { bubbles: true }));
      if (root.dataset.submitOnChange === "1" && previousValue !== option.value) {
        const form = root.closest("form");
        if (form) form.requestSubmit();
      }
    };

    // Detect click-outside on pointerdown (capture phase) so it's
    // independent of any other click handler that might stop propagation.
    document.addEventListener(
      "pointerdown",
      (e) => {
        if (!openDd) return;
        const t = e.target;
        if (!(t instanceof Element)) return;
        // Stay open if the pointer landed inside any dropdown wrapper or
        // inside the floating menu (which is portaled visually but still
        // a DOM descendant of the wrapper).
        if (t.closest("[data-dropdown]") || openDd.menu.contains(t)) return;
        closeOpen();
      },
      true,
    );

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      // Click on a button inside a dropdown → toggle open
      const button = target.closest("[data-dd-button]");
      if (button) {
        const root = button.closest("[data-dropdown]");
        if (root && !button.disabled) {
          e.preventDefault();
          openMenu(root);
        }
        return;
      }

      // Click on an option → pick it
      const option = target.closest("[data-dd-option]");
      if (option && openDd) {
        const root = option.closest("[data-dropdown]");
        if (root) {
          setValue(root, {
            value: option.dataset.value || "",
            label: option.dataset.label || option.textContent?.trim() || "",
            image: option.dataset.image || "",
            iconStyle: option.dataset.iconStyle || "none",
          });
          closeOpen();
        }
      }
    });

    document.addEventListener("keydown", (e) => {
      if (!openDd) {
        // Open with Enter/Space when button focused
        const target = e.target;
        if (
          target instanceof HTMLElement &&
          target.matches("[data-dd-button]") &&
          (e.key === "Enter" || e.key === " " || e.key === "ArrowDown")
        ) {
          e.preventDefault();
          const root = target.closest("[data-dropdown]");
          if (root) openMenu(root);
        }
        return;
      }
      if (e.key === "Escape") {
        e.preventDefault();
        const btn = openDd.button;
        closeOpen();
        btn.focus();
        return;
      }
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        // Only consider visible options (filtered list).
        const opts = Array.from(openDd.menu.querySelectorAll("[data-dd-option]"))
          .filter((o) => !o.closest("li").classList.contains("hidden"));
        if (opts.length === 0) return;
        const focused = document.activeElement;
        // If focus is on the search input, hop to first/last option.
        if (focused === openDd.search) {
          opts[e.key === "ArrowDown" ? 0 : opts.length - 1].focus();
          return;
        }
        const idx = opts.indexOf(focused);
        let next;
        if (e.key === "ArrowDown") next = idx < 0 ? 0 : (idx + 1) % opts.length;
        else next = idx <= 0 ? opts.length - 1 : idx - 1;
        opts[next].focus();
        return;
      }
      if (e.key === "Enter") {
        const target = e.target;
        // Pressing Enter inside the search input selects the first visible option.
        if (target === openDd.search) {
          e.preventDefault();
          const firstVisible = openDd.menu.querySelector(
            "li:not(.hidden) [data-dd-option]",
          );
          if (firstVisible instanceof HTMLElement) {
            const root = firstVisible.closest("[data-dropdown]");
            if (root) {
              setValue(root, {
                value: firstVisible.dataset.value || "",
                label: firstVisible.dataset.label || firstVisible.textContent?.trim() || "",
                image: firstVisible.dataset.image || "",
                iconStyle: firstVisible.dataset.iconStyle || "none",
              });
              closeOpen();
              const btn = root.querySelector("[data-dd-button]");
              btn?.focus();
            }
          }
          return;
        }
        if (target instanceof HTMLElement && target.matches("[data-dd-option]")) {
          e.preventDefault();
          const root = target.closest("[data-dropdown]");
          if (root) {
            setValue(root, {
              value: target.dataset.value || "",
              label: target.dataset.label || target.textContent?.trim() || "",
              image: target.dataset.image || "",
              iconStyle: target.dataset.iconStyle || "none",
            });
            closeOpen();
            const btn = root.querySelector("[data-dd-button]");
            btn?.focus();
          }
        }
        return;
      }
      if (e.key === " ") {
        const target = e.target;
        // Don't intercept Space when typing in the search input.
        if (target === openDd.search) return;
        if (target instanceof HTMLElement && target.matches("[data-dd-option]")) {
          e.preventDefault();
          target.click();
        }
      }
    });

    // Reposition or close on scroll/resize so the menu doesn't drift.
    // Critical: ignore scroll events that originate INSIDE the open menu
    // (the inner options list is scrollable, and closing on its own scroll
    // would make the menu unusable for long lists).
    window.addEventListener(
      "scroll",
      (e) => {
        if (!openDd) return;
        const tgt = e.target;
        if (tgt instanceof Node && openDd.menu.contains(tgt)) return;
        closeOpen();
      },
      true,
    );
    window.addEventListener("resize", () => closeOpen());

    // Live filter as the user types in the search input.
    document.addEventListener("input", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement)) return;
      if (!t.matches("[data-dd-search]")) return;
      const menu = t.closest("[data-dd-menu]");
      if (menu) applyFilter(menu, t.value);
    });
  })();
</script>
