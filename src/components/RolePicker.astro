---
// Role picker for /staff: usa el componente Dropdown custom (mismo
// look-and-feel que el resto del CMS) y agrega un botón "+ Cargo"
// que abre un mini-form inline para crear un cargo nuevo sin salir
// de la página. La nueva opción se inserta en el dropdown vía DOM y
// queda seleccionada al instante.
//
// `staff.role` es free-text — staff_roles es solo el catálogo de
// sugerencias. Por eso enviamos el NOMBRE (no el id) al backend.

import { getSupabaseServerClient } from "~/lib/supabase-server";
import Dropdown from "~/components/Dropdown.astro";
import type { DropdownOption } from "~/components/Dropdown.astro";
import { roleLabel } from "~/lib/staff-roles";

interface Props {
  /** Name of the form field that carries the role value. */
  name: string;
  /** Current value (the role name). Selected if it matches a row. */
  value?: string | null;
  label?: string;
  description?: string;
  required?: boolean;
}
const {
  name,
  value = "",
  label = "Cargo",
  description = "Selecciona un cargo o agrega uno nuevo.",
  required = false,
} = Astro.props as Props;

// Server-side fetch so the dropdown is fully hydrated on first paint.
const sb = getSupabaseServerClient(Astro.request, Astro.cookies);
const { data: roles } = await sb
  .from("staff_roles")
  .select("id, name, sort_order")
  .order("sort_order", { ascending: true })
  .order("name", { ascending: true });

const selected = (value ?? "").trim();
// El label puede expandirse cosméticamente ("CEO — Chief Executive
// Officer"), pero el value queda como está en el DB ("CEO") para que
// staff.role siga apuntando al string canónico.
const baseOptions: DropdownOption[] = (roles ?? []).map((r) => ({
  value: r.name,
  label: roleLabel(r.name),
  icon: "lucide:briefcase",
}));
// Si el valor guardado no está en la lookup table (alguien escribió un
// cargo custom desde otro flujo, o se borró del catálogo), lo añadimos
// como opción extra para que se preserve.
const hasSelected = selected && baseOptions.some((o) => o.value === selected);
const options: DropdownOption[] = selected && !hasSelected
  ? [...baseOptions, { value: selected, label: roleLabel(selected), icon: "lucide:briefcase" }]
  : baseOptions;
---

<div class="role-picker" data-role-picker>
  {label && (
    <label class="label block mb-1.5">
      {label}{required && <span class="text-red-600">*</span>}
    </label>
  )}
  <div class="flex items-stretch gap-2">
    <div class="flex-1 min-w-0" data-role-dd>
      <Dropdown
        name={name}
        value={selected || undefined}
        options={options}
        placeholder="Selecciona un cargo…"
        searchable={false}
      />
    </div>
    <button
      type="button"
      class="btn-outline shrink-0 px-3 text-xs"
      data-role-add-btn
      aria-label="Agregar nuevo cargo"
      title="Agregar nuevo cargo"
    >
      + Cargo
    </button>
  </div>
  {description && (
    <p class="text-stone-500 text-xs mt-1.5">{description}</p>
  )}

  {/* Hidden mini-form revealed when the user clicks "+ Cargo". */}
  <div class="hidden mt-2 items-stretch gap-2" data-role-add-form>
    <input
      type="text"
      placeholder="Nuevo cargo (ej. Distribución)"
      class="form-input flex-1 min-w-0"
      data-role-add-input
      autocomplete="off"
    />
    <button type="button" class="btn-primary shrink-0 text-xs" data-role-add-save>Agregar</button>
    <button type="button" class="btn-outline shrink-0 text-xs" data-role-add-cancel>Cancelar</button>
  </div>
  <p class="hidden text-red-700 text-xs mt-1.5" data-role-add-error></p>
</div>

<script is:inline>
  (() => {
    if (window.__casRolePickerInit) return;
    window.__casRolePickerInit = true;

    const escapeHtml = (s) =>
      String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    // Mirror of lib/staff-roles.ts roleLabel() — keep both in sync. The
    // server renders the initial labels via that module; this lookup
    // handles options inserted at runtime via "+ Cargo".
    const ROLE_EXPANSIONS = {
      CEO: "Chief Executive Officer",
      CTO: "Chief Technology Officer",
      COO: "Chief Operating Officer",
      CFO: "Chief Financial Officer",
      CMO: "Chief Marketing Officer",
    };
    const roleLabel = (name) => {
      const trimmed = String(name ?? "").trim();
      const exp = ROLE_EXPANSIONS[trimmed.toUpperCase()];
      return exp ? `${trimmed} — ${exp}` : trimmed;
    };

    // Replicate Dropdown.setValue() externally: append/select an option
    // by name in a given dropdown root. The role catalogue is text-only,
    // so we don't need image/iconStyle/fontFamily.
    const selectRoleInDropdown = (ddRoot, roleName) => {
      const input = ddRoot.querySelector("[data-dd-input]");
      const display = ddRoot.querySelector("[data-dd-display]");
      const optionsList = ddRoot.querySelector("[data-dd-options]");
      if (!input || !display || !optionsList) return;

      const labelText = roleLabel(roleName);

      // 1. Append the option if it doesn't exist yet.
      const escapedValue = roleName.replace(/"/g, '\\"');
      let optionBtn = ddRoot.querySelector(`[data-dd-option][data-value="${escapedValue}"]`);
      if (!optionBtn) {
        const li = document.createElement("li");
        li.setAttribute("data-dd-search-text", labelText.toLowerCase());
        const refIcon = ddRoot.querySelector("[data-dd-option] .cas-dd-option-glyph");
        const iconHtml = refIcon ? refIcon.outerHTML : "";
        li.innerHTML = `<button
            type="button"
            role="option"
            aria-selected="false"
            data-dd-option
            data-value="${escapeHtml(roleName)}"
            data-label="${escapeHtml(labelText)}"
            data-image=""
            data-icon-style="none"
            data-font-family=""
            class="cas-dd-option">
            ${iconHtml}
            <span class="cas-dd-option-text"><span class="cas-dd-option-label">${escapeHtml(labelText)}</span></span>
          </button>`;
        optionsList.appendChild(li);
        optionBtn = li.querySelector("[data-dd-option]");
      }

      // 2. Update hidden input + display. The submitted value is the
      // short name (preserves the DB string); the display label is the
      // expanded version.
      input.value = roleName;
      const srcGlyph = optionBtn.querySelector(".cas-dd-option-glyph svg");
      const glyphHtml = srcGlyph
        ? `<span class="cas-dd-display-glyph shrink-0">${srcGlyph.outerHTML}</span>`
        : "";
      display.innerHTML = glyphHtml + `<span class="truncate">${escapeHtml(labelText)}</span>`;

      // 3. Mark aria-selected on the right option.
      ddRoot.querySelectorAll("[data-dd-option]").forEach((o) => {
        const isSel = o.dataset.value === roleName;
        o.setAttribute("aria-selected", isSel ? "true" : "false");
        o.classList.toggle("cas-dd-option-selected", isSel);
      });

      // 4. Fire `change` so dirty-trackers / form-state listeners pick up
      // the new value — mirrors what Dropdown.setValue does internally.
      input.dispatchEvent(new Event("change", { bubbles: true }));
    };

    const wire = (root) => {
      if (root.dataset.wired === "1") return;
      root.dataset.wired = "1";

      const ddWrap = root.querySelector("[data-role-dd]");
      const ddRoot = ddWrap?.querySelector("[data-dropdown]");
      const addBtn = root.querySelector("[data-role-add-btn]");
      const form = root.querySelector("[data-role-add-form]");
      const input = root.querySelector("[data-role-add-input]");
      const save = root.querySelector("[data-role-add-save]");
      const cancel = root.querySelector("[data-role-add-cancel]");
      const err = root.querySelector("[data-role-add-error]");
      if (!ddRoot) return;

      const reveal = () => {
        form.classList.remove("hidden");
        form.classList.add("flex");
        err.classList.add("hidden");
        input.value = "";
        setTimeout(() => input.focus(), 0);
      };
      const hide = () => {
        form.classList.add("hidden");
        form.classList.remove("flex");
        err.classList.add("hidden");
      };
      const showError = (msg) => {
        err.textContent = msg;
        err.classList.remove("hidden");
      };

      const submit = async () => {
        const name = input.value.trim();
        if (!name) { showError("Escribe el nombre del cargo."); return; }
        save.disabled = true;
        try {
          const res = await fetch("/api/staff-roles", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ name }),
          });
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            showError(body.error || "No se pudo crear el cargo.");
            return;
          }
          const body = await res.json();
          selectRoleInDropdown(ddRoot, body.role.name);
          hide();
        } catch (e) {
          showError("Error de red. Reintenta.");
        } finally {
          save.disabled = false;
        }
      };

      addBtn.addEventListener("click", reveal);
      cancel.addEventListener("click", hide);
      save.addEventListener("click", submit);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") { e.preventDefault(); submit(); }
        if (e.key === "Escape") { e.preventDefault(); hide(); }
      });
    };

    const wireAll = () => document.querySelectorAll("[data-role-picker]").forEach(wire);
    wireAll();
    document.addEventListener("astro:page-load", wireAll);
  })();
</script>
