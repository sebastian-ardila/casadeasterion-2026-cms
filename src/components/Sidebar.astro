---
import type { Level, Resource } from "~/lib/auth";

interface Props {
  user: App.Locals["user"];
  permissions: Record<Resource, Level> | null;
}
const { user, permissions } = Astro.props;
const path = Astro.url.pathname;
const isOwner = user?.role === "owner";

const allItems: Array<{ href: string; label: string; resource?: Resource; ownerOnly?: boolean }> = [
  { href: "/", label: "Inicio" },
  { href: "/books", label: "Libros", resource: "books" },
  { href: "/posts", label: "Artículos", resource: "posts" },
  { href: "/authors", label: "Autores", resource: "authors" },
  { href: "/categories", label: "Categorías", resource: "categories" },
  { href: "/site", label: "Configuración", resource: "site" },
  { href: "/admins", label: "Administradores", ownerOnly: true },
];

const items = allItems.filter((item) => {
  if (item.ownerOnly) return isOwner;
  if (item.resource) return (permissions?.[item.resource] ?? "none") !== "none";
  return true;
});

const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<aside class="w-64 shrink-0 border-r border-stone-200 bg-stone-50 min-h-screen flex flex-col">
  <div class="px-6 py-8">
    <p class="font-serif uppercase tracking-[0.18em] text-sm">Casa de Asterión</p>
    <p class="text-[11px] uppercase tracking-[0.18em] text-stone-500 mt-1">CMS</p>
  </div>

  <nav class="flex-1 px-2">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={[
          "nav-link",
          isActive(item.href) && "nav-link-active",
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="border-t border-stone-200 px-6 py-5 text-xs text-stone-600">
    {user ? (
      <>
        <p class="truncate font-medium text-stone-900">{user.full_name ?? user.email}</p>
        <p class="truncate text-stone-500">{user.email}</p>
        <p class="text-[10px] uppercase tracking-[0.12em] text-stone-400 mt-1">{user.role}</p>
        <form action="/logout" method="POST" class="mt-3">
          <button class="text-stone-600 hover:text-stone-900 underline">Cerrar sesión</button>
        </form>
      </>
    ) : (
      <a href="/login" class="underline">Iniciar sesión</a>
    )}
  </div>
</aside>
