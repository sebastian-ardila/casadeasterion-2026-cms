---
import { Icon } from "astro-icon/components";
import type { Level, Resource } from "~/lib/auth";

interface Props {
  user: App.Locals["user"];
  permissions: Record<Resource, Level> | null;
}
const { user, permissions } = Astro.props;
const path = Astro.url.pathname;
const isOwner = user?.role === "owner";

// `countKey`: identifies which value from /api/sidebar-counts the JS
// should drop into this row's badge. Items without a key (Inicio,
// Landing Page) just don't render a badge.
// `subItems`: nested rows that show only when the parent route is
// active. Used by Landing Page to expose Home / Catálogo / Artículos / etc.
type SidebarSub = { href: string; label: string; icon: string; pageKey?: string };
const allItems: Array<{ href: string; label: string; icon: string; resource?: Resource; ownerOnly?: boolean; managerOnly?: boolean; countKey?: string; subItems?: SidebarSub[] }> = [
  { href: "/",              label: "Inicio",        icon: "lucide:home" },
  { href: "/books",         label: "Catálogo",      icon: "lucide:book-open",       resource: "books",         countKey: "books" },
  { href: "/posts",         label: "Publicaciones", icon: "lucide:newspaper",       resource: "posts",         countKey: "posts" },
  { href: "/authors",       label: "Autores",       icon: "lucide:users",           resource: "authors",       countKey: "authors" },
  { href: "/collaborators", label: "Colaboradores", icon: "lucide:user-plus",       resource: "collaborators", countKey: "collaborators" },
  { href: "/staff",         label: "Nosotros",      icon: "lucide:building",        resource: "staff",         countKey: "staff" },
  { href: "/collections",   label: "Colecciones",   icon: "lucide:library",         resource: "collections",   countKey: "collections" },
  { href: "/categories",    label: "Categorías",    icon: "lucide:folder-tree",     resource: "categories",    countKey: "categories" },
  {
    href: "/site",
    label: "Webpage",
    icon: "lucide:layout-template",
    resource: "site",
    // Sin subItems: /site ya muestra las sub-páginas en su middle
    // list panel — el dropdown del sidebar era redundante.
  },
  { href: "/orders",      label: "Pedidos",      icon: "lucide:shopping-bag",    resource: "orders",       countKey: "orders" },
  { href: "/subscribers", label: "Suscriptores", icon: "lucide:mail",            resource: "subscribers",  countKey: "subscribers" },
  { href: "/admins",      label: "Usuarios",     icon: "lucide:users-round",     managerOnly: true,      countKey: "admins" },
];

const isManager = user?.role === "owner" || user?.role === "admin";
const items = allItems.filter((item) => {
  if (item.ownerOnly) return isOwner;
  if (item.managerOnly) return isManager;
  if (item.resource) return (permissions?.[item.resource] ?? "none") !== "none";
  return true;
});

const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

{/* Mobile top bar — hidden on md+ */}
<header class="md:hidden sticky top-0 z-30 flex items-center justify-between gap-3 px-4 h-14 border-b border-stone-200 bg-white">
  <button
    type="button"
    id="sidebar-toggle"
    aria-controls="cms-sidebar"
    aria-expanded="false"
    class="cursor-pointer w-9 h-9 flex items-center justify-center -ml-2 hover:bg-stone-100 transition"
  >
    <svg id="sidebar-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
    <svg id="sidebar-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
  </button>
  <div class="flex items-center gap-2 min-w-0">
    <span class="cas-logo-swap w-7 h-7 shrink-0">
      <img src="/casadeasterion4.webp" alt="" width="28" height="28" class="cas-logo-default w-full h-full object-contain" />
      <img src="/casadeasterion5.webp" alt="" width="28" height="28" loading="lazy" class="cas-logo-hover w-full h-full object-contain" />
    </span>
    <p class="font-serif uppercase tracking-[0.16em] text-xs truncate">Casa de Asterión</p>
  </div>
  <div class="w-9" aria-hidden="true"></div>
</header>

{/* Backdrop for mobile drawer */}
<div
  id="sidebar-backdrop"
  class="md:hidden fixed inset-0 z-30 bg-stone-900/50 hidden"
  aria-hidden="true"
></div>

<aside
  id="cms-sidebar"
  class="cms-sidebar fixed md:sticky top-0 left-0 z-40 md:z-auto w-64 md:w-60 lg:w-64 shrink-0 border-r border-stone-200 bg-stone-50 flex flex-col -translate-x-full md:translate-x-0 transition-transform duration-200"
>
  <div class="shrink-0 px-5 md:px-6 pt-5 md:pt-7 pb-4 border-b border-stone-200/70">
    <div class="flex items-center gap-3 mb-4">
      <span class="cas-logo-swap w-10 h-10 md:w-11 md:h-11 shrink-0">
        <img src="/casadeasterion4.webp" alt="" width="44" height="44" class="cas-logo-default w-full h-full object-contain" />
        <img src="/casadeasterion5.webp" alt="" width="44" height="44" loading="lazy" class="cas-logo-hover w-full h-full object-contain" />
      </span>
      <div class="min-w-0">
        <p class="font-serif uppercase tracking-[0.18em] text-sm leading-tight">Casa de Asterión</p>
        <p class="text-[10px] uppercase tracking-[0.18em] text-stone-500 mt-0.5">CMS</p>
      </div>
    </div>

    <a
      href="https://casadeasterionediciones.com"
      target="_blank"
      rel="noopener noreferrer"
      class="cursor-pointer flex items-center justify-between gap-2 px-3 py-2 border border-stone-300 text-stone-700 hover:border-stone-900 hover:text-stone-900 transition group"
    >
      <span class="text-xs uppercase tracking-[0.16em]">Ver sitio</span>
      <svg class="shrink-0 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7"/>
        <path d="M7 7h10v10"/>
      </svg>
    </a>
  </div>

  <nav class="flex-1 min-h-0 overflow-y-auto overscroll-contain px-2 py-3" data-sidebar-nav>
    {items.map((item) => (
      <>
        <a
          href={item.href}
          data-astro-prefetch
          class:list={[
            "nav-link cas-nav-row",
            !!item.subItems && "cas-nav-row-has-toggle",
            isActive(item.href) && "nav-link-active",
          ]}
        >
          <Icon name={item.icon} class="w-4 h-4 shrink-0" aria-hidden="true" />
          <span class="cas-nav-label">{item.label}</span>
          {item.countKey && (
            <span class="cas-nav-count" data-count-key={item.countKey} aria-hidden="true"></span>
          )}
          {item.subItems && (
            <span
              class="cas-nav-expander"
              role="button"
              tabindex="0"
              data-expand-toggle={item.href}
              aria-label="Mostrar u ocultar subpáginas"
            >
              <Icon name="lucide:chevron-down" class="w-3.5 h-3.5" aria-hidden="true" />
            </span>
          )}
        </a>
        {item.subItems && (
          <div class="cas-subnav" data-subnav-parent={item.href} hidden>
            {item.subItems.map((sub) => (
              <a
                href={sub.href}
                data-astro-prefetch
                data-page-key={sub.pageKey}
                class="cas-subnav-link"
              >
                <Icon name={sub.icon} class="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
                <span>{sub.label}</span>
              </a>
            ))}
          </div>
        )}
      </>
    ))}
  </nav>

  {/* Sync the expand/collapse state from localStorage BEFORE the
      browser paints the sidebar. SSR ships every sub-nav as hidden;
      this script reopens any that the user had open last time. */}
  <script is:inline>
    (() => {
      try {
        const raw = localStorage.getItem("cas:sidebar-expanded");
        if (!raw) return;
        const state = JSON.parse(raw);
        if (!state || typeof state !== "object") return;
        document.querySelectorAll("#cms-sidebar [data-subnav-parent]").forEach((el) => {
          const parent = el.getAttribute("data-subnav-parent") || "";
          if (state[parent] === true) {
            el.removeAttribute("hidden");
            const row = document.querySelector('#cms-sidebar a.nav-link[href="' + parent + '"]');
            if (row) row.setAttribute("data-expanded", "1");
          }
        });
      } catch {}
    })();
  </script>

  <div class="shrink-0 border-t border-stone-200 px-5 py-4 text-xs text-stone-600 bg-stone-50">
    {user ? (
      <div class="flex items-start gap-3">
        {user.avatar_url ? (
          <img
            src={user.avatar_url}
            alt=""
            referrerpolicy="no-referrer"
            class="w-9 h-9 rounded-full object-cover shrink-0 mt-0.5 border border-stone-200"
          />
        ) : (
          <div class="w-9 h-9 rounded-full bg-stone-200 shrink-0 mt-0.5 flex items-center justify-center text-stone-600 text-xs font-medium">
            {(user.full_name ?? user.email).slice(0, 1).toUpperCase()}
          </div>
        )}
        <div class="min-w-0 flex-1">
          <p class="truncate font-medium text-stone-900 text-[13px]">{user.full_name ?? user.email}</p>
          <p class="truncate text-stone-500 text-[11px]">{user.email}</p>
          <p class="text-[10px] uppercase tracking-[0.12em] text-stone-400 mt-0.5">{user.role}</p>
          <button
            type="button"
            id="cms-logout-btn"
            class="cas-logout-btn mt-2 cursor-pointer inline-flex items-center gap-1.5 text-stone-700 hover:text-stone-900 text-[12px] border border-stone-300 hover:border-stone-900 px-2.5 py-1 transition"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span class="pointer-events-none">Cerrar sesión</span>
          </button>
        </div>
      </div>
    ) : (
      <a href="/login" class="cursor-pointer underline">Iniciar sesión</a>
    )}
  </div>
</aside>

<style is:global>
  /* Use h-screen on desktop, but on mobile (where the sidebar lives in a
     fixed drawer) prefer the dynamic viewport height so the user's profile
     and "Cerrar sesión" never get clipped behind the iOS Safari URL bar. */
  .cms-sidebar { height: 100vh; }
  @supports (height: 100dvh) {
    .cms-sidebar { height: 100dvh; }
  }

  /* Sidebar row layout: icon · label · (optional count badge).
     The label takes the remaining space and truncates if it's too
     long; the badge sits flush right with a comfortable gap. */
  .cas-nav-row { min-width: 0; }
  .cas-nav-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cas-nav-count {
    flex: 0 0 auto;
    margin-left: 0.5rem;
    padding: 0 0.5rem;
    min-width: 1.5rem;
    height: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    border-radius: 9999px;
    background: rgb(231 229 228);          /* stone-200 */
    color: rgb(68 64 60);                  /* stone-700 */
    /* Sin transition — la fila completa anima su background pero el
       counter cambia instantáneo. Animar el counter generaba un
       "parpadeo" perceptible al navegar entre secciones. */
  }
  .cas-nav-count:empty { display: none; }  /* hide until JS fills it */
  .nav-link-active .cas-nav-count {
    background: rgba(255,255,255,0.18);
    color: rgb(245 245 244);
  }

  /* Highlight contador de Pedidos — los pedidos son señal de venta y
     merecen destacarse sobre el resto del menú. Solo cuando hay al
     menos un pedido (no aplicamos color cuando el badge está vacío). */
  .cas-nav-count[data-count-key="orders"]:not(:empty) {
    background: rgb(254 215 170);          /* orange-200 */
    color: rgb(124 45 18);                 /* orange-900 */
    font-weight: 600;
  }
  .nav-link-active .cas-nav-count[data-count-key="orders"]:not(:empty) {
    background: rgb(251 146 60);           /* orange-400 */
    color: rgb(67 20 7);                   /* orange-950 */
  }

  /* Expand/collapse caret for rows that have a sub-nav (Page →
     Home / Catálogo / …). Click toggles the chips below. The icon
     rotates 180° when the sub-nav is open. The label part of the
     row keeps navigating as a normal link. */
  .cas-nav-expander {
    flex: 0 0 auto;
    margin-left: 0.25rem;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    color: currentColor;
    opacity: 0.7;
    cursor: pointer;
    transition: background-color 0.12s, opacity 0.12s, transform 0.15s;
  }
  .cas-nav-expander:hover { opacity: 1; background: rgba(0,0,0,0.06); }
  .nav-link-active .cas-nav-expander:hover { background: rgba(255,255,255,0.12); }
  .cas-nav-expander > svg { transition: transform 0.15s; }
  .cas-nav-row-has-toggle[data-expanded="1"] .cas-nav-expander > svg {
    transform: rotate(180deg);
  }

  /* Sub-navigation chips under an expanded parent (e.g. Landing Page →
     Home / Catálogo / Artículos / …). Wrapping row of pills, each
     sized to its own content (icon + label), so several fit per line
     within the sidebar's narrow column. */
  .cas-subnav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0.25rem 0.625rem 0.5rem;
  }
  .cas-subnav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.55rem;
    font-size: 0.75rem;
    line-height: 1.2;
    color: rgb(120 113 108);               /* stone-500 */
    background: white;
    border: 1px solid rgb(231 229 228);    /* stone-200 */
    border-radius: 9999px;
    text-decoration: none;
    transition: color 0.12s, background-color 0.12s, border-color 0.12s;
    cursor: pointer;
    white-space: nowrap;
  }
  .cas-subnav-link:hover {
    color: rgb(28 25 23);
    background: rgb(245 245 244);
    border-color: rgb(214 211 209);
  }
  .cas-subnav-link.cas-subnav-active,
  .cas-subnav-link.cas-subnav-active:hover {
    color: white;
    background: rgb(28 25 23);             /* stone-900 */
    border-color: rgb(28 25 23);
    font-weight: 500;
  }
  .cas-subnav-link > svg { color: currentColor; flex: 0 0 auto; }
</style>

<script is:inline>
  // The sidebar is persisted between view transitions (transition:persist) so
  // it never re-mounts. We attach delegated listeners on `document` once, and
  // re-sync the active link on every astro:after-swap.
  (() => {
    if (window.__casSidebarInit) return;
    window.__casSidebarInit = true;

    const get = () => ({
      btn: document.getElementById("sidebar-toggle"),
      sidebar: document.getElementById("cms-sidebar"),
      backdrop: document.getElementById("sidebar-backdrop"),
      iconOpen: document.getElementById("sidebar-icon-open"),
      iconClose: document.getElementById("sidebar-icon-close"),
    });

    const setOpen = (open) => {
      const { btn, sidebar, backdrop, iconOpen, iconClose } = get();
      if (!sidebar || !backdrop || !btn) return;
      sidebar.classList.toggle("-translate-x-full", !open);
      backdrop.classList.toggle("hidden", !open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
    };

    document.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest("#sidebar-toggle")) {
        const { sidebar } = get();
        if (sidebar) setOpen(sidebar.classList.contains("-translate-x-full"));
        return;
      }
      if (t.closest("#sidebar-backdrop")) {
        setOpen(false);
        return;
      }
      // Logout button: delegate to window.casLogout (registered by the
      // module script below). We can't import("@supabase/ssr") from this
      // is:inline block because module specifiers aren't resolvable in the
      // browser without a bundler.
      if (t.closest("#cms-logout-btn")) {
        e.preventDefault();
        const btn = t.closest("#cms-logout-btn");
        if (btn instanceof HTMLButtonElement) {
          btn.disabled = true;
          btn.style.opacity = "0.6";
        }
        if (typeof window.casLogout === "function") {
          window.casLogout();
        } else {
          // Fallback if the module script hasn't booted yet.
          fetch("/logout", { method: "POST", credentials: "same-origin" })
            .finally(() => { window.location.href = "/login"; });
        }
        return;
      }
      // Close drawer when clicking any link inside the sidebar.
      if (t.closest("#cms-sidebar a")) {
        setOpen(false);
      }
    });

    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) {
        const { sidebar, backdrop, btn, iconOpen, iconClose } = get();
        sidebar?.classList.add("-translate-x-full");
        backdrop?.classList.add("hidden");
        document.body.style.overflow = "";
        btn?.setAttribute("aria-expanded", "false");
        iconOpen?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
      }
    });

    // ---- Count badges -------------------------------------------------
    // Format integers compactly so a 12 000-author catalog still fits the
    // sidebar (12K) and a 1 234 567-row table doesn't blow the layout
    // (1.2M). Single decimal kept only when it adds information; trailing
    // ".0" is stripped.
    const formatCount = (n) => {
      if (!Number.isFinite(n) || n < 0) return "";
      if (n < 1000) return String(n);
      const fmt = (v, suffix) => {
        const s = v.toFixed(1);
        return (s.endsWith(".0") ? s.slice(0, -2) : s) + suffix;
      };
      if (n < 10_000)        return fmt(n / 1000, "K");
      if (n < 1_000_000)     return Math.round(n / 1000) + "K";
      if (n < 10_000_000)    return fmt(n / 1_000_000, "M");
      if (n < 1_000_000_000) return Math.round(n / 1_000_000) + "M";
      return fmt(n / 1_000_000_000, "B");
    };

    const SIDEBAR_COUNTS_CACHE_KEY = "cas:sidebar-counts";
    const applyCounts = (counts) => {
      if (!counts || typeof counts !== "object") return;
      document.querySelectorAll("[data-count-key]").forEach((el) => {
        const key = el.getAttribute("data-count-key");
        if (!key) return;
        const v = counts[key];
        // Si la respuesta del endpoint no incluye esta key (porque el
        // usuario no tiene permiso, o porque countOf falló silenciosamente,
        // o porque la red cortó la respuesta a mitad), MANTENEMOS el valor
        // actual del badge en lugar de blanquearlo a "". Vaciarlo dispararía
        // :empty { display: none } → "parpadeo" entre navegaciones.
        if (typeof v !== "number") return;
        const next = formatCount(v);
        if (el.textContent !== next) el.textContent = next;
        const titleStr = String(v);
        if (el.title !== titleStr) el.title = titleStr;
      });
    };

    // Re-aplica el cache al sidebar. Útil en boot y también en cada
    // page-load: si por alguna razón Astro re-renderizó el sidebar
    // server-side (los span del SSR vienen vacíos), volvemos a llenarlo
    // antes que se vea vacío.
    const applyCachedCounts = () => {
      try {
        const cached = sessionStorage.getItem(SIDEBAR_COUNTS_CACHE_KEY);
        if (cached) applyCounts(JSON.parse(cached));
      } catch {}
    };

    applyCachedCounts();

    let countsInflight = false;
    const refreshCounts = async () => {
      if (countsInflight) return;
      countsInflight = true;
      try {
        const res = await fetch("/api/sidebar-counts", { credentials: "same-origin" });
        if (!res.ok) return;
        const data = await res.json();
        applyCounts(data);
        try { sessionStorage.setItem(SIDEBAR_COUNTS_CACHE_KEY, JSON.stringify(data)); } catch {}
      } catch {
        // Network hiccup — keep whatever's already rendered.
      } finally {
        countsInflight = false;
      }
    };

    // En cada navegación: primero rellenamos del cache (instantáneo, no
    // espera la red) y luego refrescamos los counts. Si el sidebar
    // persistió, applyCachedCounts es no-op (los badges ya tienen valor
    // y el diff check no toca el DOM). Si por algún motivo el sidebar
    // perdió su estado, esto evita el "parpadeo" de vacío → lleno.
    document.addEventListener("astro:page-load", () => {
      applyCachedCounts();
      refreshCounts();
    });
    document.addEventListener("astro:after-swap", applyCachedCounts);

    // Per-parent expand/collapse state. The default is "open when the
    // parent route is active" — but the user can override (open when
    // inactive, or close when active) and we persist that in
    // localStorage so it survives reloads and navigations.
    const EXPAND_STORAGE_KEY = "cas:sidebar-expanded";
    const readExpandState = () => {
      try {
        const raw = localStorage.getItem(EXPAND_STORAGE_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch { return {}; }
    };
    const writeExpandState = (s) => {
      try { localStorage.setItem(EXPAND_STORAGE_KEY, JSON.stringify(s)); } catch {}
    };
    const isExpanded = (parentHref, _parentActive) => {
      const s = readExpandState();
      // Explicit override — true / false stored.
      if (typeof s[parentHref] === "boolean") return s[parentHref];
      // Default: collapsed. The user opens it once and the choice
      // sticks via localStorage (survives reloads, navigations,
      // logout/login on the same browser).
      return false;
    };

    // Re-sync the active state of nav links. Called immediately on click and
    // again when a navigation completes — so the highlighted item updates the
    // moment you tap, not after the destination page finishes loading.
    // Also expands/collapses sub-navs (e.g. Page's Home / Catálogo /
    // Artículos / …) and highlights the active sub-item by ?page=… key.
    const setActive = (path, search) => {
      const params = new URLSearchParams(search || "");
      const pageKey = (params.get("page") || "home").toLowerCase();
      const isActive = (href) => {
        const hrefPath = href.split("?")[0];
        return hrefPath === path || (hrefPath !== "/" && path.startsWith(hrefPath));
      };
      document.querySelectorAll("#cms-sidebar [data-sidebar-nav] a.nav-link").forEach((a) => {
        const href = a.getAttribute("href") || "";
        a.classList.toggle("nav-link-active", isActive(href));
      });
      // Sub-navs: visibility is the OR of (parent route active) and the
      // user's explicit expand override. The parent row also gets a
      // [data-expanded] flag so the chevron knows which way to point.
      document.querySelectorAll("#cms-sidebar [data-subnav-parent]").forEach((el) => {
        const parent = el.getAttribute("data-subnav-parent") || "";
        const parentActive = isActive(parent);
        const open = isExpanded(parent, parentActive);
        if (open) el.removeAttribute("hidden");
        else el.setAttribute("hidden", "");
        const row = document.querySelector(
          `#cms-sidebar a.nav-link[href="${parent}"]`,
        );
        if (row) {
          if (open) row.setAttribute("data-expanded", "1");
          else row.removeAttribute("data-expanded");
        }
      });
      document.querySelectorAll("#cms-sidebar .cas-subnav-link").forEach((a) => {
        const key = a.getAttribute("data-page-key") || "";
        a.classList.toggle("cas-subnav-active", key === pageKey);
      });
    };

    // Click on the expander caret toggles the sub-nav for that parent
    // row, without navigating to the parent's href.
    document.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const exp = t.closest("[data-expand-toggle]");
      if (!exp) return;
      e.preventDefault();
      e.stopPropagation();
      const parent = exp.getAttribute("data-expand-toggle") || "";
      const subnav = document.querySelector(
        `#cms-sidebar [data-subnav-parent="${parent}"]`,
      );
      if (!subnav) return;
      const isHidden = subnav.hasAttribute("hidden");
      const s = readExpandState();
      s[parent] = isHidden;          // store the new state explicitly
      writeExpandState(s);
      if (isHidden) subnav.removeAttribute("hidden");
      else subnav.setAttribute("hidden", "");
      const row = document.querySelector(
        `#cms-sidebar a.nav-link[href="${parent}"]`,
      );
      if (row) {
        if (isHidden) row.setAttribute("data-expanded", "1");
        else row.removeAttribute("data-expanded");
      }
    });
    document.addEventListener("keydown", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (e.key !== "Enter" && e.key !== " ") return;
      const exp = t.closest("[data-expand-toggle]");
      if (!exp) return;
      e.preventDefault();
      e.stopPropagation();
      exp.click();
    });
    const syncActive = () =>
      setActive(window.location.pathname, window.location.search);

    // Highlight the target link immediately on click — no waiting for SSR.
    document.addEventListener("astro:before-preparation", (e) => {
      try {
        const dest = e.to instanceof URL ? e.to : new URL(e.to);
        setActive(dest.pathname, dest.search);
      } catch {}
    });
    document.addEventListener("astro:page-load", syncActive);
    document.addEventListener("astro:after-swap", syncActive);
    // Listen for in-page page-tab changes from /site (the chip nav).
    // The /site script dispatches "cas:page-tab-change" so we can sync
    // the sidebar without a real navigation.
    window.addEventListener("cas:page-tab-change", syncActive);
    syncActive();
  })();
</script>

<script>
  // Bundled module — Astro processes this so the @supabase/ssr import
  // resolves at build time. Exposes window.casLogout so the inline
  // delegated handler above can call it without importing anything.
  import { createBrowserClient } from "@supabase/ssr";

  declare global {
    interface Window {
      casLogout?: () => Promise<void> | void;
    }
  }

  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  window.casLogout = async () => {
    // 1. Tear down the client-side Supabase session (clears localStorage
    //    auth tokens via supabase-js's storage adapter).
    try {
      if (url && key) {
        const supabase = createBrowserClient(url, key);
        await supabase.auth.signOut();
      }
    } catch {
      // ignore — server-side logout below also clears auth cookies
    }
    // 2. Clear server-side session cookies.
    try {
      await fetch("/logout", { method: "POST", credentials: "same-origin" });
    } catch {}
    // 3. Belt-and-suspenders cleanup of any leftover Supabase storage.
    //    signOut() should have done this, but PKCE flow code-verifiers
    //    sometimes linger and trip up the next signInWithOAuth on /login.
    try {
      const localKeys: string[] = [];
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && (k.startsWith("sb-") || k.startsWith("supabase."))) {
          localKeys.push(k);
        }
      }
      localKeys.forEach((k) => localStorage.removeItem(k));
    } catch {}
    // 4. Wipe per-user data the CMS cached in sessionStorage so the next
    //    account doesn't see leftover stats / lists.
    try {
      const keys: string[] = [];
      for (let i = 0; i < sessionStorage.length; i++) {
        const k = sessionStorage.key(i);
        if (k && (k.startsWith("cas:") || k.startsWith("cas_") || k.startsWith("cda_"))) {
          keys.push(k);
        }
      }
      keys.forEach((k) => sessionStorage.removeItem(k));
    } catch {}
    // 5. Hard navigate so persisted components (sidebar, build status bar,
    //    toast stack, etc.) are torn down and the new state is fully read
    //    from the server.
    window.location.href = "/login";
  };
</script>
