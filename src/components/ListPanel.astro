---
import { Icon } from "astro-icon/components";
import type { Resource, Level } from "~/lib/auth";

// "admins" is owner-only and isn't a Resource (no permission level),
// so we accept it as a literal extension here.
type PanelResource = Extract<Resource, "posts" | "books" | "authors" | "categories"> | "admins";

interface Props {
  resource: PanelResource;
  activeId?: string | null;
  permission: Level;
  // When true, hide the list panel on mobile (used when the user is
  // viewing or editing a single item — the content takes the full width).
  hideOnMobile?: boolean;
}
const { resource, activeId, permission, hideOnMobile = false } = Astro.props;
const canEdit = permission === "edit";

const headerByResource: Record<PanelResource, { title: string; icon: string; newHref: string; newLabel: string }> = {
  posts: { title: "Artículos", icon: "lucide:newspaper", newHref: "/posts/new", newLabel: "+ Nuevo artículo" },
  books: { title: "Libros", icon: "lucide:book-open", newHref: "/books/new", newLabel: "+ Nuevo libro" },
  authors: { title: "Autores", icon: "lucide:users", newHref: "/authors/new", newLabel: "+ Nuevo autor" },
  categories: { title: "Categorías", icon: "lucide:folder-tree", newHref: "/categories/new", newLabel: "+ Nueva categoría" },
  admins: { title: "Usuarios", icon: "lucide:users-round", newHref: "/admins/new", newLabel: "+ Nuevo usuario" },
};
const header = headerByResource[resource];

// Treat /new as a virtual active row at the top.
const isNew = Astro.url.pathname.endsWith("/new");
---

<aside
  class:list={[
    "list-panel w-full md:w-72 lg:w-80 shrink-0 md:border-r border-stone-200 bg-white md:h-screen flex flex-col",
    hideOnMobile && "hidden md:flex",
  ]}
  data-list-panel={resource}
  data-active-id={activeId ?? ""}
>
  <div class="px-5 pt-5 pb-3 border-b border-stone-200">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 class="font-serif text-lg">{header.title}</h2>
      {canEdit && (
        <a
          href={header.newHref}
          data-astro-prefetch
          class:list={[
            "cursor-pointer text-xs px-2.5 py-1.5 border transition",
            isNew
              ? "border-stone-900 bg-stone-900 text-white"
              : "border-stone-300 hover:border-stone-900",
          ]}
        >
          {header.newLabel}
        </a>
      )}
    </div>
    <div class="relative">
      <Icon name="lucide:search" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-stone-400 pointer-events-none" aria-hidden="true" />
      <input
        type="text"
        class="w-full text-sm pl-8 pr-2.5 py-1.5 border border-stone-200 bg-stone-50 focus:bg-white focus:border-stone-900 focus:outline-none transition"
        placeholder="Buscar…"
        autocomplete="off"
        spellcheck="false"
        data-list-search
      />
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto" data-list-nav>
    {/* Skeleton placeholders shown until JS replaces them with real data. */}
    <ul data-list-skeleton>
      {Array.from({ length: 6 }).map((_, i) => (
        <li class="px-5 py-3 border-b border-stone-100" style={`opacity: ${1 - i * 0.12}`}>
          <div class="h-3 bg-stone-200 rounded w-3/4 mb-2 animate-pulse"></div>
          <div class="h-2.5 bg-stone-100 rounded w-1/2 animate-pulse"></div>
        </li>
      ))}
    </ul>

    <p class="text-sm text-stone-500 px-5 py-6 hidden" data-list-empty>
      Aún no hay {header.title.toLowerCase()}.
    </p>

    <p class="text-sm text-red-700 px-5 py-6 hidden" data-list-error>
      No se pudieron cargar los datos.
    </p>

    <ul class="hidden" data-list-items></ul>
  </nav>
</aside>

<style is:global>
  /* Status pills inside the dynamically-rendered list. */
  .lp-status {
    display: inline-block;
    flex-shrink: 0;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 6px;
    margin-top: 2px;
  }
  .lp-status-pub {
    background: #dcfce7;
    color: #14532d;
  }
  .lp-status-draft {
    background: #e7e5e4;
    color: #57534e;
  }
  .lp-status-owner {
    background: #ede9fe;
    color: #5b21b6;
  }
  .lp-status-admin {
    background: #1c1917;
    color: #fafaf9;
  }
  .lp-status-editor {
    background: #f5f5f4;
    color: #44403c;
  }
  .lp-link {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 20px;
    border-bottom: 1px solid #f5f5f4;
    transition: background-color 0.1s;
  }
  .lp-link:hover {
    background: #fafaf9;
  }
  .lp-link-active {
    background: #f5f5f4;
    border-left: 2px solid #1c1917;
  }
  .lp-thumb {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    background: #f5f5f4;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a8a29e;
  }
  .lp-thumb-photo {
    border-radius: 9999px;
  }
  .lp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lp-thumb svg {
    width: 22px;
    height: 22px;
    opacity: 0.7;
  }
  .lp-body {
    flex: 1 1 0%;
    min-width: 0;
  }
  .lp-title {
    font-weight: 500;
    font-size: 14px;
    color: #1c1917;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1 1 0%;
  }
  .lp-sub {
    font-size: 12px;
    color: #78716c;
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lp-meta {
    font-size: 11px;
    color: #a8a29e;
    margin-top: 2px;
    font-style: italic;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lp-row-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  /* Emoji-style thumb (used for category kinds) */
  .lp-thumb-emoji {
    background: #fafaf9;
    border: 1px solid #e7e5e4;
    border-radius: 9999px;
    font-size: 16px;
    color: #44403c;
  }
  .lp-thumb-emoji-philosophy { background: #eef2ff; border-color: #e0e7ff; color: #3730a3; }
  .lp-thumb-emoji-poetry     { background: #fff1f2; border-color: #ffe4e6; color: #9f1239; }
  .lp-thumb-emoji-book       { background: #fffbeb; border-color: #fef3c7; color: #92400e; }
  .lp-thumb-emoji-other      { background: #f5f5f4; border-color: #e7e5e4; color: #44403c; }

  /* ── Reorder controls (categories) ── */
  .lp-link.lp-link-reorderable {
    padding-right: 0;
    position: relative;
  }
  .lp-link-body {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Grip — larger touch target, more visible affordance */
  .lp-grip {
    flex-shrink: 0;
    width: 24px;
    align-self: stretch;
    margin: -12px 0 -12px -16px;
    padding-left: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d6d3d1;
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition: color 0.15s, background 0.15s;
  }
  .lp-link:hover .lp-grip { color: #78716c; }
  .lp-grip:hover { color: #1c1917 !important; background: #fafaf9; }
  .lp-grip:active { cursor: grabbing; }

  /* Up/down arrows — visible-on-hover in desktop, always in mobile */
  .lp-arrows {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-left: 1px solid #f5f5f4;
    align-self: stretch;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .lp-link:hover .lp-arrows,
  .lp-link:focus-within .lp-arrows {
    opacity: 1;
  }
  @media (max-width: 767px) {
    .lp-arrows { opacity: 1; }
  }
  .lp-arrow {
    width: 30px;
    flex: 1 1 0%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #78716c;
    background: transparent;
    border: 0;
    padding: 0;
    transition: background 0.12s, color 0.12s;
  }
  .lp-arrow:hover:not(:disabled) {
    background: #1c1917;
    color: #fff;
  }
  .lp-arrow:disabled {
    opacity: 0.18;
    cursor: not-allowed;
  }
  .lp-arrow + .lp-arrow {
    border-top: 1px solid #f5f5f4;
  }

  /* Drag/drop visual indicators */
  .lp-link.lp-dragging {
    opacity: 0.35;
    transform: scale(0.98);
  }
  .lp-link {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0.1s, opacity 0.15s;
  }
  /* Drop indicator: glowing horizontal bar above/below the target row */
  .lp-link.lp-drop-above::before,
  .lp-link.lp-drop-below::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    height: 3px;
    background: #1c1917;
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(28, 25, 23, 0.45);
    pointer-events: none;
    z-index: 1;
  }
  .lp-link.lp-drop-above::before { top: -2px; }
  .lp-link.lp-drop-below::after  { bottom: -2px; }

  /* Whole-list "saving" overlay */
  [data-list-panel].lp-saving-list {
    position: relative;
  }
  [data-list-panel].lp-saving-list::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.4);
    pointer-events: none;
    z-index: 2;
  }
  .lp-save-spinner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #1c1917;
  }
  .lp-save-spinner svg {
    animation: lp-spin 1s linear infinite;
  }
  @keyframes lp-spin { to { transform: rotate(360deg); } }
</style>

<script is:inline>
  // Idempotent global controller: each <aside data-list-panel> is hydrated by
  // fetching /api/list?resource=<r>. Results are cached in sessionStorage so
  // navigating back is instant.
  (() => {
    if (window.__casListInit) return;
    window.__casListInit = true;

    const cacheKey = (r) => `cas:list:${r}`;
    const CACHE_TTL = 60_000; // 1 min

    const escape = (s) =>
      String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");

    // Lowercase + strip diacritics so 'ector' or 'Hector' both match 'Héctor'.
    const normalize = (s) =>
      String(s ?? "").toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");

    const applySearch = (panel) => {
      const input = panel.querySelector("[data-list-search]");
      const list = panel.querySelector("[data-list-items]");
      if (!input || !list) return;
      const q = normalize(input.value.trim());
      let visible = 0;
      list.querySelectorAll("[data-list-row]").forEach((li) => {
        const text = li.dataset.searchText || "";
        const match = !q || text.includes(q);
        li.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      // Toggle the empty state for the search-no-results case.
      const empty = panel.querySelector("[data-list-empty]");
      if (empty) {
        if (q && visible === 0) {
          empty.textContent = "Sin resultados.";
          empty.classList.remove("hidden");
        } else if (q) {
          empty.classList.add("hidden");
        }
        // When q is empty, leave whatever state hydrate() set.
      }
    };

    // Derive the active id from the current URL (more reliable than the SSR
    // dataset attr, since the panel can be persisted across view transitions).
    const currentActiveId = (resource) => {
      const path = window.location.pathname;
      const m = path.match(new RegExp(`^/${resource}/([^/]+)$`));
      if (!m) return "";
      const seg = m[1];
      // /:resource/new is not an item id.
      return seg === "new" ? "" : seg;
    };

    // ── Reorder logic (currently used only by `categories`) ──
    let draggedItem = null;

    const updateArrowDisabled = (list) => {
      const items = list.querySelectorAll("li > a.lp-link");
      items.forEach((a, idx) => {
        const up = a.querySelector('[data-move="up"]');
        const down = a.querySelector('[data-move="down"]');
        if (up) up.disabled = idx === 0;
        if (down) down.disabled = idx === items.length - 1;
      });
    };

    // FLIP animation helper: snapshots positions, runs `mutate()` to alter
    // the DOM, then animates each row from its old position to its new one.
    const flipAnimate = (list, mutate) => {
      const items = Array.from(list.querySelectorAll("li"));
      const before = new Map();
      items.forEach((li) => before.set(li, li.getBoundingClientRect().top));

      mutate();

      items.forEach((li) => {
        const oldTop = before.get(li);
        if (oldTop == null) return;
        const newTop = li.getBoundingClientRect().top;
        const dy = oldTop - newTop;
        if (Math.abs(dy) < 1) return;
        const link = li.querySelector(".lp-link");
        if (!link) return;
        // Apply the inverse transform instantly, then transition to 0.
        link.style.transition = "none";
        link.style.transform = `translateY(${dy}px)`;
        // Force reflow so the browser registers the offset.
        void link.offsetHeight;
        link.style.transition = "";
        link.style.transform = "";
      });
    };

    const persistReorder = async (panel, list) => {
      const resource = panel.dataset.listPanel;
      // Only categories supports reorder right now.
      if (resource !== "categories") return;
      const ids = Array.from(list.querySelectorAll("li > a.lp-link")).map((a) => a.dataset.id);
      panel.classList.add("lp-saving-list");
      try {
        const res = await fetch(`/api/${resource}/reorder`, {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ order: ids }),
        });
        if (!res.ok) throw new Error("http_" + res.status);
        try { sessionStorage.removeItem(cacheKey(resource)); } catch {}
        if (typeof window.casToast === "function") {
          window.casToast({ type: "success", message: "Orden guardado." });
        }
        if (typeof window.casBuildPending === "function") {
          window.casBuildPending();
        }
      } catch {
        if (typeof window.casToast === "function") {
          window.casToast({ type: "error", message: "No se pudo guardar el orden." });
        }
      } finally {
        panel.classList.remove("lp-saving-list");
      }
    };

    const wireReorder = (panel, list) => {
      // Click on grip / arrows / drag should NOT navigate.
      list.addEventListener("click", (e) => {
        const t = e.target instanceof Element ? e.target : null;
        if (!t) return;
        const grip = t.closest("[data-grip]");
        const moveBtn = t.closest("[data-move]");
        if (grip || moveBtn) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (moveBtn) {
          const id = moveBtn.dataset.id;
          const dir = moveBtn.dataset.move;
          const link = list.querySelector(`a.lp-link[data-id="${id}"]`);
          if (!link) return;
          const li = link.parentElement;
          if (!li) return;
          const sibling = dir === "up" ? li.previousElementSibling : li.nextElementSibling;
          if (!sibling) return;
          flipAnimate(list, () => {
            if (dir === "up") list.insertBefore(li, sibling);
            else list.insertBefore(sibling, li);
          });
          updateArrowDisabled(list);
          persistReorder(panel, list);
        }
      });

      // Drag start (on the grip)
      list.addEventListener("dragstart", (e) => {
        const t = e.target instanceof Element ? e.target : null;
        if (!t) return;
        if (!t.closest("[data-grip]")) return;
        const li = t.closest("li");
        if (!li) return;
        draggedItem = li;
        li.querySelector(".lp-link")?.classList.add("lp-dragging");
        try {
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", li.querySelector(".lp-link")?.dataset.id || "");
          }
        } catch {}
      });
      list.addEventListener("dragend", () => {
        list.querySelectorAll(".lp-dragging, .lp-drop-above, .lp-drop-below")
          .forEach((el) => el.classList.remove("lp-dragging", "lp-drop-above", "lp-drop-below"));
        draggedItem = null;
      });
      list.addEventListener("dragover", (e) => {
        if (!draggedItem) return;
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
        const target = e.target instanceof Element ? e.target.closest("li") : null;
        list.querySelectorAll(".lp-drop-above, .lp-drop-below")
          .forEach((el) => el.classList.remove("lp-drop-above", "lp-drop-below"));
        if (!target || target === draggedItem) return;
        const link = target.querySelector(".lp-link");
        if (!link) return;
        const rect = target.getBoundingClientRect();
        const before = e.clientY < rect.top + rect.height / 2;
        link.classList.add(before ? "lp-drop-above" : "lp-drop-below");
      });
      list.addEventListener("drop", (e) => {
        if (!draggedItem) return;
        e.preventDefault();
        const target = e.target instanceof Element ? e.target.closest("li") : null;
        list.querySelectorAll(".lp-drop-above, .lp-drop-below")
          .forEach((el) => el.classList.remove("lp-drop-above", "lp-drop-below"));
        if (!target || target === draggedItem) {
          draggedItem = null;
          return;
        }
        const rect = target.getBoundingClientRect();
        const before = e.clientY < rect.top + rect.height / 2;
        const moving = draggedItem;
        flipAnimate(list, () => {
          if (before) list.insertBefore(moving, target);
          else list.insertBefore(moving, target.nextElementSibling);
        });
        draggedItem = null;
        updateArrowDisabled(list);
        persistReorder(panel, list);
      });
    };

    const renderItems = (panel, items) => {
      const skeleton = panel.querySelector("[data-list-skeleton]");
      const empty = panel.querySelector("[data-list-empty]");
      const errEl = panel.querySelector("[data-list-error]");
      const list = panel.querySelector("[data-list-items]");
      const resource = panel.dataset.listPanel;
      const activeId = currentActiveId(resource);

      skeleton?.classList.add("hidden");
      errEl?.classList.add("hidden");

      if (!items || items.length === 0) {
        empty?.classList.remove("hidden");
        list?.classList.add("hidden");
        return;
      }

      empty?.classList.add("hidden");
      list.classList.remove("hidden");

      // Inline SVG placeholders, kept short so we can embed many of them.
      const PLACEHOLDER_PHOTO = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>`;
      const PLACEHOLDER_COVER = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1"/><circle cx="9" cy="10" r="1.5"/><path d="M21 16l-5-5-7 7"/></svg>`;
      const GRIP_SVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>`;
      const ARROW_UP = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>`;
      const ARROW_DOWN = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`;

      // Map kind labels (pulled from subtitle for emoji items) to a CSS variant
      // so the thumb gets a colored background per category kind.
      const KIND_VARIANTS = {
        "Filosofía": "philosophy",
        "Poesía": "poetry",
        "Libro": "book",
        "Otro": "other",
      };

      const reorderable = items.some((it) => it.reorderable);

      list.innerHTML = items
        .map((it, idx) => {
          const active = it.id === activeId;
          const cls = "lp-link" + (active ? " lp-link-active" : "") + (reorderable ? " lp-link-reorderable" : "");
          const STATUS_VARIANTS = {
            published: { cls: "lp-status-pub",   label: "pub" },
            draft:     { cls: "lp-status-draft", label: "borr" },
            owner:     { cls: "lp-status-owner",  label: "owner" },
            admin:     { cls: "lp-status-admin",  label: "admin" },
            editor:    { cls: "lp-status-editor", label: "editor" },
          };
          const sv = STATUS_VARIANTS[it.status];
          const status = sv
            ? `<span class="lp-status ${sv.cls}">${sv.label}</span>`
            : "";

          const isPhoto = it.imageStyle === "photo";
          const isEmoji = it.imageStyle === "emoji";
          let thumb = "";
          if (isEmoji) {
            const variant = KIND_VARIANTS[it.subtitle || ""] || "other";
            thumb = `<div class="lp-thumb lp-thumb-emoji lp-thumb-emoji-${variant}">${escape(it.imageUrl || "◇")}</div>`;
          } else {
            const thumbClass = "lp-thumb" + (isPhoto ? " lp-thumb-photo" : "");
            const placeholder = isPhoto ? PLACEHOLDER_PHOTO : PLACEHOLDER_COVER;
            thumb = it.imageUrl
              ? `<div class="${thumbClass}"><img src="${escape(it.imageUrl)}" alt="" loading="lazy" onerror="this.parentElement.innerHTML=this.dataset.fallback;" data-fallback="${escape(placeholder)}"/></div>`
              : `<div class="${thumbClass}">${placeholder}</div>`;
          }

          const grip = it.reorderable
            ? `<span class="lp-grip" data-grip draggable="true" aria-label="Arrastrar para reordenar" title="Arrastrar para reordenar">${GRIP_SVG}</span>`
            : "";

          const arrows = it.reorderable ? `
            <div class="lp-arrows">
              <button type="button" class="lp-arrow" data-move="up" data-id="${escape(it.id)}" aria-label="Subir"${idx === 0 ? " disabled" : ""}>${ARROW_UP}</button>
              <button type="button" class="lp-arrow" data-move="down" data-id="${escape(it.id)}" aria-label="Bajar"${idx === items.length - 1 ? " disabled" : ""}>${ARROW_DOWN}</button>
            </div>` : "";

          // Pre-normalize search text once per item so the input filter
          // can do a simple substring check.
          const searchText = normalize(`${it.title || ""} ${it.subtitle || ""}`);

          return `
            <li data-list-row data-search-text="${escape(searchText)}">
              <a href="${escape(it.href)}" class="${cls}" data-astro-prefetch data-id="${escape(it.id)}">
                <span class="lp-link-body">
                  ${grip}
                  ${thumb}
                  <div class="lp-body">
                    <div class="lp-row-top">
                      <p class="lp-title">${escape(it.title)}</p>
                      ${status}
                    </div>
                    ${it.subtitle ? `<p class="lp-sub">${escape(it.subtitle)}</p>` : ""}
                    ${it.meta ? `<p class="lp-meta">${escape(it.meta)}</p>` : ""}
                  </div>
                </span>
                ${arrows}
              </a>
            </li>`;
        })
        .join("");

      if (reorderable) wireReorder(panel, list);
      // Re-apply any active search query so freshly-rendered rows get
      // filtered the same way (e.g. after a background refetch).
      applySearch(panel);
    };

    // Wire the search input on each panel. Idempotent — uses a flag so
    // panels persisted across view transitions don't double-bind.
    const wireSearch = (panel) => {
      const input = panel.querySelector("[data-list-search]");
      if (!input || input.dataset.casWired) return;
      input.dataset.casWired = "1";
      input.addEventListener("input", () => applySearch(panel));
    };

    const showError = (panel) => {
      panel.querySelector("[data-list-skeleton]")?.classList.add("hidden");
      panel.querySelector("[data-list-error]")?.classList.remove("hidden");
    };

    const hydrate = async (panel) => {
      const resource = panel.dataset.listPanel;
      if (!resource) return;

      // Hydrate from cache if fresh.
      try {
        const raw = sessionStorage.getItem(cacheKey(resource));
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < CACHE_TTL) {
            renderItems(panel, parsed.items);
          }
        }
      } catch {}

      // Always refetch in the background to keep things fresh.
      try {
        const res = await fetch(`/api/list?resource=${encodeURIComponent(resource)}`, {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) {
          showError(panel);
          return;
        }
        const data = await res.json();
        renderItems(panel, data.items);
        try {
          sessionStorage.setItem(
            cacheKey(resource),
            JSON.stringify({ t: Date.now(), items: data.items })
          );
        } catch {}
      } catch (err) {
        // Network error: only show error if we never rendered anything.
        if (panel.querySelector("[data-list-items]")?.classList.contains("hidden")) {
          showError(panel);
        }
      }
    };

    const hydrateAll = () => {
      document.querySelectorAll("[data-list-panel]").forEach((panel) => {
        wireSearch(panel);
        // Only hydrate once per page load; activeId update is handled below.
        if (!panel.dataset.hydrated) {
          panel.dataset.hydrated = "1";
          hydrate(panel);
        } else {
          // Re-render with the new activeId from cache (no refetch needed).
          const resource = panel.dataset.listPanel;
          try {
            const raw = sessionStorage.getItem(cacheKey(resource));
            if (raw) {
              const parsed = JSON.parse(raw);
              renderItems(panel, parsed.items);
            }
          } catch {}
        }
      });
    };

    // Initial run.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", hydrateAll);
    } else {
      hydrateAll();
    }

    // Re-hydrate after Astro view transitions navigate.
    document.addEventListener("astro:after-swap", hydrateAll);

    // Invalidate cache when a form succeeds (server redirects with ?saved=1).
    document.addEventListener("astro:page-load", () => {
      const url = new URL(window.location.href);
      if (url.searchParams.has("saved")) {
        ["posts", "books", "authors"].forEach((r) => {
          try {
            sessionStorage.removeItem(cacheKey(r));
          } catch {}
        });
      }
    });
  })();
</script>
