---
// Mobile-only "back to list" link, shown above detail/new pages so users can
// jump out without needing the sidebar.
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<a
  href={href}
  class="md:hidden cursor-pointer inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.14em] text-stone-500 hover:text-stone-900 mb-4"
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M15 18l-6-6 6-6"/>
  </svg>
  {label}
</a>
