---
interface Props {
  name: string;
  value?: string[] | null;
  label?: string;
  bucket?: "covers" | "content" | "authors";
  hint?: string;
}
const {
  name,
  value,
  label = "Galería",
  bucket = "content",
  hint = "Arrastra imágenes o agrégalas. Reordena con los botones.",
} = Astro.props;
const id = `gal-${name}-${Math.random().toString(36).slice(2, 8)}`;
const initial = (value ?? []).filter(Boolean);
---

<div class="block" data-gallery-upload={id} data-bucket={bucket}>
  <span class="label">{label}</span>
  <p class="text-xs text-stone-500 mt-0.5 mb-2">{hint}</p>

  <input type="hidden" name={name} id={`${id}-data`} value={JSON.stringify(initial)} />

  <div
    id={`${id}-dropzone`}
    class="border-2 border-dashed border-stone-300 bg-stone-50 p-4 rounded-sm transition"
  >
    <ul id={`${id}-list`} class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-3">
      {initial.map((url, i) => (
        <li class="relative group bg-white border border-stone-200" data-index={i}>
          <img src={url} alt="" class="w-full h-32 object-cover" />
          <div class="absolute inset-x-0 bottom-0 flex justify-between items-center px-1 py-1 bg-stone-900/60 opacity-0 group-hover:opacity-100 transition">
            <button type="button" class="text-white text-xs px-1.5 py-0.5 hover:underline" data-action="left">←</button>
            <button type="button" class="text-white text-xs px-1.5 py-0.5 hover:underline" data-action="right">→</button>
            <button type="button" class="text-white text-xs px-1.5 py-0.5 hover:underline" data-action="remove">Quitar</button>
          </div>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <label class="btn cursor-pointer">
        <input
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
          id={`${id}-file`}
          class="hidden"
          multiple
        />
        + Agregar imágenes
      </label>
      <p id={`${id}-status`} class="text-xs text-stone-500 min-h-[1rem]"></p>
    </div>
  </div>
</div>

<script type="module" define:vars={{ id, bucket }}>
  const dataInput = document.getElementById(`${id}-data`);
  const list = document.getElementById(`${id}-list`);
  const dropzone = document.getElementById(`${id}-dropzone`);
  const fileInput = document.getElementById(`${id}-file`);
  const status = document.getElementById(`${id}-status`);

  let urls = (() => { try { return JSON.parse(dataInput.value) || []; } catch { return []; } })();

  const sync = () => { dataInput.value = JSON.stringify(urls); };

  const render = () => {
    list.innerHTML = "";
    urls.forEach((url, i) => {
      const li = document.createElement("li");
      li.className = "relative group bg-white border border-stone-200";
      li.dataset.index = String(i);
      li.innerHTML = `
        <img src="${url}" alt="" class="w-full h-32 object-cover" />
        <div class="absolute inset-x-0 bottom-0 flex justify-between items-center px-1 py-1 bg-stone-900/60 opacity-0 group-hover:opacity-100 transition">
          <button type="button" class="text-white text-xs px-1.5 py-0.5 hover:underline" data-action="left">←</button>
          <button type="button" class="text-white text-xs px-1.5 py-0.5 hover:underline" data-action="right">→</button>
          <button type="button" class="text-white text-xs px-1.5 py-0.5 hover:underline" data-action="remove">Quitar</button>
        </div>
      `;
      list.appendChild(li);
    });
  };

  list.addEventListener("click", (e) => {
    const btn = e.target.closest("button[data-action]");
    if (!btn) return;
    const li = btn.closest("li[data-index]");
    if (!li) return;
    const i = Number(li.dataset.index);
    const action = btn.dataset.action;
    if (action === "remove") {
      urls.splice(i, 1);
    } else if (action === "left" && i > 0) {
      [urls[i - 1], urls[i]] = [urls[i], urls[i - 1]];
    } else if (action === "right" && i < urls.length - 1) {
      [urls[i], urls[i + 1]] = [urls[i + 1], urls[i]];
    }
    sync();
    render();
  });

  const upload = async (file) => {
    const fd = new FormData();
    fd.set("file", file);
    fd.set("bucket", bucket);
    const res = await fetch("/api/upload", { method: "POST", body: fd });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error ?? "upload_failed");
    return json.url;
  };

  const handleFiles = async (files) => {
    const list = Array.from(files).filter((f) => f.type.startsWith("image/"));
    if (!list.length) return;
    status.textContent = `Subiendo ${list.length} ${list.length === 1 ? "imagen" : "imágenes"}...`;
    status.style.color = "#57534e";
    let ok = 0;
    for (const file of list) {
      try {
        if (file.size > 10 * 1024 * 1024) {
          throw new Error(`${file.name}: muy grande (>10 MB)`);
        }
        const url = await upload(file);
        urls.push(url);
        sync();
        render();
        ok++;
      } catch (err) {
        status.textContent = err.message ?? "Error al subir.";
        status.style.color = "#b91c1c";
        return;
      }
    }
    status.textContent = `${ok} ${ok === 1 ? "imagen subida" : "imágenes subidas"}.`;
    status.style.color = "#166534";
  };

  fileInput.addEventListener("change", (e) => {
    handleFiles(e.target.files);
    e.target.value = "";
  });

  ["dragenter", "dragover"].forEach((ev) => {
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.classList.add("border-stone-900", "bg-stone-100");
    });
  });
  ["dragleave", "drop"].forEach((ev) => {
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.classList.remove("border-stone-900", "bg-stone-100");
    });
  });
  dropzone.addEventListener("drop", (e) => {
    if (e.dataTransfer?.files?.length) handleFiles(e.dataTransfer.files);
  });
</script>
