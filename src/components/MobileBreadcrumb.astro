---
// Sticky breadcrumb that lives at the top of <main>. On mobile it sits
// below the mobile header (top-14); on desktop it sticks to the top of
// main's own scroll container (top-0). Negative horizontal + top
// margins make it extend to main's full content area and absorb main's
// top padding so it sits flush at the very top.
interface Props {
  currentLabel?: string;
}
const { currentLabel } = Astro.props;

const labels: Record<string, string> = {
  posts: "Artículos",
  books: "Libros",
  authors: "Autores",
  categories: "Categorías",
  site: "Webpage",
  admins: "Administradores",
  subscribers: "Suscriptores",
  orders: "Pedidos",
  new: "Nuevo",
};

const path = Astro.url.pathname.replace(/\/$/, "");
const segments = path.split("/").filter(Boolean);
const showCrumbs = segments.length > 0;

// Special-case /site: it's a single-route page that switches sub-views
// via ?page= (Home / Catálogo / Artículos / …) and ?tab= (Hero /
// Editorial / Contacto / SEO inside Home). When the user is on Home,
// the trail reads "Inicio › Webpage › Home › Hero". On any other
// page-tab there's no inner tab nav so the trail stops at that
// sub-page (e.g. "Inicio › Webpage › Catálogo"). Both extra crumbs
// can be updated client-side as the user clicks a chip / tab —
// see [data-breadcrumb-pagetab] / [data-breadcrumb-tab].
const SITE_PAGE_LABELS: Record<string, string> = {
  home: "Home",
  catalogo: "Catálogo",
  articulos: "Artículos",
  filosofia: "Filosofía",
  poesia: "Poesía",
  autores: "Autores",
  contacto: "Contacto",
};
const SITE_TAB_LABELS: Record<string, string> = {
  hero: "Hero",
  editorial: "Editorial",
  contacto: "Contacto",
  seo: "SEO",
};
const isSite = segments[0] === "site" && segments.length === 1;
const sitePageKey = isSite
  ? (Astro.url.searchParams.get("page") || "home").toLowerCase()
  : null;
const sitePageLabel = sitePageKey ? (SITE_PAGE_LABELS[sitePageKey] ?? "Home") : null;
const siteTabKey = isSite && sitePageKey === "home"
  ? (Astro.url.searchParams.get("tab") || "hero").toLowerCase()
  : null;
const siteTabLabel = siteTabKey ? (SITE_TAB_LABELS[siteTabKey] ?? "Hero") : null;

type Crumb = { label: string; href: string | null; dataKey?: string };
const crumbs: Crumb[] = showCrumbs
  ? [
      { label: "Inicio", href: "/" },
      ...segments.map((seg, idx) => {
        const isLast = idx === segments.length - 1;
        // On /site, demote the "Webpage" segment to a link so the
        // appended sub-page / sub-tab crumbs are the actual leaf.
        const href = isLast && !isSite
          ? null
          : "/" + segments.slice(0, idx + 1).join("/");
        const label = isLast && currentLabel
          ? currentLabel
          : labels[seg] ?? decodeURIComponent(seg).replace(/-/g, " ");
        return { label, href };
      }),
      ...(isSite && sitePageLabel
        ? [{
            label: sitePageLabel,
            // If there's a deeper crumb (sub-tab inside Home), this
            // crumb is no longer the leaf so it becomes a link back
            // to /site (?page= clears since it's the implicit home).
            href: siteTabLabel ? "/site" : null,
            dataKey: "pagetab",
          }]
        : []),
      ...(siteTabLabel
        ? [{ label: siteTabLabel, href: null, dataKey: "tab" }]
        : []),
    ]
  : [];
---

{showCrumbs && (
  <nav
    aria-label="Breadcrumb"
    class="cas-breadcrumb sticky top-14 md:top-0 z-20 bg-white/95 backdrop-blur border-b border-stone-200 h-10"
  >
    <ol class="px-5 md:px-8 lg:px-10 h-full flex items-center gap-1.5 text-[11px] uppercase tracking-[0.14em] overflow-x-auto whitespace-nowrap">
      {crumbs.map((crumb, idx) => {
        const last = idx === crumbs.length - 1;
        const dataAttr = crumb.dataKey ? { [`data-breadcrumb-${crumb.dataKey}`]: "" } : {};
        return (
          <li class="flex items-center gap-1.5 shrink-0" {...dataAttr}>
            {crumb.href ? (
              <a href={crumb.href} class="text-stone-500 hover:text-stone-900 transition" data-astro-prefetch>
                <span data-breadcrumb-label>{crumb.label}</span>
              </a>
            ) : (
              <span class:list={[last ? "text-stone-900 font-medium" : "text-stone-500", "first-letter:capitalize"]}>
                <span data-breadcrumb-label>{crumb.label}</span>
              </span>
            )}
            {!last && (
              <span aria-hidden="true" class="text-stone-300">›</span>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
