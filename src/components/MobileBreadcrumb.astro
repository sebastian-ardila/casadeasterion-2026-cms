---
// Sticky breadcrumb that lives at the top of <main>. On mobile it sits
// below the mobile header (top-14); on desktop it sticks to the top of
// main's own scroll container (top-0). Negative horizontal + top
// margins make it extend to main's full content area and absorb main's
// top padding so it sits flush at the very top.
import { Icon } from "astro-icon/components";

interface Props {
  currentLabel?: string;
}
const { currentLabel } = Astro.props;

const labels: Record<string, string> = {
  posts: "Publicaciones",
  books: "Libros",
  authors: "Autores",
  collaborators: "Colaboradores",
  staff: "Personal",
  categories: "Categorías",
  site: "Webpage",
  admins: "Administradores",
  subscribers: "Suscriptores",
  orders: "Pedidos",
  new: "Nuevo",
};

// Lucide icon per segment. Same set used in the sidebar so the user
// sees the same glyph in both places.
const icons: Record<string, string> = {
  posts: "lucide:newspaper",
  books: "lucide:book-open",
  authors: "lucide:users",
  collaborators: "lucide:user-plus",
  staff: "lucide:building",
  categories: "lucide:folder-tree",
  site: "lucide:layout-template",
  admins: "lucide:users-round",
  subscribers: "lucide:mail",
  orders: "lucide:shopping-bag",
  new: "lucide:plus",
};

const path = Astro.url.pathname.replace(/\/$/, "");
const segments = path.split("/").filter(Boolean);
const showCrumbs = segments.length > 0;

// Special-case /site: it's a single-route page that switches sub-views
// via ?page= (Home / Catálogo / Artículos / …) and ?tab= (Hero /
// Editorial / Contacto / SEO inside Home). When the user is on Home,
// the trail reads "Inicio › Webpage › Home › Hero". On any other
// page-tab there's no inner tab nav so the trail stops at that
// sub-page (e.g. "Inicio › Webpage › Catálogo"). Both extra crumbs
// can be updated client-side as the user clicks a chip / tab —
// see [data-breadcrumb-pagetab] / [data-breadcrumb-tab].
const SITE_PAGE_LABELS: Record<string, string> = {
  home: "Home",
  catalogo: "Catálogo",
  articulos: "Publicaciones",
  filosofia: "Filosofía",
  poesia: "Poesía",
  autores: "Autores",
  contacto: "Contacto",
};
const SITE_PAGE_ICONS: Record<string, string> = {
  home: "lucide:home",
  catalogo: "lucide:book-open",
  articulos: "lucide:newspaper",
  filosofia: "lucide:feather",
  poesia: "lucide:feather",
  autores: "lucide:users",
  contacto: "lucide:phone",
};
const SITE_TAB_LABELS: Record<string, string> = {
  hero: "Hero",
  editorial: "Editorial",
  contacto: "Contacto",
  seo: "SEO",
};
const SITE_TAB_ICONS: Record<string, string> = {
  hero: "lucide:image",
  editorial: "lucide:scroll-text",
  contacto: "lucide:mail",
  seo: "lucide:search",
};
const isSite = segments[0] === "site" && segments.length === 1;
const sitePageKey = isSite
  ? (Astro.url.searchParams.get("page") || "home").toLowerCase()
  : null;
const sitePageLabel = sitePageKey ? (SITE_PAGE_LABELS[sitePageKey] ?? "Home") : null;
const siteTabKey = isSite && sitePageKey === "home"
  ? (Astro.url.searchParams.get("tab") || "hero").toLowerCase()
  : null;
const siteTabLabel = siteTabKey ? (SITE_TAB_LABELS[siteTabKey] ?? "Hero") : null;

type Crumb = { label: string; href: string | null; icon: string | null; dataKey?: string };
const crumbs: Crumb[] = showCrumbs
  ? [
      { label: "Inicio", href: "/", icon: "lucide:home" },
      ...segments.map((seg, idx) => {
        const isLast = idx === segments.length - 1;
        // On /site, demote the "Webpage" segment to a link so the
        // appended sub-page / sub-tab crumbs are the actual leaf.
        const href = isLast && !isSite
          ? null
          : "/" + segments.slice(0, idx + 1).join("/");
        const knownLabel = labels[seg];
        const label = isLast && currentLabel
          ? currentLabel
          : knownLabel ?? decodeURIComponent(seg).replace(/-/g, " ");
        // Dynamic leaf segments (slugs, IDs) don't get an icon — they
        // represent unique content rather than a section. Detectar
        // un slug dinámico: el currentLabel difiere del label
        // estático conocido del segmento. Si coinciden (caso de
        // /orders/index que pasa breadcrumbLabel="Pedidos"), seguimos
        // mostrando el icono de la sección.
        const isDynamicLeaf = isLast && currentLabel && knownLabel !== currentLabel;
        const icon = isDynamicLeaf ? null : (icons[seg] ?? null);
        return { label, href, icon };
      }),
      ...(isSite && sitePageLabel && sitePageKey
        ? [{
            label: sitePageLabel,
            // If there's a deeper crumb (sub-tab inside Home), this
            // crumb is no longer the leaf so it becomes a link back
            // to /site (?page= clears since it's the implicit home).
            href: siteTabLabel ? "/site" : null,
            icon: SITE_PAGE_ICONS[sitePageKey] ?? null,
            dataKey: "pagetab",
          }]
        : []),
      ...(siteTabLabel && siteTabKey
        ? [{
            label: siteTabLabel,
            href: null,
            icon: SITE_TAB_ICONS[siteTabKey] ?? null,
            dataKey: "tab",
          }]
        : []),
    ]
  : [];
---

{showCrumbs && (
  <nav
    aria-label="Breadcrumb"
    class="cas-breadcrumb sticky top-14 md:top-0 z-20 bg-white/95 backdrop-blur border-b border-stone-200 h-10"
  >
    <ol class="px-5 md:px-8 lg:px-10 h-full flex items-center gap-1.5 text-[11px] uppercase tracking-[0.14em] overflow-x-auto whitespace-nowrap">
      {crumbs.map((crumb, idx) => {
        const last = idx === crumbs.length - 1;
        const dataAttr = crumb.dataKey ? { [`data-breadcrumb-${crumb.dataKey}`]: "" } : {};
        return (
          <li class="flex items-center gap-1.5 shrink-0" {...dataAttr}>
            {crumb.href ? (
              <a href={crumb.href} class="inline-flex items-center gap-1.5 text-stone-500 hover:text-stone-900 transition" data-astro-prefetch>
                {crumb.icon && (
                  <Icon name={crumb.icon} class="w-3 h-3 shrink-0" aria-hidden="true" />
                )}
                <span data-breadcrumb-label>{crumb.label}</span>
              </a>
            ) : (
              <span class:list={[last ? "text-stone-900 font-medium" : "text-stone-500", "inline-flex items-center gap-1.5 first-letter:capitalize"]}>
                {crumb.icon && (
                  <Icon name={crumb.icon} class="w-3 h-3 shrink-0" aria-hidden="true" />
                )}
                <span data-breadcrumb-label>{crumb.label}</span>
              </span>
            )}
            {!last && (
              <span aria-hidden="true" class="text-stone-300">›</span>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
