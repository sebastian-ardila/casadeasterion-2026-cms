---
// Global unsaved-changes guard. Sits once at the top of AppLayout. When
// the user clicks an internal link, opens the logout flow, or reloads
// the page while ANY form on screen has unsaved changes (detected via
// the snapshot the FormActions bar stashes in the form's dataset), it
// intercepts the action and shows a modal with:
//   - a summary of every changed field,
//   - "Guardar borrador y salir" (sets status=draft and submits),
//   - "Salir sin guardar" (discards and proceeds),
//   - "Cancelar" (stays put).
//
// The component is opt-in per form via the FormActions bar's
// `dirtyAware` prop (defaults true). Forms without that bar are
// invisible to the guard.
---

<dialog
  data-cas-leave-guard
  class="cas-leave-guard"
  aria-labelledby="cas-leave-guard-title"
  aria-describedby="cas-leave-guard-desc"
>
  <form method="dialog" class="cas-leave-guard-form">
    <header class="cas-leave-guard-header">
      <div class="cas-leave-guard-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
      <div>
        <h2 id="cas-leave-guard-title">Cambios sin guardar</h2>
        <p id="cas-leave-guard-desc" class="cas-leave-guard-sub">
          Si sales ahora perderás los cambios que hiciste en este formulario.
        </p>
      </div>
    </header>

    <section class="cas-leave-guard-summary">
      <p class="cas-leave-guard-summary-title">Resumen de cambios</p>
      <ul data-cas-leave-guard-changes class="cas-leave-guard-list"></ul>
      <p
        data-cas-leave-guard-more
        class="cas-leave-guard-more"
        hidden
      ></p>
    </section>

    <footer class="cas-leave-guard-actions">
      <button
        type="button"
        data-cas-leave-guard-cancel
        class="cas-leave-guard-btn cas-leave-guard-btn-ghost"
      >
        Continuar editando
      </button>
      <button
        type="button"
        data-cas-leave-guard-discard
        class="cas-leave-guard-btn cas-leave-guard-btn-discard"
      >
        Salir sin guardar
      </button>
      <button
        type="button"
        data-cas-leave-guard-save
        class="cas-leave-guard-btn cas-leave-guard-btn-primary"
      >
        Guardar borrador y salir
      </button>
    </footer>
  </form>
</dialog>

<style is:global>
  dialog.cas-leave-guard {
    /* Posicionamiento explícito: algunas combinaciones de reset CSS +
       Astro transitions pueden interferir con el centrado nativo de
       <dialog>. Forzamos fixed + transform para garantizar el centro
       independientemente del flujo. */
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    /* Ancho fijo, alto NATURAL — el dialog crece con el contenido y
       solo se capea con el viewport. Si hay muchos cambios el
       summary scrollea sin estirar el dialog. Resultado: cuando hay
       pocos campos el modal queda compacto y los botones quedan
       pegados al footer en lugar de flotar lejos del contenido. */
    /* Alto FIJO (no se ajusta al contenido). El form interno llena
       este alto con flex: header arriba, summary toma todo el medio
       (scrollea si excede), footer SIEMPRE pegado abajo. Resultado:
       botones consistentemente posicionados sin importar cuántos
       cambios haya. */
    width: min(720px, calc(100vw - 2rem));
    height: min(640px, calc(100vh - 2rem));
    padding: 0;
    border: 0;
    background: white;
    color: rgb(28 25 23);
    box-shadow: 0 25px 60px -10px rgb(0 0 0 / 0.35), 0 10px 25px -5px rgb(0 0 0 / 0.15);
    border-radius: 4px;
    overflow: hidden;
  }
  /* Animación de entrada: fade + leve scale desde 96% para que aparezca
     definido en su posición final en lugar de "crecer" desde 0. */
  dialog.cas-leave-guard[open] {
    animation: cas-leave-guard-in 160ms ease-out;
  }
  dialog.cas-leave-guard[open]::backdrop {
    animation: cas-leave-guard-backdrop-in 160ms ease-out;
  }
  @keyframes cas-leave-guard-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
  @keyframes cas-leave-guard-backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  dialog.cas-leave-guard::backdrop {
    background: rgb(28 25 23 / 0.55);
    backdrop-filter: blur(2px);
  }
  @media (prefers-reduced-motion: reduce) {
    dialog.cas-leave-guard[open],
    dialog.cas-leave-guard[open]::backdrop {
      animation: none;
    }
  }
  .cas-leave-guard-form {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cas-leave-guard-header {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid rgb(231 229 228);
    flex-shrink: 0;
  }
  .cas-leave-guard-icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(255 247 237);
    color: rgb(154 52 18);
    border: 1px solid rgb(254 215 170);
    border-radius: 9999px;
  }
  .cas-leave-guard-header h2 {
    font-family: var(--font-serif, "Cormorant Garamond", Georgia, serif);
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }
  .cas-leave-guard-sub {
    margin: 0;
    font-size: 0.875rem;
    color: rgb(87 83 78);
    line-height: 1.4;
  }
  .cas-leave-guard-summary {
    padding: 1rem 1.5rem;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
  }
  .cas-leave-guard-summary-title {
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: rgb(120 113 108);
    margin: 0 0 0.625rem;
  }
  .cas-leave-guard-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cas-leave-guard-item {
    border: 1px solid rgb(231 229 228);
    border-radius: 3px;
    padding: 0.5rem 0.75rem;
    background: rgb(250 250 249);
    font-size: 0.8125rem;
  }
  .cas-leave-guard-item-label {
    display: block;
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: rgb(120 113 108);
    margin-bottom: 0.25rem;
  }
  .cas-leave-guard-item-diff {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: rgb(28 25 23);
    word-break: break-word;
  }
  .cas-leave-guard-item-before,
  .cas-leave-guard-item-after {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    line-height: 1.4;
  }
  .cas-leave-guard-item-before {
    color: rgb(120 113 108);
  }
  .cas-leave-guard-item-tag {
    flex-shrink: 0;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(120 113 108);
    padding-top: 0.05em;
    width: 3.2rem;
  }
  .cas-leave-guard-item-value {
    flex: 1 1 auto;
    min-width: 0;
  }
  .cas-leave-guard-item-value-empty {
    color: rgb(168 162 158);
    font-style: italic;
  }
  .cas-leave-guard-more {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: rgb(120 113 108);
    font-style: italic;
  }
  .cas-leave-guard-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-top: 1px solid rgb(231 229 228);
    background: rgb(250 250 249);
    flex-shrink: 0;
    /* mt-auto NO funciona en flex-direction:column si el summary
       ya tiene flex:1 — el summary empuja al footer hacia abajo. */
  }
  .cas-leave-guard-btn {
    cursor: pointer;
    font-size: 0.8125rem;
    padding: 0.5rem 0.875rem;
    border-radius: 3px;
    border: 1px solid transparent;
    transition: background-color 0.12s, border-color 0.12s, color 0.12s;
  }
  /* Mobile: botones apilados de arriba a abajo en orden de jerarquía
     visual — el primario (Guardar borrador) primero porque es la
     acción "segura", luego destructive (Salir sin guardar), por
     último ghost (Continuar editando). Todos full-width y con
     padding mayor para tap targets >= 44pt. */
  @media (max-width: 640px) {
    dialog.cas-leave-guard {
      /* Mobile: ocupar la mayor parte del viewport (alto fijo grande)
         y mantener el footer siempre pegado al fondo via flex. */
      height: calc(100vh - 1.5rem);
      max-height: calc(100vh - 1.5rem);
      width: calc(100vw - 1.5rem);
    }
    .cas-leave-guard-actions {
      /* Botones apilados con primario arriba: column-reverse invierte
         el orden DOM (cancel, discard, save) → (save, discard, cancel).
         Full-width con tap targets cómodos. */
      flex-direction: column-reverse;
      align-items: stretch;
      padding: 1rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
      gap: 0.5rem;
    }
    .cas-leave-guard-btn {
      width: 100%;
      padding: 0.875rem 1rem;
      font-size: 0.9375rem;
      text-align: center;
    }
  }
  .cas-leave-guard-btn-ghost {
    background: white;
    border-color: rgb(231 229 228);
    color: rgb(68 64 60);
  }
  .cas-leave-guard-btn-ghost:hover {
    background: rgb(245 245 244);
    border-color: rgb(214 211 209);
  }
  .cas-leave-guard-btn-discard {
    background: white;
    border-color: rgb(252 165 165);
    color: rgb(153 27 27);
  }
  .cas-leave-guard-btn-discard:hover {
    background: rgb(254 242 242);
    border-color: rgb(248 113 113);
  }
  .cas-leave-guard-btn-primary {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }
  .cas-leave-guard-btn-primary:hover {
    background: rgb(68 64 60);
    border-color: rgb(68 64 60);
  }
  .cas-leave-guard-btn-primary:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>

<script is:inline>
  (() => {
    // El script se carga inline cada vez que esta página se renderiza.
    // Separamos en dos pasos:
    //   1. Listeners GLOBALES en document/window — solo una vez por sesión
    //      del browser (gestionados por window.__casLeaveGuardGlobals).
    //   2. Binding al dialog actual — cada navegación, porque Astro
    //      view-transitions reemplaza el <dialog> (transition:persist no
    //      aplica bien a un componente con múltiples elementos top-level).
    //
    // El bug antes: capturábamos refs al dialog en variables al inicio.
    // Cuando el usuario llegaba al CMS desde una URL externa o navegaba
    // al primer form, las refs quedaban undefined o apuntaban a un dialog
    // viejo, y el modal nunca abría — interceptábamos el click pero
    // openModal silenciosamente fallaba dejando al usuario atrapado.

    const SESSION_KEY = "cas:leave-after-save";

    // Mirror of FormActions.snapshotForm. Duplicated (not imported) so
    // LeaveGuard stays a standalone is:inline script without bundler
    // dependencies. Keep both in sync if you change one.
    function snapshotForm(form) {
      const arr = [];
      form.querySelectorAll("[name]").forEach((el) => {
        const e = el;
        if (!e.name) return;
        if (e.type === "checkbox" || e.type === "radio") {
          arr.push([e.name + ":" + (e.value || ""), e.checked ? "1" : ""]);
        } else if (e.type === "file") {
          arr.push([e.name, e.files && e.files.length ? "file:" + e.files.length : ""]);
        } else if (e.type === "submit" || e.type === "button" || e.type === "reset") {
          return;
        } else {
          arr.push([e.name, e.value ?? ""]);
        }
      });
      return JSON.stringify(arr.sort());
    }

    function getDirtyForm() {
      const bars = document.querySelectorAll('[data-cas-form-bar][data-cas-dirty-aware="1"]');
      for (const bar of bars) {
        const form = bar.closest("form");
        if (!form) continue;
        const initial = form.dataset.casInitialSnapshot;
        if (initial == null) continue;
        if (snapshotForm(form) !== initial) return form;
      }
      return null;
    }

    // ---------- Label resolution ---------------------------------------
    // Map of name → human label. Hard-coded names that don't have an
    // obvious DOM label fall back here. Anything found via the normal
    // resolution path wins over this map.
    const NAME_LABELS = {
      title: "Título",
      subtitle: "Subtítulo",
      slug: "Slug",
      name: "Nombre",
      content_md: "Contenido",
      description_md: "Descripción",
      bio_md: "Biografía",
      excerpt: "Resumen",
      cover_image_url: "Imagen de portada",
      cover_image_alt: "Alt de portada",
      gallery_urls: "Galería",
      photo_url: "Foto",
      icon: "Ícono",
      status: "Estado",
      category_id: "Categoría",
      collection_id: "Colección",
      book_id: "Libro asociado",
      isbn: "ISBN",
      pages: "Páginas",
      format: "Formato",
      price_amount: "Precio",
      price_currency: "Moneda",
      publication_date: "Fecha de publicación",
      reading_time_minutes: "Tiempo de lectura",
      meta_description: "Meta description",
      tags: "Tags",
      keywords: "Keywords",
      canonical_url: "URL canónica",
      author_ids: "Autores",
      translator_ids: "Traductores",
      prologuist_ids: "Prologuistas",
      collaborator_ids: "Colaboradores",
      book_ids: "Libros",
      post_ids: "Publicaciones",
      role: "Rol",
      role_tags: "Roles",
      email: "Email",
      full_name: "Nombre completo",
      position: "Cargo",
      order: "Orden",
      sort_order: "Orden",
      url: "URL",
      website: "Sitio web",
    };

    function humanizeName(name) {
      const base = name.split(":")[0].replace(/_/g, " ").trim();
      if (!base) return name;
      return base.charAt(0).toUpperCase() + base.slice(1);
    }

    function labelFor(form, name) {
      const base = name.split(":")[0];
      // 1. Try <label for=id> matching an input with this name.
      const input = form.querySelector(`[name="${CSS.escape(base)}"]`);
      if (input && input.id) {
        const lbl = form.querySelector(`label[for="${CSS.escape(input.id)}"]`);
        const txt = lbl && (lbl.textContent || "").trim();
        if (txt) return txt;
      }
      // 2. Try a sibling .label inside the same wrapper. Many of our
      //    cell-stack components don't use <label for>.
      if (input) {
        const wrap = input.closest(".cell-stack, .field, [data-leave-guard-group]");
        const lbl = wrap && wrap.querySelector(".label, [data-leave-guard-label]");
        const txt = lbl && (lbl.textContent || "").trim();
        if (txt) return txt;
      }
      // 3. Hard-coded fallback.
      if (NAME_LABELS[base]) return NAME_LABELS[base];
      // 4. Humanized name as last resort.
      return humanizeName(base);
    }

    // ---------- Diff ---------------------------------------------------
    const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    // Intenta resolver un value crudo a su texto legible mirando los
    // controles del form. Devuelve null si no puede resolver y el
    // caller cae al renderizado del raw value.
    //
    // Soporta:
    //   - <Dropdown> custom (data-dropdown + data-dd-option/data-label)
    //   - <MultiAuthorPicker> (data-map-picker + data-map-add-item con data-name)
    //   - <select name=X> nativo
    //   - <input type="radio" name=X value=value> + label asociado
    function resolveDisplayValue(form, name, rawValue) {
      if (rawValue == null || rawValue === "") return null;

      // Dropdown custom: value único en el hidden input.
      const dropdown = form.querySelector(`[data-dropdown][data-name="${CSS.escape(name)}"]`);
      if (dropdown) {
        if (!rawValue) return null;
        const opt = dropdown.querySelector(`[data-dd-option][data-value="${CSS.escape(rawValue)}"]`);
        const label = opt && (opt.getAttribute("data-label") || (opt.textContent || "").trim());
        if (label) return label;
      }

      // MultiAuthorPicker: lista de UUIDs separados por coma.
      const picker = form.querySelector(`[data-map-picker][data-name="${CSS.escape(name)}"]`);
      if (picker) {
        const ids = rawValue.split(",").map((s) => s.trim()).filter(Boolean);
        if (ids.length === 0) return null;
        const names = ids.map((id) => {
          const item = picker.querySelector(`[data-map-add-item][data-id="${CSS.escape(id)}"]`);
          const n = item && item.getAttribute("data-name");
          return n || id.slice(0, 8) + "…";
        });
        // Si hay 1-3 nombres los enumeramos; si hay más, agrupamos.
        if (names.length <= 3) return names.join(", ");
        return `${names.slice(0, 2).join(", ")} y ${names.length - 2} más`;
      }

      // <select> nativo.
      const sel = form.querySelector(`select[name="${CSS.escape(name)}"]`);
      if (sel) {
        const opt = Array.from(sel.options).find((o) => o.value === rawValue);
        if (opt) return (opt.textContent || "").trim() || rawValue;
      }

      // Radio: buscamos el radio con name+value y leemos el label
      // (sea <label for> o el texto del padre <label>).
      const radio = form.querySelector(
        `input[type="radio"][name="${CSS.escape(name)}"][value="${CSS.escape(rawValue)}"]`,
      );
      if (radio) {
        let labelText = "";
        if (radio.id) {
          const lbl = form.querySelector(`label[for="${CSS.escape(radio.id)}"]`);
          if (lbl) labelText = (lbl.textContent || "").trim();
        }
        if (!labelText) {
          const wrap = radio.closest("label");
          if (wrap) labelText = (wrap.textContent || "").trim();
        }
        if (labelText) return labelText;
      }

      return null;
    }

    function summarize(form, name, value) {
      if (value == null || value === "") return { empty: true, text: "(vacío)" };

      // Intento resolver el value a texto legible antes de cualquier
      // otro tratamiento. Esto cubre UUIDs de Dropdown/MultiAuthor,
      // values de <select>, etc.
      const resolved = resolveDisplayValue(form, name, value);
      if (resolved != null) {
        const max = 140;
        const text = resolved.length > max ? resolved.slice(0, max).trimEnd() + "…" : resolved;
        return { empty: false, text };
      }

      if (value.startsWith("file:")) {
        const n = value.slice(5);
        return { empty: false, text: `${n} archivo${n === "1" ? "" : "s"} adjunto${n === "1" ? "" : "s"}` };
      }
      // UUID suelto que no resolvimos (no había picker/dropdown): muestra
      // solo "(referencia)" para no confundir al editor con el ID crudo.
      if (UUID_RE.test(value)) {
        return { empty: false, text: "(referencia)" };
      }
      // UUID-comma list sin picker: degradamos al conteo.
      if (/^[0-9a-f-]{8,}(,[0-9a-f-]{8,})+$/i.test(value)) {
        const n = value.split(",").length;
        return { empty: false, text: `${n} elementos` };
      }
      // Long values truncated for the modal.
      const max = 140;
      const text = value.length > max ? value.slice(0, max).trimEnd() + "…" : value;
      return { empty: false, text };
    }

    function buildDiff(form) {
      const initialJson = form.dataset.casInitialSnapshot;
      if (!initialJson) return [];
      let before, after;
      try {
        before = new Map(JSON.parse(initialJson));
      } catch {
        return [];
      }
      after = new Map(JSON.parse(snapshotForm(form)));
      // Aggregate changes by base field name (strip the ":value" suffix
      // we attach to checkboxes/radios so the user sees one row per
      // field, not one per option).
      const byField = new Map();
      const keys = new Set([...before.keys(), ...after.keys()]);
      for (const key of keys) {
        const beforeVal = before.get(key) || "";
        const afterVal = after.get(key) || "";
        if (beforeVal === afterVal) continue;
        const baseName = String(key).split(":")[0];
        if (!byField.has(baseName)) {
          byField.set(baseName, { before: beforeVal, after: afterVal });
        }
      }
      const changes = [];
      byField.forEach((v, name) => {
        changes.push({
          name,
          label: labelFor(form, name),
          before: summarize(form, name, v.before),
          after: summarize(form, name, v.after),
        });
      });
      // Stable order: alphabetical by label so it doesn't shift across
      // re-opens of the modal.
      changes.sort((a, b) => a.label.localeCompare(b.label, "es"));
      return changes;
    }

    // ---------- Modal --------------------------------------------------
    // Helper que consulta el dialog actual en el DOM (puede cambiar entre
    // navegaciones de Astro). Si la página actual no incluye el LeaveGuard
    // (caso raro), getDialog() devuelve null y los handlers se vuelven
    // no-op.
    function getDialog() {
      return document.querySelector("[data-cas-leave-guard]");
    }
    function getDialogParts() {
      const dialog = getDialog();
      if (!dialog) return null;
      const listEl    = dialog.querySelector("[data-cas-leave-guard-changes]");
      const moreEl    = dialog.querySelector("[data-cas-leave-guard-more]");
      const cancelBtn = dialog.querySelector("[data-cas-leave-guard-cancel]");
      const discardBtn= dialog.querySelector("[data-cas-leave-guard-discard]");
      const saveBtn   = dialog.querySelector("[data-cas-leave-guard-save]");
      if (!listEl || !cancelBtn || !discardBtn || !saveBtn) return null;
      return { dialog, listEl, moreEl, cancelBtn, discardBtn, saveBtn };
    }

    // Estado global del modal (mantiene la promesa de href/form pendiente
    // entre el click y el "Continuar editando / Salir / Guardar borrador").
    if (!window.__casLeaveGuardState) {
      window.__casLeaveGuardState = { pendingHref: null, pendingForm: null };
    }
    const state = window.__casLeaveGuardState;
    const MAX_VISIBLE = 8;

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function renderChanges(parts, changes) {
      parts.listEl.innerHTML = "";
      const visible = changes.slice(0, MAX_VISIBLE);
      for (const c of visible) {
        const li = document.createElement("li");
        li.className = "cas-leave-guard-item";
        const beforeClass = c.before.empty ? "cas-leave-guard-item-value cas-leave-guard-item-value-empty" : "cas-leave-guard-item-value";
        const afterClass = c.after.empty ? "cas-leave-guard-item-value cas-leave-guard-item-value-empty" : "cas-leave-guard-item-value";
        li.innerHTML =
          `<span class="cas-leave-guard-item-label">${escapeHtml(c.label)}</span>` +
          `<div class="cas-leave-guard-item-diff">` +
            `<div class="cas-leave-guard-item-before">` +
              `<span class="cas-leave-guard-item-tag">Antes</span>` +
              `<span class="${beforeClass}">${escapeHtml(c.before.text)}</span>` +
            `</div>` +
            `<div class="cas-leave-guard-item-after">` +
              `<span class="cas-leave-guard-item-tag">Ahora</span>` +
              `<span class="${afterClass}">${escapeHtml(c.after.text)}</span>` +
            `</div>` +
          `</div>`;
        parts.listEl.appendChild(li);
      }
      if (parts.moreEl) {
        if (changes.length > MAX_VISIBLE) {
          parts.moreEl.hidden = false;
          const rest = changes.length - MAX_VISIBLE;
          parts.moreEl.textContent = `Y ${rest} cambio${rest === 1 ? "" : "s"} más no mostrados.`;
        } else {
          parts.moreEl.hidden = true;
        }
      }
    }

    // Returns true if the form has any "draft" capable status control:
    //   - <select name="status"> with an <option value="draft">
    //   - <input type="radio" name="status" value="draft">
    // Else "Guardar borrador y salir" stays hidden.
    function hasDraftStatus(form) {
      const selectStatus = form.querySelector('select[name="status"]');
      if (selectStatus) {
        return Array.from(selectStatus.options).some((o) => o.value === "draft");
      }
      const radioDraft = form.querySelector('input[type="radio"][name="status"][value="draft"]');
      return !!radioDraft;
    }

    // Switches the form's status control to "draft" before submitting.
    // Returns true if it managed to set it.
    function setStatusToDraft(form) {
      const selectStatus = form.querySelector('select[name="status"]');
      if (selectStatus) {
        const has = Array.from(selectStatus.options).some((o) => o.value === "draft");
        if (has) {
          selectStatus.value = "draft";
          return true;
        }
      }
      const radioDraft = form.querySelector('input[type="radio"][name="status"][value="draft"]');
      if (radioDraft) {
        radioDraft.checked = true;
        return true;
      }
      return false;
    }

    function openModal(form, href) {
      const parts = getDialogParts();
      if (!parts) {
        // Sin dialog en el DOM no podemos mostrar el modal — caemos a
        // permitir la navegación para no atrapar al usuario.
        if (href) window.location.href = href;
        return;
      }
      state.pendingForm = form;
      state.pendingHref = href;
      const changes = buildDiff(form);
      renderChanges(parts, changes);
      // Hide the "Guardar borrador" affordance when the form has no
      // draft-capable status control — we can't promise a safe save.
      parts.saveBtn.hidden = !hasDraftStatus(form);
      if (typeof parts.dialog.showModal === "function") {
        try {
          parts.dialog.showModal();
        } catch {
          parts.dialog.setAttribute("open", "");
        }
      } else {
        // Fallback for browsers without <dialog>. Show as overlay.
        parts.dialog.setAttribute("open", "");
      }
      parts.cancelBtn.focus();
    }

    function closeModal() {
      state.pendingForm = null;
      state.pendingHref = null;
      const parts = getDialogParts();
      if (!parts) return;
      if (typeof parts.dialog.close === "function") {
        try { parts.dialog.close(); } catch {}
      } else {
        parts.dialog.removeAttribute("open");
      }
    }

    // Bind del modal — idempotente vía data-cas-bound. Se llama en cada
    // page-load porque Astro view-transitions reemplaza el <dialog> y
    // los handlers viejos quedan colgando.
    function bindModal() {
      const parts = getDialogParts();
      if (!parts) return;
      if (parts.dialog.dataset.casBound === "1") return;
      parts.dialog.dataset.casBound = "1";

      parts.cancelBtn.addEventListener("click", () => closeModal());
      // ESC del <dialog> nativo dispara "cancel" + "close": limpiamos
      // estado pendiente.
      parts.dialog.addEventListener("close", () => {
        state.pendingForm = null;
        state.pendingHref = null;
      });

      parts.discardBtn.addEventListener("click", () => {
        const href = state.pendingHref;
        const form = state.pendingForm;
        closeModal();
        if (form) {
          form.dataset.casInitialSnapshot = snapshotForm(form);
        }
        if (href) {
          window.location.href = href;
        } else {
          window.location.reload();
        }
      });

      parts.saveBtn.addEventListener("click", () => {
        const href = state.pendingHref;
        const form = state.pendingForm;
        if (!form) {
          closeModal();
          return;
        }
        // Force status=draft (supports both <select> and radios). If the
        // form has no status control at all, just submit as-is.
        setStatusToDraft(form);
        // Remember where the user was trying to go. After the POST
        // succeeds and the server redirects back to the entity detail
        // page, maybeForwardAfterSave() forwards the browser to the
        // original destination.
        if (href) {
          try { sessionStorage.setItem(SESSION_KEY, href); } catch {}
        }
        // Mark the form as clean so beforeunload and the click guard
        // don't fire again as the form submits / redirects.
        form.dataset.casInitialSnapshot = snapshotForm(form);
        closeModal();
        // Native submit (NOT requestSubmit) to bypass the disabled save
        // button on clean state.
        form.submit();
      });
    }

    // ---------- Global listeners (una sola vez por sesión) -------------
    // Estos listeners NO deben re-bindearse en cada navegación (causarían
    // disparos múltiples). Usamos un flag en window para idempotencia.
    if (!window.__casLeaveGuardGlobalsBound) {
      window.__casLeaveGuardGlobalsBound = true;

    // ---------- Submit handling ---------------------------------------
    // When a form is submitted normally (the FormActions "Guardar"
    // button), the resulting POST → redirect would otherwise trigger
    // beforeunload's "leave site?" prompt because the form is still
    // marked dirty. Clearing the snapshot here makes the guard happy.
    // The capture phase runs before any other submit handler so we
    // don't race with FormGuards or page-specific logic.
    document.addEventListener(
      "submit",
      (e) => {
        if (e.defaultPrevented) return;
        const form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.dataset.casInitialSnapshot == null) return;
        form.dataset.casInitialSnapshot = snapshotForm(form);
      },
      { capture: true },
    );

    // ---------- Click interception ------------------------------------
    document.addEventListener(
      "click",
      (e) => {
        if (e.defaultPrevented) return;
        const target = e.target;
        if (!(target instanceof Element)) return;

        // Internal anchor. (Logout is intentionally NOT intercepted
        // here — its flow tears down the Supabase session and the
        // modal's "Guardar borrador" couldn't keep the user logged
        // in afterwards. The native beforeunload still catches it.)
        const a = target.closest("a[href]");
        if (!a) return;
        // Allow modifier-clicks (cmd/ctrl/shift) to open in a new tab —
        // the current page keeps its state intact.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (a.target && a.target !== "" && a.target !== "_self") return;
        let url;
        try {
          url = new URL(a.getAttribute("href"), window.location.href);
        } catch {
          return;
        }
        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.search === window.location.search) {
          // Same page (anchor jump, query-only change) — let it through.
          return;
        }
        const form = getDirtyForm();
        if (!form) return;
        // Don't intercept clicks INSIDE the dialog itself.
        if (a.closest("[data-cas-leave-guard]")) return;
        e.preventDefault();
        e.stopPropagation();
        openModal(form, url.href);
      },
      { capture: true },
    );

    // ---------- beforeunload ------------------------------------------
    // For reloads, tab close, and any navigation we don't catch via
    // click (browser back/forward without astro:before-preparation).
    window.addEventListener("beforeunload", (e) => {
      if (getDirtyForm()) {
        e.preventDefault();
        e.returnValue = "";
      }
    });

    // Astro view-transitions also bypasses click. Belt-and-suspenders:
    // intercept before-preparation when a dirty form is on screen.
    document.addEventListener("astro:before-preparation", (e) => {
      if (e.defaultPrevented) return;
      const form = getDirtyForm();
      if (!form) return;
      try {
        const to = e.to instanceof URL ? e.to : new URL(e.to);
        if (to.pathname === window.location.pathname && to.search === window.location.search) {
          return;
        }
        e.preventDefault();
        openModal(form, to.href);
      } catch {
        // If we can't parse the target URL, fall through and let it
        // navigate — better than locking the user in.
      }
    });

    // Cada navegación de Astro reemplaza el <dialog> (transition:persist
    // no aplica bien a un componente con múltiples elementos top-level).
    // Re-bindeamos el modal después de cada page-load para que los
    // botones del nuevo dialog tengan sus handlers.
    document.addEventListener("astro:page-load", bindModal);

    // ---------- Post-save redirect ------------------------------------
    // After "Guardar borrador y salir", the form submits and the server
    // redirects back to the entity detail with ?saved=1. We detect that
    // landing and forward to the destination the user originally chose.
    document.addEventListener("astro:page-load", maybeForwardAfterSave);
    } /* fin __casLeaveGuardGlobalsBound */

    // Función disponible tanto en el guard como en la primera ejecución.
    function maybeForwardAfterSave() {
      let target = null;
      try {
        target = sessionStorage.getItem(SESSION_KEY);
      } catch {}
      if (!target) return;
      const params = new URLSearchParams(window.location.search);
      if (params.get("saved") !== "1") return;
      try { sessionStorage.removeItem(SESSION_KEY); } catch {}
      setTimeout(() => {
        window.location.href = target;
      }, 600);
    }

    // Bind del modal y post-save check en cada ejecución del script
    // inline (es decir, en cada SSR de una página). Idempotente vía
    // data-cas-bound del dialog y vía sessionStorage para el post-save.
    bindModal();
    maybeForwardAfterSave();
  })();
</script>
