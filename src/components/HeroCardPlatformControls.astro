---
import Dropdown from "~/components/Dropdown.astro";

interface Props {
  platform: "desktop" | "mobile";
}

const { platform: p } = Astro.props;

// Title fonts — kept in sync with apps/web/src/lib/hero-card.ts
// HERO_CARD_FONTS map. The hint text is what the CMS shows in the
// dropdown; the value travels to the public site as title_font.
const FONT_OPTIONS = [
  { value: "serif",          label: "Cormorant Garamond", hint: "Serif editorial clásica" },
  { value: "playfair",       label: "Playfair Display",   hint: "Serif con contraste" },
  { value: "lora",           label: "Lora",               hint: "Serif suave para lectura" },
  { value: "sans",           label: "Inter",              hint: "Sans-serif neutral" },
  { value: "dm-sans",        label: "DM Sans",            hint: "Sans geométrica moderna" },
  { value: "space-grotesk",  label: "Space Grotesk",      hint: "Sans-serif técnica" },
];
---

{/* Background color + alpha */}
<div class="hcc-stack">
  <label class="label">Fondo</label>
  <div class="hcc-color-block">
    <label class="hcc-swatch-wrap" aria-label="Color de fondo">
      <input type="color" data-bind={`${p}.bg_color`} class="hcc-swatch-input" />
      <span class="hcc-swatch" data-color-swatch></span>
    </label>
    <div class="hcc-color-info">
      <span class="hcc-color-hex" data-bind-mirror={`${p}.bg_color`}>#1a1715</span>
      <input type="range" data-bind={`${p}.bg_alpha`} min="0" max="1" step="0.05" class="hcc-range" aria-label="Opacidad" />
      <span class="hcc-color-pct" data-alpha-pct={`${p}.bg_alpha`}>100%</span>
    </div>
  </div>
  <p class="hcc-hint">Si subes una imagen de fondo, el color actúa como overlay encima.</p>
</div>

{/* Blur */}
<div class="hcc-stack">
  <label class="label">Blur del fondo</label>
  <div class="hcc-row hcc-row-tight">
    <svg class="hcc-row-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
    <input type="range" data-bind={`${p}.bg_blur`} min="0" max="40" step="1" class="hcc-range" />
    <span class="hcc-color-pct" data-blur-px={`${p}.bg_blur`}>0px</span>
  </div>
</div>

{/* Text color + title font in a balanced row */}
<div class="grid sm:grid-cols-2 gap-3">
  <div class="hcc-stack">
    <label class="label">Color del texto</label>
    <div class="hcc-color-block hcc-color-block--solo">
      <label class="hcc-swatch-wrap" aria-label="Color del texto">
        <input type="color" data-bind={`${p}.text_color`} class="hcc-swatch-input" />
        <span class="hcc-swatch" data-color-swatch></span>
      </label>
      <div class="hcc-color-info">
        <span class="hcc-color-hex" data-bind-mirror={`${p}.text_color`}>#f5f1ea</span>
      </div>
    </div>
  </div>
  <div class="hcc-stack" data-bind-dd={`${p}.title_font`}>
    <label class="label">Fuente del título</label>
    <Dropdown name={`${p}_title_font`} value="serif" options={FONT_OPTIONS} />
  </div>
</div>

{/* Border radius — visual editor with link toggle inside the same box */}
<div>
  <label class="label">Bordes redondeados</label>
  <div class="hcc-radius-grid" data-radius-platform={p}>
    <div class="hcc-radius-corner">
      <span class="hcc-corner-icon hcc-corner-tl" aria-hidden="true"></span>
      <input type="number" data-bind={`${p}.border_radius_tl`} min="0" max="200" class="hcc-input" data-radius-input aria-label="Esquina superior izquierda" />
    </div>
    <div class="hcc-radius-corner hcc-radius-corner-tr">
      <input type="number" data-bind={`${p}.border_radius_tr`} min="0" max="200" class="hcc-input" data-radius-input aria-label="Esquina superior derecha" />
      <span class="hcc-corner-icon hcc-corner-tr" aria-hidden="true"></span>
    </div>
    <div class="hcc-radius-corner">
      <span class="hcc-corner-icon hcc-corner-bl" aria-hidden="true"></span>
      <input type="number" data-bind={`${p}.border_radius_bl`} min="0" max="200" class="hcc-input" data-radius-input aria-label="Esquina inferior izquierda" />
    </div>
    <div class="hcc-radius-corner hcc-radius-corner-br">
      <input type="number" data-bind={`${p}.border_radius_br`} min="0" max="200" class="hcc-input" data-radius-input aria-label="Esquina inferior derecha" />
      <span class="hcc-corner-icon hcc-corner-br" aria-hidden="true"></span>
    </div>
    <label class="hcc-radius-link-row">
      <input type="checkbox" data-radius-link={p} />
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <span>Vincular esquinas</span>
    </label>
  </div>
</div>

{/* Size: width + height + padding with directional icons */}
<div>
  <label class="label">Tamaño</label>
  <div class="hcc-size-grid">
    <label class="hcc-num-cell">
      <span class="hcc-num-cell-label">
        <svg class="hcc-num-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8l4 4-4 4M6 8l-4 4 4 4M2 12h20"/></svg>
        Ancho
      </span>
      <div class="hcc-num-input-wrap">
        <input type="number" data-bind={`${p}.width`} min="0" max="1400" class="hcc-input hcc-num-input" />
        <span class="hcc-num-suffix">px</span>
      </div>
    </label>
    <label class="hcc-num-cell">
      <span class="hcc-num-cell-label">
        <svg class="hcc-num-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 18l4 4 4-4M8 6l4-4 4 4M12 2v20"/></svg>
        Alto mín.
      </span>
      <div class="hcc-num-input-wrap">
        <input type="number" data-bind={`${p}.height`} min="0" max="1000" class="hcc-input hcc-num-input" />
        <span class="hcc-num-suffix">px</span>
      </div>
    </label>
    <label class="hcc-num-cell">
      <span class="hcc-num-cell-label">
        <svg class="hcc-num-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2"/><rect x="7" y="7" width="10" height="10" rx="1"/></svg>
        Padding
      </span>
      <div class="hcc-num-input-wrap">
        <input type="number" data-bind={`${p}.padding`} min="0" max="120" class="hcc-input hcc-num-input" />
        <span class="hcc-num-suffix">px</span>
      </div>
    </label>
  </div>
  <p class="hcc-hint mt-1">Ancho = 0 → se adapta al contenedor (recomendado para mobile).</p>
</div>

{/* Position: compact layout — pad + inputs side-by-side */}
<div>
  <label class="label">Posición</label>
  <div class="hcc-position-block">
    <div class="hcc-position-pad" data-position-pad={p} role="application" aria-label="Arrastra para posicionar la card">
      <span class="hcc-position-axis hcc-position-axis-h" aria-hidden="true"></span>
      <span class="hcc-position-axis hcc-position-axis-v" aria-hidden="true"></span>
      <span class="hcc-position-dot" data-position-dot></span>
    </div>
    <div class="hcc-position-fields">
      <label class="hcc-num-cell hcc-num-cell-tight">
        <span class="hcc-num-cell-label">
          <svg class="hcc-num-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          X
        </span>
        <div class="hcc-num-input-wrap">
          <input type="number" data-bind={`${p}.offset_x`} min="-400" max="1000" class="hcc-input hcc-num-input" />
          <span class="hcc-num-suffix">px</span>
        </div>
      </label>
      <label class="hcc-num-cell hcc-num-cell-tight">
        <span class="hcc-num-cell-label">
          <svg class="hcc-num-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          Y
        </span>
        <div class="hcc-num-input-wrap">
          <input type="number" data-bind={`${p}.offset_y`} min="-300" max="300" class="hcc-input hcc-num-input" />
          <span class="hcc-num-suffix">px</span>
        </div>
      </label>
    </div>
  </div>
  <p class="hcc-hint mt-1">Pad: X = 0–400, Y = -100–100. Para valores fuera de rango, edita directamente.</p>
</div>

{/* Shadow */}
<label class="hcc-checkbox-row">
  <input type="checkbox" data-bind={`${p}.shadow`} />
  <span>Sombra</span>
</label>
