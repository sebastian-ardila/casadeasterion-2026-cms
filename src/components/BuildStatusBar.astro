---
// Discreet, single-line status bar in the bottom-left corner that reflects the
// state of the public-site Amplify build. Decoupled from action toasts:
// toasts confirm what the user just *did*, this bar reflects what's *still
// happening on the deploy* afterwards.
//
// States:
//   hidden     — no build pending, bar isn't rendered.
//   publishing — request fired, polling Amplify for jobs.
//   succeeded  — build finished. Auto-dismisses 5s later.
//   failed     — build failed or timed out. Stays visible until clicked away.
//
// Trigger: window.casBuildPending() — called from page-load (?publish=1) and
// from client-side mutations like the categories reorder. Polling is robust
// against multiple consecutive triggers (a new save while one is in flight
// just resets the timer; the polling loop stays alive).
---

<div
  id="cas-build-bar"
  class="cas-build-bar fixed bottom-6 left-6 z-50 hidden"
  role="status"
  aria-live="polite"
>
  <span class="cas-build-icon shrink-0 w-5 h-5 flex items-center justify-center" aria-hidden="true">
    <svg data-icon="publishing" class="w-4 h-4 cas-build-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <circle cx="12" cy="12" r="9" stroke-opacity="0.2"></circle>
      <path d="M21 12a9 9 0 0 1-9 9" stroke-linecap="round"></path>
    </svg>
    <svg data-icon="succeeded" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <svg data-icon="failed" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
    <svg data-icon="unavailable" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
      <line x1="12" y1="9" x2="12" y2="13"></line>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
  </span>
  <span class="cas-build-text text-[12px] font-medium text-stone-800" data-text>Publicando sitio…</span>
  <button
    type="button"
    class="cas-build-close shrink-0 cursor-pointer w-5 h-5 rounded-full text-stone-300 hover:text-stone-700 flex items-center justify-center transition hidden"
    data-close
    aria-label="Cerrar"
  >
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</div>

<style is:global>
  .cas-build-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    border: 1px solid #e7e5e4;
    border-left-width: 3px;
    box-shadow:
      0 8px 20px -8px rgba(28, 25, 23, 0.18),
      0 2px 6px -2px rgba(28, 25, 23, 0.08);
    transform: translateY(8px);
    opacity: 0;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease-out,
      border-color 280ms ease;
  }
  /* Tailwind's `.hidden` (display: none) loses to .cas-build-bar's
     `display: flex`. Force it back so the bar doesn't sit invisibly on top
     of UI in the bottom-left corner (notably the sidebar's "Cerrar sesión"
     button) and eat clicks. */
  .cas-build-bar.hidden {
    display: none !important;
  }
  .cas-build-bar.cas-build-bar-visible {
    transform: translateY(0);
    opacity: 1;
  }
  .cas-build-bar[data-state="publishing"] {
    border-left-color: #4f46e5;
  }
  .cas-build-bar[data-state="publishing"] .cas-build-icon { color: #4f46e5; }

  .cas-build-bar[data-state="succeeded"] {
    border-left-color: #059669;
  }
  .cas-build-bar[data-state="succeeded"] .cas-build-icon { color: #059669; }

  .cas-build-bar[data-state="failed"] {
    border-left-color: #dc2626;
  }
  .cas-build-bar[data-state="failed"] .cas-build-icon { color: #dc2626; }

  .cas-build-bar[data-state="unavailable"] {
    border-left-color: #d97706;
  }
  .cas-build-bar[data-state="unavailable"] .cas-build-icon { color: #d97706; }

  .cas-build-spin {
    animation: cas-build-spin 1.1s linear infinite;
  }
  @keyframes cas-build-spin {
    to { transform: rotate(360deg); }
  }

  /* Place the build bar BELOW the toast stack: toasts grow upward from
     bottom-left, build bar sits at the floor. The toast container is at
     `bottom: 1.5rem`; the build bar below would overlap. So we shift the
     toast container up when the build bar is visible. */
  body.has-build-bar #cas-toasts {
    bottom: calc(1.5rem + 44px); /* bar height + gap */
  }
</style>

<script is:inline>
  (() => {
    if (window.__casBuildBarInit) return;
    window.__casBuildBarInit = true;

    const STORAGE_KEY = "cas_build";
    const FAST_INTERVAL = 3000;
    const SLOW_INTERVAL = 5000;
    const FAST_WINDOW = 30_000;
    const FIRST_DELAY = 1000;
    const SUCCESS_LINGER = 5000;
    const MAX_RUNTIME = 10 * 60 * 1000;

    let pollTimer = null;
    let polling = false;
    let succeedDismissTimer = null;

    const TEXT = {
      publishing:  "Publicando sitio…",
      succeeded:   "Sitio publicado",
      failed:      "Falló la publicación",
      unavailable: "No se puede verificar el deploy",
    };

    // ── State ──
    const readState = () => {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch {
        return null;
      }
    };
    const writeState = (s) => {
      try {
        if (s) sessionStorage.setItem(STORAGE_KEY, JSON.stringify(s));
        else sessionStorage.removeItem(STORAGE_KEY);
      } catch {}
    };

    // ── DOM ──
    const els = () => ({
      bar: document.getElementById("cas-build-bar"),
      text: document.querySelector("#cas-build-bar [data-text]"),
      close: document.querySelector("#cas-build-bar [data-close]"),
    });

    const showIcon = (state) => {
      document.querySelectorAll("#cas-build-bar [data-icon]").forEach((svg) => {
        svg.classList.toggle("hidden", svg.getAttribute("data-icon") !== state);
      });
    };

    const renderBar = () => {
      const { bar, text, close } = els();
      const state = readState();
      if (!bar || !text || !close) return;

      if (!state || !state.state) {
        bar.classList.add("hidden");
        bar.classList.remove("cas-build-bar-visible");
        document.body.classList.remove("has-build-bar");
        return;
      }

      bar.classList.remove("hidden");
      requestAnimationFrame(() => bar.classList.add("cas-build-bar-visible"));
      bar.dataset.state = state.state;
      text.textContent = TEXT[state.state] || "";
      showIcon(state.state);
      // Show close button only for terminal states (everything but
      // the actively-polling "publishing").
      close.classList.toggle("hidden", state.state === "publishing");
      // Stop the spinner-driven polling stat for terminal states.
      if (state.state !== "publishing") stopPoll();
      document.body.classList.add("has-build-bar");
    };

    const dismiss = () => {
      writeState(null);
      if (succeedDismissTimer) clearTimeout(succeedDismissTimer);
      succeedDismissTimer = null;
      stopPoll();
      renderBar();
    };

    const stopPoll = () => {
      polling = false;
      if (pollTimer) {
        clearTimeout(pollTimer);
        pollTimer = null;
      }
    };

    const setState = (newState) => {
      const cur = readState() || {};
      cur.state = newState.state ?? cur.state;
      if (newState.since != null) cur.since = newState.since;
      if (newState.terminalAt != null) cur.terminalAt = newState.terminalAt;
      writeState(cur);
      renderBar();
    };

    const scheduleNextPoll = (since) => {
      const elapsed = Date.now() - since;
      const interval = elapsed < FAST_WINDOW ? FAST_INTERVAL : SLOW_INTERVAL;
      pollTimer = setTimeout(poll, interval);
    };

    const poll = async () => {
      const state = readState();
      if (!state || state.state !== "publishing") {
        polling = false;
        return;
      }
      const since = state.since;
      try {
        const res = await fetch(`/api/build-status?since=${since}`, {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) throw new Error("http_" + res.status);
        const data = await res.json();
        if (data.phase === "unavailable") {
          // Endpoint can't talk to Amplify (missing creds, IAM perms,
          // bad app id, transient AWS error). Show this as a visible
          // terminal state with a close button instead of hiding the
          // bar — otherwise the user just sees the bar flash and
          // disappear with no idea why. Reason + message are logged
          // to the console so devs can diagnose without DB access.
          console.warn(
            "[BuildStatusBar] /api/build-status returned unavailable:",
            data.reason || "(no reason)",
            data.message || "",
          );
          setState({ state: "unavailable", terminalAt: Date.now() });
          stopPoll();
          return;
        }
        if (data.phase === "succeed") {
          setState({ state: "succeeded", terminalAt: Date.now() });
          // Auto-dismiss after a linger.
          if (succeedDismissTimer) clearTimeout(succeedDismissTimer);
          succeedDismissTimer = setTimeout(() => {
            const s = readState();
            if (s && s.state === "succeeded") dismiss();
          }, SUCCESS_LINGER);
          stopPoll();
          return;
        }
        if (data.phase === "failed") {
          setState({ state: "failed", terminalAt: Date.now() });
          stopPoll();
          return;
        }
        // running or pending → stay in publishing, keep polling.
      } catch {
        // transient — keep polling.
      }
      // Watchdog timeout.
      if (Date.now() - since > MAX_RUNTIME) {
        setState({ state: "failed", terminalAt: Date.now() });
        stopPoll();
        return;
      }
      scheduleNextPoll(since);
    };

    const ensurePolling = () => {
      const state = readState();
      if (!state || state.state !== "publishing") {
        stopPoll();
        return;
      }
      if (polling || pollTimer) return;
      polling = true;
      pollTimer = setTimeout(poll, FIRST_DELAY);
    };

    // ── Public API ──
    // Mark a new build as pending. If we were idle, this kicks off the
    // status bar + polling. If we were already in publishing, it keeps
    // running. If we were in a terminal state, it restarts.
    const buildPending = () => {
      const cur = readState();
      if (cur && cur.state === "publishing" && cur.since) {
        // Already publishing — nothing to do; the existing poll covers
        // this new save too.
        return;
      }
      // Either no state, or terminal — start fresh.
      if (succeedDismissTimer) clearTimeout(succeedDismissTimer);
      succeedDismissTimer = null;
      writeState({ state: "publishing", since: Date.now() });
      renderBar();
      ensurePolling();
    };
    window.casBuildPending = buildPending;

    // ── Wire close + initial render ──
    const wire = () => {
      const { close } = els();
      if (!close || close.dataset.casWired) return;
      close.dataset.casWired = "1";
      close.addEventListener("click", dismiss);
    };

    const evaluate = () => {
      wire();
      renderBar();
      ensurePolling();
    };

    document.addEventListener("astro:page-load", evaluate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", evaluate);
    } else {
      evaluate();
    }
  })();
</script>
