---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  value?: string | null;
  label?: string;
  bucket?: "covers" | "content" | "authors";
  hint?: string;
}
const {
  name,
  value,
  label = "Imagen",
  bucket = "covers",
  hint = "Click o arrastra una imagen. JPG, PNG, WebP o AVIF. Máx 10 MB.",
} = Astro.props;
const id = `up-${name}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="block min-w-0" data-image-upload={id} data-bucket={bucket}>
  {label && <span class="label">{label}</span>}

  <div
    class="cas-uploader relative flex items-stretch gap-4 border border-dashed border-stone-300 hover:border-stone-500 transition bg-stone-50/40 p-3"
    data-uploader
  >
    {/* Preview thumb (or placeholder) */}
    <div
      id={`${id}-preview-wrap`}
      class="relative w-24 h-24 shrink-0 bg-stone-100 border border-stone-200 overflow-hidden flex items-center justify-center"
    >
      {value ? (
        <img
          id={`${id}-preview`}
          src={value}
          alt=""
          class="w-full h-full object-cover"
        />
      ) : (
        <div id={`${id}-preview`} class="w-full h-full flex items-center justify-center text-stone-400">
          <Icon name="lucide:image" class="w-7 h-7" aria-hidden="true" />
        </div>
      )}
    </div>

    {/* Drop / click area */}
    <label
      for={`${id}-file`}
      class="flex-1 min-w-0 flex flex-col justify-center cursor-pointer text-sm text-stone-700"
    >
      <span class="inline-flex items-center gap-1.5 font-medium">
        <Icon name="lucide:upload-cloud" class="w-4 h-4" aria-hidden="true" />
        <span data-uploader-action>{value ? "Cambiar imagen" : "Seleccionar imagen"}</span>
      </span>
      <span class="text-xs text-stone-500 mt-1">{hint}</span>
      <span id={`${id}-status`} class="text-xs mt-1 min-h-[1rem]"></span>
    </label>

    {/* Remove button (only when there's a value) */}
    <button
      type="button"
      id={`${id}-clear`}
      class:list={[
        "self-start text-stone-500 hover:text-red-700 transition cursor-pointer p-1 -m-1",
        !value && "hidden",
      ]}
      aria-label="Quitar imagen"
      title="Quitar imagen"
    >
      <Icon name="lucide:trash-2" class="w-4 h-4" aria-hidden="true" />
    </button>

    {/* Hidden input that holds the URL the form submits */}
    <input
      type="hidden"
      name={name}
      id={`${id}-url`}
      value={value ?? ""}
    />
    {/* Hidden file input fed by the label / drop zone */}
    <input
      type="file"
      accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
      id={`${id}-file`}
      class="sr-only"
    />

    {/* Drag overlay */}
    <div
      class="cas-uploader-drag-overlay absolute inset-0 bg-violet-50/80 border-2 border-dashed border-violet-500 hidden pointer-events-none flex items-center justify-center text-violet-700 text-sm font-medium"
      data-drag-overlay
    >
      Suelta la imagen para subirla
    </div>
  </div>
</div>

<script type="module" define:vars={{ id, bucket }}>
  const wrapper = document.querySelector(`[data-image-upload="${id}"]`);
  if (wrapper) {
    const fileInput = document.getElementById(`${id}-file`);
    const urlInput = document.getElementById(`${id}-url`);
    const previewWrap = document.getElementById(`${id}-preview-wrap`);
    const status = document.getElementById(`${id}-status`);
    const clearBtn = document.getElementById(`${id}-clear`);
    const action = wrapper.querySelector("[data-uploader-action]");
    const dropZone = wrapper.querySelector("[data-uploader]");
    const dragOverlay = wrapper.querySelector("[data-drag-overlay]");

    const PLACEHOLDER_HTML = `<div id="${id}-preview" class="w-full h-full flex items-center justify-center text-stone-400"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>`;

    const setUrl = (url) => {
      urlInput.value = url || "";
      if (url) {
        previewWrap.innerHTML = `<img id="${id}-preview" src="${url}" alt="" class="w-full h-full object-cover" />`;
        action.textContent = "Cambiar imagen";
        clearBtn.classList.remove("hidden");
      } else {
        previewWrap.innerHTML = PLACEHOLDER_HTML;
        action.textContent = "Seleccionar imagen";
        clearBtn.classList.add("hidden");
      }
      wrapper.dispatchEvent(
        new CustomEvent("cas:imageupload:change", {
          bubbles: true,
          detail: { url: url || "", name: urlInput.name },
        }),
      );
    };

    const upload = async (file) => {
      if (!file) return;
      status.textContent = "Subiendo…";
      status.style.color = "#57534e";

      const fd = new FormData();
      fd.set("file", file);
      fd.set("bucket", bucket);

      try {
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const json = await res.json();
        if (!res.ok) {
          status.textContent = json.error ?? "Error al subir.";
          status.style.color = "#b91c1c";
          return;
        }
        setUrl(json.url);
        status.textContent = "Listo.";
        status.style.color = "#166534";
      } catch (err) {
        status.textContent = "Error de red.";
        status.style.color = "#b91c1c";
      }
    };

    if (fileInput) {
      fileInput.addEventListener("change", (e) => {
        const file = e.target.files?.[0];
        if (file) upload(file);
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        setUrl("");
        if (fileInput) fileInput.value = "";
        status.textContent = "";
      });
    }

    if (dropZone && dragOverlay) {
      let dragDepth = 0;
      const showDrag = () => dragOverlay.classList.remove("hidden");
      const hideDrag = () => dragOverlay.classList.add("hidden");

      dropZone.addEventListener("dragenter", (e) => {
        e.preventDefault();
        if (e.dataTransfer?.types?.includes("Files")) {
          dragDepth++;
          showDrag();
        }
      });
      dropZone.addEventListener("dragover", (e) => {
        e.preventDefault();
      });
      dropZone.addEventListener("dragleave", () => {
        dragDepth = Math.max(0, dragDepth - 1);
        if (dragDepth === 0) hideDrag();
      });
      dropZone.addEventListener("drop", (e) => {
        e.preventDefault();
        dragDepth = 0;
        hideDrag();
        const file = e.dataTransfer?.files?.[0];
        if (file && file.type.startsWith("image/")) upload(file);
      });
    }

    // Expose programmatic setter so other code (e.g. the site config hydrator)
    // can update this uploader without going through the file input.
    wrapper.__casSetImage = setUrl;
  }
</script>
