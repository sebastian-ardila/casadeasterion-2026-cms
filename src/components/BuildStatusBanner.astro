---
// Stack of build/publish toasts. Each publish-affecting save adds a toast to
// the queue (driven by `?published=1&item=…` on the redirect URL, or by a
// programmatic call to window.__casAddBuildToast(item)). All toasts share
// the same Amplify build status — when the rebuild succeeds/fails, every
// active toast transitions together.
//
// Up to 4 toasts are rendered visually with decreasing opacity (latest on
// top); any extras collapse into a "+N más" summary card that expands on
// click.
---

<div
  id="cda-toast-stack"
  class="fixed bottom-6 right-6 z-50 flex flex-col items-stretch gap-2 pointer-events-none w-[380px] max-w-[calc(100vw-2rem)]"
  data-expanded="0"
  aria-live="polite"
></div>

<template id="cda-toast-template">
  <div
    class="cas-toast"
    data-phase="saved"
    role="status"
  >
    <div class="cas-toast-glow" aria-hidden="true"></div>
    <div class="flex items-start gap-3 p-3.5">
      <div class="cas-toast-icon shrink-0 w-9 h-9 rounded-full flex items-center justify-center transition-colors duration-300">
        <svg data-icon="saved" class="cas-icon w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17 21 17 13 7 13 7 21"/>
          <polyline points="7 3 7 8 15 8"/>
        </svg>
        <svg data-icon="pending" class="cas-icon cas-icon-spin w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-opacity="0.18"></circle>
          <path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"></path>
        </svg>
        <svg data-icon="running" class="cas-icon cas-icon-spin w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-opacity="0.18"></circle>
          <path d="M21 12a9 9 0 0 1-9 9" stroke-linecap="round"></path>
        </svg>
        <svg data-icon="succeed" class="cas-icon w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <svg data-icon="failed" class="cas-icon w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <svg data-icon="timeout" class="cas-icon w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <polyline points="12 7 12 12 15 14"/>
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <p class="cas-toast-item font-medium text-[13px] text-stone-900 truncate">Cambios</p>
          <span class="cas-toast-pill" data-pill>Programando</span>
        </div>
        <p class="cas-toast-status text-[11px] text-stone-600 mt-0.5 leading-snug flex items-center gap-1.5">
          <span class="cas-loading-dots">
            <span></span><span></span><span></span>
          </span>
          <span data-status-text>Disparando publicación al sitio público.</span>
        </p>
      </div>
      <button
        type="button"
        class="cas-toast-close shrink-0 cursor-pointer w-6 h-6 rounded-full text-stone-400 hover:text-stone-700 hover:bg-stone-100 flex items-center justify-center transition"
        aria-label="Cerrar"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="cas-toast-progress-track">
      <div class="cas-toast-progress-bar" style="width: 8%"></div>
    </div>
  </div>
</template>

<template id="cda-toast-summary-template">
  <button
    type="button"
    class="cas-toast-summary"
    aria-expanded="false"
  >
    <span class="cas-toast-summary-icon shrink-0 w-6 h-6 rounded-full bg-stone-100 text-stone-700 flex items-center justify-center">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </span>
    <span class="cas-toast-summary-text text-[12px] text-stone-700">+ <span data-count>0</span> más</span>
  </button>
</template>

<style is:global>
  /* Stack pointer-events: only the toasts themselves accept clicks. */
  #cda-toast-stack > * { pointer-events: auto; }

  .cas-toast {
    position: relative;
    width: 100%;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    border: 1px solid #e7e5e4;
    border-left-width: 3px;
    box-shadow:
      0 18px 40px -12px rgba(28, 25, 23, 0.18),
      0 4px 12px -4px rgba(28, 25, 23, 0.1);
    overflow: hidden;
    transform: translateY(8px) scale(0.98);
    opacity: 0;
    transition:
      opacity 220ms ease-out,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 280ms ease,
      max-height 280ms ease,
      margin 280ms ease,
      padding 280ms ease;
    max-height: 200px;
  }
  .cas-toast.cas-toast-visible {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  .cas-toast.cas-toast-leaving {
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    max-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
  }
  /* Stacked opacity tiers (newest at top → most visible). The data-stack-pos
     index is set by JS based on collapsed-stack ordering. */
  #cda-toast-stack[data-expanded="0"] .cas-toast[data-stack-pos="0"] { opacity: 1; }
  #cda-toast-stack[data-expanded="0"] .cas-toast[data-stack-pos="1"] { opacity: 0.92; }
  #cda-toast-stack[data-expanded="0"] .cas-toast[data-stack-pos="2"] { opacity: 0.84; }
  #cda-toast-stack[data-expanded="0"] .cas-toast[data-stack-pos="3"] { opacity: 0.76; }
  #cda-toast-stack[data-expanded="0"] .cas-toast.cas-toast-hidden { display: none; }

  .cas-toast-glow {
    position: absolute;
    top: -36px;
    left: -36px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(26px);
    opacity: 0.5;
    transition: background 320ms ease, opacity 320ms ease;
  }

  .cas-toast-pill {
    display: inline-flex;
    align-items: center;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 2px 7px;
    border-radius: 9999px;
    transition: background 220ms ease, color 220ms ease;
  }

  .cas-toast-icon {
    transition: background 280ms ease, color 280ms ease;
  }

  .cas-icon-spin {
    animation: cas-spin 1.1s linear infinite;
  }
  @keyframes cas-spin {
    to { transform: rotate(360deg); }
  }

  .cas-toast[data-phase="saved"] .cas-toast-icon,
  .cas-toast[data-phase="pending"] .cas-toast-icon,
  .cas-toast[data-phase="running"] .cas-toast-icon {
    position: relative;
  }
  .cas-toast[data-phase="saved"] .cas-toast-icon::after,
  .cas-toast[data-phase="pending"] .cas-toast-icon::after,
  .cas-toast[data-phase="running"] .cas-toast-icon::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid currentColor;
    opacity: 0.25;
    animation: cas-breathe 2.2s ease-in-out infinite;
  }
  @keyframes cas-breathe {
    0%, 100% { transform: scale(1); opacity: 0.0; }
    50%      { transform: scale(1.18); opacity: 0.35; }
  }

  .cas-loading-dots {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 8px;
  }
  .cas-loading-dots span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
    animation: cas-dot 1.2s ease-in-out infinite;
  }
  .cas-loading-dots span:nth-child(2) { animation-delay: 0.18s; }
  .cas-loading-dots span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes cas-dot {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.3; }
    40%           { transform: scale(1.2); opacity: 1; }
  }
  .cas-toast[data-phase="succeed"] .cas-loading-dots,
  .cas-toast[data-phase="failed"] .cas-loading-dots,
  .cas-toast[data-phase="timeout"] .cas-loading-dots {
    display: none;
  }

  .cas-toast-progress-track {
    height: 3px;
    background: rgba(120, 113, 108, 0.08);
    overflow: hidden;
    position: relative;
  }
  .cas-toast-progress-bar {
    height: 100%;
    transition: width 700ms cubic-bezier(0.22, 1, 0.36, 1), background 280ms ease;
    background: #44403c;
  }
  .cas-toast[data-phase="running"] .cas-toast-progress-track::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent 40%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 60%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: cas-shimmer 1.6s linear infinite;
    pointer-events: none;
  }
  @keyframes cas-shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }
  .cas-toast[data-phase="saved"] .cas-toast-progress-bar,
  .cas-toast[data-phase="pending"] .cas-toast-progress-bar {
    animation: cas-pulse 1.6s ease-in-out infinite;
  }
  @keyframes cas-pulse {
    0%, 100% { opacity: 0.6; }
    50%      { opacity: 1; }
  }

  /* Per-phase color treatments */
  .cas-toast[data-phase="saved"]   { border-left-color: #78716c; }
  .cas-toast[data-phase="saved"] .cas-toast-glow { background: #d6d3d1; opacity: 0.35; }
  .cas-toast[data-phase="saved"] .cas-toast-icon { background: #f5f5f4; color: #44403c; }
  .cas-toast[data-phase="saved"] .cas-toast-pill { background: #f5f5f4; color: #57534e; }
  .cas-toast[data-phase="saved"] .cas-toast-progress-bar { background: #78716c; }

  .cas-toast[data-phase="pending"] { border-left-color: #d97706; }
  .cas-toast[data-phase="pending"] .cas-toast-glow { background: #fbbf24; opacity: 0.35; }
  .cas-toast[data-phase="pending"] .cas-toast-icon { background: #fef3c7; color: #92400e; }
  .cas-toast[data-phase="pending"] .cas-toast-pill { background: #fef3c7; color: #92400e; }
  .cas-toast[data-phase="pending"] .cas-toast-progress-bar { background: #d97706; }

  .cas-toast[data-phase="running"] { border-left-color: #4f46e5; }
  .cas-toast[data-phase="running"] .cas-toast-glow { background: #818cf8; opacity: 0.45; }
  .cas-toast[data-phase="running"] .cas-toast-icon { background: #e0e7ff; color: #3730a3; }
  .cas-toast[data-phase="running"] .cas-toast-pill { background: #e0e7ff; color: #3730a3; }
  .cas-toast[data-phase="running"] .cas-toast-progress-bar { background: #4f46e5; }

  .cas-toast[data-phase="succeed"] { border-left-color: #059669; }
  .cas-toast[data-phase="succeed"] .cas-toast-glow { background: #34d399; opacity: 0.4; }
  .cas-toast[data-phase="succeed"] .cas-toast-icon { background: #d1fae5; color: #065f46; }
  .cas-toast[data-phase="succeed"] .cas-toast-pill { background: #d1fae5; color: #065f46; }
  .cas-toast[data-phase="succeed"] .cas-toast-progress-bar { background: #059669; }

  .cas-toast[data-phase="failed"] { border-left-color: #dc2626; }
  .cas-toast[data-phase="failed"] .cas-toast-glow { background: #f87171; opacity: 0.4; }
  .cas-toast[data-phase="failed"] .cas-toast-icon { background: #fee2e2; color: #991b1b; }
  .cas-toast[data-phase="failed"] .cas-toast-pill { background: #fee2e2; color: #991b1b; }
  .cas-toast[data-phase="failed"] .cas-toast-progress-bar { background: #dc2626; }

  .cas-toast[data-phase="timeout"] { border-left-color: #475569; }
  .cas-toast[data-phase="timeout"] .cas-toast-glow { background: #94a3b8; opacity: 0.35; }
  .cas-toast[data-phase="timeout"] .cas-toast-icon { background: #f1f5f9; color: #334155; }
  .cas-toast[data-phase="timeout"] .cas-toast-pill { background: #f1f5f9; color: #334155; }
  .cas-toast[data-phase="timeout"] .cas-toast-progress-bar { background: #475569; }

  /* Summary "+N más" card */
  .cas-toast-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    border: 1px dashed #d6d3d1;
    border-radius: 0;
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease;
    width: 100%;
    text-align: left;
  }
  .cas-toast-summary:hover {
    background: rgba(255, 255, 255, 1);
    border-color: #78716c;
  }
  .cas-toast-summary[aria-expanded="true"] .cas-toast-summary-icon svg {
    transform: rotate(180deg);
  }
  .cas-toast-summary-icon svg {
    transition: transform 200ms ease;
  }
</style>

<script is:inline>
  (() => {
    if (window.__casToastInit) return;
    window.__casToastInit = true;

    const STORAGE_KEY = "cda_toasts_v2";
    const FIRST_POLL_DELAY = 800;
    const POLL_INTERVAL_FAST = 3000;  // first ~30s
    const POLL_INTERVAL_SLOW = 5000;
    const FAST_WINDOW = 30_000;
    const MAX_RUNTIME = 10 * 60 * 1000;
    const MAX_VISIBLE = 4;

    const PHASE_CONFIG = {
      saved:   { pill: "Programando", text: "Disparando publicación al sitio público.", progress: 12  },
      pending: { pill: "En cola",     text: "Esperando que Amplify reciba el trigger.",  progress: 28  },
      running: { pill: "Publicando",  text: "Generando HTML estático en Amplify.",       progress: 70  },
      succeed: { pill: "Listo",       text: "El sitio público se actualizó.",            progress: 100 },
      failed:  { pill: "Error",       text: "Revisa el build log en Amplify.",           progress: 100 },
      timeout: { pill: "En curso",    text: "El build sigue corriendo. Revisa Amplify.", progress: 92  },
    };

    let pollTimer = null;
    let polling = false;
    let toastEls = new Map();        // toast id → element
    let summaryEl = null;             // the "+N más" card, if mounted
    let expandedSummary = false;

    // ── State persistence ──
    const readState = () => {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return { toasts: [] };
        const parsed = JSON.parse(raw);
        const now = Date.now();
        const live = (parsed.toasts ?? []).filter((t) => {
          if (t.dismissedAt) return false;
          if (t.terminalAt && now - t.terminalAt > 12_000) return false;
          if (now - t.createdAt > MAX_RUNTIME) return false;
          return true;
        });
        return { ...parsed, toasts: live };
      } catch {
        return { toasts: [] };
      }
    };
    const writeState = (state) => {
      try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
    };

    const addToast = (item) => {
      const state = readState();
      const id = `t_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`;
      state.toasts.push({
        id,
        item: item || "Cambios guardados",
        createdAt: Date.now(),
        phase: "saved",
        terminalAt: null,
        dismissedAt: null,
      });
      writeState(state);
      return id;
    };

    const dismissToast = (id) => {
      const state = readState();
      const t = state.toasts.find((x) => x.id === id);
      if (!t) return;
      t.dismissedAt = Date.now();
      writeState(state);
    };

    // ── DOM rendering ──
    const stack = () => document.getElementById("cda-toast-stack");
    const toastTpl = () => document.getElementById("cda-toast-template");
    const summaryTpl = () => document.getElementById("cda-toast-summary-template");

    const showIcon = (el, phase) => {
      el.querySelectorAll(".cas-icon").forEach((svg) => {
        svg.classList.toggle("hidden", svg.getAttribute("data-icon") !== phase);
      });
    };

    const applyPhaseToToast = (el, toast) => {
      const cfg = PHASE_CONFIG[toast.phase] || PHASE_CONFIG.saved;
      el.dataset.phase = toast.phase;
      el.querySelector(".cas-toast-item").textContent = toast.item;
      el.querySelector("[data-pill]").textContent = cfg.pill;
      const txt = el.querySelector("[data-status-text]");
      if (toast.phase === "succeed" && toast.terminalAt && toast.createdAt) {
        const sec = Math.round((toast.terminalAt - toast.createdAt) / 1000);
        txt.textContent = `Listo en ${sec}s. El sitio público ya está actualizado.`;
      } else {
        txt.textContent = cfg.text;
      }
      const bar = el.querySelector(".cas-toast-progress-bar");
      const cur = parseFloat(bar.style.width) || 0;
      bar.style.width = (toast.phase === "succeed" || toast.phase === "failed"
        ? cfg.progress
        : Math.max(cur, cfg.progress)) + "%";
      showIcon(el, toast.phase);
    };

    const buildToastNode = (toast) => {
      const t = toastTpl();
      if (!t) return null;
      const node = t.content.firstElementChild.cloneNode(true);
      applyPhaseToToast(node, toast);
      node.querySelector(".cas-toast-close").addEventListener("click", (e) => {
        e.stopPropagation();
        node.classList.add("cas-toast-leaving");
        dismissToast(toast.id);
        setTimeout(() => {
          node.remove();
          toastEls.delete(toast.id);
          renderAll();
        }, 280);
      });
      return node;
    };

    const buildSummaryNode = () => {
      const t = summaryTpl();
      if (!t) return null;
      const node = t.content.firstElementChild.cloneNode(true);
      node.addEventListener("click", () => {
        expandedSummary = !expandedSummary;
        const s = stack();
        if (s) s.dataset.expanded = expandedSummary ? "1" : "0";
        node.setAttribute("aria-expanded", expandedSummary ? "true" : "false");
        renderAll();
      });
      return node;
    };

    const renderAll = () => {
      const container = stack();
      if (!container) return;
      const state = readState();
      // Newest first
      const sorted = [...state.toasts].sort((a, b) => b.createdAt - a.createdAt);

      // Drop DOM nodes whose toasts are gone
      const liveIds = new Set(sorted.map((t) => t.id));
      for (const [id, el] of toastEls.entries()) {
        if (!liveIds.has(id)) {
          el.classList.add("cas-toast-leaving");
          setTimeout(() => el.remove(), 280);
          toastEls.delete(id);
        }
      }

      // Ensure each toast has a DOM node, and that the order in the DOM
      // matches `sorted` (insertBefore re-orders without rebuilding).
      let prev = null;
      sorted.forEach((toast, idx) => {
        let el = toastEls.get(toast.id);
        if (!el) {
          el = buildToastNode(toast);
          if (!el) return;
          toastEls.set(toast.id, el);
          // Insert before `prev` (which is the next sibling in render order).
          // Wait until we attach below — simpler to just append now and reorder.
          container.appendChild(el);
          requestAnimationFrame(() => el.classList.add("cas-toast-visible"));
        } else {
          applyPhaseToToast(el, toast);
        }
        // Set stack position for the opacity tier.
        const visiblePos = expandedSummary ? -1 : idx;
        if (visiblePos >= 0 && visiblePos < MAX_VISIBLE) {
          el.dataset.stackPos = String(visiblePos);
          el.classList.remove("cas-toast-hidden");
        } else if (expandedSummary) {
          el.dataset.stackPos = "0"; // uniform opacity when expanded
          el.classList.remove("cas-toast-hidden");
        } else {
          el.classList.add("cas-toast-hidden");
        }
      });

      // DOM order: walk sorted and insertBefore relative to next item.
      for (let i = sorted.length - 1; i >= 0; i--) {
        const toast = sorted[i];
        const el = toastEls.get(toast.id);
        if (!el) continue;
        // Move to its correct slot among siblings.
        const desiredSibling = container.children[i];
        if (desiredSibling && desiredSibling !== el) {
          container.insertBefore(el, desiredSibling);
        }
      }

      // Summary card "+ N más"
      const overflow = sorted.length - MAX_VISIBLE;
      if (overflow > 0 && !expandedSummary) {
        if (!summaryEl || !summaryEl.isConnected) {
          summaryEl = buildSummaryNode();
        }
        if (summaryEl) {
          summaryEl.querySelector("[data-count]").textContent = String(overflow);
          // append at end
          if (summaryEl.parentElement !== container) {
            container.appendChild(summaryEl);
          } else {
            container.appendChild(summaryEl); // re-append so it's last
          }
        }
      } else if (summaryEl && summaryEl.parentElement === container) {
        // Show summary even when expanded so user can collapse.
        if (overflow > 0 && expandedSummary) {
          summaryEl.querySelector("[data-count]").textContent = "Ocultar " + overflow;
          summaryEl.setAttribute("aria-expanded", "true");
          container.appendChild(summaryEl);
        } else {
          summaryEl.remove();
        }
      }
    };

    // ── Polling ──
    const since = () => {
      const state = readState();
      const live = state.toasts.filter((t) => !t.dismissedAt && !t.terminalAt);
      if (live.length === 0) return 0;
      return Math.min(...live.map((t) => t.createdAt));
    };

    const setAllLivePhase = (phase, extra) => {
      const state = readState();
      let mutated = false;
      for (const t of state.toasts) {
        if (t.dismissedAt || t.terminalAt) continue;
        // Only allow forward transitions to terminal states; let saved↔pending
        // and pending↔running freely intermix.
        t.phase = phase;
        if (phase === "succeed" || phase === "failed" || phase === "timeout") {
          t.terminalAt = (extra && extra.endTime ? new Date(extra.endTime).getTime() : Date.now());
        }
        mutated = true;
      }
      if (mutated) {
        writeState(state);
        renderAll();
      }
    };

    const stopPoll = () => {
      polling = false;
      if (pollTimer) {
        clearTimeout(pollTimer);
        pollTimer = null;
      }
    };

    const scheduleNextPoll = (s) => {
      const elapsed = Date.now() - s;
      const interval = elapsed < FAST_WINDOW ? POLL_INTERVAL_FAST : POLL_INTERVAL_SLOW;
      pollTimer = setTimeout(poll, interval);
    };

    const poll = async () => {
      const s = since();
      // No more live toasts → polling is genuinely done.
      if (s === 0) {
        polling = false;
        return;
      }
      polling = true;
      try {
        const res = await fetch(`/api/build-status?since=${s}`, {
          headers: { accept: "application/json" },
          credentials: "same-origin",
        });
        if (!res.ok) throw new Error("http_" + res.status);
        const data = await res.json();
        if (data.phase === "succeed") {
          setAllLivePhase("succeed", { endTime: data.endTime });
          // Schedule auto-dismiss after 12s. Don't stop polling outright —
          // a new toast added during the dismiss window must still kick in,
          // and ensurePolling() handles that.
          setTimeout(() => {
            const state = readState();
            for (const t of state.toasts) {
              if (t.terminalAt && Date.now() - t.terminalAt > 11_000) t.dismissedAt = Date.now();
            }
            writeState(state);
            renderAll();
            // After dismissals, see if anything else is still live.
            ensurePolling();
          }, 12_500);
          // Polling for THIS batch is done — but if a new toast comes in,
          // ensurePolling() will restart us. Reset state so it can.
          polling = false;
          return;
        }
        if (data.phase === "failed") {
          setAllLivePhase("failed");
          polling = false;
          return;
        }
        if (data.phase === "running") setAllLivePhase("running");
        else setAllLivePhase("pending");
      } catch {
        // Transient error: keep polling.
      }
      // Always reschedule unless we hit a terminal phase above.
      if (Date.now() - s > MAX_RUNTIME) {
        setAllLivePhase("timeout");
        polling = false;
        return;
      }
      scheduleNextPoll(s);
    };

    const ensurePolling = () => {
      const s = since();
      if (s === 0) {
        // Nothing to poll for. Safe to stop any orphaned timer.
        if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
        polling = false;
        return;
      }
      if (polling || pollTimer) return; // already polling
      polling = true;
      pollTimer = setTimeout(poll, FIRST_POLL_DELAY);
    };

    // ── Page load handling ──
    const evaluate = () => {
      const url = new URL(window.location.href);
      if (url.searchParams.get("published") === "1") {
        const item = url.searchParams.get("item") || "Cambios guardados";
        addToast(decodeURIComponent(item));
        url.searchParams.delete("published");
        url.searchParams.delete("item");
        window.history.replaceState({}, "", url.toString());
      }
      renderAll();
      ensurePolling();
    };

    document.addEventListener("astro:page-load", evaluate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", evaluate);
    } else {
      evaluate();
    }

    // Programmatic API for client-side actions that trigger a rebuild
    // (e.g. drag-and-drop reorder) — they don't navigate, so they can't
    // rely on ?published=1 in the URL.
    window.__casAddBuildToast = (item) => {
      addToast(item || "Cambios guardados");
      renderAll();
      ensurePolling();
    };
  })();
</script>
