---
// Floating banner that appears immediately after a publish-affecting save and
// transitions through phases:
//   saved        → just submitted, scheduling rebuild (instant)
//   pending      → trigger queued, waiting for the cron dispatcher
//   running      → Amplify build job in progress
//   succeed/fail → terminal
//
// Driven by sessionStorage["cda_publish_at"] = Date.now() set when the URL
// has ?published=1 (set by every CMS POST handler that mutates published
// content). Persists across view transitions via transition:persist.
---

<div
  id="cda-build-banner"
  class="hidden fixed bottom-6 right-6 z-50 w-[360px] max-w-[calc(100vw-3rem)] bg-white border border-stone-300 shadow-2xl"
  role="status"
  aria-live="polite"
>
  <div class="flex items-start gap-3 p-4">
    <div id="cda-build-icon" class="shrink-0 w-9 h-9 rounded-full bg-stone-100 flex items-center justify-center text-stone-700">
      <svg id="cda-build-spinner" class="w-5 h-5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="9" stroke-opacity="0.25"></circle>
        <path d="M21 12a9 9 0 0 1-9 9" stroke-linecap="round"></path>
      </svg>
      <svg id="cda-build-check" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <svg id="cda-build-cross" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p id="cda-build-title" class="font-medium text-stone-900 text-sm">Cambios guardados</p>
      <p id="cda-build-subtitle" class="text-xs text-stone-600 mt-0.5">Programando publicación…</p>
      <a
        id="cda-build-link"
        href="https://casadeasterionediciones.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-xs text-stone-700 underline mt-2 inline-block"
      >Ver sitio público →</a>
    </div>
    <button
      type="button"
      id="cda-build-close"
      aria-label="Cerrar"
      class="shrink-0 cursor-pointer text-stone-400 hover:text-stone-700 text-xl leading-none px-1"
    >×</button>
  </div>
  <div class="h-1 bg-stone-100 overflow-hidden">
    <div id="cda-build-progress" class="h-full bg-stone-700 transition-all duration-700" style="width: 6%"></div>
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__casBuildBannerInit) return;
    window.__casBuildBannerInit = true;

    const PUBLISH_KEY = "cda_publish_at";
    const FIRST_POLL_DELAY = 1500;
    const POLL_INTERVAL = 5000;
    const MAX_RUNTIME = 10 * 60 * 1000; // 10 min hard cap

    let timer = null;
    let pollingForSince = 0;
    let lastPhase = null;

    const stop = () => {
      pollingForSince = 0;
      lastPhase = null;
      if (timer) {
        clearTimeout(timer);
        timer = null;
      }
    };

    const els = () => ({
      banner: document.getElementById("cda-build-banner"),
      title: document.getElementById("cda-build-title"),
      subtitle: document.getElementById("cda-build-subtitle"),
      progress: document.getElementById("cda-build-progress"),
      link: document.getElementById("cda-build-link"),
      close: document.getElementById("cda-build-close"),
      spinner: document.getElementById("cda-build-spinner"),
      check: document.getElementById("cda-build-check"),
      cross: document.getElementById("cda-build-cross"),
      icon: document.getElementById("cda-build-icon"),
    });

    const setPhase = (phase, extra) => {
      const e = els();
      if (!e.banner) return;
      lastPhase = phase;
      e.banner.classList.remove("hidden");

      // Reset terminal-state styles each call.
      e.progress.classList.remove("bg-green-600", "bg-red-600");
      e.progress.classList.add("bg-stone-700");
      e.icon.classList.remove("bg-green-100", "text-green-700", "bg-red-100", "text-red-700");
      e.icon.classList.add("bg-stone-100", "text-stone-700");
      e.spinner.classList.remove("hidden");
      e.check.classList.add("hidden");
      e.cross.classList.add("hidden");
      e.link.classList.add("hidden");

      if (phase === "saved") {
        e.title.textContent = "Cambios guardados";
        e.subtitle.textContent = "Programando publicación…";
        e.progress.style.width = "8%";
      } else if (phase === "pending") {
        e.title.textContent = "Esperando rebuild";
        e.subtitle.textContent = "Disparando el build en Amplify.";
        // Ramp from 8% to ~28% over the wait.
        const cur = parseFloat(e.progress.style.width) || 8;
        e.progress.style.width = Math.max(cur, Math.min(28, cur + 4)) + "%";
      } else if (phase === "running") {
        e.title.textContent = "Construyendo sitio público…";
        e.subtitle.textContent = "Generando HTML estático en Amplify.";
        const cur = parseFloat(e.progress.style.width) || 30;
        e.progress.style.width = Math.min(85, Math.max(cur, 32) + 5) + "%";
      } else if (phase === "succeed") {
        e.title.textContent = "Sitio publicado";
        const elapsed = extra && extra.endTime
          ? Math.round((new Date(extra.endTime).getTime() - (extra.since || Date.now())) / 1000)
          : null;
        e.subtitle.textContent = elapsed ? `Listo en ${elapsed}s.` : "Listo.";
        e.progress.style.width = "100%";
        e.progress.classList.remove("bg-stone-700");
        e.progress.classList.add("bg-green-600");
        e.icon.classList.remove("bg-stone-100", "text-stone-700");
        e.icon.classList.add("bg-green-100", "text-green-700");
        e.spinner.classList.add("hidden");
        e.check.classList.remove("hidden");
        e.link.classList.remove("hidden");
      } else if (phase === "failed") {
        e.title.textContent = "Falló el deploy del sitio";
        e.subtitle.textContent = "Revisa el build log en Amplify.";
        e.progress.style.width = "100%";
        e.progress.classList.remove("bg-stone-700");
        e.progress.classList.add("bg-red-600");
        e.icon.classList.remove("bg-stone-100", "text-stone-700");
        e.icon.classList.add("bg-red-100", "text-red-700");
        e.spinner.classList.add("hidden");
        e.cross.classList.remove("hidden");
      } else if (phase === "timeout") {
        e.title.textContent = "Tomó más de lo esperado";
        e.subtitle.textContent = "El build sigue corriendo. Revisa Amplify.";
      }
    };

    const dismiss = () => {
      const e = els();
      if (e.banner) e.banner.classList.add("hidden");
      sessionStorage.removeItem(PUBLISH_KEY);
      stop();
    };

    const wireClose = () => {
      const e = els();
      if (!e.close || e.close.dataset.casWired) return;
      e.close.dataset.casWired = "1";
      e.close.addEventListener("click", dismiss);
    };

    const poll = async (since) => {
      if (pollingForSince !== since) return; // a newer publish superseded this
      try {
        const res = await fetch(`/api/build-status?since=${since}`, {
          headers: { accept: "application/json" },
          credentials: "same-origin",
        });
        if (!res.ok) throw new Error("http_" + res.status);
        const data = await res.json();
        if (data.phase === "succeed") {
          setPhase("succeed", { endTime: data.endTime, since });
          sessionStorage.removeItem(PUBLISH_KEY);
          // Auto-dismiss after 12s.
          setTimeout(() => {
            const e = els();
            if (e.banner) e.banner.classList.add("hidden");
          }, 12000);
          stop();
          return;
        }
        if (data.phase === "failed") {
          setPhase("failed");
          sessionStorage.removeItem(PUBLISH_KEY);
          stop();
          return;
        }
        if (data.phase === "running") setPhase("running");
        else if (lastPhase !== "pending" && lastPhase !== "running") setPhase("pending");
        else if (lastPhase === "pending") setPhase("pending"); // bump progress
      } catch {
        // ignore transient errors, keep polling
      }
      if (Date.now() - since > MAX_RUNTIME) {
        setPhase("timeout");
        sessionStorage.removeItem(PUBLISH_KEY);
        stop();
        return;
      }
      timer = setTimeout(() => poll(since), POLL_INTERVAL);
    };

    const evaluate = () => {
      // 1. Did this page load result from a publish-affecting POST?
      //    Capture the timestamp and clean the URL.
      const url = new URL(window.location.href);
      if (url.searchParams.get("published") === "1") {
        sessionStorage.setItem(PUBLISH_KEY, String(Date.now()));
        url.searchParams.delete("published");
        window.history.replaceState({}, "", url.toString());
      }

      const since = Number(sessionStorage.getItem(PUBLISH_KEY) ?? "0");
      if (!since || Date.now() - since > MAX_RUNTIME) {
        sessionStorage.removeItem(PUBLISH_KEY);
        return;
      }

      wireClose();

      // 2. If we're not already polling for this publish, start now.
      if (pollingForSince !== since) {
        if (timer) clearTimeout(timer);
        pollingForSince = since;

        // Show "saved → scheduling" instantly, then transition to pending after
        // the first poll. The first poll is fast (1.5s) so we detect the job
        // as soon as the cron dispatcher fires.
        setPhase("saved");
        timer = setTimeout(() => poll(since), FIRST_POLL_DELAY);
      } else {
        // Same publish in progress; just make sure the banner is visible.
        const e = els();
        if (e.banner) e.banner.classList.remove("hidden");
      }
    };

    // Run on first paint AND on every navigation (form submits via Astro's
    // ClientRouter trigger astro:page-load instead of a full reload).
    document.addEventListener("astro:page-load", evaluate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", evaluate);
    } else {
      evaluate();
    }
  })();
</script>
