---
// Editor de la imagen del hero por dispositivo (Web / Tablet / Móvil).
//
// - Web usa la imagen principal (hero_image_url).
// - Tablet y Móvil heredan la imagen de Web salvo que el editor apague
//   "Usar la misma imagen que Web" y suba una propia.
// - Cada dispositivo tiene su propio ajuste (fit), posición X/Y y zoom;
//   Móvil además elige la proporción del espacio.
//
// Todo el encuadre viaja en un único hidden input `hero_image_config`
// (JSON) que site.astro normaliza con lib/hero-image.ts y guarda en
// site_configuration.hero_image_config. El sitio público lo lee en
// apps/web/src/pages/index.astro.
//
// API para site.astro: el elemento [data-hero-image-editor] expone
// `__casHieSet(config)` para hidratar con los valores del servidor y
// emite `cas:heroimage:change` cuando cambia algo.
import { Icon } from "astro-icon/components";
import ImageUpload from "~/components/ImageUpload.astro";

interface Props {
  fallbackUrl: string;
}
const { fallbackUrl } = Astro.props;

const FITS = [
  { value: "cover", label: "Rellenar" },
  { value: "contain", label: "Completa" },
  { value: "fill", label: "Estirar" },
  { value: "none", label: "Original" },
];
const RATIOS = [
  { value: "1/1", label: "1:1", title: "Cuadrado" },
  { value: "4/5", label: "4:5", title: "Vertical" },
  { value: "4/3", label: "4:3", title: "Horizontal" },
  { value: "16/9", label: "16:9", title: "Panorámico" },
];
const POSITIONS = [
  [0, 0], [50, 0], [100, 0],
  [0, 50], [50, 50], [100, 50],
  [0, 100], [50, 100], [100, 100],
];
---

<section class="card cas-hie" data-hero-image-editor data-fallback-url={fallbackUrl}>
  <div class="cas-hie-head">
    <span class="shrink-0 mt-0.5 inline-flex items-center justify-center w-8 h-8 bg-stone-100 text-stone-700 border border-stone-200">
      <Icon name="lucide:image" class="w-4 h-4" aria-hidden="true" />
    </span>
    <div class="min-w-0">
      <h2 class="card-section-title">Imagen del hero</h2>
      <p class="text-sm text-stone-500">Foto del inicio. Configúrala por dispositivo: Tablet y Móvil usan lo de Web hasta que los cambies.</p>
    </div>
  </div>

  {/* Selector de dispositivo */}
  <div class="cas-hie-devbar">
    <span class="label">Dispositivo</span>
    <div class="cas-hie-tabs" role="tablist" aria-label="Dispositivo">
      <button type="button" role="tab" data-hie-device="web" aria-selected="true">
        <Icon name="lucide:monitor" class="w-4 h-4" aria-hidden="true" /> Web
        <span class="cas-hie-dot" data-hie-dot hidden></span>
      </button>
      <button type="button" role="tab" data-hie-device="tablet" aria-selected="false">
        <Icon name="lucide:tablet" class="w-4 h-4" aria-hidden="true" /> Tablet
        <span class="cas-hie-dot" data-hie-dot hidden title="Tiene ajustes propios"></span>
      </button>
      <button type="button" role="tab" data-hie-device="mobile" aria-selected="false">
        <Icon name="lucide:smartphone" class="w-4 h-4" aria-hidden="true" /> Móvil
        <span class="cas-hie-dot" data-hie-dot hidden title="Tiene ajustes propios"></span>
      </button>
    </div>
    <p class="cas-hie-hint" data-hie-devhint></p>
  </div>

  {/* Vista previa con arrastre */}
  <div class="cas-hie-stage">
    <div class="cas-hie-device" data-hie-preview data-device="web">
      <div class="cas-hie-site">
        <div class="cas-hie-copy" aria-hidden="true">
          <span class="cas-hie-copy-t">Casa de Asterión Ediciones</span>
          <span class="cas-hie-copy-l"></span>
          <span class="cas-hie-copy-l cas-hie-copy-l--s"></span>
          <span class="cas-hie-copy-cta"></span>
        </div>
        <div class="cas-hie-frame" data-hie-frame title="Arrastra para mover la imagen">
          <img data-hie-img alt="" draggable="false" />
          <span class="cas-hie-guide" aria-hidden="true"></span>
          <span class="cas-hie-chip" data-hie-chip></span>
        </div>
      </div>
    </div>
  </div>
  <p class="cas-hie-hint text-center !mt-2">Arrastra la imagen en la vista previa para moverla.</p>

  {/* 1 · Imagen */}
  <div class="cas-hie-sub">
    <div class="cas-hie-sub-title">
      <span><span class="cas-hie-num">1</span>Imagen</span>
      <span class="cas-hie-badge" data-hie-srcbadge></span>
    </div>

    <div class="cas-hie-inherit" data-hie-inherit-row hidden>
      <div class="min-w-0">
        <p class="text-sm text-stone-800 font-medium" data-hie-inherit-title>Usar la misma imagen que Web</p>
        <p class="text-xs text-stone-500 mt-0.5 leading-snug">Desactívalo para subir una imagen distinta solo para este dispositivo.</p>
      </div>
      <button type="button" role="switch" aria-checked="true" class="cas-toggle" data-hie-inherit aria-label="Usar la misma imagen que Web">
        <span class="cas-toggle-thumb" aria-hidden="true"></span>
      </button>
    </div>

    <div data-hie-upload="web">
      <ImageUpload name="hero_image_url" label="" bucket="covers" hint="Click o arrastra. Recomendado: 2400×1600px o más, horizontal." />
    </div>
    <div data-hie-upload="tablet" hidden>
      <ImageUpload name="hero_image_tablet_url" label="" bucket="covers" hint="Imagen solo para tablet. Recomendado: 1600×2000px o más." />
    </div>
    <div data-hie-upload="mobile" hidden>
      <ImageUpload name="hero_image_mobile_url" label="" bucket="covers" hint="Imagen solo para celular. Recomendado: 1200×1200px o más." />
    </div>
    <div class="cas-hie-inherited" data-hie-inherited hidden>
      <div class="cas-hie-thumb" data-hie-inherited-thumb></div>
      <p class="text-sm text-stone-600">Se está usando la imagen de <strong>Web</strong>.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2 mt-3">
      <button type="button" class="cas-hie-btn" data-hie-download>
        <Icon name="lucide:download" class="w-4 h-4" aria-hidden="true" />
        <span data-hie-download-label>Descargar imagen actual</span>
      </button>
      <span class="cas-hie-hint !m-0" data-hie-meta></span>
    </div>
  </div>

  {/* 2 · Ajuste */}
  <div class="cas-hie-sub">
    <div class="cas-hie-sub-title"><span><span class="cas-hie-num">2</span>Ajuste en el espacio</span></div>
    <div class="cas-hie-fits" role="radiogroup" aria-label="Ajuste de la imagen">
      {FITS.map((f) => (
        <button type="button" role="radio" class="cas-hie-fit" data-hie-fit={f.value} aria-checked="false">
          <svg viewBox="0 0 34 24" aria-hidden="true">
            <rect x="1" y="1" width="32" height="22" fill="none" stroke="currentColor" stroke-dasharray="2 2" />
            {f.value === "cover" && <rect x="-4" y="-3" width="42" height="30" fill="currentColor" opacity=".3" />}
            {f.value === "contain" && <rect x="8" y="1" width="18" height="22" fill="currentColor" opacity=".3" />}
            {f.value === "fill" && <><rect x="1" y="1" width="32" height="22" fill="currentColor" opacity=".3" /><path d="M6 12h22M6 12l3-3M6 12l3 3M28 12l-3-3M28 12l-3 3" stroke="currentColor" fill="none" /></>}
            {f.value === "none" && <rect x="11" y="7" width="12" height="10" fill="currentColor" opacity=".3" />}
          </svg>
          {f.label}
        </button>
      ))}
    </div>
    <p class="cas-hie-hint" data-hie-fithint></p>
  </div>

  {/* 3 · Posición */}
  <div class="cas-hie-sub">
    <div class="cas-hie-sub-title">
      <span><span class="cas-hie-num">3</span>Posición</span>
      <button type="button" class="cas-hie-mini" data-hie-center>Centrar</button>
    </div>
    <div class="flex items-center gap-5">
      <div class="cas-hie-posgrid" role="group" aria-label="Posición rápida">
        {POSITIONS.map(([x, y]) => (
          <button type="button" data-hie-pos={`${x},${y}`} title={`X ${x}% · Y ${y}%`} aria-label={`X ${x}%, Y ${y}%`}></button>
        ))}
      </div>
      <div class="flex-1 min-w-0 space-y-2">
        <label class="cas-hie-slider"><span>X</span><input type="range" min="0" max="100" step="1" data-hie-x aria-label="Posición horizontal" /><output data-hie-x-out></output></label>
        <label class="cas-hie-slider"><span>Y</span><input type="range" min="0" max="100" step="1" data-hie-y aria-label="Posición vertical" /><output data-hie-y-out></output></label>
      </div>
    </div>
  </div>

  {/* 4 · Tamaño */}
  <div class="cas-hie-sub">
    <div class="cas-hie-sub-title">
      <span><span class="cas-hie-num">4</span>Tamaño</span>
      <button type="button" class="cas-hie-mini" data-hie-zoom-reset>100%</button>
    </div>
    <label class="cas-hie-slider">
      <span><Icon name="lucide:zoom-in" class="w-3.5 h-3.5" aria-hidden="true" /></span>
      <input type="range" min="50" max="300" step="5" data-hie-zoom aria-label="Tamaño de la imagen" />
      <output data-hie-zoom-out></output>
    </label>
    <p class="cas-hie-hint">Agranda o achica la imagen dentro de su espacio, sin cambiar el diseño de la página.</p>
    <div class="mt-4" data-hie-ratio-box hidden>
      <span class="label">Alto del espacio en móvil</span>
      <div class="cas-hie-ratios" role="radiogroup" aria-label="Proporción en móvil">
        {RATIOS.map((r) => (
          <button type="button" role="radio" data-hie-ratio={r.value} aria-checked="false" title={r.title}>
            <span class="cas-hie-ratio-shape" style={`aspect-ratio: ${r.value.replace("/", " / ")}`}></span>
            <span>{r.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="cas-hie-sub cas-hie-sub--foot">
    <span class="cas-hie-hint !m-0" data-hie-summary></span>
    <button type="button" class="cas-hie-btn" data-hie-reset>
      <Icon name="lucide:rotate-ccw" class="w-4 h-4" aria-hidden="true" />
      Restablecer este dispositivo
    </button>
  </div>

  {/* Contenido adicional (color de fondo, imagen por defecto) */}
  <div class="cas-hie-sub">
    <slot />
  </div>

  <input type="hidden" name="hero_image_config" value="" data-hie-json />
</section>

<style>
  .cas-hie { padding: 0; }
  .cas-hie-head { display: flex; gap: 0.75rem; align-items: flex-start; padding: 1.5rem 1.5rem 1.25rem; border-bottom: 1px solid rgb(231 229 228); }
  .cas-hie-head .card-section-title { margin-bottom: 0.25rem; }
  .cas-hie-devbar { position: sticky; top: 0; z-index: 5; padding: 1rem 1.5rem; background: rgb(250 250 249); border-bottom: 1px solid rgb(231 229 228); }
  .cas-hie-tabs { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid rgb(214 211 209); background: #fff; }
  .cas-hie-tabs button { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.55rem 0.5rem; font-size: 0.875rem; color: rgb(68 64 60); cursor: pointer; transition: background-color 120ms; }
  .cas-hie-tabs button + button { border-left: 1px solid rgb(214 211 209); }
  .cas-hie-tabs button:hover { background: rgb(245 245 244); }
  .cas-hie-tabs button[aria-selected="true"] { background: rgb(28 25 23); color: #fff; }
  .cas-hie-dot { width: 6px; height: 6px; border-radius: 9999px; background: rgb(180 83 9); }
  .cas-hie-tabs button[aria-selected="true"] .cas-hie-dot { background: rgb(251 191 36); }
  .cas-hie-hint { font-size: 0.75rem; color: rgb(120 113 108); margin-top: 0.4rem; line-height: 1.35; }

  .cas-hie-stage { display: flex; align-items: center; justify-content: center; padding: 1.5rem; margin: 1.25rem 1.5rem 0; background: rgb(233 230 225); border: 1px solid rgb(231 229 228); min-height: 300px; }
  .cas-hie-device { position: relative; overflow: hidden; background: oklch(99% 0.003 70); box-shadow: 0 10px 30px rgb(0 0 0 / 0.16); border: 6px solid rgb(28 25 23); transition: width 220ms ease, height 220ms ease; }
  .cas-hie-device[data-device="web"] { width: min(100%, 520px); aspect-ratio: 16 / 9; border-radius: 6px; }
  .cas-hie-device[data-device="tablet"] { width: 240px; height: 320px; border-width: 8px; border-radius: 14px; }
  .cas-hie-device[data-device="mobile"] { width: 180px; height: 370px; border-width: 7px; border-radius: 22px; }
  .cas-hie-site { position: absolute; inset: 0; display: flex; }
  .cas-hie-device[data-device="mobile"] .cas-hie-site { flex-direction: column; overflow: hidden; }
  .cas-hie-copy { display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 7%; width: 50%; min-width: 0; }
  .cas-hie-device[data-device="mobile"] .cas-hie-copy { width: 100%; padding: 22px 14px 12px; }
  .cas-hie-copy-t { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 600; font-size: 18px; line-height: 1; color: oklch(20% 0.01 70); }
  .cas-hie-device[data-device="tablet"] .cas-hie-copy-t { font-size: 14px; }
  .cas-hie-copy-l { height: 4px; width: 80%; background: rgb(214 211 209); }
  .cas-hie-copy-l--s { width: 55%; }
  .cas-hie-copy-cta { margin-top: 4px; height: 12px; width: 60%; background: rgb(28 25 23); }
  .cas-hie-frame { position: relative; overflow: hidden; width: 50%; height: 100%; background: rgb(41 37 36); cursor: grab; touch-action: none; }
  .cas-hie-device[data-device="mobile"] .cas-hie-frame { width: 100%; height: auto; flex-shrink: 0; margin-top: 8px; }
  .cas-hie-frame.is-dragging { cursor: grabbing; }
  .cas-hie-frame img { position: absolute; inset: 0; width: 100%; height: 100%; user-select: none; pointer-events: none; }
  .cas-hie-guide { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 150ms; background-image: linear-gradient(rgb(255 255 255 / 0.35) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.35) 1px, transparent 1px); background-size: 33.333% 33.333%; }
  .cas-hie-frame:hover .cas-hie-guide, .cas-hie-frame.is-dragging .cas-hie-guide { opacity: 1; }
  .cas-hie-chip { position: absolute; left: 6px; bottom: 6px; background: rgb(28 25 23 / 0.75); color: #fff; font-size: 10px; padding: 2px 6px; pointer-events: none; white-space: nowrap; }

  .cas-hie-sub { padding: 1.25rem 1.5rem; }
  .cas-hie-sub + .cas-hie-sub { border-top: 1px solid rgb(231 229 228); }
  .cas-hie-stage + .cas-hie-hint + .cas-hie-sub { margin-top: 0.75rem; border-top: 1px solid rgb(231 229 228); }
  .cas-hie-sub--foot { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; background: rgb(250 250 249); }
  .cas-hie-sub-title { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.75rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600; color: rgb(68 64 60); }
  .cas-hie-num { display: inline-flex; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem; margin-right: 0.5rem; border: 1px solid rgb(214 211 209); font-size: 0.65rem; letter-spacing: 0; color: rgb(68 64 60); }
  .cas-hie-badge { text-transform: none; letter-spacing: 0; font-weight: 500; font-size: 0.75rem; color: rgb(120 113 108); }
  .cas-hie-mini { text-transform: none; letter-spacing: 0; font-weight: 500; font-size: 0.7rem; padding: 0.15rem 0.5rem; border: 1px solid rgb(214 211 209); background: #fff; cursor: pointer; color: rgb(41 37 36); }
  .cas-hie-mini:hover { background: rgb(245 245 244); }
  .cas-hie-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.75rem; font-size: 0.8125rem; border: 1px solid rgb(214 211 209); background: #fff; cursor: pointer; color: rgb(41 37 36); }
  .cas-hie-btn:hover { background: rgb(250 250 249); }
  .cas-hie-btn:disabled { opacity: 0.5; cursor: progress; }

  .cas-hie-inherit { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem; margin-bottom: 0.75rem; border: 1px solid rgb(231 229 228); background: rgb(250 250 249); }
  .cas-hie-inherited { display: flex; align-items: center; gap: 1rem; padding: 0.75rem; border: 1px solid rgb(231 229 228); }
  .cas-hie-thumb { width: 4rem; height: 4rem; flex-shrink: 0; background: rgb(245 245 244) center / cover no-repeat; border: 1px solid rgb(231 229 228); }

  .cas-hie-fits { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .cas-hie-fit { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.6rem 0.25rem 0.5rem; border: 1px solid rgb(214 211 209); background: #fff; font-size: 0.8rem; color: rgb(68 64 60); cursor: pointer; }
  .cas-hie-fit svg { width: 34px; height: 24px; }
  .cas-hie-fit:hover { background: rgb(250 250 249); }
  .cas-hie-fit[aria-checked="true"] { border-color: rgb(28 25 23); box-shadow: inset 0 0 0 1px rgb(28 25 23); color: rgb(28 25 23); font-weight: 600; }

  .cas-hie-posgrid { display: grid; grid-template-columns: repeat(3, 1.5rem); gap: 0.3rem; flex-shrink: 0; }
  .cas-hie-posgrid button { width: 1.5rem; height: 1.5rem; display: flex; align-items: center; justify-content: center; border: 1px solid rgb(214 211 209); background: #fff; cursor: pointer; }
  .cas-hie-posgrid button::after { content: ""; width: 6px; height: 6px; border-radius: 9999px; background: rgb(214 211 209); }
  .cas-hie-posgrid button[aria-pressed="true"] { border-color: rgb(28 25 23); }
  .cas-hie-posgrid button[aria-pressed="true"]::after { background: rgb(28 25 23); }

  .cas-hie-slider { display: grid; grid-template-columns: 1.1rem 1fr 3rem; align-items: center; gap: 0.6rem; font-size: 0.75rem; color: rgb(120 113 108); }
  .cas-hie-slider input { width: 100%; accent-color: rgb(28 25 23); }
  .cas-hie-slider output { text-align: right; color: rgb(41 37 36); font-variant-numeric: tabular-nums; }

  .cas-hie-ratios { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .cas-hie-ratios button { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.55rem 0.25rem; border: 1px solid rgb(214 211 209); background: #fff; font-size: 0.75rem; color: rgb(68 64 60); cursor: pointer; }
  .cas-hie-ratios button[aria-checked="true"] { border-color: rgb(28 25 23); box-shadow: inset 0 0 0 1px rgb(28 25 23); color: rgb(28 25 23); font-weight: 600; }
  .cas-hie-ratio-shape { display: block; height: 22px; max-width: 40px; border: 1.5px solid currentColor; opacity: 0.6; }

  @media (max-width: 640px) {
    .cas-hie-head, .cas-hie-devbar, .cas-hie-sub { padding-left: 1rem; padding-right: 1rem; }
    .cas-hie-stage { margin-left: 1rem; margin-right: 1rem; padding: 1rem; }
    .cas-hie-fits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script is:inline>
  (() => {

  const DEVICES = ["web", "tablet", "mobile"];
  const FITS = ["cover", "contain", "fill", "none"];
  const RATIOS = ["1/1", "4/5", "4/3", "16/9"];
  const LABEL = { web: "Web", tablet: "Tablet", mobile: "Móvil" };
  const FIT_LABEL = { cover: "Rellenar", contain: "Completa", fill: "Estirar", none: "Original" };
  const DEV_HINT = {
    web: "Aplica a computadores (1024 px o más). Tablet y Móvil usan esta configuración hasta que los cambies.",
    tablet: "Aplica a tablets (768–1023 px). La imagen ocupa la mitad derecha de la pantalla.",
    mobile: "Aplica a celulares (menos de 768 px). La imagen va debajo del texto.",
  };
  const FIT_HINT = {
    cover: "Llena todo el espacio; puede recortar los bordes.",
    contain: "Muestra la imagen completa; puede dejar franjas con el color de fondo.",
    fill: "Deforma la imagen para llenar el espacio exacto.",
    none: "Tamaño real de la imagen, sin escalar.",
  };

  const defDevice = () => ({ inherit_image: true, image_url: "", fit: "cover", x: 50, y: 50, zoom: 100, ratio: "4/3" });
  const clamp = (v, min, max, d) => {
    const n = typeof v === "number" ? v : Number(v);
    return Number.isFinite(n) ? Math.min(max, Math.max(min, Math.round(n))) : d;
  };
  const normDevice = (raw) => {
    const r = (raw && typeof raw === "object" ? raw : {});
    const d = defDevice();
    return {
      inherit_image: r.inherit_image === false ? false : true,
      image_url: typeof r.image_url === "string" ? r.image_url.trim() : "",
      fit: FITS.includes(r.fit) ? r.fit : d.fit,
      x: clamp(r.x, 0, 100, d.x),
      y: clamp(r.y, 0, 100, d.y),
      zoom: clamp(r.zoom, 50, 300, d.zoom),
      ratio: RATIOS.includes(r.ratio) ? r.ratio : d.ratio,
    };
  };
  const norm = (raw) => {
    const r = (raw && typeof raw === "object" ? raw : {});
    return {
      web: { ...normDevice(r.web), inherit_image: false, image_url: "" },
      tablet: normDevice(r.tablet),
      mobile: normDevice(r.mobile),
    };
  };
  const isCustom = (c) =>
    !c.inherit_image || c.fit !== "cover" || c.x !== 50 || c.y !== 50 || c.zoom !== 100;

  const root = document.querySelector("[data-hero-image-editor]");
  if (root && !root.__casHieSet) {
    const q = (sel) => root.querySelector(sel);
    const qa = (sel) => Array.from(root.querySelectorAll(sel));
    const fallbackUrl = root.dataset.fallbackUrl || "";
    const jsonInput = q("[data-hie-json]");
    const uploadInput = (d) =>
      root.querySelector(`[data-hie-upload="${d}"] input[type="hidden"]`);

    let cfg = norm(null);
    let device = "web";

    const webUrl = () => (uploadInput("web")?.value || "").trim();
    const effectiveUrl = (d) => {
      const c = cfg[d];
      if (d !== "web" && !c.inherit_image && c.image_url) return c.image_url;
      return webUrl() || fallbackUrl;
    };

    const writeJson = (dirty) => {
      jsonInput.value = JSON.stringify(cfg);
      if (dirty) {
        root.dispatchEvent(new CustomEvent("cas:dirty", { bubbles: true }));
      }
      root.dispatchEvent(new CustomEvent("cas:heroimage:change", { bubbles: true, detail: { config: cfg } }));
    };

    const metaCache = new Map();
    const showMeta = (url) => {
      const meta = q("[data-hie-meta]");
      if (metaCache.has(url)) { meta.textContent = metaCache.get(url); return; }
      meta.textContent = "";
      const probe = new Image();
      probe.onload = () => {
        const txt = `${probe.naturalWidth} × ${probe.naturalHeight} px`;
        metaCache.set(url, txt);
        if (effectiveUrl(device) === url) meta.textContent = txt;
      };
      probe.src = url;
    };

    const render = () => {
      const c = cfg[device];
      const url = effectiveUrl(device);

      qa("[data-hie-device]").forEach((b) => {
        const d = b.dataset.hieDevice;
        b.setAttribute("aria-selected", String(d === device));
        const dot = b.querySelector("[data-hie-dot]");
        if (dot) dot.hidden = d === "web" || !isCustom(cfg[d]);
      });
      q("[data-hie-devhint]").textContent = DEV_HINT[device];

      // 1 · Imagen
      const inheritRow = q("[data-hie-inherit-row]");
      inheritRow.hidden = device === "web";
      const sw = q("[data-hie-inherit]");
      sw.setAttribute("aria-checked", String(c.inherit_image));
      DEVICES.forEach((d) => {
        q(`[data-hie-upload="${d}"]`).hidden = !(d === device && (d === "web" || !c.inherit_image));
      });
      const inherited = q("[data-hie-inherited]");
      inherited.hidden = device === "web" || !c.inherit_image;
      q("[data-hie-inherited-thumb]").style.backgroundImage = `url('${(webUrl() || fallbackUrl).replace(/'/g, "%27")}')`;
      q("[data-hie-srcbadge]").textContent =
        device === "web"
          ? (webUrl() ? "Imagen principal" : "Usando la imagen por defecto")
          : c.inherit_image ? "Heredada de Web" : `Imagen propia de ${LABEL[device]}`;
      showMeta(url);

      // 2 · Ajuste
      qa("[data-hie-fit]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.hieFit === c.fit)));
      q("[data-hie-fithint]").textContent = FIT_HINT[c.fit];

      // 3 · Posición
      q("[data-hie-x]").value = String(c.x);
      q("[data-hie-y]").value = String(c.y);
      q("[data-hie-x-out]").textContent = `${c.x}%`;
      q("[data-hie-y-out]").textContent = `${c.y}%`;
      qa("[data-hie-pos]").forEach((b) => {
        const [x, y] = (b.dataset.hiePos || "").split(",").map(Number);
        b.setAttribute("aria-pressed", String(x === c.x && y === c.y));
      });

      // 4 · Tamaño
      q("[data-hie-zoom]").value = String(c.zoom);
      q("[data-hie-zoom-out]").textContent = `${c.zoom}%`;
      q("[data-hie-ratio-box]").hidden = device !== "mobile";
      qa("[data-hie-ratio]").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.hieRatio === c.ratio)));

      q("[data-hie-summary]").textContent =
        device === "web"
          ? "Tablet y Móvil usan esta configuración salvo que la cambies allí."
          : c.inherit_image
            ? `Misma imagen que Web; encuadre propio de ${LABEL[device]}.`
            : `Imagen distinta solo para ${LABEL[device]}.`;

      // Vista previa
      const preview = q("[data-hie-preview]");
      preview.dataset.device = device;
      const frame = q("[data-hie-frame]");
      frame.style.aspectRatio = device === "mobile" ? c.ratio.replace("/", " / ") : "";
      const img = q("[data-hie-img]");
      if (img.getAttribute("src") !== url) img.src = url;
      img.style.objectFit = c.fit;
      img.style.objectPosition = `${c.x}% ${c.y}%`;
      img.style.transformOrigin = `${c.x}% ${c.y}%`;
      img.style.transform = c.zoom === 100 ? "" : `scale(${c.zoom / 100})`;
      q("[data-hie-chip]").textContent = `${FIT_LABEL[c.fit]} · ${c.x}% ${c.y}% · ${c.zoom}%`;
    };

    const update = (patch) => {
      cfg[device] = { ...cfg[device], ...patch };
      render();
      writeJson(true);
    };

    // Tabs
    qa("[data-hie-device]").forEach((b) =>
      b.addEventListener("click", () => { device = b.dataset.hieDevice; render(); }),
    );
    // Heredar imagen
    q("[data-hie-inherit]").addEventListener("click", () => {
      const next = !cfg[device].inherit_image;
      update({ inherit_image: next });
    });
    // Fit / posición / zoom / ratio
    qa("[data-hie-fit]").forEach((b) => b.addEventListener("click", () => update({ fit: b.dataset.hieFit })));
    qa("[data-hie-pos]").forEach((b) => b.addEventListener("click", () => {
      const [x, y] = (b.dataset.hiePos || "50,50").split(",").map(Number);
      update({ x, y });
    }));
    q("[data-hie-x]").addEventListener("input", (e) => update({ x: Number(e.target.value) }));
    q("[data-hie-y]").addEventListener("input", (e) => update({ y: Number(e.target.value) }));
    q("[data-hie-center]").addEventListener("click", () => update({ x: 50, y: 50 }));
    q("[data-hie-zoom]").addEventListener("input", (e) => update({ zoom: Number(e.target.value) }));
    q("[data-hie-zoom-reset]").addEventListener("click", () => update({ zoom: 100 }));
    qa("[data-hie-ratio]").forEach((b) => b.addEventListener("click", () => update({ ratio: b.dataset.hieRatio })));
    q("[data-hie-reset]").addEventListener("click", () => {
      const keepUrl = cfg[device].image_url;
      cfg[device] = device === "web"
        ? { ...defDevice(), inherit_image: false }
        : { ...defDevice(), image_url: keepUrl };
      if (device !== "web") {
        const input = uploadInput(device);
        if (input) input.value = keepUrl;
      }
      render();
      writeJson(true);
    });

    // Subidas de imagen (Web / Tablet / Móvil)
    document.addEventListener("cas:imageupload:change", (e) => {
      const name = e.detail?.name;
      const url = (e.detail?.url || "").trim();
      if (name === "hero_image_tablet_url") cfg.tablet.image_url = url;
      else if (name === "hero_image_mobile_url") cfg.mobile.image_url = url;
      else if (name !== "hero_image_url") return;
      render();
      writeJson(false);
    });

    // Descargar la imagen actual del dispositivo seleccionado
    const dlBtn = q("[data-hie-download]");
    const dlLabel = q("[data-hie-download-label]");
    dlBtn.addEventListener("click", async () => {
      const url = effectiveUrl(device);
      if (!url) return;
      const fromPath = decodeURIComponent(new URL(url, location.href).pathname.split("/").pop() || "");
      const baseName = /\.[a-z0-9]{2,5}$/i.test(fromPath) ? fromPath : `hero-${device}.jpg`;
      dlBtn.disabled = true;
      dlLabel.textContent = "Descargando…";
      try {
        const res = await fetch(url, { mode: "cors" });
        if (!res.ok) throw new Error(String(res.status));
        const blob = await res.blob();
        const href = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = href;
        a.download = baseName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(href), 2000);
      } catch {
        // Si el servidor de la imagen no permite descargarla directo,
        // la abrimos en otra pestaña para guardarla desde allí.
        window.open(url, "_blank", "noopener");
      } finally {
        dlBtn.disabled = false;
        dlLabel.textContent = "Descargar imagen actual";
      }
    });

    // Arrastrar dentro de la vista previa
    const frame = q("[data-hie-frame]");
    let drag = null;
    frame.addEventListener("pointerdown", (e) => {
      frame.setPointerCapture(e.pointerId);
      frame.classList.add("is-dragging");
      drag = { px: e.clientX, py: e.clientY, x: cfg[device].x, y: cfg[device].y };
    });
    frame.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const r = frame.getBoundingClientRect();
      // Arrastrar a la derecha muestra más del lado izquierdo (X baja).
      const SPEED = 1.5;
      const nx = clamp(drag.x - ((e.clientX - drag.px) / r.width) * 100 * SPEED, 0, 100, 50);
      const ny = clamp(drag.y - ((e.clientY - drag.py) / r.height) * 100 * SPEED, 0, 100, 50);
      if (nx !== cfg[device].x || ny !== cfg[device].y) update({ x: nx, y: ny });
    });
    const endDrag = () => { drag = null; frame.classList.remove("is-dragging"); };
    frame.addEventListener("pointerup", endDrag);
    frame.addEventListener("pointercancel", endDrag);

    // API para site.astro (hidratación con los valores del servidor).
    root.__casHieSet = (raw) => {
      cfg = norm(raw);
      ["tablet", "mobile"].forEach((d) => {
        const input = uploadInput(d);
        const wrapper = input?.closest("[data-image-upload]");
        if (wrapper?.__casSetImage) wrapper.__casSetImage(cfg[d].image_url);
        else if (input) input.value = cfg[d].image_url;
      });
      render();
      writeJson(false);
    };
    root.__casHieGet = () => cfg;

    render();
    writeJson(false);
  }
  })();
</script>
