---
// Inline icon picker — a searchable grid of lucide icons. Used by
// the category form to associate a glyph with each category.
//
// Submits as a regular form field: writes the chosen icon name
// (e.g. "feather") into a hidden <input name={name}>. No JS framework.
import { Icon } from "astro-icon/components";
import { CATEGORY_ICONS } from "~/lib/category-icons";

interface Props {
  name: string;
  value?: string | null;
  /** Optional aria label / search placeholder. */
  placeholder?: string;
}
const { name, value = null, placeholder = "Buscar icono…" } = Astro.props;
const safe = (value ?? "").replace(/^lucide:/, "");
---

<div class="cas-icon-picker" data-icon-picker>
  <input type="hidden" name={name} value={safe} data-icon-picker-input />

  <div class="cas-icon-picker-toolbar">
    <div class="cas-icon-picker-current">
      <span class="cas-icon-picker-current-thumb" data-icon-picker-thumb>
        {safe && (
          <Icon name={`lucide:${safe}`} class="w-5 h-5" aria-hidden="true" />
        )}
      </span>
      <span class="cas-icon-picker-current-label" data-icon-picker-label>
        {safe || "Sin icono"}
      </span>
      <button
        type="button"
        class="cas-icon-picker-clear"
        data-icon-picker-clear
        aria-label="Quitar icono"
        hidden={!safe}
      >Quitar</button>
    </div>
    <div class="cas-icon-picker-search-wrap">
      <svg
        class="cas-icon-picker-search-icon"
        width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        type="text"
        class="cas-icon-picker-search"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
        data-icon-picker-search
      />
    </div>
  </div>

  <div class="cas-icon-picker-grid" data-icon-picker-grid>
    {CATEGORY_ICONS.map((iconName) => (
      <button
        type="button"
        class:list={[
          "cas-icon-picker-cell",
          iconName === safe && "cas-icon-picker-cell-active",
        ]}
        data-icon-name={iconName}
        title={iconName}
        aria-label={iconName}
        aria-pressed={iconName === safe ? "true" : "false"}
      >
        <Icon name={`lucide:${iconName}`} class="w-5 h-5" aria-hidden="true" />
      </button>
    ))}
    <p class="cas-icon-picker-empty hidden" data-icon-picker-empty>Sin resultados.</p>
  </div>
</div>

<style is:global>
  .cas-icon-picker {
    display: block;
  }
  .cas-icon-picker-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .cas-icon-picker-current {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid #e7e5e4;
    background: #fafaf9;
    font-size: 0.8rem;
    color: #1c1917;
  }
  .cas-icon-picker-current-thumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: #1c1917;
  }
  .cas-icon-picker-current-thumb svg {
    width: 18px;
    height: 18px;
  }
  .cas-icon-picker-current-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: #57534e;
  }
  .cas-icon-picker-clear {
    cursor: pointer;
    background: transparent;
    border: 0;
    padding: 0 0.25rem;
    color: #78716c;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cas-icon-picker-clear:hover {
    color: #1c1917;
  }
  .cas-icon-picker-clear[hidden] {
    display: none;
  }
  .cas-icon-picker-search-wrap {
    position: relative;
    flex: 1 1 200px;
  }
  .cas-icon-picker-search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #a8a29e;
    pointer-events: none;
  }
  .cas-icon-picker-search {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2rem;
    border: 1px solid #d6d3d1;
    background: #fff;
    font-size: 0.875rem;
    color: #1c1917;
    outline: none;
    transition: border-color 0.15s;
  }
  .cas-icon-picker-search:focus {
    border-color: #1c1917;
  }
  .cas-icon-picker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
    gap: 4px;
    max-height: 16rem;
    overflow-y: auto;
    padding: 8px;
    border: 1px solid #e7e5e4;
    background: #fff;
  }
  .cas-icon-picker-cell {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid transparent;
    background: transparent;
    color: #44403c;
    transition: background 0.1s, border-color 0.1s, color 0.1s;
  }
  .cas-icon-picker-cell:hover {
    background: #f5f5f4;
    color: #1c1917;
  }
  .cas-icon-picker-cell-active {
    background: #1c1917;
    color: #fff;
    border-color: #1c1917;
  }
  .cas-icon-picker-cell-active:hover {
    background: #1c1917;
    color: #fff;
  }
  .cas-icon-picker-empty {
    grid-column: 1 / -1;
    padding: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: #78716c;
  }
  .cas-icon-picker-empty.hidden {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    if (window.__casIconPickerInit) return;
    window.__casIconPickerInit = true;

    const normalize = (s) =>
      String(s ?? "").toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");

    const setValue = (picker, iconName) => {
      const input = picker.querySelector("[data-icon-picker-input]");
      const label = picker.querySelector("[data-icon-picker-label]");
      const thumb = picker.querySelector("[data-icon-picker-thumb]");
      const clear = picker.querySelector("[data-icon-picker-clear]");
      const cells = picker.querySelectorAll("[data-icon-name]");
      if (input) input.value = iconName ?? "";
      if (label) label.textContent = iconName || "Sin icono";
      // Copy the SVG from the chosen cell into the toolbar thumb. The
      // cell's <svg> was already prerendered by astro-icon, so this
      // doesn't need iconify at runtime.
      if (thumb) {
        if (iconName) {
          const src = picker.querySelector(`[data-icon-name="${iconName}"] svg`);
          thumb.innerHTML = src ? src.outerHTML : "";
        } else {
          thumb.innerHTML = "";
        }
      }
      if (clear) {
        if (iconName) clear.removeAttribute("hidden");
        else clear.setAttribute("hidden", "");
      }
      cells.forEach((c) => {
        const on = c.getAttribute("data-icon-name") === iconName;
        c.classList.toggle("cas-icon-picker-cell-active", on);
        c.setAttribute("aria-pressed", on ? "true" : "false");
      });
      // Hidden inputs don't fire input/change on programmatic writes.
      // Notify FormActions so the Guardar button can flip dirty.
      picker.dispatchEvent(new CustomEvent("cas:dirty", { bubbles: true }));
    };

    document.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const cell = t.closest("[data-icon-name]");
      if (cell) {
        const picker = cell.closest("[data-icon-picker]");
        if (!picker) return;
        setValue(picker, cell.getAttribute("data-icon-name"));
        return;
      }
      if (t.closest("[data-icon-picker-clear]")) {
        const picker = t.closest("[data-icon-picker]");
        if (!picker) return;
        setValue(picker, null);
      }
    });

    document.addEventListener("input", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement)) return;
      if (!t.matches("[data-icon-picker-search]")) return;
      const picker = t.closest("[data-icon-picker]");
      if (!picker) return;
      const q = normalize(t.value.trim());
      let visible = 0;
      picker.querySelectorAll("[data-icon-name]").forEach((cell) => {
        const text = normalize(cell.getAttribute("data-icon-name") || "");
        const match = !q || text.includes(q);
        cell.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      const empty = picker.querySelector("[data-icon-picker-empty]");
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    });
  })();
</script>
