---
interface Props {
  label: string;
  name: string;
  type?: string;
  value?: string | number | null;
  required?: boolean;
  placeholder?: string;
  hint?: string;
  // Longer description shown beneath the label (in addition to / instead of hint).
  description?: string;
  rows?: number;
}
const {
  label,
  name,
  type = "text",
  value,
  required,
  placeholder,
  hint,
  description,
  rows,
} = Astro.props;
---

<div class="block min-w-0">
  <label for={`f-${name}`} class="block">
    <span class="label">{label}{required && <span class="text-stone-400 font-normal"> *</span>}</span>
  </label>
  {type === "textarea" ? (
    <textarea
      id={`f-${name}`}
      name={name}
      class="input"
      rows={rows ?? 4}
      required={required}
      placeholder={placeholder}
      set:html={value ?? ""}
    />
  ) : (
    <input
      id={`f-${name}`}
      type={type}
      name={name}
      class="input"
      value={value ?? ""}
      required={required}
      placeholder={placeholder}
    />
  )}
  {description && (
    <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">{description}</p>
  )}
  {hint && <p class="text-xs text-stone-500 mt-1.5">{hint}</p>}
</div>
