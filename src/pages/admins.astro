---
import AppLayout from "~/layouts/AppLayout.astro";
import { requireOwner, RESOURCES, RESOURCE_LABEL, invalidateAuthCache } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

// SSR: only auth gate + POST handling. Admin list hydrates from /api/page-data?type=admins.
const guard = await requireOwner(Astro);
if (guard instanceof Response) return guard;
const owner = guard;

let formError: string | null = null;
let saved: string | null = null;

if (Astro.request.method === "POST") {
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");

    if (action === "set_permission") {
      const profileId = strReq(fd, "profile_id");
      const resource = strReq(fd, "resource");
      const level = strReq(fd, "level");
      if (!(RESOURCES as readonly string[]).includes(resource)) throw new Error("recurso inválido");
      if (!["none", "view", "edit"].includes(level)) throw new Error("nivel inválido");
      const { error } = await supabase
        .from("admin_permissions")
        .upsert({ profile_id: profileId, resource, level }, { onConflict: "profile_id,resource" });
      if (error) throw error;
      // Bust the in-memory permissions cache for this admin so the change
      // is visible immediately on subsequent navigations.
      invalidateAuthCache(Astro, profileId);
      saved = "Permiso actualizado.";
    } else if (action === "add_email") {
      const email = strReq(fd, "email").trim().toLowerCase();
      const note = str(fd, "note");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error("email inválido");
      const { error } = await supabase
        .from("admin_emails")
        .insert({ email, note, added_by: owner.id });
      if (error) throw error;
      saved = `Email pre-aprobado: ${email}`;
    } else if (action === "remove_admin") {
      const email = strReq(fd, "email").toLowerCase();
      if (email === owner.email.toLowerCase()) throw new Error("no puedes quitarte a ti mismo");
      const { error } = await supabase
        .from("admin_emails")
        .delete()
        .eq("email", email);
      if (error) throw error;
      saved = `Acceso revocado: ${email}`;
    } else {
      throw new Error("acción desconocida");
    }
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Pass static config (resources + labels) to client for rendering.
const RESOURCE_LABELS_JSON = JSON.stringify(RESOURCE_LABEL);
---

<AppLayout title="Administradores">
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Administradores</h1>
  <p class="text-stone-500 mb-8">Quién puede entrar al CMS y qué puede tocar.</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {saved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">{saved}</p>
  )}

  <div data-admins-root data-resource-labels={RESOURCE_LABELS_JSON}>
    <h2 class="font-serif text-xl mt-2 mb-4">Activos</h2>

    {/* Skeleton rows for active admins */}
    <div data-admins-active-skeleton class="space-y-5 mb-12 max-w-5xl">
      {Array.from({ length: 2 }).map(() => (
        <div class="card animate-pulse">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-full bg-stone-200"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 bg-stone-200 rounded w-1/3"></div>
              <div class="h-3 bg-stone-100 rounded w-1/2"></div>
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            {Array.from({ length: 5 }).map(() => (
              <div class="h-9 bg-stone-100 rounded"></div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div data-admins-active class="hidden space-y-5 mb-12 max-w-5xl"></div>

    <div data-admins-pending class="hidden mb-12 max-w-5xl"></div>
  </div>

  <h2 class="font-serif text-xl mb-4">Pre-aprobar nuevo email</h2>
  <form method="POST" class="card border-dashed border-2 max-w-3xl space-y-4">
    <div>
      <h3 class="card-section-title text-base">Agregar a la allowlist</h3>
      <p class="card-section-desc">El nuevo admin entra con todos los permisos en "sin acceso". Una vez se loguee por primera vez, podrás darle permisos por sección desde la lista de arriba.</p>
    </div>
    <input type="hidden" name="_action" value="add_email" />
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
      <div class="sm:col-span-5">
        <label class="block">
          <span class="label">Email de Google</span>
          <input class="input" type="email" name="email" placeholder="alguien@dominio.com" required />
        </label>
      </div>
      <div class="sm:col-span-5">
        <label class="block">
          <span class="label">Nota (opcional)</span>
          <input class="input" type="text" name="note" placeholder="Rol o quién es esta persona" />
        </label>
      </div>
      <div class="sm:col-span-2 flex justify-end">
        <button class="btn-primary w-full sm:w-auto">Agregar</button>
      </div>
    </div>
  </form>
</AppLayout>

<script is:inline>
  (() => {
    if (window.__casAdminsInit) return;
    window.__casAdminsInit = true;

    const escape = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    const initials = (s, fallback) =>
      ((s ?? fallback ?? "").trim().split(/\s+/).slice(0, 2).map((p) => p[0]).join("") || "?").toUpperCase();

    const RESOURCES = ["posts", "books", "authors", "categories", "site"];
    const LEVELS = [
      { value: "none", label: "Sin acceso" },
      { value: "view", label: "Ver" },
      { value: "edit", label: "Editar" },
    ];

    const renderProfile = (p, perms, ownerId) => {
      const isSelf = p.id === ownerId;
      const isOwnerRow = p.role === "owner";
      const root = document.querySelector("[data-admins-root]");
      const labels = JSON.parse(root.dataset.resourceLabels || "{}");

      const avatar = p.avatar_url
        ? `<img src="${escape(p.avatar_url)}" alt="" referrerpolicy="no-referrer" class="w-12 h-12 rounded-full object-cover shrink-0 border border-stone-200" />`
        : `<div class="w-12 h-12 rounded-full bg-stone-200 shrink-0 flex items-center justify-center text-stone-700 text-sm font-medium">${escape(initials(p.full_name, p.email))}</div>`;

      const removeBtn = (!isOwnerRow && !isSelf) ? `
        <form method="POST" onsubmit="return confirm('¿Revocar acceso de ${escape(p.email)}?')">
          <input type="hidden" name="_action" value="remove_admin" />
          <input type="hidden" name="email" value="${escape(p.email)}" />
          <button class="btn-danger text-xs">Revocar acceso</button>
        </form>` : "";

      // Encode the original permission state on the card so we can detect
      // changes client-side without losing it on re-renders.
      const originalPerms = JSON.stringify(perms);

      const permsBlocks = RESOURCES.map((r) => {
        const opts = LEVELS.map(
          (lv) => `<option value="${lv.value}"${perms[r] === lv.value ? " selected" : ""}>${lv.label}</option>`
        ).join("");
        return `
          <div class="flex flex-col">
            <label class="text-[11px] uppercase tracking-[0.12em] text-stone-500 mb-1.5">${escape(labels[r] ?? r)}</label>
            <select name="level_${r}" data-resource="${r}" class="input"${isOwnerRow ? " disabled" : ""}>${opts}</select>
          </div>`;
      }).join("");

      const ownerNote = isOwnerRow
        ? `<p class="text-xs text-stone-400 mt-3 italic">El owner siempre tiene acceso completo a todas las secciones.</p>`
        : "";

      const saveBar = !isOwnerRow ? `
        <div class="flex items-center justify-end gap-3 mt-4 pt-4 border-t border-stone-100" data-perms-savebar>
          <span class="text-xs text-stone-500 hidden" data-perms-status>Sin cambios pendientes.</span>
          <button type="button" class="btn cursor-pointer hidden" data-perms-revert>Descartar</button>
          <button type="submit" class="btn-primary" disabled data-perms-save>Guardar cambios</button>
        </div>` : "";

      return `
        <form class="card" data-perms-form data-profile-id="${escape(p.id)}" data-original='${escape(originalPerms)}'>
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
            <div class="flex items-start gap-4 min-w-0">
              ${avatar}
              <div class="min-w-0">
                <p class="font-medium text-stone-900 truncate">${escape(p.full_name ?? p.email)}</p>
                <p class="text-xs text-stone-500 truncate">${escape(p.email)}</p>
                <p class="text-[10px] uppercase tracking-[0.12em] text-stone-400 mt-1">
                  ${isOwnerRow ? "Owner" : "Admin"}${isSelf ? " · tú" : ""}
                </p>
              </div>
            </div>
            ${removeBtn}
          </div>
          <p class="text-xs text-stone-500 mb-3 uppercase tracking-[0.12em]">Permisos por sección</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">${permsBlocks}</div>
          ${ownerNote}
          ${saveBar}
        </form>`;
    };

    // ── Detect-changes + save handler ──
    const decodeOriginal = (form) => {
      try {
        const raw = form.dataset.original || "{}";
        // Astro double-escapes; decode HTML entities back to JSON.
        const txt = document.createElement("textarea");
        txt.innerHTML = raw;
        return JSON.parse(txt.value);
      } catch {
        return {};
      }
    };

    const collectCurrent = (form) => {
      const cur = {};
      form.querySelectorAll("select[data-resource]").forEach((sel) => {
        cur[sel.dataset.resource] = sel.value;
      });
      return cur;
    };

    const diffPerms = (original, current) => {
      const changes = {};
      let count = 0;
      for (const k of Object.keys(current)) {
        if (current[k] !== original[k]) {
          changes[k] = current[k];
          count++;
        }
      }
      return { changes, count };
    };

    const updateSaveBar = (form) => {
      const saveBtn = form.querySelector("[data-perms-save]");
      const revertBtn = form.querySelector("[data-perms-revert]");
      const status = form.querySelector("[data-perms-status]");
      if (!saveBtn) return; // owner row has no savebar
      const original = decodeOriginal(form);
      const current = collectCurrent(form);
      const { count } = diffPerms(original, current);
      saveBtn.disabled = count === 0;
      revertBtn?.classList.toggle("hidden", count === 0);
      if (status) {
        status.classList.toggle("hidden", count === 0);
        status.textContent = count === 0
          ? ""
          : `${count} ${count === 1 ? "cambio sin guardar" : "cambios sin guardar"}`;
        status.classList.toggle("text-amber-700", count > 0);
        status.classList.toggle("font-medium", count > 0);
      }
    };

    const submitPerms = async (form) => {
      const profileId = form.dataset.profileId;
      const original = decodeOriginal(form);
      const current = collectCurrent(form);
      const { changes, count } = diffPerms(original, current);
      if (count === 0 || !profileId) return;

      const saveBtn = form.querySelector("[data-perms-save]");
      const revertBtn = form.querySelector("[data-perms-revert]");
      const status = form.querySelector("[data-perms-status]");
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = "Guardando…";
      }
      try {
        const res = await fetch("/api/admins/permissions", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ profileId, permissions: changes }),
        });
        if (!res.ok) throw new Error("http_" + res.status);
        // Update original snapshot to current — no more pending changes.
        form.dataset.original = JSON.stringify(current);
        if (status) {
          status.classList.remove("hidden", "text-amber-700");
          status.classList.add("text-green-700", "font-medium");
          status.textContent = "Cambios guardados.";
          setTimeout(() => {
            status.classList.add("hidden");
            status.classList.remove("text-green-700", "font-medium");
          }, 2500);
        }
      } catch (err) {
        if (status) {
          status.classList.remove("hidden");
          status.classList.add("text-red-700", "font-medium");
          status.textContent = "No se pudo guardar. Intenta de nuevo.";
        }
      } finally {
        if (saveBtn) saveBtn.textContent = "Guardar cambios";
        updateSaveBar(form);
      }
    };

    const revertPerms = (form) => {
      const original = decodeOriginal(form);
      form.querySelectorAll("select[data-resource]").forEach((sel) => {
        if (original[sel.dataset.resource] != null) sel.value = original[sel.dataset.resource];
      });
      updateSaveBar(form);
    };

    const wirePermsForm = (form) => {
      if (form.dataset.casWired) return;
      form.dataset.casWired = "1";
      form.addEventListener("change", (e) => {
        const t = e.target;
        if (t instanceof HTMLSelectElement && t.dataset.resource) {
          updateSaveBar(form);
        }
      });
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        submitPerms(form);
      });
      form.addEventListener("click", (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest("[data-perms-revert]")) {
          e.preventDefault();
          revertPerms(form);
        }
      });
      // Initialize state.
      updateSaveBar(form);
    };

    const renderPending = (pending) => {
      const container = document.querySelector("[data-admins-pending]");
      if (!container) return;
      if (!pending || pending.length === 0) {
        container.classList.add("hidden");
        container.innerHTML = "";
        return;
      }
      const rows = pending.map((e) => `
        <tr class="border-t border-stone-100">
          <td class="px-4 py-3">${escape(e.email)}</td>
          <td class="px-4 py-3 text-stone-600">${escape(e.note ?? "—")}</td>
          <td class="px-4 py-3 text-stone-500 text-xs">${new Date(e.added_at).toLocaleDateString()}</td>
          <td class="px-4 py-3 text-right">
            <form method="POST" onsubmit="return confirm('¿Quitar ${escape(e.email)} de la lista?')">
              <input type="hidden" name="_action" value="remove_admin" />
              <input type="hidden" name="email" value="${escape(e.email)}" />
              <button class="cursor-pointer text-xs text-red-700 hover:underline">Quitar</button>
            </form>
          </td>
        </tr>`).join("");
      container.innerHTML = `
        <h2 class="font-serif text-xl mb-4">Pre-aprobados</h2>
        <p class="text-sm text-stone-500 mb-4 max-w-2xl">
          Estos correos pueden iniciar sesión en el CMS, pero aún no se han logueado por primera vez. Cuando lo hagan aparecerán arriba.
        </p>
        <div class="card p-0 overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-stone-50 text-xs uppercase tracking-[0.12em] text-stone-600">
              <tr>
                <th class="text-left px-4 py-3 font-semibold">Email</th>
                <th class="text-left px-4 py-3 font-semibold">Nota</th>
                <th class="text-left px-4 py-3 font-semibold">Agregado</th>
                <th class="px-4 py-3"></th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>`;
      container.classList.remove("hidden");
    };

    const cacheKey = "cas:admins";
    const TTL = 60_000;

    const render = (data) => {
      const root = document.querySelector("[data-admins-root]");
      if (!root) return;
      const skeleton = root.querySelector("[data-admins-active-skeleton]");
      const list = root.querySelector("[data-admins-active]");

      const profiles = data.profiles ?? [];
      const permRows = data.permRows ?? [];

      const permsByProfile = new Map();
      for (const p of profiles) {
        const initial = { posts: "none", books: "none", authors: "none", categories: "none", site: "none" };
        if (p.role === "owner") for (const r of RESOURCES) initial[r] = "edit";
        permsByProfile.set(p.id, initial);
      }
      for (const row of permRows) {
        const r = permsByProfile.get(row.profile_id);
        if (r && RESOURCES.includes(row.resource)) r[row.resource] = row.level;
      }

      list.innerHTML = profiles.map((p) =>
        renderProfile(p, permsByProfile.get(p.id), data.ownerId)
      ).join("");
      skeleton?.classList.add("hidden");
      list.classList.remove("hidden");

      // Wire change-detection + save handler for every card.
      list.querySelectorAll("[data-perms-form]").forEach(wirePermsForm);

      const profileEmails = new Set(profiles.map((p) => p.email.toLowerCase()));
      const pending = (data.allowlist ?? []).filter((a) => !profileEmails.has(a.email.toLowerCase()));
      renderPending(pending);
    };

    const hydrate = async () => {
      if (!document.querySelector("[data-admins-root]")) return;

      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) render(parsed.data);
        }
      } catch {}

      try {
        const res = await fetch("/api/page-data?type=admins", {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) return;
        const data = await res.json();
        render(data);
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), data })); } catch {}
      } catch {}
    };

    document.addEventListener("astro:page-load", () => {
      try { sessionStorage.removeItem(cacheKey); } catch {} // always refetch after submit
      hydrate();
    });
    document.addEventListener("astro:after-swap", hydrate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", hydrate);
    } else {
      hydrate();
    }
  })();
</script>
