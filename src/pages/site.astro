  </div>

  <div data-page-tab-panel="autores" hidden>
    <PageStub icon="lucide:users" title="Autores" />
  </div>

    </div>{/* /.px-5 py-6 ... inner content padding */}
  </div>{/* /.cas-site-main */}
  </div>{/* /.cas-site-shell */}
</AppLayout>

<style is:global>
  /* === Page nav (Home / Catálogo / Artículos / …) ===
     Stickies under the breadcrumb. Initial state: relaxed wrapping
     row of chips. Stuck state ([data-stuck="1"], set by JS via an
     IntersectionObserver sentinel): becomes a single-line row that
     scrolls horizontally if needed, with a hairline bottom border so
     it visually separates from the inner tab nav. Both states share
     the same chip sizing so chips don't reflow when stickying. */
  /* The sticky wrapper around the page-nav + tab-nav. Negative
     margins cancel main's wrapper padding so the stack pins flush
     to the breadcrumb at scroll=0 AND when stuck. Inner padding
     reproduces the visual padding of the original layout. */
  .cas-stickystack {
    position: sticky;
    z-index: 11;
    top: 96px;
    margin: -1.5rem -1.25rem 1.5rem;
    background: white;
  }
  @media (min-width: 768px) {
    .cas-stickystack {
      top: 0;
      margin-top: -2.5rem;
      margin-left: -2rem;
      margin-right: -2rem;
    }
  }
  @media (min-width: 1024px) {
    .cas-stickystack {
      margin-left: -2.5rem;
      margin-right: -2.5rem;
    }
  }

  /* Page-nav list (vertical, lives in the middle list panel).
     Replaces the old horizontal cas-pagechip pills. Looks and behaves
     like a row in ListPanel (Categorías). The active state styling
     keeps the same .cas-pagechip-active class so the existing JS
     toggler doesn't need to change. */
  .cas-pagenav-list {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
  }
  .cas-pagerow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgb(68 64 60);
    background: transparent;
    border: 0;
    border-left: 3px solid transparent;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.12s, color 0.12s, border-color 0.12s;
  }
  .cas-pagerow:hover {
    background: rgb(250 250 249);
    color: rgb(28 25 23);
  }
  .cas-pagerow > svg { color: rgb(120 113 108); }
  .cas-pagerow.cas-pagechip-active,
  .cas-pagerow.cas-pagechip-active:hover {
    background: rgb(28 25 23);
    color: white;
    border-left-color: rgb(28 25 23);
  }
  .cas-pagerow.cas-pagechip-active > svg { color: white; }

  /* Mobile: stacking — the aside collapses to a thin horizontal scroller
     above the content so phones still get to switch pages quickly. */
  @media (max-width: 767px) {
    .cas-site-shell { display: block; }
    .cas-site-listpanel {
      border-bottom: 1px solid rgb(231 229 228);
    }
    .cas-pagenav-list {
      flex-direction: row;
      overflow-x: auto;
      padding: 0.5rem;
      gap: 0.25rem;
    }
    .cas-pagerow {
      flex: 0 0 auto;
      border-left: 0;
      border-bottom: 3px solid transparent;
      padding: 0.5rem 0.875rem;
      border-radius: 9999px;
      font-size: 0.8125rem;
      background: rgb(245 245 244);
    }
    .cas-pagerow > svg:last-child { display: none; }
    .cas-pagerow.cas-pagechip-active,
    .cas-pagerow.cas-pagechip-active:hover {
      border-bottom-color: transparent;
    }
  }

  /* === Tab nav (Hero / Editorial / Contacto / SEO) ===
     Lives inside the .cas-stickystack so it travels together with
     the page-nav. No own sticky. Padding mirrors the page-nav so
     the row aligns visually. */
  .cas-tabs {
    padding: 0 1.25rem;
    background: white;
  }
  @media (min-width: 768px) {
    .cas-tabs { padding: 0 2rem; }
  }
  @media (min-width: 1024px) {
    .cas-tabs { padding: 0 2.5rem; }
  }
  .cas-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(120 113 108);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .cas-tab:hover { color: rgb(28 25 23); }
  .cas-tab-active { color: rgb(28 25 23); border-bottom-color: rgb(28 25 23); }
  /* Compact tabs on mobile: smaller padding, smaller font, hide nothing */
  @media (max-width: 640px) {
    .cas-tab { padding: 0.5rem 0.625rem; font-size: 0.8125rem; gap: 0.375rem; }
  }

  /* Fullscreen preview launcher buttons sit at the right of the tabs nav */
  .cas-fs-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    background: rgb(245 245 244);
    border: 1px solid rgb(214 211 209);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .cas-fs-btn:hover {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }

  /* === Inputs === */
  .hcc-input {
    border: 1px solid rgb(214 211 209);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: white;
    transition: border-color 0.15s;
    min-width: 0;
  }
  .hcc-input:focus { outline: none; border-color: rgb(28 25 23); }

  /* === Preview tabs (web/mobile) === */
  .cas-preview-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    border: 1px solid rgb(214 211 209);
    color: rgb(120 113 108);
    background: white;
    cursor: pointer;
  }
  .cas-preview-tab-active {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }
  .cas-preview-frame {
    height: clamp(280px, 48vh, 720px);
    position: relative;
    overflow: hidden;
  }
  /* When the editor zooms in past 100% the staged content extends
     past the frame; flip overflow to auto so they can pan. */
  .cas-preview-frame[data-preview-zoomed="true"] { overflow: auto; }
  @media (min-width: 1024px) {
    .cas-preview-frame { height: clamp(420px, 56vh, 720px); }
  }
  /* The preview card is rendered as <a> for layout parity with the
     public site, but inside the CMS we don't want clicks navigating
     away to /catalogo etc. Block all pointer interaction on the
     card and its descendants. */
  .cas-preview-noninteractive,
  .cas-preview-noninteractive * { pointer-events: none; }

  /* Preview parity with the public hero card.
     Every visual property the public site sets via Tailwind utility
     classes is replicated here as plain CSS, scoped to the preview's
     own data-attributes. This keeps the preview self-contained — it
     does NOT rely on Tailwind classes existing in the bundle, on the
     responsive viewport breakpoints (preview is rendered inside a
     desktop-sized CMS viewport so md:* would always apply), or on
     the order of inline styles vs class styles. Source of truth:
     apps/web/src/pages/index.astro lines 86-102. */

  /* Card: same flex behavior as the public <a class="hero-card-cms">. */
  [data-preview-card],
  [data-fullscreen-card] {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* Eyebrow: <p class="hcc-eyebrow uppercase text-[10px] sm:text-xs
     tracking-[0.2em] opacity-70 mb-3 sm:mb-5"> */
  [data-preview-eyebrow] {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    opacity: 0.7;
    margin: 0 0 0.75rem 0;
  }

  /* Title: <h1 class="hcc-title text-[1.4rem] sm:text-2xl md:text-5xl
     leading-[1.1] mb-3 sm:mb-5 line-clamp-3 md:line-clamp-4"> */
  [data-preview-title] {
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: normal;
    margin: 0 0 0.75rem 0;
    /* Clamp setup; line-count is platform-scoped below. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Body: <p class="hcc-body text-xs sm:text-sm md:text-base
     opacity-80 leading-relaxed line-clamp-2 md:line-clamp-3"> */
  [data-preview-body] {
    font-weight: 400;
    line-height: 1.625;       /* leading-relaxed */
    opacity: 0.8;
    letter-spacing: normal;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA: <span class="hcc-cta uppercase text-[11px] sm:text-xs
     tracking-[0.18em] border-b border-current/60 pb-1 self-start
     mt-4"> */
  [data-preview-cta] {
    align-self: flex-start;
    margin-top: 1rem;
    padding-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 400;
    border-bottom: 1px solid color-mix(in srgb, currentColor 60%, transparent);
  }

  /* DESKTOP — matches the md:* breakpoint utilities (≥768px). */
  [data-platform="desktop"] [data-preview-eyebrow] {
    font-size: 0.75rem;       /* text-xs */
    margin-bottom: 1.25rem;   /* mb-5 */
  }
  [data-platform="desktop"] [data-preview-title] {
    font-size: 3rem;          /* text-5xl */
    margin-bottom: 1.25rem;   /* mb-5 */
    -webkit-line-clamp: 4;
  }
  [data-platform="desktop"] [data-preview-body] {
    font-size: 1rem;          /* text-base */
    -webkit-line-clamp: 3;
  }
  [data-platform="desktop"] [data-preview-cta] {
    font-size: 0.75rem;       /* text-xs */
  }

  /* MOBILE — matches the base (<sm) utilities (<640px). */
  [data-platform="mobile"] [data-preview-eyebrow] {
    font-size: 10px;          /* text-[10px] */
    margin-bottom: 0.75rem;   /* mb-3 */
  }
  [data-platform="mobile"] [data-preview-title] {
    font-size: 1.4rem;        /* text-[1.4rem] */
    margin-bottom: 0.75rem;   /* mb-3 */
    -webkit-line-clamp: 3;
  }
  [data-platform="mobile"] [data-preview-body] {
    font-size: 0.75rem;       /* text-xs */
    -webkit-line-clamp: 2;
  }
  [data-platform="mobile"] [data-preview-cta] {
    font-size: 11px;          /* text-[11px] */
  }

  /* When the user clicks Web / Mobile in the preview, auto-scroll
     stops short by this much so the sticky stack doesn't cover the
     top of the target editor section. Reads the live stack height
     (--cas-stickystack-h) so the offset adapts when the bar
     compacts. Mobile adds the 56 mobile header + 40 breadcrumb. */
  [data-platform-section] {
    scroll-margin-top: calc(96px + var(--cas-stickystack-h, 92px) + 14px);
  }
  @media (min-width: 768px) {
    [data-platform-section] {
      scroll-margin-top: calc(var(--cas-stickystack-h, 92px) + 14px);
    }
  }

  /* Right-side preview aside on lg+: pinned below the sticky stack
     so it never gets covered. */
  .cas-preview-aside { /* base: nothing — sticky kicks in at lg */ }
  @media (min-width: 1024px) {
    .cas-preview-aside {
      position: sticky;
      top: calc(var(--cas-stickystack-h, 92px) + 16px);
    }
  }

  /* Zoom controls */
  .cas-preview-zoom-btn {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: white;
    border: 0;
    color: rgb(68 64 60);
    cursor: pointer;
    transition: background-color 0.12s, color 0.12s;
  }
  .cas-preview-zoom-btn:hover { background: rgb(245 245 244); color: rgb(28 25 23); }
  .cas-preview-zoom-btn:disabled { color: rgb(214 211 209); cursor: not-allowed; background: white; }
  .cas-preview-zoom-reset { border-left: 1px solid rgb(231 229 228); }
  .cas-preview-zoom-value {
    font-size: 11px;
    color: rgb(68 64 60);
    padding: 0 0.4rem;
    min-width: 36px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* === Stack + row helpers === */
  .hcc-stack { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  .hcc-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .hcc-row-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    white-space: nowrap;
  }
  .hcc-row-tight {
    flex-wrap: nowrap;
  }
  .hcc-row-icon {
    color: rgb(120 113 108);
    flex: 0 0 auto;
  }
  .hcc-mirror-text { flex: 1 1 0; min-width: 70px; }
  .hcc-mirror-num { width: 56px; flex: 0 0 auto; text-align: right; }
  .hcc-range { flex: 1 1 80px; min-width: 0; accent-color: rgb(28 25 23); }

  /* === Color block (swatch + hex + alpha slider + percent) ===
     Sized to match the Dropdown button exactly. Both controls use
     box-sizing: border-box and height: var(--cas-control-h) below,
     so a color editor and a Dropdown sit on the same row pixel for
     pixel — no 1px nudge from a stray border. */
  .hcc-color-block {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    height: var(--cas-control-h, 38px);
    border: 1px solid rgb(214 211 209);
    background: white;
    border-radius: 4px;
    padding: 0;
    overflow: hidden;
  }
  /* Force the Dropdown buttons inside this page to the same exact
     height as the color block. We scope to [data-site-form] so we
     don't affect Dropdown usages on other pages. */
  [data-site-form] .cas-dd-btn {
    box-sizing: border-box;
    height: var(--cas-control-h, 38px);
  }
  [data-site-form] { --cas-control-h: 38px; }
  .hcc-swatch-wrap {
    position: relative;
    display: block;
    width: 36px;
    height: 100%;
    border: 0;
    border-right: 1px solid rgb(214 211 209);
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
    background-image:
      linear-gradient(45deg, #e5e5e4 25%, transparent 25%),
      linear-gradient(-45deg, #e5e5e4 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e5e5e4 75%),
      linear-gradient(-45deg, transparent 75%, #e5e5e4 75%);
    background-size: 8px 8px;
    background-position: 0 0, 0 4px, 4px -4px, -4px 0;
  }
  .hcc-swatch-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    border: 0;
    padding: 0;
  }
  .hcc-swatch {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--swatch-color, #1a1715);
    pointer-events: none;
  }
  .hcc-color-info {
    flex: 1;
    min-width: 0;
    padding: 0 0.4rem 0 0.625rem;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto auto;
    gap: 0.5rem;
    align-items: center;
  }
  /* Solo variant has just the hex + reset X — no range / no pct. */
  .hcc-color-block--solo .hcc-color-info {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  /* Editable hex: looks like text by default; gets a tinted bg on
     hover/focus so users discover the click affordance. */
  .hcc-color-hex[contenteditable="true"] {
    cursor: text;
    padding: 1px 4px;
    border-radius: 3px;
    transition: background-color 0.12s;
    outline: none;
    user-select: text;
    /* Truncate when there's not enough room rather than pushing the X */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hcc-color-hex[contenteditable="true"]:hover { background: rgb(245 245 244); }
  .hcc-color-hex[contenteditable="true"]:focus {
    background: rgb(245 245 244);
    box-shadow: inset 0 0 0 1px rgb(28 25 23);
  }
  /* Reset X button. Sits flush right inside the editor frame and
     never wraps — has its own grid column above. */
  .hcc-color-reset {
    width: 22px;
    height: 22px;
    border: 0;
    background: transparent;
    color: rgb(168 162 158);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.12s, color 0.12s;
  }
  .hcc-color-reset:hover {
    background: rgb(245 245 244);
    color: rgb(28 25 23);
  }
  .hcc-color-reset:focus-visible {
    outline: none;
    background: rgb(245 245 244);
    color: rgb(28 25 23);
    box-shadow: inset 0 0 0 1.5px rgb(28 25 23);
  }
  .hcc-color-hex {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    color: rgb(68 64 60);
    text-transform: lowercase;
    white-space: nowrap;
  }
  .hcc-color-pct {
    font-size: 0.75rem;
    color: rgb(120 113 108);
    font-variant-numeric: tabular-nums;
    min-width: 36px;
    text-align: right;
    white-space: nowrap;
  }

  /* === Icon prefix === */
  .hcc-icon-prefix {
    display: inline-flex;
    color: rgb(120 113 108);
    flex: 0 0 auto;
  }

  /* === Numeric cell with icon + label + suffix === */
  .hcc-num-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .hcc-num-cell-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
  }
  .hcc-num-icon {
    display: inline-flex;
    color: rgb(120 113 108);
  }
  .hcc-num-input-wrap {
    position: relative;
    display: block;
  }
  .hcc-num-input {
    width: 100%;
    padding-right: 26px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hcc-num-suffix {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7rem;
    color: rgb(168 162 158);
    pointer-events: none;
  }

  /* === Size grid: 3 cells === */
  .hcc-size-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (max-width: 380px) {
    .hcc-size-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hcc-size-grid > :nth-child(3) { grid-column: 1 / -1; }
  }

  /* === Position inputs ===
     X and Y rows with −/+ stepper buttons flanking each input. The
     visual drag pad was removed because it pushed users toward
     positions that needed to be re-edited anyway; explicit numbers
     plus easy nudge buttons cover the common case better. */
  .hcc-pos-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 320px;
  }
  .hcc-pos-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .hcc-pos-control {
    display: flex;
    align-items: stretch;
    gap: 0.375rem;
  }
  .hcc-pos-input-wrap {
    flex: 1;
    min-width: 0;
  }
  .hcc-step {
    width: 32px;
    height: 36px;
    border: 1px solid rgb(214 211 209);
    background: white;
    border-radius: 4px;
    color: rgb(68 64 60);
    font-size: 1.1rem;
    line-height: 1;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    flex-shrink: 0;
    user-select: none;
  }
  .hcc-step:hover { background: rgb(28 25 23); border-color: rgb(28 25 23); color: white; }
  .hcc-step:active { transform: translateY(0.5px); }
  .hcc-step:focus-visible { outline: none; border-color: rgb(28 25 23); box-shadow: 0 0 0 1px rgb(28 25 23); }

  /* === Color input === */
  [data-platform-section] input[type="color"] {
    width: 44px; height: 32px; padding: 0;
    border: 1px solid rgb(214 211 209);
    cursor: pointer; background: white;
    flex: 0 0 auto;
  }
  [data-platform-section] input[type="range"] { accent-color: rgb(28 25 23); }

  /* === Triplet (3 inputs in a row) and Pair (2 inputs) === */
  .hcc-triplet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .hcc-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .hcc-triplet-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .hcc-triplet-cell > span {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
  }
  /* On really narrow screens, triplets become 2 cols + 1 below */
  @media (max-width: 380px) {
    .hcc-triplet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hcc-triplet-cell:nth-child(3) { grid-column: 1 / -1; }
  }

  /* === Border radius editor — single bordered container with corners
        + link toggle inside, so it reads as one tool. === */
  .hcc-radius-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    max-width: 360px;
    border: 1px solid rgb(229 229 228);
    background: rgb(250 250 249);
    border-radius: 6px;
    padding: 0.5rem;
  }
  .hcc-radius-corner {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    background: white;
    border: 1px solid rgb(229 229 228);
    border-radius: 4px;
  }
  /* Right-side corners get input-then-icon order */
  .hcc-radius-corner-tr,
  .hcc-radius-corner-br {
    flex-direction: row;
    justify-content: flex-end;
  }
  .hcc-radius-corner > .hcc-input {
    flex: 1 1 0;
    min-width: 0;
    padding: 0.2rem 0.4rem;
    font-size: 0.8125rem;
    border: 0;
    background: transparent;
    text-align: center;
  }
  .hcc-radius-corner > .hcc-input:focus { outline: 1px solid rgb(28 25 23); outline-offset: 1px; }
  .hcc-corner-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border: 2px solid transparent;
    color: rgb(120 113 108);
  }
  .hcc-corner-tl {
    border-top: 2px solid currentColor;
    border-left: 2px solid currentColor;
    border-top-left-radius: 5px;
  }
  .hcc-corner-tr {
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    border-top-right-radius: 5px;
  }
  .hcc-corner-bl {
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
    border-bottom-left-radius: 5px;
  }
  .hcc-corner-br {
    border-bottom: 2px solid currentColor;
    border-right: 2px solid currentColor;
    border-bottom-right-radius: 5px;
  }
  /* Link toggle row spans the full grid width inside the same container */
  .hcc-radius-link-row {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.5rem 0.1rem;
    margin-top: 0.15rem;
    border-top: 1px dashed rgb(229 229 228);
    font-size: 0.75rem;
    color: rgb(120 113 108);
    cursor: pointer;
    user-select: none;
  }
  .hcc-radius-link-row input { width: 14px; height: 14px; }
  .hcc-radius-link-row svg { color: rgb(120 113 108); }
  .hcc-radius-link-row:has(input:checked) {
    color: rgb(28 25 23);
  }
  .hcc-radius-link-row:has(input:checked) svg { color: rgb(28 25 23); }

  /* === Checkbox row === */
  .hcc-checkbox-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
    font-size: 0.875rem;
  }
  .hcc-checkbox-row input { width: 16px; height: 16px; }

  .hcc-hint { font-size: 0.75rem; color: rgb(120 113 108); }
  .hcc-hint em { font-style: italic; color: rgb(68 64 60); }
  /* Manual content fields: icon-prefixed labels + hint above the input */
  .hcc-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .hcc-field-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(68 64 60);
  }
  .hcc-field-label > svg { color: rgb(120 113 108); flex: 0 0 auto; }
  .hcc-field .hcc-hint { margin: 0 0 0.125rem; }
  .hcc-url-stack { display: flex; flex-direction: column; gap: 0.5rem; }

  /* URL combobox: a single text input with an optional dropdown of
     detected site pages. Type freely, or click the chevron to browse
     suggestions. Filtering matches the input value as you type. */
  .hcc-url-combo {
    position: relative;
    display: flex;
    align-items: stretch;
  }
  .hcc-url-combo > .hcc-input {
    padding-right: 2.5rem; /* room for the chevron button */
  }
  .hcc-url-combo-toggle {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: rgb(120 113 108);
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s;
    border-radius: 0 0.375rem 0.375rem 0;
  }
  .hcc-url-combo-toggle:hover { color: rgb(28 25 23); background: rgb(245 245 244); }
  .hcc-url-combo-toggle > svg { transition: transform 0.15s; }
  .hcc-url-combo[data-open="1"] .hcc-url-combo-toggle > svg { transform: rotate(180deg); }
  .hcc-url-combo-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 30;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: white;
    border: 1px solid rgb(231 229 228);
    border-radius: 0.5rem;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,0.18);
    max-height: 280px;
    overflow-y: auto;
  }
  .hcc-url-combo-list[hidden] { display: none; }
  .hcc-url-combo-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem;
    border-radius: 0.375rem;
    cursor: pointer;
    color: rgb(28 25 23);
  }
  .hcc-url-combo-list li:hover,
  .hcc-url-combo-list li[data-active="1"] { background: rgb(245 245 244); }
  .hcc-url-combo-list li > svg { color: rgb(120 113 108); flex: 0 0 auto; }
  .hcc-url-combo-list li .uc-label {
    font-size: 0.8125rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1 1 auto;
  }
  .hcc-url-combo-list li .uc-hint {
    font-size: 0.6875rem;
    color: rgb(120 113 108);
    margin-left: auto;
    flex: 0 0 auto;
  }
  .hcc-url-combo-empty {
    padding: 0.75rem 0.55rem;
    font-size: 0.75rem;
    color: rgb(120 113 108);
    text-align: center;
  }

  /* === Vista previa del hero ===
     Replica fiel del hero del sitio público: dos frames (web + mobile),
     cada uno con la imagen lateral/inferior. Las proporciones imitan
     viewports reales (web ~ 16:9, mobile ~ 9:18) y los estilos
     reproducen el wordmark serif, la regla decorativa, el split-button
     desktop y el solid pill mobile que vive en apps/web/src/components/Hero.astro.
     Tokens de color exactos del sitio público (apps/web/src/styles/global.css). */
  .cas-hero-pv-web,
  .cas-hero-pv-mobile {
    --pv-bg-alt: oklch(99% 0.003 70);
    --pv-fg: oklch(20% 0.01 70);
    --pv-fg-muted: oklch(45% 0.01 70);
    --pv-border: oklch(85% 0.005 70);
  }
  .cas-hero-pv-web {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--pv-bg-alt);
    border: 1px solid rgb(231 229 228);
    overflow: hidden;
    transition: background-color 200ms ease;
    container-type: inline-size;
  }
  .cas-hero-pv-web-content {
    padding: 4% 6% 4% 8%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .cas-hero-pv-web-image {
    background-color: rgb(41 37 36);
    background-size: cover;
    background-position: center;
  }
  /* Wordmark — escala con el width total del frame (no la mitad de
     contenido), igual que en el sitio público donde el `text-[6.2rem]`
     llena verticalmente la mitad izquierda. ~5cqi del width total =
     ~9-10% del frame, replicando la presencia tipográfica del original. */
  .cas-hero-pv-title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 5cqi, 5.5rem);
    line-height: 0.95;
    color: var(--pv-fg);
    margin: 0 0 6%;
    white-space: pre-line;
    word-break: break-word;
  }
  .cas-hero-pv-tagline-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 9%;
  }
  .cas-hero-pv-rule {
    flex: 0 0 auto;
    display: block;
    width: clamp(1rem, 2.4cqi, 2.4rem);
    height: 1px;
    background: var(--pv-fg);
    transform: translateY(-0.6em);
  }
  .cas-hero-pv-tagline {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: clamp(0.9rem, 2.4cqi, 2.4rem);
    line-height: 1.2;
    color: var(--pv-fg-muted);
    margin: 0;
  }
  /* En el sitio público los CTAs viven en un `space-y-6` (stack
     vertical), no en row. Reproducirlo aquí para que el editor vea la
     misma jerarquía visual. */
  .cas-hero-pv-ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }
  .cas-hero-pv-cta-primary {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--pv-fg);
    color: var(--pv-fg);
    text-decoration: none;
    cursor: default;
    user-select: none;
    pointer-events: none;
  }
  .cas-hero-pv-cta-primary > span:first-child {
    padding: 0 clamp(0.75rem, 2cqi, 2rem);
    height: clamp(2.2rem, 4.5cqi, 3.6rem);
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.55rem, 0.95cqi, 0.85rem);
    text-transform: uppercase;
    letter-spacing: 0.26em;
    white-space: nowrap;
  }
  .cas-hero-pv-arrow-box {
    width: clamp(2.2rem, 4.5cqi, 3.6rem);
    height: clamp(2.2rem, 4.5cqi, 3.6rem);
    border-left: 1px solid color-mix(in oklch, var(--pv-fg) 40%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cas-hero-pv-arrow-box svg {
    width: clamp(0.9rem, 1.8cqi, 1.4rem);
    height: clamp(0.9rem, 1.8cqi, 1.4rem);
  }
  .cas-hero-pv-cta-secondary svg {
    width: clamp(0.7rem, 1.1cqi, 1rem);
    height: clamp(0.7rem, 1.1cqi, 1rem);
  }
  .cas-hero-pv-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    cursor: default;
    user-select: none;
    pointer-events: none;
    font-size: clamp(0.55rem, 0.9cqi, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--pv-fg-muted);
  }
  /* Empty states */
  .cas-hero-pv-cta-primary[data-empty="1"],
  .cas-hero-pv-cta-secondary[data-empty="1"] { opacity: 0.35; }
  .cas-hero-pv-cta-primary[data-empty="1"] > span:first-child::before { content: "—"; }
  .cas-hero-pv-cta-secondary[data-empty="1"] > span:first-child::before { content: "—"; }

  /* Mobile preview — phone-shaped frame, content stacked above the
     image. Aspect ratio matches a real device shell so the editor can
     judge the composition at glance. */
  .cas-hero-pv-mobile-wrap {
    display: flex;
    justify-content: center;
    padding: 1rem 0 0.5rem;
  }
  .cas-hero-pv-mobile {
    width: 280px;
    border: 1px solid rgb(231 229 228);
    border-radius: 18px;
    overflow: hidden;
    background: var(--pv-bg-alt);
    box-shadow: 0 4px 12px -4px rgba(28, 25, 23, 0.08);
    container-type: inline-size;
    transition: background-color 200ms ease;
  }
  .cas-hero-pv-mobile-content {
    padding: 22px 18px 20px;
  }
  .cas-hero-pv-mobile-title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 0.98;
    color: var(--pv-fg);
    margin: 0 0 14px;
    white-space: pre-line;
    word-break: break-word;
  }
  .cas-hero-pv-mobile-tagline {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--pv-fg-muted);
    margin: 0 0 10px;
  }
  .cas-hero-pv-mobile-closer {
    display: block;
    width: 52px;
    height: 1px;
    background: color-mix(in oklch, var(--pv-fg) 40%, transparent);
    margin: 0 0 18px;
  }
  .cas-hero-pv-mobile-cta-primary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 38px;
    padding: 0 14px;
    background: var(--pv-fg);
    color: var(--pv-bg-alt);
    text-decoration: none;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    cursor: default;
    user-select: none;
    pointer-events: none;
    margin-bottom: 12px;
  }
  .cas-hero-pv-mobile-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--pv-fg-muted);
    text-decoration: none;
    cursor: default;
    user-select: none;
    pointer-events: none;
  }
  .cas-hero-pv-mobile-cta-primary[data-empty="1"],
  .cas-hero-pv-mobile-cta-secondary[data-empty="1"] { opacity: 0.35; }
  .cas-hero-pv-mobile-cta-primary[data-empty="1"] > span:first-child::before { content: "—"; }
  .cas-hero-pv-mobile-cta-secondary[data-empty="1"] > span:first-child::before { content: "—"; }
  .cas-hero-pv-mobile-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: rgb(41 37 36);
    background-size: cover;
    background-position: center;
  }

  /* === Vista previa de la ficha de libro y de la publicación ===
     Mini-replica de /catalogo/[slug] y /articulos/[slug]. Cada preview
     declara dos CSS vars en su style attribute (--pv-title-font /
     --pv-body-font) que el JS actualiza al vuelo cuando el editor
     cambia un dropdown de tipografía. Colores tomados de los tokens
     del sitio público (var --bg-alt = oklch(99% 0.003 70) etc.).
     El frame está completamente contenido — usamos container-type:
