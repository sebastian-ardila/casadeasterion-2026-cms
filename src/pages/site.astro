                  <p class="cas-detail-pv-label">Autor</p>
                  <div class="cas-detail-pv-author-row">
                    {PUBLICATION_PV.author.photo_url ? (
                      <img src={PUBLICATION_PV.author.photo_url} alt="" class="cas-detail-pv-author-thumb" />
                    ) : (
                      <span class="cas-detail-pv-author-thumb cas-detail-pv-author-thumb--empty">{PUBLICATION_PV.author.name.charAt(0)}</span>
                    )}
                    <span class="cas-detail-pv-author-name">{PUBLICATION_PV.author.name}</span>
                  </div>
                  {PUBLICATION_PV.authorBio && (
                    <p class="cas-detail-pv-author-bio">{PUBLICATION_PV.authorBio}</p>
