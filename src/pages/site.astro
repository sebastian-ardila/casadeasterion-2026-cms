  .cl-list-add:hover { border-color: rgb(28 25 23); color: rgb(28 25 23); }
  .cl-row .hcc-input { font-size: 0.8125rem; padding: 0.4rem 0.55rem; }
  .cl-row select.hcc-input {
    appearance: none;
    background:
      url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none' stroke='%2378716c' stroke-width='1.5'%3E%3Cpath d='M3 5l3 3 3-3'/%3E%3C/svg%3E")
      right 0.5rem center / 12px no-repeat white;
