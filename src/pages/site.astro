<script is:inline define:vars={{ DEFAULT_HERO_CARD, HERO_FALLBACK_URL, HERO_CARD_FONTS_MAP, LATEST_POST, LATEST_BOOK, URL_OPTIONS, FONT_FAMILY_MAP }}>
  (() => {
    if (window.__casSiteInit) return;
    window.__casSiteInit = true;

    const cacheKey = "cas:site";
    const TTL = 60_000;

    const FRAME_DESKTOP_W = 1440;
    const FRAME_DESKTOP_H = 720;
    const FRAME_MOBILE_W = 390;
    const FRAME_MOBILE_H = 720;

    let currentPreviewTab = "desktop";
    // Editor-controlled zoom factor multiplied on top of the auto-fit
    // scale. Stored on [data-preview-frame] as a data-attr (not a
    // closure variable!) so Astro view transitions don't carry stale
    // state from the previous IIFE: when the user navigates away and
    // back, document-level listeners installed by the old IIFE still
    // fire and still close over the OLD `previewZoom`. Reading from
    // the DOM each time makes any IIFE see the live value.
    const ZOOM_STEPS = [0.5, 0.75, 1, 1.25, 1.5, 2, 2.5, 3, 4];
    const getPreviewZoom = () => {
      const frame = $("[data-preview-frame]");
      const v = Number(frame?.dataset.previewZoom ?? "1");
      return Number.isFinite(v) && v > 0 ? v : 1;
    };
    const writePreviewZoomUI = (zoom) => {
      const frame = $("[data-preview-frame]");
      if (frame) frame.dataset.previewZoom = String(zoom);
      $$("[data-preview-zoom-value]").forEach(el => { el.textContent = `${Math.round(zoom * 100)}%`; });
      $$("[data-preview-zoom-out]").forEach(b => { b.disabled = zoom <= ZOOM_STEPS[0]; });
      $$("[data-preview-zoom-in]").forEach(b => { b.disabled = zoom >= ZOOM_STEPS[ZOOM_STEPS.length - 1]; });
    };
    const setPreviewZoom = (z) => {
      const next = Math.max(ZOOM_STEPS[0], Math.min(ZOOM_STEPS[ZOOM_STEPS.length - 1], z));
      if (next === getPreviewZoom()) return;
      writePreviewZoomUI(next);
      renderHeroPreview();
    };
    const stepZoom = (dir) => {
      const cur = getPreviewZoom();
      const idx = ZOOM_STEPS.indexOf(cur);
      if (idx === -1) {
        const next = dir > 0
          ? ZOOM_STEPS.find(z => z > cur)
          : [...ZOOM_STEPS].reverse().find(z => z < cur);
        if (next != null) setPreviewZoom(next);
        return;
      }
      const nextIdx = Math.max(0, Math.min(ZOOM_STEPS.length - 1, idx + dir));
      setPreviewZoom(ZOOM_STEPS[nextIdx]);
    };
    let currentHeroCfg = structuredClone(DEFAULT_HERO_CARD);

    const $ = (s, p = document) => p.querySelector(s);
    const $$ = (s, p = document) => Array.from(p.querySelectorAll(s));

    // ----- Path helpers for hero card config -----
    const setByPath = (obj, path, val) => {
      const parts = path.split(".");
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        if (typeof cur[parts[i]] !== "object" || cur[parts[i]] === null) cur[parts[i]] = {};
        cur = cur[parts[i]];
      }
      cur[parts[parts.length - 1]] = val;
    };
    const getByPath = (obj, path) => {
      const parts = path.split(".");
      let cur = obj;
      for (const p of parts) { if (cur == null) return undefined; cur = cur[p]; }
      return cur;
    };

    // ----- Color helper -----
    const hexToRgba = (hex, alpha) => {
      const c = String(hex || "").replace("#", "").trim();
      const full = c.length === 3 ? c.split("").map(x => x + x).join("") : c;
      if (full.length !== 6) return `rgba(26,23,21,${alpha})`;
      const r = parseInt(full.slice(0, 2), 16);
      const g = parseInt(full.slice(2, 4), 16);
      const b = parseInt(full.slice(4, 6), 16);
      if ([r, g, b].some(Number.isNaN)) return `rgba(26,23,21,${alpha})`;
      return `rgba(${r},${g},${b},${alpha})`;
    };

    // ----- Tab switching -----
    const TAB_LABELS = { hero: "Hero", editorial: "Editorial", contacto: "Contacto", seo: "SEO" };
    const PAGE_LABELS = {
      home: "Home", catalogo: "Catálogo", articulos: "Publicaciones",
      autores: "Autores",
    };
    // Rewrite the trailing crumbs of the breadcrumb (Webpage / Home / Hero
    // chain) to match the current page-tab and inner tab. Mirrors the
    // server-side logic in MobileBreadcrumb.astro so refresh and click
    // produce the same trail.
    //
    // NOTA: el icono del crumb NO se actualiza en client-side. Mantenemos
    // el icono que el SSR puso al cargar la página (lucide glyphs via
    // astro-icon usan <symbol id>/<use> y duplicarlos en client-side
    // rompía los symbols del sidebar persistido). Solo el texto cambia
    // en vivo; en hard nav o reload el icono se actualiza al instante.
    const updateBreadcrumbCrumbs = (pageKey, tabKey) => {
      const ol = document.querySelector(".cas-breadcrumb ol");
      if (!ol) return;
      const pagetabLi = ol.querySelector("[data-breadcrumb-pagetab]");
      // Si no estamos en /site, no hay pagetab crumb — abort para
      // no inyectar un "› Hero" colgante en el breadcrumb de otra
      // sección (defensa contra listeners de astro:page-load que
      // se disparan después de navegar fuera de /site).
      if (!pagetabLi) return;
      let tabLi = ol.querySelector("[data-breadcrumb-tab]");
      const isHome = pageKey === "home";
      const pageLabel = PAGE_LABELS[pageKey] || "Home";
      const tabLabel = TAB_LABELS[tabKey] || "Hero";

      // 1. Update the page-tab crumb label, and switch between
      //    last-leaf (span) and link-to-/site depending on whether
      //    there's a deeper tab crumb.
      if (pagetabLi) {
        const wantLink = isHome;     // a tab crumb will follow it
        const inner = pagetabLi.querySelector("a, span");
        const labelEl = pagetabLi.querySelector("[data-breadcrumb-label]");
        if (labelEl) labelEl.textContent = pageLabel;
        if (inner) {
          const isAnchor = inner.tagName === "A";
          if (wantLink && !isAnchor) {
            const a = document.createElement("a");
            a.href = "/site";
            a.className = "inline-flex items-center gap-1.5 text-stone-500 hover:text-stone-900 transition";
            a.setAttribute("data-astro-prefetch", "");
            // Preserve any pre-rendered icon by moving the existing
            // svg over into the new anchor — that way the symbols
            // already inserted by SSR keep working.
            const existingSvg = inner.querySelector("svg");
            if (existingSvg) a.appendChild(existingSvg);
            const lbl = document.createElement("span");
            lbl.setAttribute("data-breadcrumb-label", "");
            lbl.textContent = pageLabel;
            a.appendChild(lbl);
            inner.replaceWith(a);
          } else if (!wantLink && isAnchor) {
            const sp = document.createElement("span");
            sp.className = "inline-flex items-center gap-1.5 text-stone-900 font-medium first-letter:capitalize";
            const existingSvg = inner.querySelector("svg");
            if (existingSvg) sp.appendChild(existingSvg);
            const lbl = document.createElement("span");
            lbl.setAttribute("data-breadcrumb-label", "");
            lbl.textContent = pageLabel;
            sp.appendChild(lbl);
            inner.replaceWith(sp);
          }
          // Same element type → label-only update (icon stays).
        }
      }

      // 2. Add / update / remove the tab crumb (only when on Home).
      if (isHome) {
        if (!tabLi) {
          tabLi = document.createElement("li");
          tabLi.setAttribute("data-breadcrumb-tab", "");
          tabLi.className = "flex items-center gap-1.5 shrink-0";
          tabLi.innerHTML =
            '<span aria-hidden="true" class="text-stone-300">›</span>' +
            '<span class="inline-flex items-center gap-1.5 text-stone-900 font-medium first-letter:capitalize">' +
              '<span data-breadcrumb-label></span>' +
            '</span>';
          ol.appendChild(tabLi);
        }
        const tlbl = tabLi.querySelector("[data-breadcrumb-label]");
        if (tlbl) tlbl.textContent = tabLabel;
      } else if (tabLi) {
        tabLi.remove();
      }
    };

    const switchTab = (name) => {
      $$("[data-tab]").forEach(b => b.classList.toggle("cas-tab-active", b.getAttribute("data-tab") === name));
      $$("[data-tab-panel]").forEach(p => p.hidden = p.getAttribute("data-tab-panel") !== name);
      // Mobile-only fullscreen preview launchers belong to the Hero
      // tab — Editorial/Contacto/SEO have no card preview to launch.
      $$("[data-fullscreen-launchers]").forEach(el => { el.hidden = name !== "hero"; });
      try {
        const url = new URL(window.location.href);
        // "hero" is the implicit default — keep the URL clean by
        // dropping the param when on it.
        if (name === "hero") url.searchParams.delete("tab");
        else url.searchParams.set("tab", name);
        history.replaceState(null, "", url.toString());
      } catch {}
      // Sync the trailing breadcrumb crumb. We're always on page=home
      // when the tab nav is visible.
      updateBreadcrumbCrumbs("home", name);
      if (name === "hero") setTimeout(renderHeroPreview, 0);
    };

    const wireTabs = () => {
      $$("[data-tab]").forEach(btn => btn.addEventListener("click", () => switchTab(btn.getAttribute("data-tab"))));
      // Honor ?tab= on first load (legacy hash also supported).
      const url = new URL(window.location.href);
      const queryTab = (url.searchParams.get("tab") || "").toLowerCase();
      const hashTab = (window.location.hash || "").replace("#", "").toLowerCase();
      const initial = ["hero", "editorial", "contacto", "seo"].includes(queryTab)
        ? queryTab
        : (["hero", "editorial", "contacto", "seo"].includes(hashTab) ? hashTab : "hero");
      switchTab(initial);
    };

    // ----- Hero card form ↔ config -----
    const readHeroForm = () => {
      const cfg = structuredClone(currentHeroCfg);
      $$("[data-bind]").forEach(el => {
        const path = el.getAttribute("data-bind");
        let v;
        if (el.type === "checkbox") v = el.checked;
        else if (el.type === "number" || el.type === "range") {
          v = el.value === "" ? 0 : parseFloat(el.value);
          if (Number.isNaN(v)) v = 0;
        } else v = el.value;
        setByPath(cfg, path, v);
      });
      // Dropdown components: read from the hidden input inside each
      // [data-bind-dd="path"] wrapper.
      $$("[data-bind-dd]").forEach(wrap => {
        const path = wrap.getAttribute("data-bind-dd");
        const hidden = wrap.querySelector("[data-dd-input]");
        if (hidden) setByPath(cfg, path, hidden.value);
      });
      // ImageUpload bg images live in dedicated hidden inputs.
      const dImg = document.querySelector('input[type="hidden"][name="desktop_bg_image"]');
      const mImg = document.querySelector('input[type="hidden"][name="mobile_bg_image"]');
      if (dImg) cfg.desktop.bg_image_url = dImg.value || "";
      if (mImg) cfg.mobile.bg_image_url = mImg.value || "";
      return cfg;
    };

    // Programmatically set a Dropdown's value: update the hidden input,
    // the visible label, the aria-selected state, and the highlighted
    // option class. Mirrors what the Dropdown's own click handler does.
    const setDropdownValue = (wrap, value) => {
      const hidden = wrap.querySelector("[data-dd-input]");
      const display = wrap.querySelector("[data-dd-display]");
      const option = wrap.querySelector(`[data-dd-option][data-value="${CSS.escape(String(value ?? ""))}"]`);
      if (hidden) hidden.value = String(value ?? "");
      if (option && display) {
        const label = option.getAttribute("data-label") || option.querySelector(".cas-dd-option-label")?.textContent || "";
        const fontFamily = option.getAttribute("data-font-family") || "";
        const truncate = display.querySelector(".truncate");
        if (truncate) {
          truncate.textContent = label;
          if (fontFamily) truncate.style.fontFamily = fontFamily;
          else truncate.style.removeProperty("font-family");
        } else {
          const styleAttr = fontFamily ? ` style="font-family: ${fontFamily}"` : "";
          display.innerHTML = `<span class="truncate"${styleAttr}>${label}</span>`;
        }
      }
      wrap.querySelectorAll("[data-dd-option]").forEach(opt => {
        const isSelected = opt.getAttribute("data-value") === String(value ?? "");
        opt.setAttribute("aria-selected", isSelected ? "true" : "false");
        opt.classList.toggle("cas-dd-option-selected", isSelected);
      });
    };

    const writeHeroForm = (cfg) => {
      $$("[data-bind]").forEach(el => {
        const path = el.getAttribute("data-bind");
        const v = getByPath(cfg, path);
        if (v === undefined || v === null) return;
        if (el.type === "checkbox") el.checked = !!v;
        else el.value = String(v);
      });
      // Dropdown components — set the hidden input and visible label.
      $$("[data-bind-dd]").forEach(wrap => {
        const path = wrap.getAttribute("data-bind-dd");
        const v = getByPath(cfg, path);
        if (v !== undefined && v !== null) setDropdownValue(wrap, v);
      });
      // Push bg image URLs into ImageUpload wrappers via __casSetImage.
      const set = (name, url) => {
        const hidden = document.querySelector(`input[type="hidden"][name="${name}"]`);
        const wrap = hidden?.closest("[data-image-upload]");
        if (wrap?.__casSetImage) wrap.__casSetImage(url || "");
      };
      set("desktop_bg_image", cfg.desktop?.bg_image_url || "");
      set("mobile_bg_image", cfg.mobile?.bg_image_url || "");
      updateManualVisibility(cfg.content_source);
    };

    // Manual content fields toggle. Reads from the live form when no
    // value is passed in so the dropdown's change listener can call
    // it without needing to round-trip through readHeroForm.
    const updateManualVisibility = (source) => {
      let value = source;
      if (value == null) {
        const ddWrap = document.querySelector('[data-bind-dd="content_source"]');
        value = ddWrap?.querySelector("[data-dd-input]")?.value || "editorial";
      }
      // Manual-only inputs (eyebrow / title / body) — only shown for "manual".
      const manual = document.querySelector("[data-manual-fields]");
      if (manual) manual.hidden = value !== "manual";
      // CTA inputs (text + URL) — shown for "manual" AND "editorial".
      // latest_post / latest_book auto-link to the article/book detail
      // page so they don't expose a CTA editor.
      const cta = document.querySelector("[data-cta-fields]");
      if (cta) cta.hidden = value !== "manual" && value !== "editorial";
    };

    // ----- Mini "Contenido de la card" preview -----
    // Resolves the final text the public site will render given the
    // current content_source + manual fields + the latest published
    // post/book (fetched at SSR via define:vars). Then paints those
    // strings + the desktop card's visual style into the dedicated
    // preview-card element inside the "Contenido de la card" section.
    // Strip a small subset of markdown to plain text and trim to a
    // sensible body length. Mirrors markdownToTeaser() in
    // apps/web/src/lib/hero-card.ts so the CMS preview matches the
    // public site's body when an editor's excerpt / subtitle is
    // empty and the long-form md is the only available teaser.
    const markdownToTeaser = (md, max = 280) => {
      if (!md) return "";
      const stripped = md
        .replace(/`{3}[\s\S]*?`{3}/g, " ")
        .replace(/`([^`]+)`/g, "$1")
        .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
        .replace(/^\s{0,3}#{1,6}\s+/gm, "")
        .replace(/^\s{0,3}>\s?/gm, "")
        .replace(/^\s*[-*+]\s+/gm, "")
        .replace(/^\s*\d+\.\s+/gm, "")
        .replace(/(\*\*|__)(.*?)\1/g, "$2")
        .replace(/(\*|_)(.*?)\1/g, "$2")
        .replace(/~~(.*?)~~/g, "$1")
        .replace(/\s+/g, " ")
        .trim();
      if (stripped.length <= max) return stripped;
      const cut = stripped.slice(0, max);
      const lastSpace = cut.lastIndexOf(" ");
      return (lastSpace > max * 0.6 ? cut.slice(0, lastSpace) : cut).trimEnd() + "…";
    };

    const resolveContentPreview = (cfg) => {
      const src = cfg.content_source || "editorial";
      const editorialField = document.querySelector('[name="editorial_description"]');
      const editorialText = (editorialField?.value || "").trim();
      const m = cfg.manual ?? {};
      const customCtaLabel = (m.cta_label ?? "").trim();
      let eyebrow = "Editorial";
      let title = "Casa de Asterión Ediciones";
      let body = editorialText;
      let cta = customCtaLabel || "Explorar el catálogo";
      let warning = "";
      let editorialLink = false;
      if (src === "manual") {
        eyebrow = (m.eyebrow ?? "").trim();
        title = (m.title ?? "").trim();
        body = (m.body ?? "").trim();
        cta = customCtaLabel;
      } else if (src === "latest_post") {
        if (LATEST_POST) {
          eyebrow = "Editorial";
          title = LATEST_POST.title || "(sin título)";
          // Body chain: authored excerpt → stripped content_md
          // teaser. Same fallback the public site uses now.
          body = (LATEST_POST.excerpt || "").trim() || markdownToTeaser(LATEST_POST.content_md);
          cta = "Leer artículo";
        } else {
          warning = "No hay artículos publicados todavía. Mientras tanto el sitio mostrará la descripción editorial como fallback.";
        }
      } else if (src === "latest_book") {
        if (LATEST_BOOK) {
          eyebrow = "Catálogo";
          title = LATEST_BOOK.title || "(sin título)";
          body = (LATEST_BOOK.subtitle || "").trim() || markdownToTeaser(LATEST_BOOK.description_md);
          cta = "Ver libro";
        } else {
          warning = "No hay libros publicados todavía. Mientras tanto el sitio mostrará la descripción editorial como fallback.";
        }
      } else {
        editorialLink = true;
        if (!editorialText) warning = "La descripción editorial está vacía. Edita la pestaña Editorial para que esta card tenga cuerpo.";
      }
      return { eyebrow, title, body, cta, warning, editorialLink };
    };
    const renderContentPreview = (cfg) => {
      const root = $("[data-content-preview]");
      if (!root) return;
      const frame = root.querySelector("[data-cp-frame]");
      const stage = root.querySelector("[data-cp-stage]");
      const card = root.querySelector("[data-cp-card]");
      if (!frame || !stage || !card) return;

      const { eyebrow, title, body, cta, warning, editorialLink } = resolveContentPreview(cfg);
      const setText = (sel, txt) => {
        const el = root.querySelector(sel);
        if (el) el.textContent = txt || "";
      };
      setText("[data-cp-eyebrow]", eyebrow);
      setText("[data-cp-title]",   title);
      setText("[data-cp-body]",    body);
      setText("[data-cp-cta]",     cta);

      // Render the card at its REAL desktop dimensions so line-clamp,
      // padding and spacing behave identically to the public site.
      // Then transform: scale() the stage to fit the form column.
      const d = cfg.desktop ?? {};
      const cardW = d.width > 0 ? d.width : 760;
      const cardH = d.height > 0 ? d.height : 520;
      const padding = d.padding ?? 56;
      const bg = hexToRgba(d.bg_color || "#1a1715", d.bg_alpha ?? 1);
      const bgRule = d.bg_image_url
        ? `linear-gradient(${bg}, ${bg}), url('${d.bg_image_url}') center/cover no-repeat`
        : bg;
      card.style.width = `${cardW}px`;
      card.style.minHeight = `${cardH}px`;
      card.style.padding = `${padding}px`;
      card.style.background = bgRule;
      card.style.color = d.text_color || "#f5f1ea";
      card.style.borderRadius = `${d.border_radius_tl || 0}px ${d.border_radius_tr || 0}px ${d.border_radius_br || 0}px ${d.border_radius_bl || 0}px`;
      card.style.boxShadow = d.shadow ? "0 25px 50px -12px rgba(0,0,0,0.25)" : "0 6px 14px -8px rgba(0,0,0,0.18)";
      card.style.setProperty("--cp-title-font",   HERO_CARD_FONTS_MAP[d.title_font]   || HERO_CARD_FONTS_MAP.serif);
      card.style.setProperty("--cp-eyebrow-font", HERO_CARD_FONTS_MAP[d.eyebrow_font] || HERO_CARD_FONTS_MAP.sans);
      card.style.setProperty("--cp-body-font",    HERO_CARD_FONTS_MAP[d.body_font]    || HERO_CARD_FONTS_MAP.sans);
      card.style.setProperty("--cp-cta-font",     HERO_CARD_FONTS_MAP[d.cta_font]     || HERO_CARD_FONTS_MAP.sans);

      // Fit the card horizontally; never up-scale (max scale = 1).
      const frameW = frame.clientWidth - 16;
      const scale = frameW > 0 ? Math.min(frameW / cardW, 1) : 0.5;
      stage.style.transform = `scale(${scale})`;
      stage.style.width = `${cardW}px`;
      stage.style.height = `${cardH}px`;
      stage.style.left = `${Math.max(8, (frame.clientWidth - cardW * scale) / 2)}px`;
      stage.style.top = "8px";
      // Frame height tracks the scaled card height + padding.
      frame.style.height = `${Math.max(160, cardH * scale + 16)}px`;

      const warn = root.querySelector("[data-cp-warning]");
      if (warn) {
        if (warning) { warn.textContent = warning; warn.hidden = false; }
        else { warn.hidden = true; }
      }
      const link = root.querySelector("[data-cp-edit-editorial]");
      if (link) link.hidden = !editorialLink;
    };

    // ----- Preview render -----
    // Visual styles that don't depend on positioning (bg, color, radius,
    // padding, font, shadow, blur, min-height). Position/size is set in
    // applyDesktopPos/applyMobilePos because those differ between layouts.
    const applyVisuals = (card, layout) => {
      const bg = hexToRgba(layout.bg_color, layout.bg_alpha);
      const bgRule = layout.bg_image_url
        ? `linear-gradient(${bg}, ${bg}), url('${layout.bg_image_url}') center/cover no-repeat`
        : bg;
      card.style.background = bgRule;
      card.style.color = layout.text_color;
      card.style.borderRadius = `${layout.border_radius_tl}px ${layout.border_radius_tr}px ${layout.border_radius_br}px ${layout.border_radius_bl}px`;
      card.style.padding = `${layout.padding}px`;
      card.style.minHeight = `${layout.height}px`;
      card.style.boxShadow = layout.shadow ? "0 25px 50px -12px rgba(0,0,0,0.25)" : "none";
      card.style.backdropFilter = layout.bg_blur > 0 ? `blur(${layout.bg_blur}px)` : "none";
      card.style.webkitBackdropFilter = layout.bg_blur > 0 ? `blur(${layout.bg_blur}px)` : "none";
      // Apply each chosen typeface to the matching preview element.
      // HERO_CARD_FONTS_MAP mirrors the same-named map in
      // apps/web/src/lib/hero-card.ts; both must list the same codes.
      const fontFor = (key, fallback) => HERO_CARD_FONTS_MAP[key] || HERO_CARD_FONTS_MAP[fallback] || HERO_CARD_FONTS_MAP.serif;
      const apply = (sel, family) => {
        const el = card.querySelector(sel);
        if (el) el.style.fontFamily = family;
      };
      apply("[data-preview-title]",   fontFor(layout.title_font,   "serif"));
      apply("[data-preview-eyebrow]", fontFor(layout.eyebrow_font, "sans"));
      apply("[data-preview-body]",    fontFor(layout.body_font,    "sans"));
      apply("[data-preview-cta]",     fontFor(layout.cta_font,     "sans"));
    };

    // Desktop: card sits absolute over the right-half hero image. Margin-right
    // is intentionally 0 so the card extends past the 50% divider.
    const applyDesktopPos = (card, layout) => {
      card.style.position = "absolute";
      card.style.left = `${layout.offset_x}px`;
      card.style.top = `calc(50% + ${layout.offset_y}px)`;
      card.style.transform = "translateY(-50%)";
      card.style.alignSelf = "auto";
      card.style.marginLeft = "0";
      card.style.marginTop = "0";
      card.style.marginRight = "0";
      card.style.marginBottom = "0";
      card.style.width = layout.width > 0 ? `${layout.width}px` : "auto";
      card.style.maxWidth = layout.width > 0 ? "100%" : `calc(100% - ${layout.offset_x * 2}px)`;
    };

    // Mobile: card is in flow inside a flex-col stage; offset_x mirrors to
    // both sides for visual balance, matching the public site rendering.
    const applyMobilePos = (card, layout) => {
      card.style.position = "static";
      card.style.left = "auto";
      card.style.top = "auto";
      card.style.transform = "none";
      card.style.marginLeft = `${layout.offset_x}px`;
      card.style.marginRight = `${layout.offset_x}px`;
      card.style.marginTop = `${layout.offset_y}px`;
      card.style.marginBottom = "0";
      if (layout.width > 0) {
        card.style.width = `${layout.width}px`;
        card.style.maxWidth = "100%";
        card.style.alignSelf = "flex-start";
      } else {
        card.style.width = "auto";
        card.style.maxWidth = "none";
        card.style.alignSelf = "stretch";
      }
    };

    const applyContent = (card, cfg) => {
      // Reuse the mini-preview's resolver so the right-side preview
      // and the inline mini preview agree on title / body / cta —
      // including the markdown teaser fallback when the latest
      // post / book has no excerpt or subtitle.
      const resolved = resolveContentPreview(cfg);
      const m = cfg.manual ?? {};
      const ctaHref = (m.cta_href ?? "").trim();
      const c = {
        eyebrow: resolved.eyebrow,
        title: resolved.title,
        body: resolved.body,
        cta_label: resolved.cta,
        cta_href: cfg.content_source === "latest_post"
          ? (LATEST_POST ? `/articulos/${LATEST_POST.slug}` : "#")
          : cfg.content_source === "latest_book"
          ? (LATEST_BOOK ? `/catalogo/${LATEST_BOOK.slug}` : "#")
          : (ctaHref || "/catalogo"),
      };
      const eyebrow = card.querySelector("[data-preview-eyebrow]");
      const title = card.querySelector("[data-preview-title]");
      const body = card.querySelector("[data-preview-body]");
      const cta = card.querySelector("[data-preview-cta]");
      if (eyebrow) {
        eyebrow.textContent = c.eyebrow || "";
        eyebrow.style.display = c.eyebrow ? "block" : "none";
      }
      if (title) {
        title.textContent = c.title || "";
        // Clear inline display so the [data-preview-title] CSS rule
        // (display: -webkit-box) governs and -webkit-line-clamp can
        // truncate. Only set "none" inline when there's no text.
        title.style.display = c.title ? "" : "none";
      }
      if (body) {
        body.textContent = c.body || "";
        body.style.display = c.body ? "" : "none";
      }
      if (cta) cta.textContent = c.cta_label || "";
      card.href = c.cta_href || "#";
    };

    // Render into a target preview (inline or fullscreen). Pulls the
    // current cfg from the form once at the top so both targets stay
    // in sync.
    const renderInto = (els, platform, cfg, heroImageUrl) => {
      if (!els.stage || !els.card || !els.frame) return;
      const layout = platform === "desktop" ? cfg.desktop : cfg.mobile;
      applyVisuals(els.card, layout);
      applyContent(els.card, cfg);

      // Title font-size is governed by the [data-platform=...] CSS
      // rules; no inline override needed (and an inline value would
      // beat the rule, breaking platform parity).

      if (platform === "desktop") {
        els.stage.style.display = "block";
        if (els.bgImage) {
          els.bgImage.style.display = "block";
          els.bgImage.style.backgroundImage = `url('${heroImageUrl}')`;
        }
        if (els.mobileImg) els.mobileImg.style.display = "none";
        applyDesktopPos(els.card, layout);
      } else {
        els.stage.style.display = "flex";
        els.stage.style.flexDirection = "column";
        if (els.bgImage) els.bgImage.style.display = "none";
        applyMobilePos(els.card, layout);
        if (els.mobileImg) {
          els.mobileImg.style.display = "block";
          els.mobileImg.src = heroImageUrl;
          els.mobileImg.style.width = "100%";
          els.mobileImg.style.aspectRatio = "4 / 3";
          els.mobileImg.style.objectFit = "cover";
          els.mobileImg.style.marginTop = "24px";
        }
      }

      const fw = els.frame.clientWidth - 16;
      const fh = els.frame.clientHeight - 16;
      const targetW = platform === "desktop" ? FRAME_DESKTOP_W : FRAME_MOBILE_W;
      const targetH = platform === "desktop" ? FRAME_DESKTOP_H : FRAME_MOBILE_H;
      const fitScale = platform === "desktop"
        ? Math.min(fw / targetW, fh / targetH, 1)
        : Math.min(fw / targetW, 1);
      const zoom = getPreviewZoom();
      const finalScale = fitScale * zoom;
      els.stage.style.width = `${targetW}px`;
      els.stage.style.height = platform === "desktop" ? `${targetH}px` : "auto";
      els.stage.style.minHeight = platform === "mobile" ? `${targetH}px` : "";
      els.stage.dataset.platform = platform;
      els.stage.style.transformOrigin = "top left";
      els.stage.style.transform = `scale(${finalScale})`;
      els.stage.style.position = "absolute";
      els.stage.style.top = "8px";
      const scaledW = targetW * finalScale;
      const offsetLeft = (els.frame.clientWidth - scaledW) / 2;
      els.stage.style.left = zoom > 1
        ? "8px"
        : `${Math.max(8, offsetLeft)}px`;
      if (els.frame) {
        if (zoom > 1) els.frame.setAttribute("data-preview-zoomed", "true");
        else els.frame.removeAttribute("data-preview-zoomed");
      }

      if (els.meta) els.meta.textContent = `${platform} · ${targetW} × ${targetH}`;
    };

    const inlineEls = () => ({
      stage: $("[data-preview-stage]"),
      card: $("[data-preview-card]"),
      bgImage: $("[data-preview-bg-image]"),
      mobileImg: $("[data-preview-mobile-img]"),
      frame: $("[data-preview-frame]"),
      meta: $("[data-preview-meta]"),
    });
    const fullscreenEls = () => ({
      stage: $("[data-fullscreen-stage]"),
      card: $("[data-fullscreen-card]"),
      bgImage: $("[data-fullscreen-bg-image]"),
      mobileImg: $("[data-fullscreen-mobile-img]"),
      frame: $("[data-fullscreen-frame]"),
      meta: $("[data-fullscreen-meta]"),
    });

    // Cross-platform fallback for the card's bg image. If only one
    // side has an image set, the other reuses it. Mirrors the same
    // logic in apps/web/src/lib/hero-card.ts so the preview matches
    // what visitors will see.
    const applyBgImageFallback = (cfg) => {
      const dImg = (cfg.desktop?.bg_image_url || "").trim();
      const mImg = (cfg.mobile?.bg_image_url || "").trim();
      const merged = dImg || mImg;
      const out = structuredClone(cfg);
      out.desktop.bg_image_url = dImg || merged;
      out.mobile.bg_image_url = mImg || merged;
      return out;
    };

    // Show / hide each platform's "using fallback" hint based on
    // whether that platform's own bg_image_url is empty while the
    // other one has a value.
    const updateBgFallbackHints = (cfg) => {
      const dImg = (cfg.desktop?.bg_image_url || "").trim();
      const mImg = (cfg.mobile?.bg_image_url || "").trim();
      $$("[data-bg-image-row]").forEach(row => {
        const platform = row.getAttribute("data-bg-image-row");
        const own = platform === "desktop" ? dImg : mImg;
        const other = platform === "desktop" ? mImg : dImg;
        const hint = row.querySelector("[data-bg-fallback-hint]");
        if (hint) hint.hidden = !(own === "" && other !== "");
      });
    };

    // Frame sizes reused across position bounds + preview render.
    const PLATFORM_FRAMES = { desktop: { w: 1440, h: 720 }, mobile: { w: 390, h: 720 } };

    // Compute the valid range for each X / Y input given the current
    // card width/height, then sync the input's min/max attrs, clamp
    // the value if it's out of range, and disable the appropriate
    // stepper buttons. If both bounds collapse to the same number
    // (the card is wider/taller than the frame so it can't move at
    // all on that axis) the input itself is disabled too.
    const updatePositionBounds = () => {
      ["desktop", "mobile"].forEach(platform => {
        const frame = PLATFORM_FRAMES[platform];
        const xInput = document.querySelector(`[data-bind="${platform}.offset_x"]`);
        const yInput = document.querySelector(`[data-bind="${platform}.offset_y"]`);
        const wInput = document.querySelector(`[data-bind="${platform}.width"]`);
        const hInput = document.querySelector(`[data-bind="${platform}.height"]`);
        if (!xInput || !yInput) return;

        const w = Number(wInput?.value) || 0;
        const h = Number(hInput?.value) || 0;
        const xCur = Number(xInput.value) || 0;
        const yCur = Number(yInput.value) || 0;

        // Effective card dimensions matching the public-site layout.
        let effW;
        if (w > 0) {
          effW = Math.min(w, frame.w);
        } else if (platform === "mobile") {
          effW = Math.max(0, frame.w - xCur * 2);
        } else {
          effW = Math.max(0, frame.w - xCur);
        }
        const effH = Math.max(0, Math.min(h, frame.h));

        let xMin, xMax, yMin, yMax;
        if (platform === "desktop") {
          xMin = 0;
          xMax = Math.max(0, frame.w - effW);
          const ySpan = Math.max(0, (frame.h - effH) / 2);
          yMin = -ySpan;
          yMax = ySpan;
        } else {
          xMin = 0;
          if (w > 0) xMax = Math.max(0, Math.floor((frame.w - effW) / 2));
          else xMax = Math.max(0, Math.floor((frame.w - 80) / 2));
          yMin = 0;
          yMax = Math.max(0, frame.h - effH);
        }

        // Clamp current value if it slipped out of bounds (e.g. the
        // user enlarged the card after moving it).
        const newX = Math.max(xMin, Math.min(xMax, xCur));
        const newY = Math.max(yMin, Math.min(yMax, yCur));
        if (newX !== xCur) xInput.value = String(newX);
        if (newY !== yCur) yInput.value = String(newY);

        xInput.min = String(xMin);
        xInput.max = String(xMax);
        yInput.min = String(yMin);
        yInput.max = String(yMax);

        const xLocked = xMin === xMax;
        const yLocked = yMin === yMax;
        xInput.disabled = xLocked;
        yInput.disabled = yLocked;
        xInput.closest(".hcc-pos-row")?.setAttribute("data-locked", xLocked ? "true" : "false");
        yInput.closest(".hcc-pos-row")?.setAttribute("data-locked", yLocked ? "true" : "false");

        const xMinusBtn = document.querySelector(`[data-step-target="${platform}.offset_x"][data-step="-8"]`);
        const xPlusBtn = document.querySelector(`[data-step-target="${platform}.offset_x"][data-step="8"]`);
        const yMinusBtn = document.querySelector(`[data-step-target="${platform}.offset_y"][data-step="-8"]`);
        const yPlusBtn = document.querySelector(`[data-step-target="${platform}.offset_y"][data-step="8"]`);
        if (xMinusBtn) xMinusBtn.disabled = newX <= xMin;
        if (xPlusBtn) xPlusBtn.disabled = newX >= xMax;
        if (yMinusBtn) yMinusBtn.disabled = newY <= yMin;
        if (yPlusBtn) yPlusBtn.disabled = newY >= yMax;
      });
    };

    const renderHeroPreview = () => {
      // Legacy hero-card panel was removed (replaced by direct text
      // inputs for the new wordmark hero). If the form no longer has
      // a [data-hero-json] hidden input, there is nothing to render.
      if (!$("[data-hero-json]")) return;
      // Raw cfg — preserves empty bg_image_url so the user's intent
      // ("no image set on this side") is what we save to Supabase.
      const cfg = readHeroForm();
      currentHeroCfg = cfg;
      updateBgFallbackHints(cfg);
      updatePositionBounds();
      renderContentPreview(cfg);
      const heroJson = $("[data-hero-json]");
      if (heroJson) heroJson.value = JSON.stringify(cfg);
      // Preview cfg — bg image falls back across platforms so the
      // CMS preview matches what the public site will render.
      const previewCfg = applyBgImageFallback(cfg);

      // Mirror inputs (read-only labels next to color/range)
      $$("[data-bind]").forEach(el => {
        const path = el.getAttribute("data-bind");
        const v = getByPath(cfg, path);
        const mirror = el.parentElement?.querySelector(`[data-bind-mirror="${path}"]`);
        if (mirror && mirror !== el) {
          if (mirror.tagName === "INPUT") mirror.value = String(v);
          else mirror.textContent = String(v);
        }
      });

      // Color swatches: paint the visual swatch with the current hex.
      $$('input[type="color"][data-bind]').forEach(inp => {
        const swatch = inp.parentElement?.querySelector('[data-color-swatch]');
        if (swatch) swatch.style.setProperty("--swatch-color", inp.value);
      });
      // Alpha percentage readouts
      $$("[data-alpha-pct]").forEach(el => {
        const path = el.getAttribute("data-alpha-pct");
        const v = getByPath(cfg, path);
        el.textContent = `${Math.round((Number(v) || 0) * 100)}%`;
      });
      // Blur px readouts
      $$("[data-blur-px]").forEach(el => {
        const path = el.getAttribute("data-blur-px");
        const v = getByPath(cfg, path);
        el.textContent = `${Math.round(Number(v) || 0)}px`;
      });

      const heroImgInput = document.querySelector('input[type="hidden"][name="hero_image_url"]');
      const heroImageUrl = (heroImgInput?.value || "").trim() || HERO_FALLBACK_URL;

      // Inline preview (the right-side panel inside the Hero tab)
      renderInto(inlineEls(), currentPreviewTab, previewCfg, heroImageUrl);

      // Fullscreen preview, when open
      const modal = $("[data-fullscreen-modal]");
      if (modal && !modal.hasAttribute("hidden")) {
        const fsPlatform = modal.getAttribute("data-current-platform") || "desktop";
        renderInto(fullscreenEls(), fsPlatform, previewCfg, heroImageUrl);
      }
    };

    // Open / close fullscreen
    const openFullscreen = (platform) => {
      const modal = $("[data-fullscreen-modal]");
      if (!modal) return;
      modal.removeAttribute("hidden");
      modal.setAttribute("data-current-platform", platform);
      const label = $("[data-fullscreen-platform-label]");
      if (label) label.textContent = platform === "desktop" ? "Web" : "Mobile";
      document.body.style.overflow = "hidden";
      // Render now and on next tick (to ensure layout is finalized)
      renderHeroPreview();
      requestAnimationFrame(renderHeroPreview);
    };
    const closeFullscreen = () => {
      const modal = $("[data-fullscreen-modal]");
      if (!modal) return;
      modal.setAttribute("hidden", "");
      modal.removeAttribute("data-current-platform");
      document.body.style.overflow = "";
    };

    // ----- Hero fallback "En uso / Inactiva" badge -----
    const updateHeroFallbackStatus = () => {
      const form = $("[data-site-form]");
      if (!form) return;
      const hidden = form.querySelector('input[type="hidden"][name="hero_image_url"]');
      const wrap = form.querySelector("[data-hero-fallback-status]");
      if (!hidden || !wrap) return;
      const dot = wrap.querySelector("[data-hero-fallback-dot]");
      const label = wrap.querySelector("[data-hero-fallback-label]");
      if (!dot || !label) return;
      const inUse = !hidden.value;
      wrap.className = "mt-2 inline-flex items-center gap-1 px-1.5 py-0.5 self-start text-[10px] font-medium uppercase tracking-wider rounded-sm border";
      if (inUse) {
        wrap.classList.add("bg-emerald-50", "text-emerald-700", "border-emerald-200");
        dot.className = "w-1.5 h-1.5 rounded-full bg-emerald-500";
        label.textContent = "En uso";
      } else {
        wrap.classList.add("bg-stone-100", "text-stone-500", "border-stone-200");
        dot.className = "w-1.5 h-1.5 rounded-full bg-stone-400";
        label.textContent = "Inactiva";
      }
    };

    // ColorEditor helpers — every <ColorEditor> renders the same
    // [data-color-editor] wrapper with a child color input, swatch,
    // hex span, optional X reset, and optional hidden form input.
    // Behavior is centralized here so reset/edit-hex/swatch-paint
    // work consistently across every instance.
    const HERO_BG_DEFAULT_PREVIEW = "#f5f1ea"; // matches public site --bg-alt
    const HEX_RX = /^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/;
    const expandHex = (s) => (s.length === 3 ? s.split("").map(c => c + c).join("") : s).toLowerCase();
    const renderColorEditor = (editor) => {
      const inp = editor.querySelector("[data-color-input]");
      const swatch = editor.querySelector("[data-color-swatch]");
      const hex = editor.querySelector("[data-color-hex]");
      const isSet = editor.dataset.set !== "false";
      const v = (inp?.value || "").toLowerCase();
      if (swatch) swatch.style.setProperty("--swatch-color", isSet ? v : "transparent");
      // Don't overwrite the hex text the user is currently editing.
      if (hex && document.activeElement !== hex) {
        hex.textContent = isSet ? v : "Por defecto";
      }
      // Special: the hero page bg editor mirrors itself onto the
      // preview frames so the editor sees the public-site bg live.
      if (editor.dataset.colorEditorId === "hero-bg") {
        const applyTo = (el) => { if (el) el.style.background = isSet ? v : ""; };
        applyTo($("[data-preview-frame]"));
        applyTo($("[data-fullscreen-frame]"));
      }
    };
    const renderAllColorEditors = () => {
      $$("[data-color-editor]").forEach(renderColorEditor);
    };

    // ----- Hero preview (web + mobile, lives inline in the Hero tab) -----
    // Mirrors the wordmark + tagline + CTAs + image + bg color into the
    // two preview frames (web with side image, mobile with stacked image).
    // Cheap enough to run on every input/change without throttling.
    const renderHeroTextPreview = () => {
      const form = $("[data-site-form]");
      const preview = $("[data-hero-preview]");
      if (!form || !preview) return;
      const getVal = (name) => {
        const el = form.querySelector(`[name="${name}"]`);
        return el && typeof el.value === "string" ? el.value : "";
      };
      const title = getVal("hero_title") || "—";
      const tagline = getVal("hero_tagline");
      const ctaPrimary = getVal("hero_cta_primary_label");
      const ctaSecondary = getVal("hero_cta_secondary_label");
      const heroImage = getVal("hero_image_url").trim() || HERO_FALLBACK_URL;
      const bg = getVal("hero_bg_color").trim();

      // Helpers to set text + empty-state in pairs (web / mobile).
      const setPair = (sel, value) => {
        document.querySelectorAll(sel).forEach((el) => { el.textContent = value; });
      };
      const setEmpty = (sel, value) => {
        document.querySelectorAll(sel).forEach((el) => {
          el.dataset.empty = value ? "0" : "1";
        });
      };

      setPair("[data-pv-web-title], [data-pv-mobile-title]", title);
      setPair("[data-pv-web-tagline], [data-pv-mobile-tagline]", tagline || "—");
      setPair("[data-pv-web-primary-label], [data-pv-mobile-primary-label]", ctaPrimary);
      setPair("[data-pv-web-secondary-label], [data-pv-mobile-secondary-label]", ctaSecondary);
      setEmpty("[data-pv-web-primary], [data-pv-mobile-primary]", ctaPrimary);
      setEmpty("[data-pv-web-secondary], [data-pv-mobile-secondary]", ctaSecondary);

      // Hero image — same fallback the public site uses.
      const imageUrl = `url('${heroImage.replace(/'/g, "%27")}')`;
      const webImg = $("[data-pv-image-web]");
      const mobImg = $("[data-pv-image-mobile]");
      if (webImg) webImg.style.backgroundImage = imageUrl;
      if (mobImg) mobImg.style.backgroundImage = imageUrl;

      // Bg color shared across both frames. Falls back to the same
      // --bg-alt token the public site uses when nothing's been set.
      const webBg = $("[data-pv-bg]");
      const mobBg = $("[data-pv-bg-mobile]");
      const bgValue = bg || "oklch(99% 0.003 70)";
      if (webBg) webBg.style.backgroundColor = bgValue;
      if (mobBg) mobBg.style.backgroundColor = bgValue;
    };

    // ----- Live previews of /catalogo/[slug] and /articulos/[slug] -----
    // Each panel ("Catálogo > Libro" and "Publicaciones > Publicación")
    // has a single DetailTypographyPanel + a preview card. The dropdowns
    // emit `change` events that we listen for and reflect on the preview
    // via two CSS vars on the wrapper: --pv-title-font / --pv-body-font.
    // We also seed the cover image with LATEST_BOOK / LATEST_POST so the
    // editor sees the real piece of content the public site will render.
    const resolveFamily = (key) => FONT_FAMILY_MAP[key] || FONT_FAMILY_MAP.serif;
    const initDetailPreview = (root, namePrefix) => {
      if (!root) return;
      const titleSelect = document.querySelector(`[name="${namePrefix}_title_font"]`);
      const bodySelect = document.querySelector(`[name="${namePrefix}_body_font"]`);
      const apply = () => {
        if (titleSelect && titleSelect.value) {
          root.style.setProperty("--pv-title-font", resolveFamily(titleSelect.value));
        }
        if (bodySelect && bodySelect.value) {
          root.style.setProperty("--pv-body-font", resolveFamily(bodySelect.value));
        }
      };
      apply();
      titleSelect?.addEventListener("change", apply);
      bodySelect?.addEventListener("change", apply);
      // Dropdown.astro emits the `change` event after the user picks
      // an option in the custom listbox; native <select fallback> also
      // fires `change`. Both are covered here.
    };
    const hydrateDetailCovers = () => {
      const bookCover = document.querySelector("[data-pv-book-cover]");
      if (bookCover) {
        const url = LATEST_BOOK?.cover_image_url?.trim();
        if (url) {
          bookCover.style.backgroundImage = `url('${url.replace(/'/g, "%27")}')`;
          bookCover.dataset.empty = "0";
        } else {
          bookCover.dataset.empty = "1";
        }
      }
      const publicationCover = document.querySelector("[data-pv-publication-cover]");
      if (publicationCover) {
        const url = LATEST_POST?.cover_image_url?.trim();
        if (url) {
          publicationCover.style.backgroundImage = `url('${url.replace(/'/g, "%27")}')`;
          publicationCover.dataset.empty = "0";
        } else {
          publicationCover.dataset.empty = "1";
        }
      }
    };
    const initAllDetailPreviews = () => {
      initDetailPreview(document.querySelector("[data-book-detail-preview]"), "book_detail");
      initDetailPreview(document.querySelector("[data-publication-detail-preview]"), "article_detail");
      hydrateDetailCovers();
    };

    // ----- Hydration of all site_configuration -----
    const apply = (cfg) => {
      const form = $("[data-site-form]");
      if (!form) return;
      const set = (name, value) => {
        const el = form.querySelector(`[name="${name}"]`);
        if (el && typeof value === "string") el.value = value;
      };
      set("hero_quote", cfg.hero_quote ?? "");
      set("hero_quote_author", cfg.hero_quote_author ?? "");
      set("editorial_description", cfg.editorial_description ?? "");
      set("footer_legal", cfg.footer_legal ?? "");
      set("whatsapp_phone", cfg.whatsapp_phone ?? "");
      set("whatsapp_message_template", cfg.whatsapp_message_template ?? "");
      set("contact_email", cfg.contact_email ?? "");
      set("contact_address", cfg.contact_address ?? "");
      set("contact_hours", cfg.contact_hours ?? "");
      // Multi-row contact / social lists
      listEditors.get("contact_emails_extra")?.setData(Array.isArray(cfg.contact_emails_extra) ? cfg.contact_emails_extra : []);
      listEditors.get("contact_addresses_extra")?.setData(Array.isArray(cfg.contact_addresses_extra) ? cfg.contact_addresses_extra : []);
      listEditors.get("contact_phones")?.setData(Array.isArray(cfg.contact_phones) ? cfg.contact_phones : []);
      listEditors.get("social_accounts")?.setData(Array.isArray(cfg.social_accounts) ? cfg.social_accounts : []);
      const social = (cfg.social_links ?? {});
      set("social_facebook", social.facebook ?? "");
      set("social_instagram", social.instagram ?? "");
      set("social_twitter", social.twitter ?? "");
      const kws = Array.isArray(cfg.default_keywords) ? cfg.default_keywords.join(", ") : (cfg.default_keywords ?? "");
      set("default_keywords", kws);
      set("twitter_handle", cfg.twitter_handle ?? "");
      const setImage = (name, value) => {
        const hidden = form.querySelector(`input[type="hidden"][name="${name}"]`);
        const wrapper = hidden?.closest("[data-image-upload]");
        if (wrapper && typeof wrapper.__casSetImage === "function") {
          wrapper.__casSetImage(typeof value === "string" ? value : "");
        }
      };
      setImage("og_image_default", cfg.og_image_default ?? "");
      setImage("organization_logo_url", cfg.organization_logo_url ?? "");
      setImage("hero_image_url", cfg.hero_image_url ?? "");
      updateHeroFallbackStatus();

      // Hero page bg color — find its ColorEditor and seed the value.
      const heroBgEditor = form.querySelector('[data-color-editor-id="hero-bg"]');
      if (heroBgEditor) {
        const heroBgInput = heroBgEditor.querySelector("[data-color-input]");
        const heroBgHidden = heroBgEditor.querySelector("[data-color-hidden]");
        const stored = (cfg.hero_bg_color ?? "").trim();
        if (heroBgInput) heroBgInput.value = stored || HERO_BG_DEFAULT_PREVIEW;
        if (heroBgHidden) heroBgHidden.value = stored;
        heroBgEditor.dataset.set = stored ? "true" : "false";
        renderColorEditor(heroBgEditor);
      }

      // Hero textos — wordmark, tagline, CTAs.
      set("hero_title", cfg.hero_title ?? "Casa de\nAsterión\nEdiciones");
      set("hero_tagline", cfg.hero_tagline ?? "Libros que no se apuran: filosofía y poesía editadas con tiempo y oficio.");
      set("hero_cta_primary_label", cfg.hero_cta_primary_label ?? "Entrar al catálogo");
      set("hero_cta_primary_href", cfg.hero_cta_primary_href ?? "/catalogo");
      set("hero_cta_secondary_label", cfg.hero_cta_secondary_label ?? "Leer publicaciones");
      set("hero_cta_secondary_href", cfg.hero_cta_secondary_href ?? "/articulos");
      // Live preview of the hero is part of the same panel; refresh
      // every time apply() runs so the bg color, image color and
      // texts stay in sync with whatever the inputs currently hold.
      renderHeroTextPreview();

      // The form has just been populated with the server values; tell
      // the FormActions dirty-tracker to take this as the new baseline.
      // The submit button stays disabled until the user changes
      // something — much better UX than "enabled from the start".
      form.dispatchEvent(new CustomEvent("cas:resnapshot", { bubbles: true }));
    };

    const hydrate = async () => {
      if (!$("[data-site-form]")) return;
      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) apply(parsed.cfg);
        }
      } catch {}
      try {
        const res = await fetch("/api/page-data?type=site", { credentials: "same-origin", headers: { accept: "application/json" } });
        if (!res.ok) return;
        const data = await res.json();
        apply(data.config ?? {});
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), cfg: data.config })); } catch {}
      } catch {}
    };

    // Centralized tab switcher — used by clicks on the preview tabs and by
    // auto-switch when the user starts editing controls of a different
    // platform.
    const switchPreviewTab = (name) => {
      if (name !== "desktop" && name !== "mobile") return;
      if (currentPreviewTab === name) return;
      currentPreviewTab = name;
      $$("[data-preview-tab]").forEach(b => b.classList.toggle("cas-preview-tab-active", b.getAttribute("data-preview-tab") === name));
      $$("[data-platform-section]").forEach(sec => {
        sec.style.outline = sec.getAttribute("data-platform-section") === name ? "2px solid rgb(28 25 23)" : "";
        sec.style.outlineOffset = "-2px";
      });
      renderHeroPreview();
    };

    // ----- Contact list editors (emails / phones / addresses / social) -----
    // One generic helper builds and wires a list editor based on its
    // [data-list-template] attribute. Each row is a typed object;
    // every input/change syncs the array into a hidden JSON input
    // that the form POST submits as foo_json. The Astro handler
    // parses each foo_json and upserts under its real config key.
    const SOCIAL_PLATFORMS = [
      { value: "instagram", label: "Instagram" },
      { value: "facebook",  label: "Facebook" },
      { value: "twitter",   label: "Twitter / X" },
      { value: "youtube",   label: "YouTube" },
      { value: "linkedin",  label: "LinkedIn" },
      { value: "tiktok",    label: "TikTok" },
      { value: "threads",   label: "Threads" },
      { value: "bluesky",   label: "Bluesky" },
      { value: "website",   label: "Sitio web" },
      { value: "other",     label: "Otro" },
    ];
    const REMOVE_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    const attachListEditor = (root) => {
      // Reuse the cached instance if this root was already wired
      // earlier in this page's lifetime. Without this guard, every
      // call to wireForm (DOMContentLoaded + astro:page-load +
      // astro:after-swap) re-attached a new "Agregar" listener,
      // so a single click added 2+ rows. Same pattern used to
      // exist for phones / addresses / emails / social.
      if (root.__listEditor) return root.__listEditor;
      const tpl = root.getAttribute("data-list-template");
      const rowsEl = root.querySelector("[data-list-rows]");
      const addBtn = root.querySelector("[data-list-add]");
      const json = root.querySelector("[data-list-json]");
      let data = [];

      const makeInput = (type, k, value, placeholder) => {
        const el = type === "textarea" ? document.createElement("textarea") : document.createElement("input");
        if (type !== "textarea") el.type = type;
        el.className = "hcc-input";
        el.dataset.k = k;
        el.value = value ?? "";
        if (placeholder) el.placeholder = placeholder;
        if (type === "textarea") el.rows = 2;
        return el;
      };

      const buildRow = (item) => {
        const row = document.createElement("div");
        row.className = "cl-row";
        row.dataset.listRow = "";
        const fields = document.createElement("div");
        fields.className = "cl-row-fields";

        if (tpl === "email") {
          fields.style.gridTemplateColumns = "minmax(0, 1.6fr) minmax(0, 1fr)";
          fields.append(
            makeInput("email", "email", item.email, "ventas@ediciones.com"),
            makeInput("text",  "label", item.label, "Etiqueta (opcional)"),
          );
        } else if (tpl === "phone") {
          fields.style.gridTemplateColumns = "minmax(0, 1.4fr) minmax(0, 1fr)";
          fields.append(
            makeInput("tel",  "phone", item.phone, "+57 311 ..."),
            makeInput("text", "label", item.label, "Etiqueta (ej: prensa)"),
          );
          const cb = document.createElement("label");
          cb.className = "cl-row-checkbox";
          cb.style.gridColumn = "1 / -1";
          const cbIn = document.createElement("input");
          cbIn.type = "checkbox";
          cbIn.dataset.k = "whatsapp";
          cbIn.checked = !!item.whatsapp;
          const txt = document.createTextNode(" Es WhatsApp (abre wa.me en lugar de tel:)");
          cb.append(cbIn, txt);
          fields.appendChild(cb);
        } else if (tpl === "address") {
          fields.style.gridTemplateColumns = "minmax(0, 1fr)";
          fields.append(
            makeInput("text",     "label",   item.label,   "Etiqueta (ej: Sede principal)"),
            makeInput("textarea", "address", item.address, "Calle ..."),
          );
        } else if (tpl === "social") {
          fields.style.gridTemplateColumns = "minmax(120px, 150px) minmax(0, 1.4fr) minmax(0, 1fr)";
          const sel = document.createElement("select");
          sel.className = "hcc-input";
          sel.dataset.k = "platform";
          for (const p of SOCIAL_PLATFORMS) {
            const opt = document.createElement("option");
            opt.value = p.value;
            opt.textContent = p.label;
            if (p.value === (item.platform || "instagram")) opt.selected = true;
            sel.appendChild(opt);
          }
          fields.append(
            sel,
            makeInput("url",  "url",   item.url,   "https://..."),
            makeInput("text", "label", item.label, "Etiqueta (opcional)"),
          );
        }
        row.appendChild(fields);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "cl-row-remove";
        remove.dataset.listRemove = "";
        remove.setAttribute("aria-label", "Quitar");
        remove.innerHTML = REMOVE_SVG;
        row.appendChild(remove);
        return row;
      };

      const sync = () => {
        const next = [];
        rowsEl.querySelectorAll("[data-list-row]").forEach(row => {
          const obj = {};
          row.querySelectorAll("[data-k]").forEach(el => {
            const k = el.dataset.k;
            obj[k] = el.type === "checkbox" ? el.checked : el.value;
          });
          next.push(obj);
        });
        data = next;
        if (json) json.value = JSON.stringify(data);
      };

      const render = () => {
        rowsEl.innerHTML = "";
        data.forEach(item => rowsEl.appendChild(buildRow(item)));
        if (json) json.value = JSON.stringify(data);
      };

      rowsEl.addEventListener("input", sync);
      rowsEl.addEventListener("change", sync);
      rowsEl.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-list-remove]");
        if (!btn) return;
        btn.closest("[data-list-row]")?.remove();
        sync();
      });
      addBtn?.addEventListener("click", () => {
        const empty = tpl === "email"   ? { email: "", label: "" }
                    : tpl === "phone"   ? { phone: "", label: "", whatsapp: false }
                    : tpl === "address" ? { label: "", address: "" }
                    : tpl === "social"  ? { platform: "instagram", url: "", label: "" }
                    : {};
        data.push(empty);
        rowsEl.appendChild(buildRow(empty));
        if (json) json.value = JSON.stringify(data);
        rowsEl.lastElementChild?.querySelector("input, textarea, select")?.focus();
      });

      const instance = {
        setData(items) {
          data = Array.isArray(items) ? items.map(x => ({ ...x })) : [];
          render();
        },
        getData() { return [...data]; },
      };
      root.__listEditor = instance;
      return instance;
    };
    // listEditors is rebuilt on every boot so Astro view transitions
    // re-attach to the freshly swapped-in DOM nodes.
    let listEditors = new Map();

    // ----- Wire events -----
    const wireForm = () => {
      // Boot is called for both DOMContentLoaded and astro:page-load
      // (and astro:after-swap on transitions), so wireForm runs 2+
      // times per page life. Without a guard, every addEventListener
      // call below stacks up — clicking "Agregar otro …" added two
      // rows because two listeners fired. Mark the form once and
      // skip subsequent runs; listEditors are cached on their root
      // elements so re-querying still works for hydrate(). */
      const wireFormRoot = $("[data-site-form]");
      listEditors = new Map();
      $$("[data-list-editor]").forEach(root => {
        const name = root.getAttribute("data-list-editor");
        if (name) listEditors.set(name, attachListEditor(root));
      });
      if (wireFormRoot?.dataset.wired === "1") return;
      if (wireFormRoot) wireFormRoot.dataset.wired = "1";

      // Live-refresh the hero text preview while the user edits the
      // inline inputs. Delegated to the form root so it covers all six
      // fields (title, tagline, primary label/href, secondary label/href)
      // plus the bg color picker. cas:dirty also fires on programmatic
      // mutations (e.g. ColorEditor's hidden input change).
      if (wireFormRoot) {
        const fields = [
          "hero_title",
          "hero_tagline",
          "hero_cta_primary_label",
          "hero_cta_primary_href",
          "hero_cta_secondary_label",
          "hero_cta_secondary_href",
          "hero_bg_color",
        ];
        const onMaybeHeroChange = (ev) => {
          const t = ev.target;
          if (t && t.name && fields.includes(t.name)) renderHeroTextPreview();
        };
        wireFormRoot.addEventListener("input", onMaybeHeroChange);
        wireFormRoot.addEventListener("change", onMaybeHeroChange);
        // hero_bg_color comes from ColorEditor which fires cas:dirty
        // bubbling — refresh unconditionally on that event since it's
        // only emitted by the few widgets we care about.
        wireFormRoot.addEventListener("cas:dirty", renderHeroTextPreview);
        // ImageUpload fires cas:imageupload:change when the user picks
        // or clears an image; refresh so the new image shows up in the
        // preview without waiting for input/change to bubble.
        wireFormRoot.addEventListener("cas:imageupload:change", renderHeroTextPreview);
      }

      $$("[data-bind]").forEach(el => {
        el.addEventListener("input", renderHeroPreview);
        el.addEventListener("change", renderHeroPreview);
      });
      // Dropdown components emit a "change" event on their hidden input
      // when the user picks an option. Listen at the wrapper level so we
      // catch all of them in one place. The content_source dropdown
      // also drives the manual-fields visibility toggle.
      $$("[data-bind-dd]").forEach(wrap => {
        wrap.addEventListener("change", () => {
          if (wrap.getAttribute("data-bind-dd") === "content_source") {
            updateManualVisibility();
          }
          renderHeroPreview();
        });
      });
      // ColorEditor: wire native picker, X reset, and editable hex
      // for every instance. We listen at the form root so newly
      // hydrated inputs work without per-element wiring.
      const colorRoot = $("[data-site-form]");
      if (colorRoot) {
        // Picker change — sync hidden input, mark editor "set", repaint.
        colorRoot.addEventListener("input", (e) => {
          const inp = e.target.closest?.("[data-color-input]");
          if (!inp) return;
          const editor = inp.closest("[data-color-editor]");
          if (!editor) return;
          editor.dataset.set = "true";
          const hidden = editor.querySelector("[data-color-hidden]");
          if (hidden) hidden.value = inp.value;
          renderColorEditor(editor);
        });
        // X reset.
        colorRoot.addEventListener("click", (e) => {
          const btn = e.target.closest?.("[data-color-reset]");
          if (!btn) return;
          e.preventDefault();
          const editor = btn.closest("[data-color-editor]");
          if (!editor) return;
          const def = editor.getAttribute("data-color-default-value") ?? "";
          const inp = editor.querySelector("[data-color-input]");
          const hidden = editor.querySelector("[data-color-hidden]");
          if (def === "") {
            // "Use site default" mode — clear the hidden input and
            // mark unset; the swatch goes transparent, hex shows
            // "Por defecto", and any preview-frame mirror clears.
            editor.dataset.set = "false";
            if (hidden) hidden.value = "";
            if (inp) inp.value = HERO_BG_DEFAULT_PREVIEW;
          } else {
            // Typed-default mode — restore the documented default hex.
            editor.dataset.set = "true";
            if (hidden) hidden.value = def;
            if (inp) inp.value = def;
          }
          renderColorEditor(editor);
          // Trigger downstream listeners (hero card preview etc.)
          if (inp) {
            inp.dispatchEvent(new Event("input", { bubbles: true }));
            inp.dispatchEvent(new Event("change", { bubbles: true }));
          }
        });
        // Editable hex — typing a valid #abc / #abcdef updates the
        // picker live. Enter blurs to commit; blur normalizes the
        // displayed text.
        colorRoot.addEventListener("input", (e) => {
          const el = e.target.closest?.("[data-color-hex]");
          if (!el || !el.isContentEditable) return;
          const editor = el.closest("[data-color-editor]");
          const inp = editor?.querySelector("[data-color-input]");
          if (!editor || !inp) return;
          const raw = (el.textContent || "").trim();
          const m = HEX_RX.exec(raw);
          if (!m) return;
          const next = "#" + expandHex(m[1]);
          if (inp.value === next && editor.dataset.set === "true") return;
          inp.value = next;
          editor.dataset.set = "true";
          const hidden = editor.querySelector("[data-color-hidden]");
          if (hidden) hidden.value = next;
          // Repaint swatch + propagate to bind listeners (don't
          // rewrite the hex span — the user is editing it).
          const swatch = editor.querySelector("[data-color-swatch]");
          if (swatch) swatch.style.setProperty("--swatch-color", next);
          if (editor.dataset.colorEditorId === "hero-bg") {
            const applyTo = (frame) => { if (frame) frame.style.background = next; };
            applyTo($("[data-preview-frame]"));
            applyTo($("[data-fullscreen-frame]"));
          }
          inp.dispatchEvent(new Event("input", { bubbles: true }));
          inp.dispatchEvent(new Event("change", { bubbles: true }));
        });
        colorRoot.addEventListener("keydown", (e) => {
          const el = e.target.closest?.("[data-color-hex]");
          if (!el || !el.isContentEditable) return;
          if (e.key === "Enter") {
            e.preventDefault();
            el.blur();
          }
        });
        colorRoot.addEventListener("focusout", (e) => {
          const el = e.target.closest?.("[data-color-hex]");
          if (!el || !el.isContentEditable) return;
          const editor = el.closest("[data-color-editor]");
          if (!editor) return;
          renderColorEditor(editor);
        });
      }

      // URL combobox: a single editable input + a dropdown of detected
      // site pages. Type freely (custom routes), or click the chevron
      // (or focus and start typing) to filter and pick a known page.
      // The input itself is the source of truth — selecting a suggestion
      // just fills it.
      const combo = $("[data-url-combo]");
      if (combo && !combo.dataset.wired) {
        combo.dataset.wired = "1";
        const input  = combo.querySelector("[data-url-combo-input]");
        const toggle = combo.querySelector("[data-url-combo-toggle]");
        const list   = combo.querySelector("[data-url-combo-list]");
        let activeIdx = -1;

        const renderList = (q) => {
          const needle = q.trim().toLowerCase();
          const matches = !needle
            ? URL_OPTIONS
            : URL_OPTIONS.filter(o =>
                (o.value || "").toLowerCase().includes(needle) ||
                (o.label || "").toLowerCase().includes(needle) ||
                (o.hint  || "").toLowerCase().includes(needle)
              );
          list.innerHTML = "";
          if (matches.length === 0) {
            const empty = document.createElement("li");
            empty.className = "hcc-url-combo-empty";
            empty.style.cursor = "default";
            empty.textContent = "Sin coincidencias — la ruta que escribiste se usará tal cual.";
            list.appendChild(empty);
            return;
          }
          matches.forEach((o, i) => {
            const li = document.createElement("li");
            li.setAttribute("role", "option");
            li.dataset.value = o.value;
            if (i === activeIdx) li.dataset.active = "1";
            li.innerHTML = `
              <span class="uc-label">${escapeHtml(o.label || o.value)}</span>
              <span class="uc-hint">${escapeHtml(o.value)}</span>
            `;
            list.appendChild(li);
          });
        };

        const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => (
          { "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]
        ));

        const open = () => {
          activeIdx = -1;
          renderList(input.value);
          list.hidden = false;
          combo.dataset.open = "1";
        };
        const close = () => {
          list.hidden = true;
          delete combo.dataset.open;
        };
        const choose = (val) => {
          input.value = val;
          input.dispatchEvent(new Event("input",  { bubbles: true }));
          input.dispatchEvent(new Event("change", { bubbles: true }));
          close();
          input.focus();
        };

        toggle.addEventListener("click", () => {
          if (combo.dataset.open) close();
          else { open(); input.focus(); }
        });
        input.addEventListener("focus", open);
        input.addEventListener("input", () => {
          activeIdx = -1;
          if (!list.hidden) renderList(input.value);
        });
        list.addEventListener("mousedown", (e) => {
          // mousedown (not click) so the input doesn't lose focus first
          // and trigger the focusout-close handler below.
          const li = e.target.closest("li[data-value]");
          if (!li) return;
          e.preventDefault();
          choose(li.dataset.value);
        });
        // Close on click outside.
        document.addEventListener("mousedown", (e) => {
          if (!combo.contains(e.target)) close();
        });
        // Keyboard navigation.
        input.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            if (list.hidden) open();
            const items = list.querySelectorAll("li[data-value]");
            if (!items.length) return;
            activeIdx = (activeIdx + 1) % items.length;
            renderList(input.value);
            const active = list.querySelector('li[data-active="1"]');
            active?.scrollIntoView({ block: "nearest" });
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            const items = list.querySelectorAll("li[data-value]");
            if (!items.length) return;
            activeIdx = (activeIdx - 1 + items.length) % items.length;
            renderList(input.value);
            const active = list.querySelector('li[data-active="1"]');
            active?.scrollIntoView({ block: "nearest" });
          } else if (e.key === "Enter") {
            const items = list.querySelectorAll("li[data-value]");
            if (!list.hidden && activeIdx >= 0 && items[activeIdx]) {
              e.preventDefault();
              choose(items[activeIdx].dataset.value);
            }
          } else if (e.key === "Escape") {
            if (!list.hidden) { e.preventDefault(); close(); }
          }
        });
      }
      // Auto-switch the preview tab when the user focuses or changes a
      // control inside one of the platform-scoped sections. Catches
      // mouse + keyboard interaction.
      $$("[data-platform-section]").forEach(sec => {
        const platform = sec.getAttribute("data-platform-section");
        const trigger = () => switchPreviewTab(platform);
        sec.addEventListener("focusin", trigger);
        sec.addEventListener("input", trigger);
        sec.addEventListener("change", trigger);
      });
      // Scroll-spy for preview platform.
      // The previous IntersectionObserver implementation switched
      // erratically because multiple sections could intersect the
      // band simultaneously and the chosen "best" entry depended on
      // intersection ratio (which fluctuates with scroll velocity).
      // Replaced with a deterministic rAF-throttled scroll handler:
      // the active platform section is the LATEST one whose top has
      // crossed below a fixed trigger line (≈30% from viewport top,
      // skipping the sticky breadcrumb+tabs). A section is picked
      // only when its top is at-or-above that line; the last one to
      // qualify (by largest top value) wins. We only fire
      // switchPreviewTab when the active section actually changes,
      // so a user's explicit Web/Mobile click isn't fought by
      // unrelated micro-scrolls.
      const platformSections = $$("[data-platform-section]");
      // scrollSpyPaused is flipped on programmatic scrolls (e.g.
      // clicking the Web/Mobile preview tab) so the spy doesn't
      // flicker the preview while it scrolls past the OTHER
      // platform's section in transit.
      let scrollSpyPaused = false;
      if (platformSections.length) {
        let lastActive = null;
        let scrollScheduled = false;
        const evaluate = () => {
          scrollScheduled = false;
          if (scrollSpyPaused) return;
          const triggerY = Math.max(140, window.innerHeight * 0.3);
          let active = null;
          let activeTop = -Infinity;
          for (const sec of platformSections) {
            const rect = sec.getBoundingClientRect();
            if (rect.top <= triggerY && rect.top > activeTop) {
              active = sec;
              activeTop = rect.top;
            }
          }
          if (active && active !== lastActive) {
            const platform = active.getAttribute("data-platform-section");
            if (platform) switchPreviewTab(platform);
            lastActive = active;
          }
        };
        const onScroll = () => {
          if (scrollScheduled) return;
          scrollScheduled = true;
          requestAnimationFrame(evaluate);
        };
        // Scroll events don't bubble, but they DO fire in the capture
        // phase. <main> has its own md:overflow-y-auto on desktop, so
        // a window-scoped listener wouldn't see those scrolls. Capture
        // phase catches scroll on any element on the page.
        document.addEventListener("scroll", onScroll, { passive: true, capture: true });
        window.addEventListener("resize", onScroll, { passive: true });
        requestAnimationFrame(evaluate);
      }
      // Web / Mobile preview tab → scroll the matching editor
      // section into view AND switch the preview tab. Pauses the
      // spy long enough for smooth-scroll to settle so the preview
      // doesn't flicker through the other platform on the way.
      // The platform sections carry scroll-margin-top so the sticky
      // tab nav (and mobile header + breadcrumb) don't cover them.
      $$("[data-preview-tab]").forEach(btn => {
        btn.addEventListener("click", () => {
          const platform = btn.getAttribute("data-preview-tab");
          if (!platform) return;
          switchPreviewTab(platform);
          const target = $(`[data-platform-section="${platform}"]`);
          if (target) {
            // Pre-collapse the pagenav to its stuck (compact) form
            // BEFORE scrollIntoView calculates the destination, so the
            // target lines up with the smaller sticky stack instead of
            // ending up partially hidden behind it.
            const pagenav = $("[data-pagenav]");
            pagenav?.setAttribute("data-stuck", "1");
            const pagenavLast = pagenav?.getAttribute("data-stuck-forced");
            pagenav?.setAttribute("data-stuck-forced", "1");
            scrollSpyPaused = true;
            // Wait one frame so the layout reflects the stuck state.
            requestAnimationFrame(() => {
              target.scrollIntoView({ behavior: "smooth", block: "start" });
              setTimeout(() => {
                scrollSpyPaused = false;
                if (!pagenavLast) pagenav?.removeAttribute("data-stuck-forced");
              }, 800);
            });
          }
        });
      });
      // Zoom controls — present once per page; we listen on each
      // matched element so duplicates inside the fullscreen modal
      // (none today, but future-proof) all work.
      $$("[data-preview-zoom-in]").forEach(b => b.addEventListener("click", () => stepZoom(+1)));
      $$("[data-preview-zoom-out]").forEach(b => b.addEventListener("click", () => stepZoom(-1)));
      $$("[data-preview-zoom-reset]").forEach(b => b.addEventListener("click", () => setPreviewZoom(1)));
      // Mini content-preview "Editar editorial" link — switches to
      // the Editorial tab and focuses the Descripción editorial
      // textarea so the editor lands directly on it.
      $$("[data-cp-edit-editorial]").forEach(a => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          switchTab("editorial");
          const textarea = document.querySelector('[name="editorial_description"]');
          if (textarea) {
            textarea.scrollIntoView({ behavior: "smooth", block: "center" });
            requestAnimationFrame(() => textarea.focus());
          }
        });
      });
      document.addEventListener("cas:imageupload:change", (e) => {
        const d = e.detail || {};
        if (d.name === "hero_image_url") {
          updateHeroFallbackStatus();
          renderHeroPreview();
        } else if (d.name === "desktop_bg_image") {
          switchPreviewTab("desktop");
          renderHeroPreview();
        } else if (d.name === "mobile_bg_image") {
          switchPreviewTab("mobile");
          renderHeroPreview();
        }
      });
      // Fullscreen launcher buttons in the tab nav
      $$("[data-fullscreen-tab]").forEach(btn => {
        btn.addEventListener("click", () => openFullscreen(btn.getAttribute("data-fullscreen-tab")));
      });
      const fsClose = $("[data-fullscreen-close]");
      if (fsClose) fsClose.addEventListener("click", closeFullscreen);
      // ESC closes the fullscreen modal
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const modal = $("[data-fullscreen-modal]");
        if (modal && !modal.hasAttribute("hidden")) closeFullscreen();
      });

      // Position steppers: −/+ buttons next to each X/Y input nudge
      // the value by `data-step` (typically ±8px). Click and hold to
      // repeat at ~12 ticks/second after a 350ms initial delay so
      // longer adjustments don't require dozens of taps.
      $$(".hcc-step").forEach(btn => {
        const targetPath = btn.getAttribute("data-step-target");
        const stepBy = Number(btn.getAttribute("data-step")) || 1;
        const input = document.querySelector(`[data-bind="${CSS.escape(targetPath)}"]`);
        if (!input) return;
        const apply = () => {
          const cur = Number(input.value) || 0;
          let next = cur + stepBy;
          const min = input.min !== "" ? Number(input.min) : -Infinity;
          const max = input.max !== "" ? Number(input.max) : Infinity;
          next = Math.max(min, Math.min(max, next));
          input.value = String(next);
          // Find the platform from the bind path (e.g. "desktop.offset_x")
          const platform = targetPath.split(".")[0];
          if (platform === "desktop" || platform === "mobile") switchPreviewTab(platform);
          renderHeroPreview();
        };
        let holdTimer = null;
        let repeatTimer = null;
        const startHold = () => {
          holdTimer = setTimeout(() => {
            repeatTimer = setInterval(apply, 80);
          }, 350);
        };
        const stopHold = () => {
          if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
          if (repeatTimer) { clearInterval(repeatTimer); repeatTimer = null; }
        };
        btn.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          apply();
          startHold();
        });
        btn.addEventListener("pointerup", stopHold);
        btn.addEventListener("pointerleave", stopHold);
        btn.addEventListener("pointercancel", stopHold);
        btn.addEventListener("blur", stopHold);
      });

      // Border-radius "link corners" toggle: when on, editing one corner
      // input mirrors its value into the other 3 of the same platform.
      $$("[data-radius-link]").forEach(toggle => {
        const platform = toggle.getAttribute("data-radius-link");
        const grid = document.querySelector(`[data-radius-platform="${platform}"]`);
        if (!grid) return;
        const inputs = Array.from(grid.querySelectorAll("[data-radius-input]"));
        inputs.forEach(inp => {
          inp.addEventListener("input", () => {
            if (!toggle.checked) return;
            const v = inp.value;
            inputs.forEach(other => {
              if (other !== inp) other.value = v;
            });
            renderHeroPreview();
          });
        });
        // When the toggle is turned ON, snap all four corners to the value
        // of the first corner so they're consistent right away.
        toggle.addEventListener("change", () => {
          if (!toggle.checked) return;
          const v = inputs[0]?.value || "0";
          inputs.forEach(i => { i.value = v; });
          renderHeroPreview();
        });
      });
      const reset = $("[data-reset-hero-btn]");
      if (reset) reset.addEventListener("click", (ev) => {
        ev.preventDefault();
        if (!confirm("¿Restablecer estilos de la card a los defaults?")) return;
        currentHeroCfg = structuredClone(DEFAULT_HERO_CARD);
        writeHeroForm(currentHeroCfg);
        renderHeroPreview();
      });
      // On submit, make sure the JSON hidden input has the latest config.
      const form = $("[data-site-form]");
      if (form) form.addEventListener("submit", () => {
        const cfg = readHeroForm();
        const heroJson = $("[data-hero-json]");
        if (heroJson) heroJson.value = JSON.stringify(cfg);
      });
      window.addEventListener("resize", renderHeroPreview);
    };

    // Page tab switcher: reads ?page= from the URL and toggles which
    // [data-page-tab-panel] is visible. "home" is the default and
    // contains the existing Hero/Editorial/Contacto/SEO controls; the
    // other pages render a "en construcción" placeholder. Clicks on a
    // chip swap panels without a real navigation, replaceState the URL
    // so refresh keeps you on the same page, and dispatch a custom
    // event so the sidebar's sub-nav can highlight the matching item.
    const PAGE_KEYS = ["home", "catalogo", "articulos", "autores"];
    const currentPageKey = () => {
      const k = (new URL(window.location.href).searchParams.get("page") || "home").toLowerCase();
      return PAGE_KEYS.includes(k) ? k : "home";
    };
    const setPageTab = (key, push) => {
      key = PAGE_KEYS.includes(key) ? key : "home";
      $$("[data-page-tab-panel]").forEach(p => {
        p.hidden = p.getAttribute("data-page-tab-panel") !== key;
      });
      $$("[data-page-tab]").forEach(b => {
        b.classList.toggle("cas-pagechip-active", b.getAttribute("data-page-tab") === key);
      });
      // Bars that only apply to a specific page (e.g. the inner
      // Hero/Editorial/Contacto/SEO tab nav lives outside the panel
      // now so it can stack flush under the page-nav, but it should
      // only be visible while the user is on Home).
      $$("[data-page-only]").forEach(el => {
        el.hidden = el.getAttribute("data-page-only") !== key;
      });
      if (push) {
        const url = new URL(window.location.href);
        if (key === "home") url.searchParams.delete("page");
        else url.searchParams.set("page", key);
        // Switching off Home invalidates ?tab= (only Home has tabs).
        if (key !== "home") url.searchParams.delete("tab");
        window.history.replaceState({}, "", url.toString());
      }
      // Sync the breadcrumb's trailing crumbs.
      const url = new URL(window.location.href);
      const tabKey = (url.searchParams.get("tab") || "hero").toLowerCase();
      updateBreadcrumbCrumbs(key, tabKey);
      window.dispatchEvent(new CustomEvent("cas:page-tab-change", { detail: { key } }));
    };
    const wirePageTabs = () => {
      const nav = $("[data-pagenav]");
      if (!nav || nav.dataset.wired) {
        // Even if already wired, sync visibility on (re)boot.
        setPageTab(currentPageKey(), false);
        return;
      }
      nav.dataset.wired = "1";
      nav.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-page-tab]");
        if (!btn) return;
        e.preventDefault();
        setPageTab(btn.getAttribute("data-page-tab"), true);
      });
      setPageTab(currentPageKey(), false);

      // Expose the sticky stack's current height as a CSS var so
      // any element that needs to clear the stickies (preview-aside,
      // scroll-margin-top of platform sections) can stay below it
      // regardless of expanded/compact state.
      const stack = $("[data-stickystack]");
      const updateStackHeight = () => {
        const target = stack || nav;
        const h = target.getBoundingClientRect().height;
        if (h > 0) {
          document.documentElement.style.setProperty("--cas-stickystack-h", `${h}px`);
        }
      };
      updateStackHeight();
      if (typeof ResizeObserver !== "undefined") {
        const ro = new ResizeObserver(updateStackHeight);
        ro.observe(stack || nav);
      } else {
        window.addEventListener("resize", updateStackHeight);
      }

      // Stuck-state detection. The pagenav is glued to the top of
      // the scroll container from y=0 (negative margin cancels the
      // wrapper padding-top). So "stuck" really means "the user
      // scrolled past a small threshold" — at which point we
      // compact the bar to a single horizontally-scrollable row.
      const main = nav.closest("main");
      const scroller =
        main && window.matchMedia("(min-width: 768px)").matches ? main : window;
      const STUCK_THRESHOLD = 8;
      let rafPending = false;
      const updateStuck = () => {
        rafPending = false;
        const y = scroller === window ? window.scrollY : scroller.scrollTop;
        const stuck = y > STUCK_THRESHOLD;
        const wasStuck = nav.hasAttribute("data-stuck");
        if (stuck && !wasStuck) {
          nav.setAttribute("data-stuck", "1");
          requestAnimationFrame(updateStackHeight);
        } else if (!stuck && wasStuck) {
          nav.removeAttribute("data-stuck");
          requestAnimationFrame(updateStackHeight);
        }
      };
      const onScroll = () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(updateStuck);
      };
      scroller.addEventListener("scroll", onScroll, { passive: true });
      updateStuck();
    };

    // Guard contra el bug donde el script de /site sigue corriendo
    // después de navegar a otra sección. Astro registra los listeners
    // en `document` así que sobreviven view-transitions; sin este
    // chequeo, wireTabs() → switchTab("hero") agregaba el crumb
    // "› Hero" al breadcrumb de /authors, /books, etc.
    const isSitePage = () => {
      const p = window.location.pathname.replace(/\/$/, "");
      return p === "/site" || p.startsWith("/site/");
    };

    const boot = () => {
      if (!isSitePage()) return;
      wirePageTabs();
      wireTabs();
      wireForm();
      hydrate();
      // The catalogo + articulos panels live outside the main home
      // <form data-site-form>, so wireForm() doesn't touch them. Wire
      // their previews here on every boot so view transitions re-bind.
      initAllDetailPreviews();
    };

    document.addEventListener("astro:page-load", () => {
      const url = new URL(window.location.href);
      if (url.searchParams.has("saved")) {
        try { sessionStorage.removeItem(cacheKey); } catch {}
      }
      boot();
    });
    document.addEventListener("astro:after-swap", boot);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
