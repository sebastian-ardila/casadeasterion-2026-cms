---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import CardHeader from "~/components/CardHeader.astro";
import Dropdown from "~/components/Dropdown.astro";
import HeroCardPlatformControls from "~/components/HeroCardPlatformControls.astro";
import { Icon } from "astro-icon/components";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq, tags as parseTags } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const CONTENT_SOURCE_OPTIONS = [
  { value: "editorial",   label: "Descripción editorial",   hint: "Default — usa la descripción global del sitio", icon: "lucide:file-text" },
  { value: "manual",      label: "Manual",                  hint: "Define el texto y la URL aquí mismo",            icon: "lucide:pencil" },
  { value: "latest_post", label: "Último artículo publicado", hint: "Se actualiza solo cuando publicas un post",     icon: "lucide:newspaper" },
  { value: "latest_book", label: "Último libro publicado",  hint: "Se actualiza solo cuando publicas un libro",     icon: "lucide:book-open" },
];

// Mirrors apps/web/src/pages/index.astro's HERO_FALLBACK. Keep in sync if
// the public-site default changes.
const HERO_FALLBACK_URL =
  "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80";

// SSR: only auth gate + POST handling. Fields hydrate from /api/page-data?type=site.
const guard = await requirePermission(Astro, "site", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=site");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();

    const rows: Array<{ key: string; value: unknown }> = [
      { key: "hero_quote",                value: strReq(fd, "hero_quote") },
      { key: "hero_quote_author",         value: strReq(fd, "hero_quote_author") },
      { key: "editorial_description",     value: strReq(fd, "editorial_description") },
      { key: "footer_legal",              value: strReq(fd, "footer_legal") },
      { key: "whatsapp_phone",            value: strReq(fd, "whatsapp_phone") },
      { key: "whatsapp_message_template", value: strReq(fd, "whatsapp_message_template") },
      {
        key: "social_links",
        value: {
          facebook: str(fd, "social_facebook") ?? "",
          instagram: str(fd, "social_instagram") ?? "",
          twitter: str(fd, "social_twitter") ?? "",
        },
      },
      { key: "default_keywords",      value: parseTags(fd, "default_keywords") },
      { key: "twitter_handle",        value: str(fd, "twitter_handle") ?? "" },
      { key: "og_image_default",      value: str(fd, "og_image_default") ?? "" },
      { key: "organization_logo_url", value: str(fd, "organization_logo_url") ?? "" },
      { key: "hero_image_url",        value: str(fd, "hero_image_url") ?? "" },
    ];

    // Hero card config travels as a single JSON blob in a hidden input.
    // If parsing fails or shape is wrong, skip it (don't block the rest).
    const heroJson = fd.get("hero_card_config_json")?.toString() ?? "";
    if (heroJson) {
      try {
        const parsed = JSON.parse(heroJson);
        if (parsed && typeof parsed === "object" && parsed.content_source && parsed.desktop && parsed.mobile) {
          rows.push({ key: "hero_card_config", value: parsed });
        }
      } catch {
        // Malformed JSON — skip silently.
      }
    }

    const { error } = await supabase
      .from("site_configuration")
      .upsert(rows as never, { onConflict: "key" });
    if (error) throw error;

    return Astro.redirect("/site?saved=1&action=updated&entity=site&publish=1");
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Default hero card config — kept in sync with apps/web/src/lib/site-config.ts
// and migration 0030. Used when no value is persisted yet, and to fill
// missing keys from a partial save.
const DEFAULT_HERO_CARD = {
  content_source: "editorial",
  manual: {
    eyebrow: "Editorial",
    title: "Casa de Asterión Ediciones",
    body: "",
    cta_label: "Explorar el catálogo",
    cta_href: "/catalogo",
  },
  desktop: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 760,
    height: 520,
    padding: 56,
    offset_x: 96,
    offset_y: 0,
    shadow: true,
  },
  mobile: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 0,
    height: 280,
    padding: 24,
    offset_x: 16,
    offset_y: 32,
    shadow: true,
  },
};

---

<AppLayout title="Landing Page">
  <div class="mb-6">
    <h1 class="font-serif text-3xl md:text-4xl mb-2">Landing Page</h1>
    <p class="text-stone-500 max-w-2xl">
      Todo lo que controla la portada y los textos globales del sitio público.
      Cada pestaña agrupa una parte distinta de la página.
    </p>
  </div>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <Icon name="lucide:lock" class="w-4 h-4" aria-hidden="true" />
      <span>Solo lectura — tienes permiso de ver pero no de editar la configuración del sitio.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  {/* Tab nav — sticky beneath the breadcrumb on scroll. The breadcrumb is
      ~40px tall (py-2.5 + 11px text) on every breakpoint; on mobile we
      add the 56px mobile-app header. So sticky top values: 96px mobile,
      40px desktop (right under the breadcrumb's bottom edge). The
      preview buttons on the right open a fullscreen overlay. */}
  <nav class="cas-tabs sticky top-[96px] md:top-[40px] z-10 flex items-stretch gap-1 mb-6 border-b border-stone-200 overflow-x-auto bg-white -mx-5 md:-mx-8 lg:-mx-10 px-5 md:px-8 lg:px-10" data-tab-nav>
    <button type="button" data-tab="hero" class="cas-tab cas-tab-active">
      <Icon name="lucide:layout-panel-top" class="w-4 h-4" aria-hidden="true" />
      <span>Hero</span>
    </button>
    <button type="button" data-tab="editorial" class="cas-tab">
      <Icon name="lucide:scroll-text" class="w-4 h-4" aria-hidden="true" />
      <span>Editorial</span>
    </button>
    <button type="button" data-tab="contacto" class="cas-tab">
      <Icon name="lucide:phone" class="w-4 h-4" aria-hidden="true" />
      <span>Contacto</span>
    </button>
    <button type="button" data-tab="seo" class="cas-tab">
      <Icon name="lucide:search" class="w-4 h-4" aria-hidden="true" />
      <span>SEO</span>
    </button>
    {/* Right side: fullscreen preview launchers — only on phone-sized
        screens. On md+ the inline preview pane is already visible, so
        these buttons would be redundant. */}
    <div class="md:hidden ml-auto flex items-center gap-1 pl-2 self-center">
      <button type="button" data-fullscreen-tab="desktop" class="cas-fs-btn" aria-label="Vista web a pantalla completa" title="Vista web a pantalla completa">
        <Icon name="lucide:monitor" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Web</span>
      </button>
      <button type="button" data-fullscreen-tab="mobile" class="cas-fs-btn" aria-label="Vista mobile a pantalla completa" title="Vista mobile a pantalla completa">
        <Icon name="lucide:smartphone" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Mobile</span>
      </button>
    </div>
  </nav>

  <form method="POST" data-site-form>
    <input type="hidden" name="hero_card_config_json" data-hero-json>
    <fieldset disabled={!canEdit} class="m-0 p-0 border-0 min-w-0">

      {/* === HERO TAB === */}
      {/* On <lg the aside (preview) goes first so the user sees changes
          immediately without scrolling. On lg+ we reorder so the preview
          sits on the right. */}
      <div data-tab-panel="hero" class="grid lg:grid-cols-[minmax(0,1fr)_440px] gap-6 items-start">
        <div class="space-y-6 min-w-0 lg:order-1 order-2">

          {/* Hero image */}
          <section class="card space-y-5">
            <CardHeader icon="lucide:image" title="Imagen del hero" desc="Foto que ocupa la mitad derecha en desktop y aparece debajo de la card en mobile." />
            <div class="grid gap-4 md:grid-cols-2">
              <ImageUpload
                name="hero_image_url"
                label="Tu imagen"
                bucket="covers"
                hint="Click o arrastra. Recomendado: 2400×1600px o más, horizontal."
              />
              <div class="block min-w-0">
                <span class="label flex items-center justify-between gap-2">
                  <span>Imagen por defecto</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-sm bg-stone-100 text-stone-500 border border-stone-200" title="Esta imagen no se puede modificar desde el CMS">
                    <Icon name="lucide:lock" class="w-3 h-3" aria-hidden="true" />
                    Bloqueado
                  </span>
                </span>
                <div class="relative flex items-stretch gap-4 border border-stone-200 bg-stone-50/60 p-3" data-hero-fallback>
                  <div class="relative w-24 h-24 shrink-0 bg-stone-100 border border-stone-200 overflow-hidden">
                    <img src={HERO_FALLBACK_URL} alt="Imagen por defecto del hero" loading="lazy" class="w-full h-full object-cover" />
                  </div>
                  <div class="flex-1 min-w-0 flex flex-col justify-center text-sm text-stone-700">
                    <span class="inline-flex items-center gap-1.5 font-medium text-stone-800">
                      <Icon name="lucide:image" class="w-4 h-4" aria-hidden="true" />
                      <span>Foto editorial de respaldo</span>
                    </span>
                    <span class="text-xs text-stone-500 mt-1 leading-snug">Aparece automáticamente si no defines una propia.</span>
                    <span class="mt-2 inline-flex items-center gap-1 px-1.5 py-0.5 self-start text-[10px] font-medium uppercase tracking-wider rounded-sm border" data-hero-fallback-status>
                      <span data-hero-fallback-dot class="w-1.5 h-1.5 rounded-full"></span>
                      <span data-hero-fallback-label>—</span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* Hero quote */}
          <section class="card space-y-5">
            <CardHeader icon="lucide:quote" title="Cita destacada" desc="Aparece debajo del hero, sobre fondo claro." />
            <Field label="Cita" name="hero_quote" type="textarea" rows={3} required description="Frase corta y elocuente. Sin comillas alrededor — el diseño las añade." />
            <Field label="Autor de la cita" name="hero_quote_author" required description="Nombre que firma la cita." />
          </section>

          {/* Hero card content */}
          <section class="card space-y-4">
            <CardHeader icon="lucide:newspaper" title="Contenido de la card" desc="Qué se muestra dentro del recuadro principal del hero." />
            <div data-bind-dd="content_source">
              <label class="label">Fuente del contenido</label>
              <Dropdown name="content_source" value="editorial" options={CONTENT_SOURCE_OPTIONS} />
              <p class="hcc-hint mt-1">Si eliges artículo o libro pero aún no hay nada publicado, se usa la descripción editorial como fallback.</p>
            </div>
            {/* Manual fields — only visible when content source is "manual".
                JS toggles the [hidden] attribute based on the selected source. */}
            <div data-manual-fields class="space-y-4 pt-4 border-t border-stone-100" hidden>
              <div>
                <label class="label">Eyebrow (texto pequeño arriba)</label>
                <input type="text" data-bind="manual.eyebrow" class="hcc-input w-full" />
              </div>
              <div>
                <label class="label">Título</label>
                <input type="text" data-bind="manual.title" class="hcc-input w-full" />
              </div>
              <div>
                <label class="label">Cuerpo</label>
                <textarea data-bind="manual.body" rows="3" class="hcc-input w-full"></textarea>
              </div>
              <div class="grid sm:grid-cols-2 gap-3">
                <div>
                  <label class="label">Texto del botón</label>
                  <input type="text" data-bind="manual.cta_label" class="hcc-input w-full" />
                </div>
                <div>
                  <label class="label">URL del botón</label>
                  <input type="text" data-bind="manual.cta_href" class="hcc-input w-full" placeholder="/catalogo" />
                </div>
              </div>
            </div>
          </section>

          {/* Hero card style: desktop */}
          <section class="card space-y-4" data-platform-section="desktop">
            <CardHeader icon="lucide:monitor" title="Estilo de la card (Web)" desc="Cómo se ve la card en pantallas medianas y grandes." />
            <HeroCardPlatformControls platform="desktop" />
          </section>

          {/* Hero card style: mobile */}
          <section class="card space-y-4" data-platform-section="mobile">
            <CardHeader icon="lucide:smartphone" title="Estilo de la card (Mobile)" desc="Cómo se ve la card en celulares." />
            <HeroCardPlatformControls platform="mobile" />
          </section>

          {/* Card bg images */}
          <section class="card space-y-4">
            <CardHeader icon="lucide:image-plus" title="Imágenes de fondo de la card" desc="Opcional. Se mezcla con el color y la opacidad de arriba." />
            <div class="grid sm:grid-cols-2 gap-4">
              <ImageUpload name="desktop_bg_image" label="Web" hint="Solo aparece en desktop." bucket="covers" />
              <ImageUpload name="mobile_bg_image" label="Mobile" hint="Solo aparece en mobile." bucket="covers" />
            </div>
          </section>
        </div>

        {/* Live preview pane */}
        <aside class="lg:sticky lg:top-6 space-y-3 lg:order-2 order-1">
          <div class="flex items-center gap-2">
            <button type="button" data-preview-tab="desktop" class="cas-preview-tab cas-preview-tab-active">
              <Icon name="lucide:monitor" class="w-3.5 h-3.5" aria-hidden="true" />
              Web
            </button>
            <button type="button" data-preview-tab="mobile" class="cas-preview-tab">
              <Icon name="lucide:smartphone" class="w-3.5 h-3.5" aria-hidden="true" />
              Mobile
            </button>
            <span class="ml-auto text-[11px] uppercase tracking-wider text-stone-400" data-preview-meta>desktop · 1440 × 720</span>
          </div>
          <div class="cas-preview-frame border border-stone-200 bg-stone-100 overflow-hidden" data-preview-frame>
            <div class="relative w-full h-full" data-preview-stage>
              {/* Right-half image — only visible in desktop preview */}
              <div data-preview-bg-image class="absolute top-0 right-0 h-full w-1/2 bg-cover bg-center pointer-events-none"></div>
              {/* The card. Position is computed at render time per platform. */}
              <a data-preview-card class="z-10 flex flex-col justify-between" target="_blank" rel="noopener noreferrer">
                <div>
                  <p data-preview-eyebrow class="uppercase tracking-[0.2em] opacity-70 mb-3"></p>
                  <h1 data-preview-title class="leading-[1.1] mb-3"></h1>
                  <p data-preview-body class="opacity-80 leading-relaxed"></p>
                </div>
                <span data-preview-cta class="uppercase tracking-[0.18em] border-b border-current/60 pb-1 self-start mt-4"></span>
              </a>
              {/* Stacked mobile image — only visible in mobile preview */}
              <img data-preview-mobile-img alt="" class="block w-full" style="display:none;" />
            </div>
          </div>
          <button type="button" class="text-xs text-stone-500 hover:text-stone-900 underline underline-offset-4" data-reset-hero-btn>
            Restablecer estilos del hero a default
          </button>
        </aside>
      </div>

      {/* === EDITORIAL TAB === */}
      <div data-tab-panel="editorial" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:scroll-text" title="Editorial" desc="Información general que aparece en footer, meta tags y al compartir." />
          <Field label="Descripción de la editorial" name="editorial_description" type="textarea" rows={3} required description="Aparece en el footer y como meta description del sitio. 1-2 frases." />
          <Field label="Línea legal del footer" name="footer_legal" required description="Texto pequeño abajo del footer (ej: '© 2026 Casa de Asterión Ediciones')." />
        </section>
      </div>

      {/* === CONTACTO TAB === */}
      <div data-tab-panel="contacto" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:phone" title="WhatsApp (compras)" desc="El botón Comprar en cada libro abre WhatsApp con un mensaje pre-llenado a este número." />
          <div class="grid sm:grid-cols-2 gap-4">
            <Field label="Número en formato E.164" name="whatsapp_phone" required description="Ej: +573117462759 (con + y código país)." />
          </div>
          <Field label="Plantilla del mensaje" name="whatsapp_message_template" type="textarea" rows={3} required description="Variables: {{title}}, {{author}}, {{isbn}}, {{slug}}. Se usa cuando un libro no define un mensaje propio." />
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:share-2" title="Redes sociales" desc="URLs completas de los perfiles oficiales. Se enlazan desde el footer." />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <Field label="Facebook" name="social_facebook" type="url" description="URL pública del perfil." />
            <Field label="Instagram" name="social_instagram" type="url" description="URL pública del perfil." />
            <Field label="Twitter / X" name="social_twitter" type="url" description="URL pública del perfil." />
          </div>
        </section>
      </div>

      {/* === SEO TAB === */}
      <div data-tab-panel="seo" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:search" title="SEO global y schema.org" desc="Defaults para cada página del sitio público y datos para JSON-LD." />
          <div class="grid sm:grid-cols-2 gap-4">
            <Field label="Palabras clave globales" name="default_keywords" description="Términos que describen la editorial. Separadas por coma." />
            <Field label="Handle de Twitter / X" name="twitter_handle" description="Con la @ inicial (ej: @casadeasterion)." />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <ImageUpload name="og_image_default" label="Imagen al compartir (Open Graph)" bucket="covers" hint="Click o arrastra. 1200×630px recomendado. Se usa cuando un post/libro no tiene portada." />
            <ImageUpload name="organization_logo_url" label="Logo de la editorial (JSON-LD)" bucket="covers" hint="Click o arrastra. Cuadrado o casi cuadrado. Lo lee Google." />
          </div>
        </section>
      </div>

      {canEdit && (
        <div class="sticky bottom-0 bg-white border-t border-stone-200 z-10 -mx-5 md:-mx-8 lg:-mx-10 -mb-6 md:-mb-10 mt-8">
          <div class="px-5 md:px-8 lg:px-10 py-3 flex gap-3">
            <button type="submit" class="btn-primary" disabled data-submit-btn>Guardar configuración</button>
          </div>
        </div>
      )}
    </fieldset>
  </form>

  {/* Fullscreen preview modal — outside the form so the submit button
      doesn't pick up its inputs. The card content elements use the
      same data-preview-{eyebrow,title,body,cta} attribute names as
      the inline preview because applyContent() queries by those
      selectors on whatever card it gets — keeping them consistent
      lets one set of render fns target either preview. */}
  <div data-fullscreen-modal hidden class="fixed inset-0 z-[60] bg-stone-900 flex flex-col">
    <header class="flex items-center justify-between px-4 h-14 border-b border-stone-700 text-stone-100 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <span data-fullscreen-platform class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-wider px-2 py-1 rounded bg-stone-800">
          <Icon name="lucide:monitor" class="w-3.5 h-3.5" aria-hidden="true" />
          <span data-fullscreen-platform-label>Web</span>
        </span>
        <span data-fullscreen-meta class="text-[11px] text-stone-400 uppercase tracking-wider truncate">1440 × 720</span>
      </div>
      <button type="button" data-fullscreen-close class="text-stone-300 hover:text-white p-2 -mr-2 transition-colors cursor-pointer" aria-label="Cerrar preview">
        <Icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
      </button>
    </header>
    <div class="flex-1 relative overflow-hidden bg-stone-100" data-fullscreen-frame>
      <div class="relative" data-fullscreen-stage>
        <div data-fullscreen-bg-image class="absolute top-0 right-0 h-full w-1/2 bg-cover bg-center pointer-events-none"></div>
        <a data-fullscreen-card class="z-10 flex flex-col justify-between" target="_blank" rel="noopener noreferrer">
          <div>
            <p data-preview-eyebrow class="uppercase tracking-[0.2em] opacity-70 mb-3"></p>
            <h1 data-preview-title class="leading-[1.1] mb-3"></h1>
            <p data-preview-body class="opacity-80 leading-relaxed"></p>
          </div>
          <span data-preview-cta class="uppercase tracking-[0.18em] border-b border-current/60 pb-1 self-start mt-4"></span>
        </a>
        <img data-fullscreen-mobile-img alt="" class="block w-full" style="display:none;" />
      </div>
    </div>
  </div>
</AppLayout>

<style is:global>
  /* === Tab nav === */
  .cas-tabs { margin-bottom: 1.5rem; }
  .cas-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(120 113 108);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .cas-tab:hover { color: rgb(28 25 23); }
  .cas-tab-active { color: rgb(28 25 23); border-bottom-color: rgb(28 25 23); }
  /* Compact tabs on mobile: smaller padding, smaller font, hide nothing */
  @media (max-width: 640px) {
    .cas-tab { padding: 0.5rem 0.625rem; font-size: 0.8125rem; gap: 0.375rem; }
  }

  /* Fullscreen preview launcher buttons sit at the right of the tabs nav */
  .cas-fs-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    background: rgb(245 245 244);
    border: 1px solid rgb(214 211 209);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .cas-fs-btn:hover {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }

  /* === Inputs === */
  .hcc-input {
    border: 1px solid rgb(214 211 209);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: white;
    transition: border-color 0.15s;
    min-width: 0;
  }
  .hcc-input:focus { outline: none; border-color: rgb(28 25 23); }

  /* === Preview tabs (web/mobile) === */
  .cas-preview-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 11px;
    text-transform: uppercase;
