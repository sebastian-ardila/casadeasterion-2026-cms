  .hcc-cp-eyebrow { font-family: var(--cp-eyebrow-font, inherit); }
  .hcc-cp-title   { font-family: var(--cp-title-font,   inherit); font-weight: 500; }
  .hcc-cp-body    { font-family: var(--cp-body-font,    inherit); }
  .hcc-cp-cta     { font-family: var(--cp-cta-font,     inherit); }
  /* Hide each role's element when its text is empty so the public
     site's "skip empty" behavior is mirrored 1:1. */
  .hcc-cp-eyebrow:empty,
  .hcc-cp-title:empty,
  .hcc-cp-body:empty,
  .hcc-cp-cta:empty { display: none; }
  .hcc-cp-hint {
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: rgb(254 252 232);   /* amber-50 */
