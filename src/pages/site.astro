        <CardHeader icon="lucide:eye" title="Vista previa" desc={LATEST_POST ? `Cómo se verá la publicación «${LATEST_POST.title}» con las tipografías que elijas.` : "Mostramos una publicación de muestra. Aparecerá una real cuando haya publicaciones publicadas."} />
        <div class="cas-detail-pv cas-detail-pv-publication-frame">
          {/* Breadcrumb */}
          <nav class="cas-detail-pv-crumbs" aria-label="Breadcrumb">
