---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import { Icon } from "astro-icon/components";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq, tags as parseTags } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

// Mirrors apps/web/src/pages/index.astro's HERO_FALLBACK. Keep in sync if
// the public-site default changes.
const HERO_FALLBACK_URL =
  "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80";

// SSR: only auth gate + POST handling. Fields hydrate from /api/page-data?type=site.
const guard = await requirePermission(Astro, "site", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=site");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();

    const rows = [
      { key: "hero_quote",                value: strReq(fd, "hero_quote") as never },
      { key: "hero_quote_author",         value: strReq(fd, "hero_quote_author") as never },
      { key: "editorial_description",     value: strReq(fd, "editorial_description") as never },
      { key: "footer_legal",              value: strReq(fd, "footer_legal") as never },
      { key: "whatsapp_phone",            value: strReq(fd, "whatsapp_phone") as never },
      { key: "whatsapp_message_template", value: strReq(fd, "whatsapp_message_template") as never },
      {
        key: "social_links",
        value: {
          facebook: str(fd, "social_facebook") ?? "",
          instagram: str(fd, "social_instagram") ?? "",
          twitter: str(fd, "social_twitter") ?? "",
        } as never,
      },
      { key: "default_keywords",      value: parseTags(fd, "default_keywords") as never },
      { key: "twitter_handle",        value: (str(fd, "twitter_handle") ?? "") as never },
      { key: "og_image_default",      value: (str(fd, "og_image_default") ?? "") as never },
      { key: "organization_logo_url", value: (str(fd, "organization_logo_url") ?? "") as never },
      { key: "hero_image_url",        value: (str(fd, "hero_image_url") ?? "") as never },
    ];

    const { error } = await supabase
      .from("site_configuration")
      .upsert(rows, { onConflict: "key" });
    if (error) throw error;

    return Astro.redirect("/site?saved=1&action=updated&entity=site&publish=1");
  } catch (err) {
    formError = friendlyError(err);
  }
}
---

<AppLayout title="Configuración">
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Configuración del sitio</h1>
  <p class="text-stone-500 mb-8">Textos, contacto y redes que aparecen en el frontend público.</p>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar la configuración del sitio.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl" data-site-form>
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Hero del homepage</h2>
        <p class="card-section-desc">Imagen de fondo del hero principal y la cita destacada que aparece bajo él.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <ImageUpload
          name="hero_image_url"
          label="Tu imagen"
          bucket="covers"
          hint="Click o arrastra. Foto que se ve en la primera pantalla del sitio (mitad derecha en desktop, fondo completo en mobile). Recomendado: 2400×1600px o más, horizontal."
        />

        {/* Read-only fallback preview. Mirrors ImageUpload's layout for
            visual coherence but is locked. JS toggles the "En uso" badge
            below based on whether `hero_image_url` is empty. */}
        <div class="block min-w-0">
          <span class="label flex items-center justify-between gap-2">
            <span>Imagen por defecto</span>
            <span
              class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-sm bg-stone-100 text-stone-500 border border-stone-200"
              title="Esta imagen no se puede modificar desde el CMS"
            >
              <Icon name="lucide:lock" class="w-3 h-3" aria-hidden="true" />
              Bloqueado
            </span>
          </span>

          <div
            class="relative flex items-stretch gap-4 border border-stone-200 bg-stone-50/60 p-3"
            data-hero-fallback
          >
            <div class="relative w-24 h-24 shrink-0 bg-stone-100 border border-stone-200 overflow-hidden">
              <img
                src={HERO_FALLBACK_URL}
                alt="Imagen por defecto del hero"
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>

            <div class="flex-1 min-w-0 flex flex-col justify-center text-sm text-stone-700">
              <span class="inline-flex items-center gap-1.5 font-medium text-stone-800">
                <Icon name="lucide:image" class="w-4 h-4" aria-hidden="true" />
                <span>Foto editorial de respaldo</span>
              </span>
              <span class="text-xs text-stone-500 mt-1 leading-snug">
                Esta imagen aparece automáticamente si no defines una propia.
              </span>
              <span
                class="mt-2 inline-flex items-center gap-1 px-1.5 py-0.5 self-start text-[10px] font-medium uppercase tracking-wider rounded-sm border"
                data-hero-fallback-status
              >
                <span data-hero-fallback-dot class="w-1.5 h-1.5 rounded-full"></span>
                <span data-hero-fallback-label>—</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <Field label="Cita" name="hero_quote" type="textarea" rows={3} required description="Frase corta y elocuente. Sin comillas alrededor — el diseño las añade." />
      <Field label="Autor de la cita" name="hero_quote_author" required description="Nombre que firma la cita." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Editorial</h2>
        <p class="card-section-desc">Información general que aparece en footer, meta tags y al compartir el sitio.</p>
      </div>
      <Field label="Descripción de la editorial" name="editorial_description" type="textarea" rows={3} required description="Aparece en el footer y como meta description del sitio. 1-2 frases." />
      <Field label="Línea legal del footer" name="footer_legal" required description="Texto pequeño abajo del footer (ej: '© 2026 Casa de Asterión Ediciones')." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">WhatsApp (compras)</h2>
        <p class="card-section-desc">El botón "Comprar" en cada libro abre WhatsApp con un mensaje pre-llenado a este número.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <Field label="Número en formato E.164" name="whatsapp_phone" required description="Ej: +573117462759 (con + y código país)." />
      </div>
      <Field label="Plantilla del mensaje" name="whatsapp_message_template" type="textarea" rows={3} required description="Variables disponibles: {{title}}, {{author}}, {{isbn}}, {{slug}}. Se usa cuando un libro no define un mensaje propio." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Redes sociales</h2>
        <p class="card-section-desc">URLs completas de los perfiles oficiales. Se enlazan desde el footer.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Field label="Facebook" name="social_facebook" type="url" description="URL pública del perfil." />
        <Field label="Instagram" name="social_instagram" type="url" description="URL pública del perfil." />
        <Field label="Twitter / X" name="social_twitter" type="url" description="URL pública del perfil." />
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">SEO global y schema.org</h2>
        <p class="card-section-desc">Defaults para cada página del sitio público (cuando un artículo, libro o autor no define los suyos) y datos de la editorial para JSON-LD.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <Field label="Palabras clave globales" name="default_keywords" description="Términos que describen la editorial. Separadas por coma." />
        <Field label="Handle de Twitter / X" name="twitter_handle" description="Con la @ inicial (ej: @casadeasterion)." />
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <ImageUpload
          name="og_image_default"
          label="Imagen al compartir (Open Graph)"
          bucket="covers"
          hint="Click o arrastra. 1200×630px recomendado. Se usa cuando un post/libro no tiene portada."
        />
        <ImageUpload
          name="organization_logo_url"
          label="Logo de la editorial (JSON-LD)"
          bucket="covers"
          hint="Click o arrastra. Cuadrado o casi cuadrado. Lo lee Google."
        />
      </div>
    </section>

    {canEdit && (
      <div class="flex gap-3 pt-4 border-t border-stone-200">
        <button type="submit" class="btn-primary" disabled data-submit-btn>Guardar configuración</button>
      </div>
    )}
    </fieldset>
  </form>
</AppLayout>

<script is:inline>
  (() => {
    if (window.__casSiteInit) return;
    window.__casSiteInit = true;

    const cacheKey = "cas:site";
    const TTL = 60_000;

    const apply = (cfg) => {
      const form = document.querySelector("[data-site-form]");
      if (!form) return;
      const set = (name, value) => {
        const el = form.querySelector(`[name="${name}"]`);
        if (el && typeof value === "string") el.value = value;
      };
      set("hero_quote", cfg.hero_quote ?? "");
      set("hero_quote_author", cfg.hero_quote_author ?? "");
      set("editorial_description", cfg.editorial_description ?? "");
      set("footer_legal", cfg.footer_legal ?? "");
      set("whatsapp_phone", cfg.whatsapp_phone ?? "");
      set("whatsapp_message_template", cfg.whatsapp_message_template ?? "");
      const social = (cfg.social_links ?? {});
      set("social_facebook", social.facebook ?? "");
      set("social_instagram", social.instagram ?? "");
      set("social_twitter", social.twitter ?? "");
      const kws = Array.isArray(cfg.default_keywords) ? cfg.default_keywords.join(", ") : (cfg.default_keywords ?? "");
      set("default_keywords", kws);
      set("twitter_handle", cfg.twitter_handle ?? "");
      // ImageUpload exposes a __casSetImage setter on its wrapper element.
      const setImage = (name, value) => {
        const hidden = form.querySelector(`input[type="hidden"][name="${name}"]`);
        const wrapper = hidden?.closest("[data-image-upload]");
        if (wrapper && typeof wrapper.__casSetImage === "function") {
          wrapper.__casSetImage(typeof value === "string" ? value : "");
        }
      };
      setImage("og_image_default", cfg.og_image_default ?? "");
      setImage("organization_logo_url", cfg.organization_logo_url ?? "");
      setImage("hero_image_url", cfg.hero_image_url ?? "");
      updateHeroFallbackStatus();
      // Enable submit once data is loaded.
      const btn = form.querySelector("[data-submit-btn]");
      if (btn) btn.disabled = false;
    };

    // The "Imagen por defecto" badge reflects whether the user has a
    // hero image configured. When empty, the fallback is "En uso"
    // (green); when set, it's "Inactiva" (stone).
    const updateHeroFallbackStatus = () => {
      const form = document.querySelector("[data-site-form]");
      if (!form) return;
      const hidden = form.querySelector('input[type="hidden"][name="hero_image_url"]');
      const wrap = form.querySelector("[data-hero-fallback-status]");
      if (!hidden || !wrap) return;
      const dot = wrap.querySelector("[data-hero-fallback-dot]");
      const label = wrap.querySelector("[data-hero-fallback-label]");
      if (!dot || !label) return;
      const inUse = !hidden.value;
      // Reset classes first so we can swap palettes cleanly.
      wrap.className =
        "mt-2 inline-flex items-center gap-1 px-1.5 py-0.5 self-start text-[10px] font-medium uppercase tracking-wider rounded-sm border";
      if (inUse) {
        wrap.classList.add("bg-emerald-50", "text-emerald-700", "border-emerald-200");
        dot.className = "w-1.5 h-1.5 rounded-full bg-emerald-500";
        label.textContent = "En uso";
      } else {
        wrap.classList.add("bg-stone-100", "text-stone-500", "border-stone-200");
        dot.className = "w-1.5 h-1.5 rounded-full bg-stone-400";
        label.textContent = "Inactiva";
      }
    };

    // React to user uploads / removals on the hero image uploader.
    document.addEventListener("cas:imageupload:change", (e) => {
      if (e.detail?.name === "hero_image_url") updateHeroFallbackStatus();
    });

    const hydrate = async () => {
      if (!document.querySelector("[data-site-form]")) return;

      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) apply(parsed.cfg);
        }
      } catch {}

      try {
        const res = await fetch("/api/page-data?type=site", {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) return;
        const data = await res.json();
        apply(data.config ?? {});
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), cfg: data.config })); } catch {}
      } catch {}
    };

    document.addEventListener("astro:page-load", () => {
      const url = new URL(window.location.href);
      if (url.searchParams.has("saved")) {
        try { sessionStorage.removeItem(cacheKey); } catch {}
      }
      hydrate();
    });
    document.addEventListener("astro:after-swap", hydrate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", hydrate);
    } else {
      hydrate();
    }
  })();
</script>
