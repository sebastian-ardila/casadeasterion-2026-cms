---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import CardHeader from "~/components/CardHeader.astro";
import Dropdown from "~/components/Dropdown.astro";
import HeroCardPlatformControls from "~/components/HeroCardPlatformControls.astro";
import ColorEditor from "~/components/ColorEditor.astro";
import PageStub from "~/components/PageStub.astro";
import { fullName, formatAgo } from "~/lib/relative-time";
import { Icon } from "astro-icon/components";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq, tags as parseTags } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

// Reads a hidden JSON-encoded list from FormData. Returns [] on
// missing / malformed input so a corrupt list can never block a
// site-config save.
function parseJsonArray(fd: FormData, key: string): unknown[] {
  const raw = fd.get(key)?.toString() ?? "";
  if (!raw) return [];
  try {
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

const CONTENT_SOURCE_OPTIONS = [
  { value: "editorial",   label: "Descripción editorial",   hint: "Default — usa la descripción global del sitio", icon: "lucide:file-text" },
  { value: "manual",      label: "Manual",                  hint: "Define el texto y la URL aquí mismo",            icon: "lucide:pencil" },
  { value: "latest_post", label: "Último artículo publicado", hint: "Se actualiza solo cuando publicas un post",     icon: "lucide:newspaper" },
  { value: "latest_book", label: "Último libro publicado",  hint: "Se actualiza solo cuando publicas un libro",     icon: "lucide:book-open" },
];

// Mirrors apps/web/src/pages/index.astro's HERO_FALLBACK. Keep in sync if
// the public-site default changes.
const HERO_FALLBACK_URL =
  "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80";

// SSR: only auth gate + POST handling. Fields hydrate from /api/page-data?type=site.
const guard = await requirePermission(Astro, "site", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;

// Auto-detected URL options for the manual content's CTA href picker.
// Static routes mirror the file structure of apps/web/src/pages; the
// dynamic ones come from Supabase so the dropdown auto-grows as the
// editor publishes new posts / books / authors. Failures here just
// degrade the picker to the static list — never block the page.
type UrlOpt = { value: string; label: string; hint?: string; icon?: string };
const URL_STATIC: UrlOpt[] = [
  { value: "/",            label: "Inicio",     hint: "Página principal",        icon: "lucide:home" },
  { value: "/catalogo",    label: "Catálogo",   hint: "Lista de libros",         icon: "lucide:book-open" },
  { value: "/articulos",   label: "Artículos",  hint: "Lista de artículos",      icon: "lucide:newspaper" },
  { value: "/autores",     label: "Autores",    hint: "Lista de autores",        icon: "lucide:users" },
  { value: "/filosofia",   label: "Filosofía",  hint: "Sección filosofía",       icon: "lucide:scroll-text" },
  { value: "/poesia",      label: "Poesía",     hint: "Sección poesía",          icon: "lucide:feather" },
  { value: "/contacto",    label: "Contacto",   hint: "Formulario de contacto",  icon: "lucide:phone" },
];
let URL_OPTIONS: UrlOpt[] = [...URL_STATIC];
// The "Contenido de la card" mini preview also wants the latest
// published post + latest published book so editors see the real
// content the public site will resolve. Surface them via define:vars.
// content_md / description_md let the JS-side teaser builder fall
// back to the long-form text when the editor hasn't filled an
// excerpt / subtitle.
type LatestPost = { slug: string; title: string; excerpt: string | null; content_md: string | null } | null;
type LatestBook = { slug: string; title: string; subtitle: string | null; description_md: string | null } | null;
let LATEST_POST: LatestPost = null;
let LATEST_BOOK: LatestBook = null;
// Most recent site_configuration row + the editor that last touched it
// — shown next to "Guardar configuración" so the team can see at a
// glance who saved last.
let LAST_SITE_EDIT: { updated_at: string; editor: { id: string; full_name: string | null; email: string | null } | null } | null = null;
try {
  const sb = getSupabaseServerClient(Astro.request, Astro.cookies);
  const [postsRes, booksRes, authorsRes, latestPostRes, latestBookRes, siteEditRes] = await Promise.all([
    sb.from("posts").select("slug, title").eq("status", "published").order("title").limit(60),
    sb.from("books").select("slug, title").eq("status", "published").order("title").limit(60),
    sb.from("authors").select("slug, name").order("name").limit(40),
    sb.from("posts").select("slug, title, excerpt, content_md").eq("status", "published").order("published_at", { ascending: false }).limit(1).maybeSingle(),
    sb.from("books").select("slug, title, subtitle, description_md").eq("status", "published").order("created_at", { ascending: false }).limit(1).maybeSingle(),
    sb.from("site_configuration")
      .select("updated_at, editor:profiles!site_configuration_updated_by_fkey(id, full_name, email)")
      .order("updated_at", { ascending: false })
      .limit(1)
      .maybeSingle(),
  ]);
  const books = (booksRes.data ?? []).filter((r) => r?.slug);
  const posts = (postsRes.data ?? []).filter((r) => r?.slug);
  const authors = (authorsRes.data ?? []).filter((r) => r?.slug);
  URL_OPTIONS = [
    ...URL_STATIC,
    ...books.map((b) => ({ value: `/catalogo/${b.slug}`,  label: b.title, hint: "Libro",    icon: "lucide:book" as const })),
    ...posts.map((p) => ({ value: `/articulos/${p.slug}`, label: p.title, hint: "Artículo", icon: "lucide:file-text" as const })),
    ...authors.map((a) => ({ value: `/autores/${a.slug}`, label: a.name,  hint: "Autor",    icon: "lucide:user" as const })),
  ];
  if (latestPostRes.data) LATEST_POST = latestPostRes.data as LatestPost;
  if (latestBookRes.data) LATEST_BOOK = latestBookRes.data as LatestBook;
  if (siteEditRes.data) LAST_SITE_EDIT = siteEditRes.data as typeof LAST_SITE_EDIT;
} catch {
  // Network / RLS hiccup — keep the static picker only.
}

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=site");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();

    const rows: Array<{ key: string; value: unknown }> = [
      { key: "hero_quote",                value: strReq(fd, "hero_quote") },
      { key: "hero_quote_author",         value: strReq(fd, "hero_quote_author") },
      { key: "editorial_description",     value: strReq(fd, "editorial_description") },
      { key: "footer_legal",              value: strReq(fd, "footer_legal") },
      { key: "whatsapp_phone",            value: strReq(fd, "whatsapp_phone") },
      { key: "whatsapp_message_template", value: strReq(fd, "whatsapp_message_template") },
      { key: "contact_email",             value: str(fd, "contact_email") ?? "" },
      { key: "contact_address",           value: str(fd, "contact_address") ?? "" },
      { key: "contact_hours",             value: str(fd, "contact_hours") ?? "" },
      { key: "contact_emails_extra",      value: parseJsonArray(fd, "contact_emails_extra_json") },
      { key: "contact_addresses_extra",   value: parseJsonArray(fd, "contact_addresses_extra_json") },
      { key: "contact_phones",            value: parseJsonArray(fd, "contact_phones_json") },
      { key: "social_accounts",           value: parseJsonArray(fd, "social_accounts_json") },
      {
        key: "social_links",
        value: {
          facebook: str(fd, "social_facebook") ?? "",
          instagram: str(fd, "social_instagram") ?? "",
          twitter: str(fd, "social_twitter") ?? "",
        },
      },
      { key: "default_keywords",      value: parseTags(fd, "default_keywords") },
      { key: "twitter_handle",        value: str(fd, "twitter_handle") ?? "" },
      { key: "og_image_default",      value: str(fd, "og_image_default") ?? "" },
      { key: "organization_logo_url", value: str(fd, "organization_logo_url") ?? "" },
      { key: "hero_image_url",        value: str(fd, "hero_image_url") ?? "" },
      { key: "hero_bg_color",         value: str(fd, "hero_bg_color") ?? "" },
    ];

    // Hero card config travels as a single JSON blob in a hidden input.
    // If parsing fails or shape is wrong, skip it (don't block the rest).
    const heroJson = fd.get("hero_card_config_json")?.toString() ?? "";
    if (heroJson) {
      try {
        const parsed = JSON.parse(heroJson);
        if (parsed && typeof parsed === "object" && parsed.content_source && parsed.desktop && parsed.mobile) {
          rows.push({ key: "hero_card_config", value: parsed });
        }
      } catch {
        // Malformed JSON — skip silently.
      }
    }

    const { error } = await supabase
      .from("site_configuration")
      .upsert(rows as never, { onConflict: "key" });
    if (error) throw error;

    return Astro.redirect("/site?saved=1&action=updated&entity=site&publish=1");
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Default hero card config — kept in sync with apps/web/src/lib/site-config.ts
// and migration 0030. Used when no value is persisted yet, and to fill
// missing keys from a partial save.
// Hero card font codes → CSS font-family. Mirror of HERO_CARD_FONTS
// in apps/web/src/lib/hero-card.ts. Used by the live preview.
const HERO_CARD_FONTS_MAP: Record<string, string> = {
  serif:               '"Cormorant Garamond", Georgia, serif',
  "eb-garamond":       '"EB Garamond", Georgia, serif',
  playfair:            '"Playfair Display", Georgia, serif',
  lora:                '"Lora", Georgia, serif',
  "libre-baskerville": '"Libre Baskerville", Georgia, serif',
  crimson:             '"Crimson Pro", Georgia, serif',
  fraunces:            '"Fraunces", Georgia, serif',
  spectral:            '"Spectral", Georgia, serif',
  sans:                '"Inter", system-ui, -apple-system, sans-serif',
  "dm-sans":           '"DM Sans", "Inter", sans-serif',
  "space-grotesk":     '"Space Grotesk", "Inter", sans-serif',
  manrope:             '"Manrope", "Inter", sans-serif',
  "work-sans":         '"Work Sans", "Inter", sans-serif',
  "plus-jakarta":      '"Plus Jakarta Sans", "Inter", sans-serif',
  outfit:              '"Outfit", "Inter", sans-serif',
  marcellus:           '"Marcellus", "Cormorant Garamond", serif',
};

const DEFAULT_HERO_CARD = {
  content_source: "editorial",
  manual: {
    eyebrow: "Editorial",
    title: "Casa de Asterión Ediciones",
    body: "",
    cta_label: "Explorar el catálogo",
    cta_href: "/catalogo",
  },
  desktop: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    eyebrow_font: "sans",
    body_font: "sans",
    cta_font: "sans",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 760,
    height: 520,
    padding: 56,
    offset_x: 96,
    offset_y: 0,
    shadow: true,
  },
  mobile: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    eyebrow_font: "sans",
    body_font: "sans",
    cta_font: "sans",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 0,
    height: 280,
    padding: 24,
    offset_x: 16,
    offset_y: 32,
    shadow: true,
  },
};

---

<AppLayout title="Webpage" wide>
  {/* Sticky wrapper that holds BOTH the page-nav (Home/Catálogo/…)
      and the inner tab nav (Hero/Editorial/…) together. The wrapper
      is the single sticky element, so the two bars travel as one
      unit — no per-element sticky math, no gaps. Negative margins
      cancel the surrounding wrapper's padding so the stack pins
      flush to the breadcrumb at all scroll positions. */}
  <div class="cas-stickystack" data-stickystack>
  <nav class="cas-pagenav" data-pagenav aria-label="Páginas del sitio">
    <button type="button" data-page-tab="home" class="cas-pagechip">
      <Icon name="lucide:home" class="w-4 h-4" aria-hidden="true" />
      <span>Home</span>
    </button>
    <button type="button" data-page-tab="catalogo" class="cas-pagechip">
      <Icon name="lucide:book-open" class="w-4 h-4" aria-hidden="true" />
      <span>Catálogo</span>
    </button>
    <button type="button" data-page-tab="articulos" class="cas-pagechip">
      <Icon name="lucide:newspaper" class="w-4 h-4" aria-hidden="true" />
      <span>Artículos</span>
    </button>
    <button type="button" data-page-tab="filosofia" class="cas-pagechip">
      <Icon name="lucide:scroll-text" class="w-4 h-4" aria-hidden="true" />
      <span>Filosofía</span>
    </button>
    <button type="button" data-page-tab="poesia" class="cas-pagechip">
      <Icon name="lucide:feather" class="w-4 h-4" aria-hidden="true" />
      <span>Poesía</span>
    </button>
    <button type="button" data-page-tab="autores" class="cas-pagechip">
      <Icon name="lucide:users" class="w-4 h-4" aria-hidden="true" />
      <span>Autores</span>
    </button>
    <button type="button" data-page-tab="contacto" class="cas-pagechip">
      <Icon name="lucide:phone" class="w-4 h-4" aria-hidden="true" />
      <span>Contacto</span>
    </button>
  </nav>

  {/* Inner tab nav (Hero / Editorial / Contacto / SEO). Sits right
      after the page-nav so the two stickies stack flush — putting
      the h1 between them broke that contact: the cas-tabs natural
      flow position was below the h1 and never reached the sticky
      pin on its own. JS hides this nav when the user switches to a
      sub-page that's not Home (it only applies to Home). */}
  <nav class="cas-tabs flex items-stretch gap-1 border-b border-stone-200 overflow-x-auto bg-white" data-tab-nav data-page-only="home">
    <button type="button" data-tab="hero" class="cas-tab cas-tab-active">
      <Icon name="lucide:layout-panel-top" class="w-4 h-4" aria-hidden="true" />
      <span>Hero</span>
    </button>
    <button type="button" data-tab="editorial" class="cas-tab">
      <Icon name="lucide:scroll-text" class="w-4 h-4" aria-hidden="true" />
      <span>Editorial</span>
    </button>
    <button type="button" data-tab="contacto" class="cas-tab">
      <Icon name="lucide:phone" class="w-4 h-4" aria-hidden="true" />
      <span>Contacto</span>
    </button>
    <button type="button" data-tab="seo" class="cas-tab">
      <Icon name="lucide:search" class="w-4 h-4" aria-hidden="true" />
      <span>SEO</span>
    </button>
    <div class="md:hidden ml-auto flex items-center gap-1 pl-2 self-center" data-fullscreen-launchers>
      <button type="button" data-fullscreen-tab="desktop" class="cas-fs-btn" aria-label="Vista web a pantalla completa" title="Vista web a pantalla completa">
        <Icon name="lucide:monitor" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Web</span>
      </button>
      <button type="button" data-fullscreen-tab="mobile" class="cas-fs-btn" aria-label="Vista mobile a pantalla completa" title="Vista mobile a pantalla completa">
        <Icon name="lucide:smartphone" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Mobile</span>
      </button>
    </div>
  </nav>
  </div>{/* /.cas-stickystack */}

  <div class="mb-6">
    <h1 class="font-serif text-3xl md:text-4xl mb-2">Webpage</h1>
    <p class="text-stone-500 max-w-2xl">
      Todo el contenido editable de cada página del sitio público.
      Elige una sub-página arriba o desde el panel lateral.
    </p>
  </div>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <Icon name="lucide:lock" class="w-4 h-4" aria-hidden="true" />
      <span>Solo lectura — tienes permiso de ver pero no de editar la configuración del sitio.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <div data-page-tab-panel="home">
  <form method="POST" data-site-form>
    <input type="hidden" name="hero_card_config_json" data-hero-json>
    <fieldset disabled={!canEdit} class="m-0 p-0 border-0 min-w-0">

      {/* === HERO TAB === */}
      {/* On <lg the aside (preview) goes first so the user sees changes
          immediately without scrolling. On lg+ we reorder so the preview
          sits on the right. */}
      <div data-tab-panel="hero" class="grid lg:grid-cols-[minmax(0,1fr)_440px] gap-6 items-start">
        <div class="space-y-6 min-w-0 lg:order-1 order-2">

          {/* Hero image — Tu imagen + Imagen por defecto stacked vertically.
              On lg+ the form column is already narrow (≈600px after the
              440px preview takes its share), so a 2-col layout here turns
              labels into 2-line wraps. Stack instead. */}
          <section class="card space-y-5">
            <CardHeader icon="lucide:image" title="Imagen del hero" desc="Foto que ocupa la mitad derecha en desktop y aparece debajo de la card en mobile." />
            <div class="space-y-4">
              {/* Page bg color — what shows behind the card and around
                  the image. Different from the card's own bg color
                  (per-platform, set in "Estilo de la card") and the
                  card's optional bg image (also per-platform). */}
              <div class="block min-w-0">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:paint-bucket" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Color de fondo del hero
                </span>
                <p class="hcc-hint mb-2">Color visible detrás de la card y alrededor de la imagen. Pulsa la X para volver al color por defecto del sitio.</p>
                <ColorEditor
                  hiddenName="hero_bg_color"
                  defaultValue=""
                  ariaLabel="Color de fondo del hero"
                  editorId="hero-bg"
                />
              </div>
              <ImageUpload
                name="hero_image_url"
                label="Tu imagen"
                bucket="covers"
                hint="Click o arrastra. Recomendado: 2400×1600px o más, horizontal."
              />
              <div class="block min-w-0">
                <span class="label flex items-center justify-between gap-2">
                  <span>Imagen por defecto</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-sm bg-stone-100 text-stone-500 border border-stone-200" title="Esta imagen no se puede modificar desde el CMS">
                    <Icon name="lucide:lock" class="w-3 h-3" aria-hidden="true" />
                    Bloqueado
                  </span>
                </span>
                <div class="relative flex items-stretch gap-4 border border-stone-200 bg-stone-50/60 p-3" data-hero-fallback>
                  <div class="relative w-24 h-24 shrink-0 bg-stone-100 border border-stone-200 overflow-hidden">
                    <img src={HERO_FALLBACK_URL} alt="Imagen por defecto del hero" loading="lazy" class="w-full h-full object-cover" />
                  </div>
                  <div class="flex-1 min-w-0 flex flex-col justify-center text-sm text-stone-700">
                    <span class="inline-flex items-center gap-1.5 font-medium text-stone-800">
                      <Icon name="lucide:image" class="w-4 h-4" aria-hidden="true" />
                      <span>Foto editorial de respaldo</span>
                    </span>
                    <span class="text-xs text-stone-500 mt-1 leading-snug">Aparece automáticamente si no defines una propia.</span>
                    <span class="mt-2 inline-flex items-center gap-1 px-1.5 py-0.5 self-start text-[10px] font-medium uppercase tracking-wider rounded-sm border" data-hero-fallback-status>
                      <span data-hero-fallback-dot class="w-1.5 h-1.5 rounded-full"></span>
                      <span data-hero-fallback-label>—</span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* Hero card content */}
          <section class="card space-y-4">
            <CardHeader icon="lucide:newspaper" title="Contenido de la card" desc="Qué se muestra dentro del recuadro principal del hero." />
            <div data-bind-dd="content_source">
              <label class="label">Fuente del contenido</label>
              <Dropdown name="content_source" value="editorial" options={CONTENT_SOURCE_OPTIONS} />
              <p class="hcc-hint mt-1">Si eliges artículo o libro pero aún no hay nada publicado, se usa la descripción editorial como fallback.</p>
            </div>

            {/* Mini preview that mirrors EXACTLY how the public site
                will render the card at desktop breakpoint. The card
                is rendered at its full configured desktop dimensions
                (width / min-height / padding) with the same Tailwind
                classes the public site uses on the .hcc-* elements
                — same font sizes (text-5xl title, text-base body,
                text-xs eyebrow/cta), same line-clamp values
                (4 / 3), same opacity / tracking — so truncation
                behaves identically to what visitors see. The whole
                stage is then CSS-scaled to fit the form column.
                Below the frame, contextual hints surface: a
                warning when source=latest_post / latest_book but
                nothing's published; an "Editar editorial" link
                when source=editorial. */}
            <div class="hcc-content-preview" data-content-preview>
              <p class="hcc-preview-eyebrow-label">Preview del contenido</p>
              <div class="hcc-cp-frame" data-cp-frame>
                <div class="hcc-cp-stage" data-cp-stage>
                  <div class="hcc-cp-card flex flex-col justify-between" data-cp-card>
                    <div>
                      <p class="hcc-cp-eyebrow uppercase text-xs tracking-[0.2em] opacity-70 mb-5" data-cp-eyebrow></p>
                      <h3 class="hcc-cp-title text-5xl leading-[1.1] mb-5 line-clamp-4" data-cp-title></h3>
                      <p class="hcc-cp-body text-base opacity-80 leading-relaxed line-clamp-3" data-cp-body></p>
                    </div>
                    <span class="hcc-cp-cta uppercase text-xs tracking-[0.18em] border-b border-current/60 pb-1 self-start mt-4" data-cp-cta></span>
                  </div>
                </div>
              </div>
              <p class="hcc-cp-hint" data-cp-warning role="status" hidden></p>
              <a class="hcc-cp-edit-link" data-cp-edit-editorial href="#" hidden>
                <Icon name="lucide:external-link" class="w-3 h-3" aria-hidden="true" />
                Editar la descripción editorial
              </a>
            </div>
            {/* Manual-only fields (eyebrow / title / body): hidden
                unless content_source = "manual". */}
            <div data-manual-fields class="space-y-4 pt-4 border-t border-stone-100" hidden>
              <div class="hcc-field">
                <label class="hcc-field-label">
                  <Icon name="lucide:tag" class="w-3.5 h-3.5" aria-hidden="true" />
                  Eyebrow
                </label>
                <p class="hcc-hint">Texto corto en mayúsculas que aparece sobre el título. Ej: <em>Editorial</em>.</p>
                <input type="text" data-bind="manual.eyebrow" class="hcc-input w-full" />
              </div>
              <div class="hcc-field">
                <label class="hcc-field-label">
                  <Icon name="lucide:type" class="w-3.5 h-3.5" aria-hidden="true" />
                  Título
                </label>
                <p class="hcc-hint">Frase principal de la card. Mantenla corta y elocuente — es lo primero que se lee.</p>
                <input type="text" data-bind="manual.title" class="hcc-input w-full" />
              </div>
              <div class="hcc-field">
                <label class="hcc-field-label">
                  <Icon name="lucide:align-left" class="w-3.5 h-3.5" aria-hidden="true" />
                  Cuerpo
                </label>
                <p class="hcc-hint">Párrafo breve bajo el título (opcional). Una o dos frases máximo.</p>
                <textarea data-bind="manual.body" rows="3" class="hcc-input w-full"></textarea>
              </div>
            </div>
            {/* CTA fields (text + URL picker): visible for both
                content_source = "manual" AND "editorial" (the
                latest_post / latest_book modes link to the article
                or book detail page directly, so they don't expose
                a custom CTA). */}
            <div data-cta-fields class="space-y-4 pt-4 border-t border-stone-100" hidden>
              <div class="hcc-field">
                <label class="hcc-field-label">
                  <Icon name="lucide:mouse-pointer-click" class="w-3.5 h-3.5" aria-hidden="true" />
                  Texto del botón
                </label>
                <p class="hcc-hint">Llamada a la acción visible en el CTA. Ej: <em>Explorar el catálogo</em>.</p>
                <input type="text" data-bind="manual.cta_label" class="hcc-input w-full" placeholder="Explorar el catálogo" />
              </div>
              <div class="hcc-field">
                <label class="hcc-field-label">
                  <Icon name="lucide:link" class="w-3.5 h-3.5" aria-hidden="true" />
                  URL del botón
                </label>
                <p class="hcc-hint">Escribe una ruta o elige una página detectada del sitio.</p>
                <div class="hcc-url-combo" data-url-combo>
                  <input
                    type="text"
                    data-bind="manual.cta_href"
                    data-url-combo-input
                    class="hcc-input w-full"
                    placeholder="/catalogo"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button
                    type="button"
                    class="hcc-url-combo-toggle"
                    data-url-combo-toggle
                    aria-label="Mostrar sugerencias"
                  >
                    <Icon name="lucide:chevron-down" class="w-4 h-4" aria-hidden="true" />
                  </button>
                  <ul class="hcc-url-combo-list" data-url-combo-list role="listbox" hidden></ul>
                </div>
              </div>
            </div>
          </section>

          {/* Hero card style: desktop */}
          <section class="card space-y-4" data-platform-section="desktop">
            <CardHeader icon="lucide:monitor" title="Estilo de la card (Web)" desc="Cómo se ve la card en pantallas medianas y grandes." />
            <HeroCardPlatformControls platform="desktop" />
          </section>

          {/* Hero card style: mobile */}
          <section class="card space-y-4" data-platform-section="mobile">
            <CardHeader icon="lucide:smartphone" title="Estilo de la card (Mobile)" desc="Cómo se ve la card en celulares." />
            <HeroCardPlatformControls platform="mobile" />
          </section>

        </div>

        {/* Live preview pane.
            On lg+ it sticks below the tab nav (~46px tall, sticky at
            md:top-0 inside main). 60px ≈ tab nav + small breathing
            room. The breadcrumb lives outside main now, so it does
            NOT count against this offset. */}
        <aside class="cas-preview-aside lg:sticky space-y-3 lg:order-2 order-1">
          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" data-preview-tab="desktop" class="cas-preview-tab cas-preview-tab-active">
              <Icon name="lucide:monitor" class="w-3.5 h-3.5" aria-hidden="true" />
              Web
            </button>
            <button type="button" data-preview-tab="mobile" class="cas-preview-tab">
              <Icon name="lucide:smartphone" class="w-3.5 h-3.5" aria-hidden="true" />
              Mobile
            </button>
            {/* Zoom controls — multiply the auto-fit scale by this
                factor so editors can inspect tiny details (a 12px
                eyebrow on a 1440px frame ≈ 4px on screen at 1×). */}
            <div class="cas-preview-zoom ml-auto flex items-center gap-0.5 border border-stone-200 rounded-sm" role="group" aria-label="Zoom del preview">
              <button type="button" data-preview-zoom-out class="cas-preview-zoom-btn" aria-label="Reducir zoom" title="Reducir zoom">
                <Icon name="lucide:minus" class="w-3.5 h-3.5" aria-hidden="true" />
              </button>
              <span class="cas-preview-zoom-value tabular-nums" data-preview-zoom-value>100%</span>
              <button type="button" data-preview-zoom-in class="cas-preview-zoom-btn" aria-label="Aumentar zoom" title="Aumentar zoom">
                <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              </button>
              <button type="button" data-preview-zoom-reset class="cas-preview-zoom-btn cas-preview-zoom-reset" aria-label="Restablecer zoom" title="Restablecer zoom (100%)">
                <Icon name="lucide:rotate-ccw" class="w-3.5 h-3.5" aria-hidden="true" />
              </button>
            </div>
            <span class="text-[11px] uppercase tracking-wider text-stone-400" data-preview-meta>desktop · 1440 × 720</span>
          </div>
          {/* The frame's overflow flips to auto when zoom > 1 so the
              user can pan via scroll. The card link is rendered with
              pointer-events: none below so a user can't accidentally
              navigate away by clicking "Explorar el catálogo". */}
          <div class="cas-preview-frame border border-stone-200 bg-stone-100" data-preview-frame>
            <div class="relative w-full h-full" data-preview-stage>
              {/* Right-half image — only visible in desktop preview */}
              <div data-preview-bg-image class="absolute top-0 right-0 h-full w-1/2 bg-cover bg-center pointer-events-none"></div>
              {/* The card. Position is computed at render time per platform. */}
              <a data-preview-card class="cas-preview-noninteractive z-10 flex flex-col justify-between" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-disabled="true">
                <div>
                  <p data-preview-eyebrow class="hcc-eyebrow uppercase tracking-[0.2em] opacity-70"></p>
                  <h1 data-preview-title class="hcc-title leading-[1.1]"></h1>
                  <p data-preview-body class="hcc-body opacity-80 leading-relaxed"></p>
                </div>
                <span data-preview-cta class="hcc-cta uppercase tracking-[0.18em] border-b border-current/60 pb-1 self-start mt-4"></span>
              </a>
              {/* Stacked mobile image — only visible in mobile preview */}
              <img data-preview-mobile-img alt="" class="block w-full" style="display:none;" />
            </div>
          </div>
          <button type="button" class="text-xs text-stone-500 hover:text-stone-900 underline underline-offset-4" data-reset-hero-btn>
            Restablecer estilos del hero a default
          </button>
        </aside>
      </div>

      {/* === EDITORIAL TAB === */}
      <div data-tab-panel="editorial" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:scroll-text" title="Editorial" desc="Información general que aparece en footer, meta tags y al compartir." />
          <Field label="Descripción de la editorial" name="editorial_description" type="textarea" rows={3} required description="Aparece en el footer y como meta description del sitio. 1-2 frases." />
          <Field label="Línea legal del footer" name="footer_legal" required description="Texto pequeño abajo del footer (ej: '© 2026 Casa de Asterión Ediciones')." />
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:quote" title="Cita destacada" desc="Aparece debajo del hero en la página de inicio, sobre fondo claro." />
          <Field label="Cita" name="hero_quote" type="textarea" rows={3} required description="Frase corta y elocuente. Sin comillas alrededor — el diseño las añade." />
          <Field label="Autor de la cita" name="hero_quote_author" required description="Nombre que firma la cita." />
        </section>
      </div>

      {/* === CONTACTO TAB === */}
      <div data-tab-panel="contacto" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:mail" title="Correos electrónicos" desc="El primer email se considera el principal. Puedes agregar todos los que necesites (prensa, ventas, derechos, etc.)." />
          <Field label="Email principal" name="contact_email" type="email" description="Aparece como primera tarjeta en /contacto." />
          <div class="cl-list" data-list-editor="contact_emails_extra" data-list-template="email">
            <div class="cl-list-rows" data-list-rows></div>
            <button type="button" class="cl-list-add" data-list-add>
              <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              Agregar otro correo
            </button>
            <input type="hidden" name="contact_emails_extra_json" data-list-json />
          </div>
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:map-pin" title="Direcciones" desc="Si tu editorial tiene varias sedes o apartado postal, agrégalos todos aquí." />
          <Field label="Dirección principal" name="contact_address" type="textarea" rows={2} description="Soporta varias líneas." />
          <div class="cl-list" data-list-editor="contact_addresses_extra" data-list-template="address">
            <div class="cl-list-rows" data-list-rows></div>
            <button type="button" class="cl-list-add" data-list-add>
              <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              Agregar otra dirección
            </button>
            <input type="hidden" name="contact_addresses_extra_json" data-list-json />
          </div>
          <Field label="Horario de atención" name="contact_hours" type="textarea" rows={2} description="Opcional. Ej: 'Lun a Vie · 9:00 — 18:00'." />
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:phone" title="Teléfonos y WhatsApp" desc="El número de compras (abajo) se usa en cada libro para abrir WhatsApp; los demás aparecen en /contacto." />
          <div class="cl-list" data-list-editor="contact_phones" data-list-template="phone">
            <div class="cl-list-rows" data-list-rows></div>
            <button type="button" class="cl-list-add" data-list-add>
              <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              Agregar otro teléfono
            </button>
            <input type="hidden" name="contact_phones_json" data-list-json />
          </div>
          <div class="pt-4 border-t border-stone-100 space-y-4">
            <p class="label flex items-center gap-1.5">
              <Icon name="lucide:shopping-cart" class="w-3.5 h-3.5" aria-hidden="true" />
              WhatsApp dedicado a compras
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              <Field label="Número en formato E.164" name="whatsapp_phone" required description="Ej: +573117462759 (con + y código país)." />
            </div>
            <Field label="Plantilla del mensaje" name="whatsapp_message_template" type="textarea" rows={3} required description="Variables: {{title}}, {{author}}, {{isbn}}, {{slug}}. Se usa cuando un libro no define un mensaje propio." />
          </div>
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:share-2" title="Redes sociales" desc="Las tres principales (Facebook, Instagram, Twitter) se enlazan también desde el footer; las demás solo aparecen en /contacto." />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="block min-w-0">
              <label for="f-social_facebook" class="block">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:facebook" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Facebook
                </span>
              </label>
              <input id="f-social_facebook" type="url" name="social_facebook" class="input" placeholder="https://www.facebook.com/..." />
              <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">URL pública del perfil.</p>
            </div>
            <div class="block min-w-0">
              <label for="f-social_instagram" class="block">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:instagram" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Instagram
                </span>
              </label>
              <input id="f-social_instagram" type="url" name="social_instagram" class="input" placeholder="https://www.instagram.com/..." />
              <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">URL pública del perfil.</p>
            </div>
            <div class="block min-w-0">
              <label for="f-social_twitter" class="block">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:twitter" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Twitter / X
                </span>
              </label>
              <input id="f-social_twitter" type="url" name="social_twitter" class="input" placeholder="https://x.com/..." />
              <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">URL pública del perfil.</p>
            </div>
          </div>
          <div class="pt-4 border-t border-stone-100">
            <p class="label">Otras redes / enlaces</p>
            <p class="hcc-hint mb-3">YouTube, LinkedIn, TikTok, sitio web, etc.</p>
            <div class="cl-list" data-list-editor="social_accounts" data-list-template="social">
              <div class="cl-list-rows" data-list-rows></div>
              <button type="button" class="cl-list-add" data-list-add>
                <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
                Agregar otra red
              </button>
              <input type="hidden" name="social_accounts_json" data-list-json />
            </div>
          </div>
        </section>
      </div>

      {/* === SEO TAB === */}
      <div data-tab-panel="seo" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:search" title="SEO global y schema.org" desc="Defaults para cada página del sitio público y datos para JSON-LD." />
          <div class="grid sm:grid-cols-2 gap-4">
            <Field label="Palabras clave globales" name="default_keywords" description="Términos que describen la editorial. Separadas por coma." />
            <Field label="Handle de Twitter / X" name="twitter_handle" description="Con la @ inicial (ej: @casadeasterion)." />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <ImageUpload name="og_image_default" label="Imagen al compartir (Open Graph)" bucket="covers" hint="Click o arrastra. 1200×630px recomendado. Se usa cuando un post/libro no tiene portada." />
            <ImageUpload name="organization_logo_url" label="Logo de la editorial (JSON-LD)" bucket="covers" hint="Click o arrastra. Cuadrado o casi cuadrado. Lo lee Google." />
          </div>
        </section>
      </div>

      {(canEdit || LAST_SITE_EDIT) && (
        <div class="sticky bottom-0 bg-white border-t border-stone-200 z-10 -mx-5 md:-mx-8 lg:-mx-10 -mb-6 md:-mb-10 mt-8">
          <div class="px-5 md:px-8 lg:px-10 py-3 flex items-center gap-3 flex-wrap">
            {canEdit && (
              <button type="submit" class="btn-primary" disabled data-submit-btn>Guardar configuración</button>
            )}
            {LAST_SITE_EDIT && formatAgo(LAST_SITE_EDIT.updated_at) && (
              <div class="text-xs text-stone-500 italic leading-tight">
                {LAST_SITE_EDIT.editor ? (
                  <>
                    <p class="m-0">
                      Editado por{" "}
                      <a
                        href={`/admins/${LAST_SITE_EDIT.editor.id}`}
                        class="underline decoration-stone-400 hover:text-stone-900 hover:decoration-current"
                        data-astro-prefetch
                        data-tooltip={fullName(LAST_SITE_EDIT.editor)}
                      >{fullName(LAST_SITE_EDIT.editor)}</a>
                    </p>
                    <p class="m-0 text-[10.5px] text-stone-400">
                      {formatAgo(LAST_SITE_EDIT.updated_at)}
                    </p>
                  </>
                ) : (
                  <p class="m-0">Última edición {formatAgo(LAST_SITE_EDIT.updated_at)}</p>
                )}
              </div>
            )}
          </div>
        </div>
      )}
    </fieldset>
  </form>

  {/* Fullscreen preview modal — outside the form so the submit button
      doesn't pick up its inputs. The card content elements use the
      same data-preview-{eyebrow,title,body,cta} attribute names as
      the inline preview because applyContent() queries by those
      selectors on whatever card it gets — keeping them consistent
      lets one set of render fns target either preview. */}
  <div data-fullscreen-modal hidden class="fixed inset-0 z-[60] bg-stone-900 flex flex-col">
    <header class="flex items-center justify-between px-4 h-14 border-b border-stone-700 text-stone-100 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <span data-fullscreen-platform class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-wider px-2 py-1 rounded bg-stone-800">
          <Icon name="lucide:monitor" class="w-3.5 h-3.5" aria-hidden="true" />
          <span data-fullscreen-platform-label>Web</span>
        </span>
        <span data-fullscreen-meta class="text-[11px] text-stone-400 uppercase tracking-wider truncate">1440 × 720</span>
      </div>
      <button type="button" data-fullscreen-close class="text-stone-300 hover:text-white p-2 -mr-2 transition-colors cursor-pointer" aria-label="Cerrar preview">
        <Icon name="lucide:x" class="w-5 h-5" aria-hidden="true" />
      </button>
    </header>
    <div class="flex-1 relative overflow-hidden bg-stone-100" data-fullscreen-frame>
      <div class="relative" data-fullscreen-stage>
        <div data-fullscreen-bg-image class="absolute top-0 right-0 h-full w-1/2 bg-cover bg-center pointer-events-none"></div>
        <a data-fullscreen-card class="cas-preview-noninteractive z-10 flex flex-col justify-between" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-disabled="true">
          <div>
            <p data-preview-eyebrow class="hcc-eyebrow uppercase tracking-[0.2em] opacity-70"></p>
            <h1 data-preview-title class="hcc-title leading-[1.1]"></h1>
            <p data-preview-body class="hcc-body opacity-80 leading-relaxed"></p>
          </div>
          <span data-preview-cta class="hcc-cta uppercase tracking-[0.18em] border-b border-current/60 pb-1 self-start mt-4"></span>
        </a>
        <img data-fullscreen-mobile-img alt="" class="block w-full" style="display:none;" />
      </div>
    </div>
  </div>

  </div>{/* /[data-page-tab-panel="home"] */}

  {/* Placeholder panels for the other site pages. Each one shows a
      simple "en construcción" card; the real editor wiring will land
      in follow-up work. */}
  <div data-page-tab-panel="catalogo" hidden>
    <PageStub icon="lucide:book-open" title="Catálogo" />
  </div>
  <div data-page-tab-panel="articulos" hidden>
    <PageStub icon="lucide:newspaper" title="Artículos" />
  </div>
  <div data-page-tab-panel="filosofia" hidden>
    <PageStub icon="lucide:scroll-text" title="Filosofía" />
  </div>
  <div data-page-tab-panel="poesia" hidden>
    <PageStub icon="lucide:feather" title="Poesía" />
  </div>
  <div data-page-tab-panel="autores" hidden>
    <PageStub icon="lucide:users" title="Autores" />
  </div>
  <div data-page-tab-panel="contacto" hidden>
    <PageStub icon="lucide:phone" title="Contacto" />
  </div>
</AppLayout>

<style is:global>
  /* === Page nav (Home / Catálogo / Artículos / …) ===
     Stickies under the breadcrumb. Initial state: relaxed wrapping
     row of chips. Stuck state ([data-stuck="1"], set by JS via an
     IntersectionObserver sentinel): becomes a single-line row that
     scrolls horizontally if needed, with a hairline bottom border so
     it visually separates from the inner tab nav. Both states share
     the same chip sizing so chips don't reflow when stickying. */
  /* The sticky wrapper around the page-nav + tab-nav. Negative
     margins cancel main's wrapper padding so the stack pins flush
     to the breadcrumb at scroll=0 AND when stuck. Inner padding
     reproduces the visual padding of the original layout. */
  .cas-stickystack {
    position: sticky;
    z-index: 11;
    top: 96px;
    margin: -1.5rem -1.25rem 1.5rem;
    background: white;
  }
  @media (min-width: 768px) {
    .cas-stickystack {
      top: 0;
      margin-top: -2.5rem;
      margin-left: -2rem;
      margin-right: -2rem;
    }
  }
  @media (min-width: 1024px) {
    .cas-stickystack {
      margin-left: -2.5rem;
      margin-right: -2.5rem;
    }
  }

  .cas-pagenav {
    /* No own sticky — the wrapper is sticky. Padding-top creates
       the visible breathing room above the chips that compensates
       for the wrapper's negative margin-top. */
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem 1.5rem;
    background: white;
    transition: padding 0.15s ease;
  }
  @media (min-width: 768px) {
    .cas-pagenav { padding: 2.5rem 2rem 1.5rem; }
  }
  @media (min-width: 1024px) {
    .cas-pagenav { padding-left: 2.5rem; padding-right: 2.5rem; }
  }
  .cas-pagenav[data-stuck="1"] {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
  }
  .cas-pagenav[data-stuck="1"]::-webkit-scrollbar { height: 4px; }
  .cas-pagenav[data-stuck="1"]::-webkit-scrollbar-thumb {
    background: rgb(214 211 209);
    border-radius: 2px;
  }

  .cas-pagechip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(68 64 60);                  /* stone-700 */
    background: white;
    border: 1px solid rgb(214 211 209);    /* stone-300 */
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .cas-pagechip:hover {
    background: rgb(245 245 244);          /* stone-100 */
    color: rgb(28 25 23);
    border-color: rgb(168 162 158);
  }
  .cas-pagechip-active,
  .cas-pagechip-active:hover {
    background: rgb(28 25 23);             /* stone-900 */
    color: white;
    border-color: rgb(28 25 23);
  }
  .cas-pagechip > svg { color: currentColor; flex: 0 0 auto; }
  @media (max-width: 640px) {
    .cas-pagechip { padding: 0.375rem 0.625rem; font-size: 0.75rem; gap: 0.375rem; }
  }

  /* === Tab nav (Hero / Editorial / Contacto / SEO) ===
     Lives inside the .cas-stickystack so it travels together with
     the page-nav. No own sticky. Padding mirrors the page-nav so
     the row aligns visually. */
  .cas-tabs {
    padding: 0 1.25rem;
    background: white;
  }
  @media (min-width: 768px) {
    .cas-tabs { padding: 0 2rem; }
  }
  @media (min-width: 1024px) {
    .cas-tabs { padding: 0 2.5rem; }
  }
  .cas-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(120 113 108);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .cas-tab:hover { color: rgb(28 25 23); }
  .cas-tab-active { color: rgb(28 25 23); border-bottom-color: rgb(28 25 23); }
  /* Compact tabs on mobile: smaller padding, smaller font, hide nothing */
  @media (max-width: 640px) {
    .cas-tab { padding: 0.5rem 0.625rem; font-size: 0.8125rem; gap: 0.375rem; }
  }

  /* Fullscreen preview launcher buttons sit at the right of the tabs nav */
  .cas-fs-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    background: rgb(245 245 244);
    border: 1px solid rgb(214 211 209);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .cas-fs-btn:hover {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }

  /* === Inputs === */
  .hcc-input {
    border: 1px solid rgb(214 211 209);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: white;
    transition: border-color 0.15s;
    min-width: 0;
  }
  .hcc-input:focus { outline: none; border-color: rgb(28 25 23); }

  /* === Preview tabs (web/mobile) === */
  .cas-preview-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    border: 1px solid rgb(214 211 209);
    color: rgb(120 113 108);
    background: white;
    cursor: pointer;
  }
  .cas-preview-tab-active {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }
  .cas-preview-frame {
    height: clamp(280px, 48vh, 720px);
    position: relative;
    overflow: hidden;
  }
  /* When the editor zooms in past 100% the staged content extends
     past the frame; flip overflow to auto so they can pan. */
  .cas-preview-frame[data-preview-zoomed="true"] { overflow: auto; }
  @media (min-width: 1024px) {
    .cas-preview-frame { height: clamp(420px, 56vh, 720px); }
  }
  /* The preview card is rendered as <a> for layout parity with the
     public site, but inside the CMS we don't want clicks navigating
     away to /catalogo etc. Block all pointer interaction on the
     card and its descendants. */
  .cas-preview-noninteractive,
  .cas-preview-noninteractive * { pointer-events: none; }

  /* Preview parity with the public hero card.
     Every visual property the public site sets via Tailwind utility
     classes is replicated here as plain CSS, scoped to the preview's
     own data-attributes. This keeps the preview self-contained — it
     does NOT rely on Tailwind classes existing in the bundle, on the
     responsive viewport breakpoints (preview is rendered inside a
     desktop-sized CMS viewport so md:* would always apply), or on
     the order of inline styles vs class styles. Source of truth:
     apps/web/src/pages/index.astro lines 86-102. */

  /* Card: same flex behavior as the public <a class="hero-card-cms">. */
  [data-preview-card],
  [data-fullscreen-card] {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* Eyebrow: <p class="hcc-eyebrow uppercase text-[10px] sm:text-xs
     tracking-[0.2em] opacity-70 mb-3 sm:mb-5"> */
  [data-preview-eyebrow] {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    opacity: 0.7;
    margin: 0 0 0.75rem 0;
  }

  /* Title: <h1 class="hcc-title text-[1.4rem] sm:text-2xl md:text-5xl
     leading-[1.1] mb-3 sm:mb-5 line-clamp-3 md:line-clamp-4"> */
  [data-preview-title] {
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: normal;
    margin: 0 0 0.75rem 0;
    /* Clamp setup; line-count is platform-scoped below. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Body: <p class="hcc-body text-xs sm:text-sm md:text-base
     opacity-80 leading-relaxed line-clamp-2 md:line-clamp-3"> */
  [data-preview-body] {
    font-weight: 400;
    line-height: 1.625;       /* leading-relaxed */
    opacity: 0.8;
    letter-spacing: normal;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA: <span class="hcc-cta uppercase text-[11px] sm:text-xs
     tracking-[0.18em] border-b border-current/60 pb-1 self-start
     mt-4"> */
  [data-preview-cta] {
    align-self: flex-start;
    margin-top: 1rem;
    padding-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 400;
    border-bottom: 1px solid color-mix(in srgb, currentColor 60%, transparent);
  }

  /* DESKTOP — matches the md:* breakpoint utilities (≥768px). */
  [data-platform="desktop"] [data-preview-eyebrow] {
    font-size: 0.75rem;       /* text-xs */
    margin-bottom: 1.25rem;   /* mb-5 */
  }
  [data-platform="desktop"] [data-preview-title] {
    font-size: 3rem;          /* text-5xl */
    margin-bottom: 1.25rem;   /* mb-5 */
    -webkit-line-clamp: 4;
  }
  [data-platform="desktop"] [data-preview-body] {
    font-size: 1rem;          /* text-base */
    -webkit-line-clamp: 3;
  }
  [data-platform="desktop"] [data-preview-cta] {
    font-size: 0.75rem;       /* text-xs */
  }

  /* MOBILE — matches the base (<sm) utilities (<640px). */
  [data-platform="mobile"] [data-preview-eyebrow] {
    font-size: 10px;          /* text-[10px] */
    margin-bottom: 0.75rem;   /* mb-3 */
  }
  [data-platform="mobile"] [data-preview-title] {
    font-size: 1.4rem;        /* text-[1.4rem] */
    margin-bottom: 0.75rem;   /* mb-3 */
    -webkit-line-clamp: 3;
  }
  [data-platform="mobile"] [data-preview-body] {
    font-size: 0.75rem;       /* text-xs */
    -webkit-line-clamp: 2;
  }
  [data-platform="mobile"] [data-preview-cta] {
    font-size: 11px;          /* text-[11px] */
  }

  /* When the user clicks Web / Mobile in the preview, auto-scroll
     stops short by this much so the sticky stack doesn't cover the
     top of the target editor section. Reads the live stack height
     (--cas-stickystack-h) so the offset adapts when the bar
     compacts. Mobile adds the 56 mobile header + 40 breadcrumb. */
  [data-platform-section] {
    scroll-margin-top: calc(96px + var(--cas-stickystack-h, 92px) + 14px);
  }
  @media (min-width: 768px) {
    [data-platform-section] {
      scroll-margin-top: calc(var(--cas-stickystack-h, 92px) + 14px);
    }
  }

  /* Right-side preview aside on lg+: pinned below the sticky stack
     so it never gets covered. */
  .cas-preview-aside { /* base: nothing — sticky kicks in at lg */ }
  @media (min-width: 1024px) {
    .cas-preview-aside {
      position: sticky;
      top: calc(var(--cas-stickystack-h, 92px) + 16px);
    }
  }

  /* Zoom controls */
  .cas-preview-zoom-btn {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: white;
    border: 0;
    color: rgb(68 64 60);
    cursor: pointer;
    transition: background-color 0.12s, color 0.12s;
  }
  .cas-preview-zoom-btn:hover { background: rgb(245 245 244); color: rgb(28 25 23); }
  .cas-preview-zoom-btn:disabled { color: rgb(214 211 209); cursor: not-allowed; background: white; }
  .cas-preview-zoom-reset { border-left: 1px solid rgb(231 229 228); }
  .cas-preview-zoom-value {
    font-size: 11px;
    color: rgb(68 64 60);
    padding: 0 0.4rem;
    min-width: 36px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* === Stack + row helpers === */
  .hcc-stack { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  .hcc-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .hcc-row-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    white-space: nowrap;
  }
  .hcc-row-tight {
    flex-wrap: nowrap;
  }
  .hcc-row-icon {
    color: rgb(120 113 108);
    flex: 0 0 auto;
  }
  .hcc-mirror-text { flex: 1 1 0; min-width: 70px; }
  .hcc-mirror-num { width: 56px; flex: 0 0 auto; text-align: right; }
  .hcc-range { flex: 1 1 80px; min-width: 0; accent-color: rgb(28 25 23); }

  /* === Color block (swatch + hex + alpha slider + percent) ===
     Sized to match the Dropdown button exactly. Both controls use
     box-sizing: border-box and height: var(--cas-control-h) below,
     so a color editor and a Dropdown sit on the same row pixel for
     pixel — no 1px nudge from a stray border. */
  .hcc-color-block {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    height: var(--cas-control-h, 38px);
    border: 1px solid rgb(214 211 209);
    background: white;
    border-radius: 4px;
    padding: 0;
    overflow: hidden;
  }
  /* Force the Dropdown buttons inside this page to the same exact
     height as the color block. We scope to [data-site-form] so we
     don't affect Dropdown usages on other pages. */
  [data-site-form] .cas-dd-btn {
    box-sizing: border-box;
    height: var(--cas-control-h, 38px);
  }
  [data-site-form] { --cas-control-h: 38px; }
  .hcc-swatch-wrap {
    position: relative;
    display: block;
    width: 36px;
    height: 100%;
    border: 0;
    border-right: 1px solid rgb(214 211 209);
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
    background-image:
      linear-gradient(45deg, #e5e5e4 25%, transparent 25%),
      linear-gradient(-45deg, #e5e5e4 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e5e5e4 75%),
      linear-gradient(-45deg, transparent 75%, #e5e5e4 75%);
    background-size: 8px 8px;
    background-position: 0 0, 0 4px, 4px -4px, -4px 0;
  }
  .hcc-swatch-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    border: 0;
    padding: 0;
  }
  .hcc-swatch {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--swatch-color, #1a1715);
    pointer-events: none;
  }
  .hcc-color-info {
    flex: 1;
    min-width: 0;
    padding: 0 0.4rem 0 0.625rem;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto auto;
    gap: 0.5rem;
    align-items: center;
  }
  /* Solo variant has just the hex + reset X — no range / no pct. */
  .hcc-color-block--solo .hcc-color-info {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  /* Editable hex: looks like text by default; gets a tinted bg on
     hover/focus so users discover the click affordance. */
  .hcc-color-hex[contenteditable="true"] {
    cursor: text;
    padding: 1px 4px;
    border-radius: 3px;
    transition: background-color 0.12s;
    outline: none;
    user-select: text;
    /* Truncate when there's not enough room rather than pushing the X */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hcc-color-hex[contenteditable="true"]:hover { background: rgb(245 245 244); }
  .hcc-color-hex[contenteditable="true"]:focus {
    background: rgb(245 245 244);
    box-shadow: inset 0 0 0 1px rgb(28 25 23);
  }
  /* Reset X button. Sits flush right inside the editor frame and
     never wraps — has its own grid column above. */
  .hcc-color-reset {
    width: 22px;
    height: 22px;
    border: 0;
    background: transparent;
    color: rgb(168 162 158);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.12s, color 0.12s;
  }
  .hcc-color-reset:hover {
    background: rgb(245 245 244);
    color: rgb(28 25 23);
  }
  .hcc-color-reset:focus-visible {
    outline: none;
    background: rgb(245 245 244);
    color: rgb(28 25 23);
    box-shadow: inset 0 0 0 1.5px rgb(28 25 23);
  }
  .hcc-color-hex {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    color: rgb(68 64 60);
    text-transform: lowercase;
    white-space: nowrap;
  }
  .hcc-color-pct {
    font-size: 0.75rem;
    color: rgb(120 113 108);
    font-variant-numeric: tabular-nums;
    min-width: 36px;
    text-align: right;
    white-space: nowrap;
  }

  /* === Icon prefix === */
  .hcc-icon-prefix {
    display: inline-flex;
    color: rgb(120 113 108);
    flex: 0 0 auto;
  }

  /* === Numeric cell with icon + label + suffix === */
  .hcc-num-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .hcc-num-cell-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
  }
  .hcc-num-icon {
    display: inline-flex;
    color: rgb(120 113 108);
  }
  .hcc-num-input-wrap {
    position: relative;
    display: block;
  }
  .hcc-num-input {
    width: 100%;
    padding-right: 26px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hcc-num-suffix {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7rem;
    color: rgb(168 162 158);
    pointer-events: none;
  }

  /* === Size grid: 3 cells === */
  .hcc-size-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (max-width: 380px) {
    .hcc-size-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hcc-size-grid > :nth-child(3) { grid-column: 1 / -1; }
  }

  /* === Position inputs ===
     X and Y rows with −/+ stepper buttons flanking each input. The
     visual drag pad was removed because it pushed users toward
     positions that needed to be re-edited anyway; explicit numbers
     plus easy nudge buttons cover the common case better. */
  .hcc-pos-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 320px;
  }
  .hcc-pos-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .hcc-pos-control {
    display: flex;
    align-items: stretch;
    gap: 0.375rem;
  }
  .hcc-pos-input-wrap {
    flex: 1;
    min-width: 0;
  }
  .hcc-step {
    width: 32px;
    height: 36px;
    border: 1px solid rgb(214 211 209);
    background: white;
    border-radius: 4px;
    color: rgb(68 64 60);
    font-size: 1.1rem;
    line-height: 1;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    flex-shrink: 0;
    user-select: none;
  }
  .hcc-step:hover { background: rgb(28 25 23); border-color: rgb(28 25 23); color: white; }
  .hcc-step:active { transform: translateY(0.5px); }
  .hcc-step:focus-visible { outline: none; border-color: rgb(28 25 23); box-shadow: 0 0 0 1px rgb(28 25 23); }

  /* === Color input === */
  [data-platform-section] input[type="color"] {
    width: 44px; height: 32px; padding: 0;
    border: 1px solid rgb(214 211 209);
    cursor: pointer; background: white;
    flex: 0 0 auto;
  }
  [data-platform-section] input[type="range"] { accent-color: rgb(28 25 23); }

  /* === Triplet (3 inputs in a row) and Pair (2 inputs) === */
  .hcc-triplet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .hcc-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .hcc-triplet-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .hcc-triplet-cell > span {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
  }
  /* On really narrow screens, triplets become 2 cols + 1 below */
  @media (max-width: 380px) {
    .hcc-triplet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hcc-triplet-cell:nth-child(3) { grid-column: 1 / -1; }
  }

  /* === Border radius editor — single bordered container with corners
        + link toggle inside, so it reads as one tool. === */
  .hcc-radius-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    max-width: 360px;
    border: 1px solid rgb(229 229 228);
    background: rgb(250 250 249);
    border-radius: 6px;
    padding: 0.5rem;
  }
  .hcc-radius-corner {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    background: white;
    border: 1px solid rgb(229 229 228);
    border-radius: 4px;
  }
  /* Right-side corners get input-then-icon order */
  .hcc-radius-corner-tr,
  .hcc-radius-corner-br {
    flex-direction: row;
    justify-content: flex-end;
  }
  .hcc-radius-corner > .hcc-input {
    flex: 1 1 0;
    min-width: 0;
    padding: 0.2rem 0.4rem;
    font-size: 0.8125rem;
    border: 0;
    background: transparent;
    text-align: center;
  }
  .hcc-radius-corner > .hcc-input:focus { outline: 1px solid rgb(28 25 23); outline-offset: 1px; }
  .hcc-corner-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border: 2px solid transparent;
    color: rgb(120 113 108);
  }
  .hcc-corner-tl {
    border-top: 2px solid currentColor;
    border-left: 2px solid currentColor;
    border-top-left-radius: 5px;
  }
  .hcc-corner-tr {
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    border-top-right-radius: 5px;
  }
  .hcc-corner-bl {
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
    border-bottom-left-radius: 5px;
  }
  .hcc-corner-br {
    border-bottom: 2px solid currentColor;
    border-right: 2px solid currentColor;
    border-bottom-right-radius: 5px;
  }
  /* Link toggle row spans the full grid width inside the same container */
  .hcc-radius-link-row {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.5rem 0.1rem;
    margin-top: 0.15rem;
    border-top: 1px dashed rgb(229 229 228);
    font-size: 0.75rem;
    color: rgb(120 113 108);
    cursor: pointer;
    user-select: none;
  }
  .hcc-radius-link-row input { width: 14px; height: 14px; }
  .hcc-radius-link-row svg { color: rgb(120 113 108); }
  .hcc-radius-link-row:has(input:checked) {
    color: rgb(28 25 23);
  }
  .hcc-radius-link-row:has(input:checked) svg { color: rgb(28 25 23); }

  /* === Checkbox row === */
  .hcc-checkbox-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
    font-size: 0.875rem;
  }
  .hcc-checkbox-row input { width: 16px; height: 16px; }

  .hcc-hint { font-size: 0.75rem; color: rgb(120 113 108); }
  .hcc-hint em { font-style: italic; color: rgb(68 64 60); }
  /* Manual content fields: icon-prefixed labels + hint above the input */
  .hcc-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .hcc-field-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(68 64 60);
  }
  .hcc-field-label > svg { color: rgb(120 113 108); flex: 0 0 auto; }
  .hcc-field .hcc-hint { margin: 0 0 0.125rem; }
  .hcc-url-stack { display: flex; flex-direction: column; gap: 0.5rem; }

  /* URL combobox: a single text input with an optional dropdown of
     detected site pages. Type freely, or click the chevron to browse
     suggestions. Filtering matches the input value as you type. */
  .hcc-url-combo {
    position: relative;
    display: flex;
    align-items: stretch;
  }
  .hcc-url-combo > .hcc-input {
    padding-right: 2.5rem; /* room for the chevron button */
  }
  .hcc-url-combo-toggle {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: rgb(120 113 108);
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s;
    border-radius: 0 0.375rem 0.375rem 0;
  }
  .hcc-url-combo-toggle:hover { color: rgb(28 25 23); background: rgb(245 245 244); }
  .hcc-url-combo-toggle > svg { transition: transform 0.15s; }
  .hcc-url-combo[data-open="1"] .hcc-url-combo-toggle > svg { transform: rotate(180deg); }
  .hcc-url-combo-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 30;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: white;
    border: 1px solid rgb(231 229 228);
    border-radius: 0.5rem;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,0.18);
    max-height: 280px;
    overflow-y: auto;
  }
  .hcc-url-combo-list[hidden] { display: none; }
  .hcc-url-combo-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem;
    border-radius: 0.375rem;
    cursor: pointer;
    color: rgb(28 25 23);
  }
  .hcc-url-combo-list li:hover,
  .hcc-url-combo-list li[data-active="1"] { background: rgb(245 245 244); }
  .hcc-url-combo-list li > svg { color: rgb(120 113 108); flex: 0 0 auto; }
  .hcc-url-combo-list li .uc-label {
    font-size: 0.8125rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1 1 auto;
  }
  .hcc-url-combo-list li .uc-hint {
    font-size: 0.6875rem;
    color: rgb(120 113 108);
    margin-left: auto;
    flex: 0 0 auto;
  }
  .hcc-url-combo-empty {
    padding: 0.75rem 0.55rem;
    font-size: 0.75rem;
    color: rgb(120 113 108);
    text-align: center;
  }

  /* === Mini content preview (lives inside "Contenido de la card") ===
     The card itself is rendered at the configured desktop dimensions
     and then transform: scale()-ed to fit the form column — same
     pattern the right-side full preview uses. This keeps text
     truncation (line-clamp), padding, font-sizes, and aspect ratio
     identical to what visitors will see at the desktop breakpoint. */
  .hcc-content-preview {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgb(229 229 228);
  }
  .hcc-preview-eyebrow-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgb(120 113 108);
    margin: 0;
  }
  .hcc-cp-frame {
    position: relative;
    width: 100%;
    background: rgb(245 245 244);
    border-radius: 4px;
    overflow: hidden;
    /* Height set inline based on card_height × scale. */
  }
  .hcc-cp-stage {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: top left;
  }
  .hcc-cp-card {
    /* width / min-height / padding / bg / color / radius set inline
       at render time from cfg.desktop. Fonts come through CSS vars
       so each role uses its chosen typeface from FONT_OPTIONS. */
    box-shadow: 0 6px 14px -8px rgba(0,0,0,0.18);
  }
  .hcc-cp-eyebrow { font-family: var(--cp-eyebrow-font, inherit); }
  .hcc-cp-title   { font-family: var(--cp-title-font,   inherit); font-weight: 500; }
  .hcc-cp-body    { font-family: var(--cp-body-font,    inherit); }
  .hcc-cp-cta     { font-family: var(--cp-cta-font,     inherit); }
  /* Hide each role's element when its text is empty so the public
     site's "skip empty" behavior is mirrored 1:1. */
  .hcc-cp-eyebrow:empty,
  .hcc-cp-title:empty,
  .hcc-cp-body:empty,
  .hcc-cp-cta:empty { display: none; }
  .hcc-cp-hint {
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: rgb(254 252 232);   /* amber-50 */
    border: 1px solid rgb(253 230 138); /* amber-200 */
    color: rgb(120 53 15);           /* amber-900 */
    border-radius: 4px;
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .hcc-cp-edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 11px;
    color: rgb(68 64 60);
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: flex-start;
  }
  .hcc-cp-edit-link:hover { color: rgb(28 25 23); }

  /* === Contact list editor (emails / phones / addresses / social) === */
  .cl-list { display: flex; flex-direction: column; gap: 0.625rem; }
  .cl-list-rows { display: flex; flex-direction: column; gap: 0.625rem; }
  .cl-list-rows:empty { display: none; }
  .cl-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: start;
    padding: 0.625rem;
    border: 1px solid rgb(231 229 228);
    background: rgb(250 250 249);
    border-radius: 4px;
  }
  .cl-row-fields {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  .cl-row-fields > .cl-row-field-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    margin-bottom: 0.125rem;
  }
  .cl-row-remove {
    background: transparent;
    border: 0;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    color: rgb(168 162 158);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.12s, color 0.12s;
    flex-shrink: 0;
  }
  .cl-row-remove:hover {
    background: rgb(254 226 226);
    color: rgb(127 29 29);
  }
  .cl-row-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: rgb(68 64 60);
    cursor: pointer;
    margin-top: 0.25rem;
  }
  .cl-list-add {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px dashed rgb(214 211 209);
    background: white;
    color: rgb(68 64 60);
    border-radius: 4px;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s, background-color 0.12s;
  }
  .cl-list-add:hover { border-color: rgb(28 25 23); color: rgb(28 25 23); }
  .cl-row .hcc-input { font-size: 0.8125rem; padding: 0.4rem 0.55rem; }
  .cl-row select.hcc-input {
    appearance: none;
    background:
      url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none' stroke='%2378716c' stroke-width='1.5'%3E%3Cpath d='M3 5l3 3 3-3'/%3E%3C/svg%3E")
      right 0.5rem center / 12px no-repeat white;
    padding-right: 1.75rem;
  }
  .hcc-bg-fallback {
    margin-top: 0.5rem;
    padding: 0.375rem 0.625rem;
    background: rgb(254 252 232); /* amber-50 */
    border: 1px solid rgb(253 230 138); /* amber-200 */
    border-radius: 4px;
    color: rgb(120 53 15); /* amber-900 */
  }
  .hcc-bg-fallback strong { font-weight: 600; }
  /* Stepper buttons disabled state — used when at min/max bound. */
  .hcc-step:disabled {
    background: rgb(245 245 244);
    border-color: rgb(231 229 228);
    color: rgb(214 211 209);
    cursor: not-allowed;
    transform: none !important;
  }
  .hcc-step:disabled:hover {
    background: rgb(245 245 244);
    border-color: rgb(231 229 228);
    color: rgb(214 211 209);
  }
  .hcc-input:disabled {
    background: rgb(245 245 244);
    color: rgb(168 162 158);
    cursor: not-allowed;
  }
  .hcc-pos-row[data-locked="true"] .hcc-num-cell-label {
    color: rgb(168 162 158);
  }
</style>

<script is:inline define:vars={{ DEFAULT_HERO_CARD, HERO_FALLBACK_URL, HERO_CARD_FONTS_MAP, LATEST_POST, LATEST_BOOK, URL_OPTIONS }}>
  (() => {
    if (window.__casSiteInit) return;
    window.__casSiteInit = true;

    const cacheKey = "cas:site";
    const TTL = 60_000;

    const FRAME_DESKTOP_W = 1440;
    const FRAME_DESKTOP_H = 720;
    const FRAME_MOBILE_W = 390;
    const FRAME_MOBILE_H = 720;

    let currentPreviewTab = "desktop";
    // Editor-controlled zoom factor multiplied on top of the auto-fit
    // scale. Stored on [data-preview-frame] as a data-attr (not a
    // closure variable!) so Astro view transitions don't carry stale
    // state from the previous IIFE: when the user navigates away and
    // back, document-level listeners installed by the old IIFE still
    // fire and still close over the OLD `previewZoom`. Reading from
    // the DOM each time makes any IIFE see the live value.
    const ZOOM_STEPS = [0.5, 0.75, 1, 1.25, 1.5, 2, 2.5, 3, 4];
    const getPreviewZoom = () => {
      const frame = $("[data-preview-frame]");
      const v = Number(frame?.dataset.previewZoom ?? "1");
      return Number.isFinite(v) && v > 0 ? v : 1;
    };
    const writePreviewZoomUI = (zoom) => {
      const frame = $("[data-preview-frame]");
      if (frame) frame.dataset.previewZoom = String(zoom);
      $$("[data-preview-zoom-value]").forEach(el => { el.textContent = `${Math.round(zoom * 100)}%`; });
      $$("[data-preview-zoom-out]").forEach(b => { b.disabled = zoom <= ZOOM_STEPS[0]; });
      $$("[data-preview-zoom-in]").forEach(b => { b.disabled = zoom >= ZOOM_STEPS[ZOOM_STEPS.length - 1]; });
    };
    const setPreviewZoom = (z) => {
      const next = Math.max(ZOOM_STEPS[0], Math.min(ZOOM_STEPS[ZOOM_STEPS.length - 1], z));
      if (next === getPreviewZoom()) return;
      writePreviewZoomUI(next);
      renderHeroPreview();
    };
    const stepZoom = (dir) => {
      const cur = getPreviewZoom();
      const idx = ZOOM_STEPS.indexOf(cur);
      if (idx === -1) {
        const next = dir > 0
          ? ZOOM_STEPS.find(z => z > cur)
          : [...ZOOM_STEPS].reverse().find(z => z < cur);
        if (next != null) setPreviewZoom(next);
        return;
      }
      const nextIdx = Math.max(0, Math.min(ZOOM_STEPS.length - 1, idx + dir));
      setPreviewZoom(ZOOM_STEPS[nextIdx]);
    };
    let currentHeroCfg = structuredClone(DEFAULT_HERO_CARD);

    const $ = (s, p = document) => p.querySelector(s);
    const $$ = (s, p = document) => Array.from(p.querySelectorAll(s));

    // ----- Path helpers for hero card config -----
    const setByPath = (obj, path, val) => {
      const parts = path.split(".");
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        if (typeof cur[parts[i]] !== "object" || cur[parts[i]] === null) cur[parts[i]] = {};
        cur = cur[parts[i]];
      }
      cur[parts[parts.length - 1]] = val;
    };
    const getByPath = (obj, path) => {
      const parts = path.split(".");
      let cur = obj;
      for (const p of parts) { if (cur == null) return undefined; cur = cur[p]; }
      return cur;
    };

    // ----- Color helper -----
    const hexToRgba = (hex, alpha) => {
      const c = String(hex || "").replace("#", "").trim();
      const full = c.length === 3 ? c.split("").map(x => x + x).join("") : c;
      if (full.length !== 6) return `rgba(26,23,21,${alpha})`;
      const r = parseInt(full.slice(0, 2), 16);
      const g = parseInt(full.slice(2, 4), 16);
      const b = parseInt(full.slice(4, 6), 16);
      if ([r, g, b].some(Number.isNaN)) return `rgba(26,23,21,${alpha})`;
      return `rgba(${r},${g},${b},${alpha})`;
    };

    // ----- Tab switching -----
    const TAB_LABELS = { hero: "Hero", editorial: "Editorial", contacto: "Contacto", seo: "SEO" };
    const PAGE_LABELS = {
      home: "Home", catalogo: "Catálogo", articulos: "Artículos",
      filosofia: "Filosofía", poesia: "Poesía", autores: "Autores",
      contacto: "Contacto",
    };
    // Rewrite the trailing crumbs of the breadcrumb (Webpage / Home / Hero
    // chain) to match the current page-tab and inner tab. Mirrors the
    // server-side logic in MobileBreadcrumb.astro so refresh and click
    // produce the same trail.
    const updateBreadcrumbCrumbs = (pageKey, tabKey) => {
      const ol = document.querySelector(".cas-breadcrumb ol");
      if (!ol) return;
      const pagetabLi = ol.querySelector("[data-breadcrumb-pagetab]");
      let tabLi = ol.querySelector("[data-breadcrumb-tab]");
      const isHome = pageKey === "home";
      const pageLabel = PAGE_LABELS[pageKey] || "Home";
      const tabLabel = TAB_LABELS[tabKey] || "Hero";

      // 1. Update the page-tab crumb label, and switch between
      //    last-leaf (span) and link-to-/site depending on whether
      //    there's a deeper tab crumb.
      if (pagetabLi) {
        const wantLink = isHome;     // a tab crumb will follow it
        const inner = pagetabLi.querySelector("a, span");
        const labelEl = pagetabLi.querySelector("[data-breadcrumb-label]");
        if (labelEl) labelEl.textContent = pageLabel;
        if (inner) {
          const isAnchor = inner.tagName === "A";
          if (wantLink && !isAnchor) {
            const a = document.createElement("a");
            a.href = "/site";
            a.className = "text-stone-500 hover:text-stone-900 transition";
            a.setAttribute("data-astro-prefetch", "");
            const lbl = document.createElement("span");
            lbl.setAttribute("data-breadcrumb-label", "");
            lbl.textContent = pageLabel;
            a.appendChild(lbl);
            inner.replaceWith(a);
          } else if (!wantLink && isAnchor) {
            const sp = document.createElement("span");
            sp.className = "text-stone-900 font-medium first-letter:capitalize";
            const lbl = document.createElement("span");
            lbl.setAttribute("data-breadcrumb-label", "");
            lbl.textContent = pageLabel;
            sp.appendChild(lbl);
            inner.replaceWith(sp);
          }
        }
      }

      // 2. Add / update / remove the tab crumb (only when on Home).
      if (isHome) {
        if (!tabLi) {
          tabLi = document.createElement("li");
          tabLi.setAttribute("data-breadcrumb-tab", "");
          tabLi.className = "flex items-center gap-1.5 shrink-0";
          tabLi.innerHTML =
            '<span aria-hidden="true" class="text-stone-300">›</span>' +
            '<span class="text-stone-900 font-medium first-letter:capitalize">' +
              '<span data-breadcrumb-label></span>' +
            '</span>';
          ol.appendChild(tabLi);
        }
        const tlbl = tabLi.querySelector("[data-breadcrumb-label]");
        if (tlbl) tlbl.textContent = tabLabel;
      } else if (tabLi) {
        tabLi.remove();
      }
    };

    const switchTab = (name) => {
      $$("[data-tab]").forEach(b => b.classList.toggle("cas-tab-active", b.getAttribute("data-tab") === name));
      $$("[data-tab-panel]").forEach(p => p.hidden = p.getAttribute("data-tab-panel") !== name);
      // Mobile-only fullscreen preview launchers belong to the Hero
      // tab — Editorial/Contacto/SEO have no card preview to launch.
      $$("[data-fullscreen-launchers]").forEach(el => { el.hidden = name !== "hero"; });
      try {
        const url = new URL(window.location.href);
        // "hero" is the implicit default — keep the URL clean by
        // dropping the param when on it.
        if (name === "hero") url.searchParams.delete("tab");
        else url.searchParams.set("tab", name);
        history.replaceState(null, "", url.toString());
      } catch {}
      // Sync the trailing breadcrumb crumb. We're always on page=home
      // when the tab nav is visible.
      updateBreadcrumbCrumbs("home", name);
      if (name === "hero") setTimeout(renderHeroPreview, 0);
    };

    const wireTabs = () => {
      $$("[data-tab]").forEach(btn => btn.addEventListener("click", () => switchTab(btn.getAttribute("data-tab"))));
      // Honor ?tab= on first load (legacy hash also supported).
      const url = new URL(window.location.href);
      const queryTab = (url.searchParams.get("tab") || "").toLowerCase();
      const hashTab = (window.location.hash || "").replace("#", "").toLowerCase();
      const initial = ["hero", "editorial", "contacto", "seo"].includes(queryTab)
        ? queryTab
        : (["hero", "editorial", "contacto", "seo"].includes(hashTab) ? hashTab : "hero");
      switchTab(initial);
    };

    // ----- Hero card form ↔ config -----
    const readHeroForm = () => {
      const cfg = structuredClone(currentHeroCfg);
      $$("[data-bind]").forEach(el => {
        const path = el.getAttribute("data-bind");
        let v;
        if (el.type === "checkbox") v = el.checked;
        else if (el.type === "number" || el.type === "range") {
          v = el.value === "" ? 0 : parseFloat(el.value);
          if (Number.isNaN(v)) v = 0;
        } else v = el.value;
        setByPath(cfg, path, v);
      });
      // Dropdown components: read from the hidden input inside each
      // [data-bind-dd="path"] wrapper.
      $$("[data-bind-dd]").forEach(wrap => {
        const path = wrap.getAttribute("data-bind-dd");
        const hidden = wrap.querySelector("[data-dd-input]");
        if (hidden) setByPath(cfg, path, hidden.value);
      });
      // ImageUpload bg images live in dedicated hidden inputs.
      const dImg = document.querySelector('input[type="hidden"][name="desktop_bg_image"]');
      const mImg = document.querySelector('input[type="hidden"][name="mobile_bg_image"]');
      if (dImg) cfg.desktop.bg_image_url = dImg.value || "";
      if (mImg) cfg.mobile.bg_image_url = mImg.value || "";
      return cfg;
    };

    // Programmatically set a Dropdown's value: update the hidden input,
    // the visible label, the aria-selected state, and the highlighted
    // option class. Mirrors what the Dropdown's own click handler does.
    const setDropdownValue = (wrap, value) => {
      const hidden = wrap.querySelector("[data-dd-input]");
      const display = wrap.querySelector("[data-dd-display]");
      const option = wrap.querySelector(`[data-dd-option][data-value="${CSS.escape(String(value ?? ""))}"]`);
      if (hidden) hidden.value = String(value ?? "");
      if (option && display) {
        const label = option.getAttribute("data-label") || option.querySelector(".cas-dd-option-label")?.textContent || "";
        const fontFamily = option.getAttribute("data-font-family") || "";
        const truncate = display.querySelector(".truncate");
        if (truncate) {
          truncate.textContent = label;
          if (fontFamily) truncate.style.fontFamily = fontFamily;
          else truncate.style.removeProperty("font-family");
        } else {
          const styleAttr = fontFamily ? ` style="font-family: ${fontFamily}"` : "";
          display.innerHTML = `<span class="truncate"${styleAttr}>${label}</span>`;
        }
      }
      wrap.querySelectorAll("[data-dd-option]").forEach(opt => {
        const isSelected = opt.getAttribute("data-value") === String(value ?? "");
        opt.setAttribute("aria-selected", isSelected ? "true" : "false");
        opt.classList.toggle("cas-dd-option-selected", isSelected);
      });
    };

    const writeHeroForm = (cfg) => {
      $$("[data-bind]").forEach(el => {
        const path = el.getAttribute("data-bind");
        const v = getByPath(cfg, path);
        if (v === undefined || v === null) return;
        if (el.type === "checkbox") el.checked = !!v;
        else el.value = String(v);
      });
      // Dropdown components — set the hidden input and visible label.
      $$("[data-bind-dd]").forEach(wrap => {
        const path = wrap.getAttribute("data-bind-dd");
        const v = getByPath(cfg, path);
        if (v !== undefined && v !== null) setDropdownValue(wrap, v);
      });
      // Push bg image URLs into ImageUpload wrappers via __casSetImage.
      const set = (name, url) => {
        const hidden = document.querySelector(`input[type="hidden"][name="${name}"]`);
        const wrap = hidden?.closest("[data-image-upload]");
        if (wrap?.__casSetImage) wrap.__casSetImage(url || "");
      };
      set("desktop_bg_image", cfg.desktop?.bg_image_url || "");
      set("mobile_bg_image", cfg.mobile?.bg_image_url || "");
      updateManualVisibility(cfg.content_source);
    };

    // Manual content fields toggle. Reads from the live form when no
    // value is passed in so the dropdown's change listener can call
    // it without needing to round-trip through readHeroForm.
    const updateManualVisibility = (source) => {
      let value = source;
      if (value == null) {
        const ddWrap = document.querySelector('[data-bind-dd="content_source"]');
        value = ddWrap?.querySelector("[data-dd-input]")?.value || "editorial";
      }
      // Manual-only inputs (eyebrow / title / body) — only shown for "manual".
      const manual = document.querySelector("[data-manual-fields]");
      if (manual) manual.hidden = value !== "manual";
      // CTA inputs (text + URL) — shown for "manual" AND "editorial".
      // latest_post / latest_book auto-link to the article/book detail
      // page so they don't expose a CTA editor.
      const cta = document.querySelector("[data-cta-fields]");
      if (cta) cta.hidden = value !== "manual" && value !== "editorial";
    };

    // ----- Mini "Contenido de la card" preview -----
    // Resolves the final text the public site will render given the
    // current content_source + manual fields + the latest published
    // post/book (fetched at SSR via define:vars). Then paints those
    // strings + the desktop card's visual style into the dedicated
    // preview-card element inside the "Contenido de la card" section.
    // Strip a small subset of markdown to plain text and trim to a
    // sensible body length. Mirrors markdownToTeaser() in
    // apps/web/src/lib/hero-card.ts so the CMS preview matches the
    // public site's body when an editor's excerpt / subtitle is
    // empty and the long-form md is the only available teaser.
    const markdownToTeaser = (md, max = 280) => {
      if (!md) return "";
      const stripped = md
        .replace(/`{3}[\s\S]*?`{3}/g, " ")
        .replace(/`([^`]+)`/g, "$1")
        .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
        .replace(/^\s{0,3}#{1,6}\s+/gm, "")
        .replace(/^\s{0,3}>\s?/gm, "")
        .replace(/^\s*[-*+]\s+/gm, "")
        .replace(/^\s*\d+\.\s+/gm, "")
        .replace(/(\*\*|__)(.*?)\1/g, "$2")
        .replace(/(\*|_)(.*?)\1/g, "$2")
        .replace(/~~(.*?)~~/g, "$1")
        .replace(/\s+/g, " ")
        .trim();
      if (stripped.length <= max) return stripped;
      const cut = stripped.slice(0, max);
      const lastSpace = cut.lastIndexOf(" ");
      return (lastSpace > max * 0.6 ? cut.slice(0, lastSpace) : cut).trimEnd() + "…";
    };

    const resolveContentPreview = (cfg) => {
      const src = cfg.content_source || "editorial";
      const editorialField = document.querySelector('[name="editorial_description"]');
      const editorialText = (editorialField?.value || "").trim();
      const m = cfg.manual ?? {};
      const customCtaLabel = (m.cta_label ?? "").trim();
      let eyebrow = "Editorial";
      let title = "Casa de Asterión Ediciones";
      let body = editorialText;
      let cta = customCtaLabel || "Explorar el catálogo";
      let warning = "";
      let editorialLink = false;
      if (src === "manual") {
        eyebrow = (m.eyebrow ?? "").trim();
        title = (m.title ?? "").trim();
        body = (m.body ?? "").trim();
        cta = customCtaLabel;
      } else if (src === "latest_post") {
        if (LATEST_POST) {
          eyebrow = "Editorial";
          title = LATEST_POST.title || "(sin título)";
          // Body chain: authored excerpt → stripped content_md
          // teaser. Same fallback the public site uses now.
          body = (LATEST_POST.excerpt || "").trim() || markdownToTeaser(LATEST_POST.content_md);
          cta = "Leer artículo";
        } else {
          warning = "No hay artículos publicados todavía. Mientras tanto el sitio mostrará la descripción editorial como fallback.";
        }
      } else if (src === "latest_book") {
        if (LATEST_BOOK) {
          eyebrow = "Catálogo";
          title = LATEST_BOOK.title || "(sin título)";
          body = (LATEST_BOOK.subtitle || "").trim() || markdownToTeaser(LATEST_BOOK.description_md);
          cta = "Ver libro";
        } else {
          warning = "No hay libros publicados todavía. Mientras tanto el sitio mostrará la descripción editorial como fallback.";
        }
      } else {
        editorialLink = true;
        if (!editorialText) warning = "La descripción editorial está vacía. Edita la pestaña Editorial para que esta card tenga cuerpo.";
      }
      return { eyebrow, title, body, cta, warning, editorialLink };
    };
    const renderContentPreview = (cfg) => {
      const root = $("[data-content-preview]");
      if (!root) return;
      const frame = root.querySelector("[data-cp-frame]");
      const stage = root.querySelector("[data-cp-stage]");
      const card = root.querySelector("[data-cp-card]");
      if (!frame || !stage || !card) return;

      const { eyebrow, title, body, cta, warning, editorialLink } = resolveContentPreview(cfg);
      const setText = (sel, txt) => {
        const el = root.querySelector(sel);
        if (el) el.textContent = txt || "";
      };
      setText("[data-cp-eyebrow]", eyebrow);
      setText("[data-cp-title]",   title);
      setText("[data-cp-body]",    body);
      setText("[data-cp-cta]",     cta);

      // Render the card at its REAL desktop dimensions so line-clamp,
      // padding and spacing behave identically to the public site.
      // Then transform: scale() the stage to fit the form column.
      const d = cfg.desktop ?? {};
      const cardW = d.width > 0 ? d.width : 760;
      const cardH = d.height > 0 ? d.height : 520;
      const padding = d.padding ?? 56;
      const bg = hexToRgba(d.bg_color || "#1a1715", d.bg_alpha ?? 1);
      const bgRule = d.bg_image_url
        ? `linear-gradient(${bg}, ${bg}), url('${d.bg_image_url}') center/cover no-repeat`
        : bg;
      card.style.width = `${cardW}px`;
      card.style.minHeight = `${cardH}px`;
      card.style.padding = `${padding}px`;
      card.style.background = bgRule;
      card.style.color = d.text_color || "#f5f1ea";
      card.style.borderRadius = `${d.border_radius_tl || 0}px ${d.border_radius_tr || 0}px ${d.border_radius_br || 0}px ${d.border_radius_bl || 0}px`;
      card.style.boxShadow = d.shadow ? "0 25px 50px -12px rgba(0,0,0,0.25)" : "0 6px 14px -8px rgba(0,0,0,0.18)";
      card.style.setProperty("--cp-title-font",   HERO_CARD_FONTS_MAP[d.title_font]   || HERO_CARD_FONTS_MAP.serif);
      card.style.setProperty("--cp-eyebrow-font", HERO_CARD_FONTS_MAP[d.eyebrow_font] || HERO_CARD_FONTS_MAP.sans);
      card.style.setProperty("--cp-body-font",    HERO_CARD_FONTS_MAP[d.body_font]    || HERO_CARD_FONTS_MAP.sans);
      card.style.setProperty("--cp-cta-font",     HERO_CARD_FONTS_MAP[d.cta_font]     || HERO_CARD_FONTS_MAP.sans);

      // Fit the card horizontally; never up-scale (max scale = 1).
      const frameW = frame.clientWidth - 16;
      const scale = frameW > 0 ? Math.min(frameW / cardW, 1) : 0.5;
      stage.style.transform = `scale(${scale})`;
      stage.style.width = `${cardW}px`;
      stage.style.height = `${cardH}px`;
      stage.style.left = `${Math.max(8, (frame.clientWidth - cardW * scale) / 2)}px`;
      stage.style.top = "8px";
      // Frame height tracks the scaled card height + padding.
      frame.style.height = `${Math.max(160, cardH * scale + 16)}px`;

      const warn = root.querySelector("[data-cp-warning]");
      if (warn) {
        if (warning) { warn.textContent = warning; warn.hidden = false; }
        else { warn.hidden = true; }
      }
      const link = root.querySelector("[data-cp-edit-editorial]");
      if (link) link.hidden = !editorialLink;
    };

    // ----- Preview render -----
    // Visual styles that don't depend on positioning (bg, color, radius,
    // padding, font, shadow, blur, min-height). Position/size is set in
    // applyDesktopPos/applyMobilePos because those differ between layouts.
    const applyVisuals = (card, layout) => {
      const bg = hexToRgba(layout.bg_color, layout.bg_alpha);
      const bgRule = layout.bg_image_url
        ? `linear-gradient(${bg}, ${bg}), url('${layout.bg_image_url}') center/cover no-repeat`
        : bg;
      card.style.background = bgRule;
      card.style.color = layout.text_color;
      card.style.borderRadius = `${layout.border_radius_tl}px ${layout.border_radius_tr}px ${layout.border_radius_br}px ${layout.border_radius_bl}px`;
      card.style.padding = `${layout.padding}px`;
      card.style.minHeight = `${layout.height}px`;
      card.style.boxShadow = layout.shadow ? "0 25px 50px -12px rgba(0,0,0,0.25)" : "none";
      card.style.backdropFilter = layout.bg_blur > 0 ? `blur(${layout.bg_blur}px)` : "none";
      card.style.webkitBackdropFilter = layout.bg_blur > 0 ? `blur(${layout.bg_blur}px)` : "none";
      // Apply each chosen typeface to the matching preview element.
      // HERO_CARD_FONTS_MAP mirrors the same-named map in
      // apps/web/src/lib/hero-card.ts; both must list the same codes.
      const fontFor = (key, fallback) => HERO_CARD_FONTS_MAP[key] || HERO_CARD_FONTS_MAP[fallback] || HERO_CARD_FONTS_MAP.serif;
      const apply = (sel, family) => {
        const el = card.querySelector(sel);
        if (el) el.style.fontFamily = family;
      };
      apply("[data-preview-title]",   fontFor(layout.title_font,   "serif"));
      apply("[data-preview-eyebrow]", fontFor(layout.eyebrow_font, "sans"));
      apply("[data-preview-body]",    fontFor(layout.body_font,    "sans"));
      apply("[data-preview-cta]",     fontFor(layout.cta_font,     "sans"));
    };

    // Desktop: card sits absolute over the right-half hero image. Margin-right
    // is intentionally 0 so the card extends past the 50% divider.
    const applyDesktopPos = (card, layout) => {
      card.style.position = "absolute";
      card.style.left = `${layout.offset_x}px`;
      card.style.top = `calc(50% + ${layout.offset_y}px)`;
      card.style.transform = "translateY(-50%)";
      card.style.alignSelf = "auto";
      card.style.marginLeft = "0";
      card.style.marginTop = "0";
      card.style.marginRight = "0";
      card.style.marginBottom = "0";
      card.style.width = layout.width > 0 ? `${layout.width}px` : "auto";
      card.style.maxWidth = layout.width > 0 ? "100%" : `calc(100% - ${layout.offset_x * 2}px)`;
    };

    // Mobile: card is in flow inside a flex-col stage; offset_x mirrors to
    // both sides for visual balance, matching the public site rendering.
    const applyMobilePos = (card, layout) => {
      card.style.position = "static";
      card.style.left = "auto";
      card.style.top = "auto";
      card.style.transform = "none";
      card.style.marginLeft = `${layout.offset_x}px`;
      card.style.marginRight = `${layout.offset_x}px`;
      card.style.marginTop = `${layout.offset_y}px`;
      card.style.marginBottom = "0";
      if (layout.width > 0) {
        card.style.width = `${layout.width}px`;
        card.style.maxWidth = "100%";
        card.style.alignSelf = "flex-start";
      } else {
        card.style.width = "auto";
        card.style.maxWidth = "none";
        card.style.alignSelf = "stretch";
      }
    };

    const applyContent = (card, cfg) => {
      // Reuse the mini-preview's resolver so the right-side preview
      // and the inline mini preview agree on title / body / cta —
      // including the markdown teaser fallback when the latest
      // post / book has no excerpt or subtitle.
      const resolved = resolveContentPreview(cfg);
      const m = cfg.manual ?? {};
      const ctaHref = (m.cta_href ?? "").trim();
      const c = {
        eyebrow: resolved.eyebrow,
        title: resolved.title,
        body: resolved.body,
        cta_label: resolved.cta,
        cta_href: cfg.content_source === "latest_post"
          ? (LATEST_POST ? `/articulos/${LATEST_POST.slug}` : "#")
          : cfg.content_source === "latest_book"
          ? (LATEST_BOOK ? `/catalogo/${LATEST_BOOK.slug}` : "#")
          : (ctaHref || "/catalogo"),
      };
      const eyebrow = card.querySelector("[data-preview-eyebrow]");
      const title = card.querySelector("[data-preview-title]");
      const body = card.querySelector("[data-preview-body]");
      const cta = card.querySelector("[data-preview-cta]");
      if (eyebrow) {
        eyebrow.textContent = c.eyebrow || "";
        eyebrow.style.display = c.eyebrow ? "block" : "none";
      }
      if (title) {
        title.textContent = c.title || "";
        // Clear inline display so the [data-preview-title] CSS rule
        // (display: -webkit-box) governs and -webkit-line-clamp can
        // truncate. Only set "none" inline when there's no text.
        title.style.display = c.title ? "" : "none";
      }
      if (body) {
        body.textContent = c.body || "";
        body.style.display = c.body ? "" : "none";
      }
      if (cta) cta.textContent = c.cta_label || "";
      card.href = c.cta_href || "#";
    };

    // Render into a target preview (inline or fullscreen). Pulls the
    // current cfg from the form once at the top so both targets stay
    // in sync.
    const renderInto = (els, platform, cfg, heroImageUrl) => {
      if (!els.stage || !els.card || !els.frame) return;
      const layout = platform === "desktop" ? cfg.desktop : cfg.mobile;
      applyVisuals(els.card, layout);
      applyContent(els.card, cfg);

      // Title font-size is governed by the [data-platform=...] CSS
      // rules; no inline override needed (and an inline value would
      // beat the rule, breaking platform parity).

      if (platform === "desktop") {
        els.stage.style.display = "block";
        if (els.bgImage) {
          els.bgImage.style.display = "block";
          els.bgImage.style.backgroundImage = `url('${heroImageUrl}')`;
        }
        if (els.mobileImg) els.mobileImg.style.display = "none";
        applyDesktopPos(els.card, layout);
      } else {
        els.stage.style.display = "flex";
        els.stage.style.flexDirection = "column";
        if (els.bgImage) els.bgImage.style.display = "none";
        applyMobilePos(els.card, layout);
        if (els.mobileImg) {
          els.mobileImg.style.display = "block";
          els.mobileImg.src = heroImageUrl;
          els.mobileImg.style.width = "100%";
          els.mobileImg.style.aspectRatio = "4 / 3";
          els.mobileImg.style.objectFit = "cover";
          els.mobileImg.style.marginTop = "24px";
        }
      }

      const fw = els.frame.clientWidth - 16;
      const fh = els.frame.clientHeight - 16;
      const targetW = platform === "desktop" ? FRAME_DESKTOP_W : FRAME_MOBILE_W;
      const targetH = platform === "desktop" ? FRAME_DESKTOP_H : FRAME_MOBILE_H;
      const fitScale = platform === "desktop"
        ? Math.min(fw / targetW, fh / targetH, 1)
        : Math.min(fw / targetW, 1);
      const zoom = getPreviewZoom();
      const finalScale = fitScale * zoom;
      els.stage.style.width = `${targetW}px`;
      els.stage.style.height = platform === "desktop" ? `${targetH}px` : "auto";
      els.stage.style.minHeight = platform === "mobile" ? `${targetH}px` : "";
      els.stage.dataset.platform = platform;
      els.stage.style.transformOrigin = "top left";
      els.stage.style.transform = `scale(${finalScale})`;
      els.stage.style.position = "absolute";
      els.stage.style.top = "8px";
      const scaledW = targetW * finalScale;
      const offsetLeft = (els.frame.clientWidth - scaledW) / 2;
      els.stage.style.left = zoom > 1
        ? "8px"
        : `${Math.max(8, offsetLeft)}px`;
      if (els.frame) {
        if (zoom > 1) els.frame.setAttribute("data-preview-zoomed", "true");
        else els.frame.removeAttribute("data-preview-zoomed");
      }

      if (els.meta) els.meta.textContent = `${platform} · ${targetW} × ${targetH}`;
    };

    const inlineEls = () => ({
      stage: $("[data-preview-stage]"),
      card: $("[data-preview-card]"),
      bgImage: $("[data-preview-bg-image]"),
      mobileImg: $("[data-preview-mobile-img]"),
      frame: $("[data-preview-frame]"),
      meta: $("[data-preview-meta]"),
    });
    const fullscreenEls = () => ({
      stage: $("[data-fullscreen-stage]"),
      card: $("[data-fullscreen-card]"),
      bgImage: $("[data-fullscreen-bg-image]"),
      mobileImg: $("[data-fullscreen-mobile-img]"),
      frame: $("[data-fullscreen-frame]"),
      meta: $("[data-fullscreen-meta]"),
    });

    // Cross-platform fallback for the card's bg image. If only one
    // side has an image set, the other reuses it. Mirrors the same
    // logic in apps/web/src/lib/hero-card.ts so the preview matches
    // what visitors will see.
    const applyBgImageFallback = (cfg) => {
      const dImg = (cfg.desktop?.bg_image_url || "").trim();
      const mImg = (cfg.mobile?.bg_image_url || "").trim();
      const merged = dImg || mImg;
      const out = structuredClone(cfg);
      out.desktop.bg_image_url = dImg || merged;
      out.mobile.bg_image_url = mImg || merged;
      return out;
    };

    // Show / hide each platform's "using fallback" hint based on
    // whether that platform's own bg_image_url is empty while the
    // other one has a value.
    const updateBgFallbackHints = (cfg) => {
      const dImg = (cfg.desktop?.bg_image_url || "").trim();
      const mImg = (cfg.mobile?.bg_image_url || "").trim();
      $$("[data-bg-image-row]").forEach(row => {
        const platform = row.getAttribute("data-bg-image-row");
        const own = platform === "desktop" ? dImg : mImg;
        const other = platform === "desktop" ? mImg : dImg;
        const hint = row.querySelector("[data-bg-fallback-hint]");
        if (hint) hint.hidden = !(own === "" && other !== "");
      });
    };

    // Frame sizes reused across position bounds + preview render.
    const PLATFORM_FRAMES = { desktop: { w: 1440, h: 720 }, mobile: { w: 390, h: 720 } };

    // Compute the valid range for each X / Y input given the current
    // card width/height, then sync the input's min/max attrs, clamp
    // the value if it's out of range, and disable the appropriate
    // stepper buttons. If both bounds collapse to the same number
    // (the card is wider/taller than the frame so it can't move at
    // all on that axis) the input itself is disabled too.
    const updatePositionBounds = () => {
      ["desktop", "mobile"].forEach(platform => {
        const frame = PLATFORM_FRAMES[platform];
        const xInput = document.querySelector(`[data-bind="${platform}.offset_x"]`);
        const yInput = document.querySelector(`[data-bind="${platform}.offset_y"]`);
        const wInput = document.querySelector(`[data-bind="${platform}.width"]`);
        const hInput = document.querySelector(`[data-bind="${platform}.height"]`);
        if (!xInput || !yInput) return;

        const w = Number(wInput?.value) || 0;
        const h = Number(hInput?.value) || 0;
        const xCur = Number(xInput.value) || 0;
        const yCur = Number(yInput.value) || 0;

        // Effective card dimensions matching the public-site layout.
        let effW;
        if (w > 0) {
          effW = Math.min(w, frame.w);
        } else if (platform === "mobile") {
          effW = Math.max(0, frame.w - xCur * 2);
        } else {
          effW = Math.max(0, frame.w - xCur);
        }
        const effH = Math.max(0, Math.min(h, frame.h));

        let xMin, xMax, yMin, yMax;
        if (platform === "desktop") {
          xMin = 0;
          xMax = Math.max(0, frame.w - effW);
          const ySpan = Math.max(0, (frame.h - effH) / 2);
          yMin = -ySpan;
          yMax = ySpan;
        } else {
          xMin = 0;
          if (w > 0) xMax = Math.max(0, Math.floor((frame.w - effW) / 2));
          else xMax = Math.max(0, Math.floor((frame.w - 80) / 2));
          yMin = 0;
          yMax = Math.max(0, frame.h - effH);
        }

        // Clamp current value if it slipped out of bounds (e.g. the
        // user enlarged the card after moving it).
        const newX = Math.max(xMin, Math.min(xMax, xCur));
        const newY = Math.max(yMin, Math.min(yMax, yCur));
        if (newX !== xCur) xInput.value = String(newX);
        if (newY !== yCur) yInput.value = String(newY);

        xInput.min = String(xMin);
        xInput.max = String(xMax);
        yInput.min = String(yMin);
        yInput.max = String(yMax);

        const xLocked = xMin === xMax;
        const yLocked = yMin === yMax;
        xInput.disabled = xLocked;
        yInput.disabled = yLocked;
        xInput.closest(".hcc-pos-row")?.setAttribute("data-locked", xLocked ? "true" : "false");
        yInput.closest(".hcc-pos-row")?.setAttribute("data-locked", yLocked ? "true" : "false");

        const xMinusBtn = document.querySelector(`[data-step-target="${platform}.offset_x"][data-step="-8"]`);
        const xPlusBtn = document.querySelector(`[data-step-target="${platform}.offset_x"][data-step="8"]`);
        const yMinusBtn = document.querySelector(`[data-step-target="${platform}.offset_y"][data-step="-8"]`);
        const yPlusBtn = document.querySelector(`[data-step-target="${platform}.offset_y"][data-step="8"]`);
        if (xMinusBtn) xMinusBtn.disabled = newX <= xMin;
        if (xPlusBtn) xPlusBtn.disabled = newX >= xMax;
        if (yMinusBtn) yMinusBtn.disabled = newY <= yMin;
        if (yPlusBtn) yPlusBtn.disabled = newY >= yMax;
      });
    };

    const renderHeroPreview = () => {
      // Raw cfg — preserves empty bg_image_url so the user's intent
      // ("no image set on this side") is what we save to Supabase.
      const cfg = readHeroForm();
      currentHeroCfg = cfg;
      updateBgFallbackHints(cfg);
      updatePositionBounds();
      renderContentPreview(cfg);
      const heroJson = $("[data-hero-json]");
      if (heroJson) heroJson.value = JSON.stringify(cfg);
      // Preview cfg — bg image falls back across platforms so the
      // CMS preview matches what the public site will render.
      const previewCfg = applyBgImageFallback(cfg);

      // Mirror inputs (read-only labels next to color/range)
      $$("[data-bind]").forEach(el => {
        const path = el.getAttribute("data-bind");
        const v = getByPath(cfg, path);
        const mirror = el.parentElement?.querySelector(`[data-bind-mirror="${path}"]`);
        if (mirror && mirror !== el) {
          if (mirror.tagName === "INPUT") mirror.value = String(v);
          else mirror.textContent = String(v);
        }
      });

      // Color swatches: paint the visual swatch with the current hex.
      $$('input[type="color"][data-bind]').forEach(inp => {
        const swatch = inp.parentElement?.querySelector('[data-color-swatch]');
        if (swatch) swatch.style.setProperty("--swatch-color", inp.value);
      });
      // Alpha percentage readouts
      $$("[data-alpha-pct]").forEach(el => {
        const path = el.getAttribute("data-alpha-pct");
        const v = getByPath(cfg, path);
        el.textContent = `${Math.round((Number(v) || 0) * 100)}%`;
      });
      // Blur px readouts
      $$("[data-blur-px]").forEach(el => {
        const path = el.getAttribute("data-blur-px");
        const v = getByPath(cfg, path);
        el.textContent = `${Math.round(Number(v) || 0)}px`;
      });

      const heroImgInput = document.querySelector('input[type="hidden"][name="hero_image_url"]');
      const heroImageUrl = (heroImgInput?.value || "").trim() || HERO_FALLBACK_URL;

      // Inline preview (the right-side panel inside the Hero tab)
      renderInto(inlineEls(), currentPreviewTab, previewCfg, heroImageUrl);

      // Fullscreen preview, when open
      const modal = $("[data-fullscreen-modal]");
      if (modal && !modal.hasAttribute("hidden")) {
        const fsPlatform = modal.getAttribute("data-current-platform") || "desktop";
        renderInto(fullscreenEls(), fsPlatform, previewCfg, heroImageUrl);
      }
    };

    // Open / close fullscreen
    const openFullscreen = (platform) => {
      const modal = $("[data-fullscreen-modal]");
      if (!modal) return;
      modal.removeAttribute("hidden");
      modal.setAttribute("data-current-platform", platform);
      const label = $("[data-fullscreen-platform-label]");
      if (label) label.textContent = platform === "desktop" ? "Web" : "Mobile";
      document.body.style.overflow = "hidden";
      // Render now and on next tick (to ensure layout is finalized)
      renderHeroPreview();
      requestAnimationFrame(renderHeroPreview);
    };
    const closeFullscreen = () => {
      const modal = $("[data-fullscreen-modal]");
      if (!modal) return;
      modal.setAttribute("hidden", "");
      modal.removeAttribute("data-current-platform");
      document.body.style.overflow = "";
    };

    // ----- Hero fallback "En uso / Inactiva" badge -----
    const updateHeroFallbackStatus = () => {
      const form = $("[data-site-form]");
      if (!form) return;
      const hidden = form.querySelector('input[type="hidden"][name="hero_image_url"]');
      const wrap = form.querySelector("[data-hero-fallback-status]");
      if (!hidden || !wrap) return;
      const dot = wrap.querySelector("[data-hero-fallback-dot]");
      const label = wrap.querySelector("[data-hero-fallback-label]");
      if (!dot || !label) return;
      const inUse = !hidden.value;
      wrap.className = "mt-2 inline-flex items-center gap-1 px-1.5 py-0.5 self-start text-[10px] font-medium uppercase tracking-wider rounded-sm border";
      if (inUse) {
        wrap.classList.add("bg-emerald-50", "text-emerald-700", "border-emerald-200");
        dot.className = "w-1.5 h-1.5 rounded-full bg-emerald-500";
        label.textContent = "En uso";
      } else {
        wrap.classList.add("bg-stone-100", "text-stone-500", "border-stone-200");
        dot.className = "w-1.5 h-1.5 rounded-full bg-stone-400";
        label.textContent = "Inactiva";
      }
    };

    // ColorEditor helpers — every <ColorEditor> renders the same
    // [data-color-editor] wrapper with a child color input, swatch,
    // hex span, optional X reset, and optional hidden form input.
    // Behavior is centralized here so reset/edit-hex/swatch-paint
    // work consistently across every instance.
    const HERO_BG_DEFAULT_PREVIEW = "#f5f1ea"; // matches public site --bg-alt
    const HEX_RX = /^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/;
    const expandHex = (s) => (s.length === 3 ? s.split("").map(c => c + c).join("") : s).toLowerCase();
    const renderColorEditor = (editor) => {
      const inp = editor.querySelector("[data-color-input]");
      const swatch = editor.querySelector("[data-color-swatch]");
      const hex = editor.querySelector("[data-color-hex]");
      const isSet = editor.dataset.set !== "false";
      const v = (inp?.value || "").toLowerCase();
      if (swatch) swatch.style.setProperty("--swatch-color", isSet ? v : "transparent");
      // Don't overwrite the hex text the user is currently editing.
      if (hex && document.activeElement !== hex) {
        hex.textContent = isSet ? v : "Por defecto";
      }
      // Special: the hero page bg editor mirrors itself onto the
      // preview frames so the editor sees the public-site bg live.
      if (editor.dataset.colorEditorId === "hero-bg") {
        const applyTo = (el) => { if (el) el.style.background = isSet ? v : ""; };
        applyTo($("[data-preview-frame]"));
        applyTo($("[data-fullscreen-frame]"));
      }
    };
    const renderAllColorEditors = () => {
      $$("[data-color-editor]").forEach(renderColorEditor);
    };

    // ----- Hydration of all site_configuration -----
    const apply = (cfg) => {
      const form = $("[data-site-form]");
      if (!form) return;
      const set = (name, value) => {
        const el = form.querySelector(`[name="${name}"]`);
        if (el && typeof value === "string") el.value = value;
      };
      set("hero_quote", cfg.hero_quote ?? "");
      set("hero_quote_author", cfg.hero_quote_author ?? "");
      set("editorial_description", cfg.editorial_description ?? "");
      set("footer_legal", cfg.footer_legal ?? "");
      set("whatsapp_phone", cfg.whatsapp_phone ?? "");
      set("whatsapp_message_template", cfg.whatsapp_message_template ?? "");
      set("contact_email", cfg.contact_email ?? "");
      set("contact_address", cfg.contact_address ?? "");
      set("contact_hours", cfg.contact_hours ?? "");
      // Multi-row contact / social lists
      listEditors.get("contact_emails_extra")?.setData(Array.isArray(cfg.contact_emails_extra) ? cfg.contact_emails_extra : []);
      listEditors.get("contact_addresses_extra")?.setData(Array.isArray(cfg.contact_addresses_extra) ? cfg.contact_addresses_extra : []);
      listEditors.get("contact_phones")?.setData(Array.isArray(cfg.contact_phones) ? cfg.contact_phones : []);
      listEditors.get("social_accounts")?.setData(Array.isArray(cfg.social_accounts) ? cfg.social_accounts : []);
      const social = (cfg.social_links ?? {});
      set("social_facebook", social.facebook ?? "");
      set("social_instagram", social.instagram ?? "");
      set("social_twitter", social.twitter ?? "");
      const kws = Array.isArray(cfg.default_keywords) ? cfg.default_keywords.join(", ") : (cfg.default_keywords ?? "");
      set("default_keywords", kws);
      set("twitter_handle", cfg.twitter_handle ?? "");
      const setImage = (name, value) => {
        const hidden = form.querySelector(`input[type="hidden"][name="${name}"]`);
        const wrapper = hidden?.closest("[data-image-upload]");
        if (wrapper && typeof wrapper.__casSetImage === "function") {
          wrapper.__casSetImage(typeof value === "string" ? value : "");
        }
      };
      setImage("og_image_default", cfg.og_image_default ?? "");
      setImage("organization_logo_url", cfg.organization_logo_url ?? "");
      setImage("hero_image_url", cfg.hero_image_url ?? "");
      updateHeroFallbackStatus();

      // Hero page bg color — find its ColorEditor and seed the value.
      const heroBgEditor = form.querySelector('[data-color-editor-id="hero-bg"]');
      if (heroBgEditor) {
        const heroBgInput = heroBgEditor.querySelector("[data-color-input]");
        const heroBgHidden = heroBgEditor.querySelector("[data-color-hidden]");
        const stored = (cfg.hero_bg_color ?? "").trim();
        if (heroBgInput) heroBgInput.value = stored || HERO_BG_DEFAULT_PREVIEW;
        if (heroBgHidden) heroBgHidden.value = stored;
        heroBgEditor.dataset.set = stored ? "true" : "false";
        renderColorEditor(heroBgEditor);
      }

      // Hero card config
      const persisted = cfg.hero_card_config;
      const heroCfg = persisted && typeof persisted === "object"
        ? {
            content_source: persisted.content_source ?? DEFAULT_HERO_CARD.content_source,
            manual: { ...DEFAULT_HERO_CARD.manual, ...(persisted.manual ?? {}) },
            desktop: { ...DEFAULT_HERO_CARD.desktop, ...(persisted.desktop ?? {}) },
            mobile: { ...DEFAULT_HERO_CARD.mobile, ...(persisted.mobile ?? {}) },
          }
        : structuredClone(DEFAULT_HERO_CARD);
      currentHeroCfg = heroCfg;
      writeHeroForm(heroCfg);
      renderHeroPreview();

      const btn = form.querySelector("[data-submit-btn]");
      if (btn) btn.disabled = false;
    };

    const hydrate = async () => {
      if (!$("[data-site-form]")) return;
      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) apply(parsed.cfg);
        }
      } catch {}
      try {
        const res = await fetch("/api/page-data?type=site", { credentials: "same-origin", headers: { accept: "application/json" } });
        if (!res.ok) return;
        const data = await res.json();
        apply(data.config ?? {});
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), cfg: data.config })); } catch {}
      } catch {}
    };

    // Centralized tab switcher — used by clicks on the preview tabs and by
    // auto-switch when the user starts editing controls of a different
    // platform.
    const switchPreviewTab = (name) => {
      if (name !== "desktop" && name !== "mobile") return;
      if (currentPreviewTab === name) return;
      currentPreviewTab = name;
      $$("[data-preview-tab]").forEach(b => b.classList.toggle("cas-preview-tab-active", b.getAttribute("data-preview-tab") === name));
      $$("[data-platform-section]").forEach(sec => {
        sec.style.outline = sec.getAttribute("data-platform-section") === name ? "2px solid rgb(28 25 23)" : "";
        sec.style.outlineOffset = "-2px";
      });
      renderHeroPreview();
    };

    // ----- Contact list editors (emails / phones / addresses / social) -----
    // One generic helper builds and wires a list editor based on its
    // [data-list-template] attribute. Each row is a typed object;
    // every input/change syncs the array into a hidden JSON input
    // that the form POST submits as foo_json. The Astro handler
    // parses each foo_json and upserts under its real config key.
    const SOCIAL_PLATFORMS = [
      { value: "instagram", label: "Instagram" },
      { value: "facebook",  label: "Facebook" },
      { value: "twitter",   label: "Twitter / X" },
      { value: "youtube",   label: "YouTube" },
      { value: "linkedin",  label: "LinkedIn" },
      { value: "tiktok",    label: "TikTok" },
      { value: "threads",   label: "Threads" },
      { value: "bluesky",   label: "Bluesky" },
      { value: "website",   label: "Sitio web" },
      { value: "other",     label: "Otro" },
    ];
    const REMOVE_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    const attachListEditor = (root) => {
      // Reuse the cached instance if this root was already wired
      // earlier in this page's lifetime. Without this guard, every
      // call to wireForm (DOMContentLoaded + astro:page-load +
      // astro:after-swap) re-attached a new "Agregar" listener,
      // so a single click added 2+ rows. Same pattern used to
      // exist for phones / addresses / emails / social.
      if (root.__listEditor) return root.__listEditor;
      const tpl = root.getAttribute("data-list-template");
      const rowsEl = root.querySelector("[data-list-rows]");
      const addBtn = root.querySelector("[data-list-add]");
      const json = root.querySelector("[data-list-json]");
      let data = [];

      const makeInput = (type, k, value, placeholder) => {
        const el = type === "textarea" ? document.createElement("textarea") : document.createElement("input");
        if (type !== "textarea") el.type = type;
        el.className = "hcc-input";
        el.dataset.k = k;
        el.value = value ?? "";
        if (placeholder) el.placeholder = placeholder;
        if (type === "textarea") el.rows = 2;
        return el;
      };

      const buildRow = (item) => {
        const row = document.createElement("div");
        row.className = "cl-row";
        row.dataset.listRow = "";
        const fields = document.createElement("div");
        fields.className = "cl-row-fields";

        if (tpl === "email") {
          fields.style.gridTemplateColumns = "minmax(0, 1.6fr) minmax(0, 1fr)";
          fields.append(
            makeInput("email", "email", item.email, "ventas@ediciones.com"),
            makeInput("text",  "label", item.label, "Etiqueta (opcional)"),
          );
        } else if (tpl === "phone") {
          fields.style.gridTemplateColumns = "minmax(0, 1.4fr) minmax(0, 1fr)";
          fields.append(
            makeInput("tel",  "phone", item.phone, "+57 311 ..."),
            makeInput("text", "label", item.label, "Etiqueta (ej: prensa)"),
          );
          const cb = document.createElement("label");
          cb.className = "cl-row-checkbox";
          cb.style.gridColumn = "1 / -1";
          const cbIn = document.createElement("input");
          cbIn.type = "checkbox";
          cbIn.dataset.k = "whatsapp";
          cbIn.checked = !!item.whatsapp;
          const txt = document.createTextNode(" Es WhatsApp (abre wa.me en lugar de tel:)");
          cb.append(cbIn, txt);
          fields.appendChild(cb);
        } else if (tpl === "address") {
          fields.style.gridTemplateColumns = "minmax(0, 1fr)";
          fields.append(
            makeInput("text",     "label",   item.label,   "Etiqueta (ej: Sede principal)"),
            makeInput("textarea", "address", item.address, "Calle ..."),
          );
        } else if (tpl === "social") {
          fields.style.gridTemplateColumns = "minmax(120px, 150px) minmax(0, 1.4fr) minmax(0, 1fr)";
          const sel = document.createElement("select");
          sel.className = "hcc-input";
          sel.dataset.k = "platform";
          for (const p of SOCIAL_PLATFORMS) {
            const opt = document.createElement("option");
            opt.value = p.value;
            opt.textContent = p.label;
            if (p.value === (item.platform || "instagram")) opt.selected = true;
            sel.appendChild(opt);
          }
          fields.append(
            sel,
            makeInput("url",  "url",   item.url,   "https://..."),
            makeInput("text", "label", item.label, "Etiqueta (opcional)"),
          );
        }
        row.appendChild(fields);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "cl-row-remove";
        remove.dataset.listRemove = "";
        remove.setAttribute("aria-label", "Quitar");
        remove.innerHTML = REMOVE_SVG;
        row.appendChild(remove);
        return row;
      };

      const sync = () => {
        const next = [];
        rowsEl.querySelectorAll("[data-list-row]").forEach(row => {
          const obj = {};
          row.querySelectorAll("[data-k]").forEach(el => {
            const k = el.dataset.k;
            obj[k] = el.type === "checkbox" ? el.checked : el.value;
          });
          next.push(obj);
        });
        data = next;
        if (json) json.value = JSON.stringify(data);
      };

      const render = () => {
        rowsEl.innerHTML = "";
        data.forEach(item => rowsEl.appendChild(buildRow(item)));
        if (json) json.value = JSON.stringify(data);
      };

      rowsEl.addEventListener("input", sync);
      rowsEl.addEventListener("change", sync);
      rowsEl.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-list-remove]");
        if (!btn) return;
        btn.closest("[data-list-row]")?.remove();
        sync();
      });
      addBtn?.addEventListener("click", () => {
        const empty = tpl === "email"   ? { email: "", label: "" }
                    : tpl === "phone"   ? { phone: "", label: "", whatsapp: false }
                    : tpl === "address" ? { label: "", address: "" }
                    : tpl === "social"  ? { platform: "instagram", url: "", label: "" }
                    : {};
        data.push(empty);
        rowsEl.appendChild(buildRow(empty));
        if (json) json.value = JSON.stringify(data);
        rowsEl.lastElementChild?.querySelector("input, textarea, select")?.focus();
      });

      const instance = {
        setData(items) {
          data = Array.isArray(items) ? items.map(x => ({ ...x })) : [];
          render();
        },
        getData() { return [...data]; },
      };
      root.__listEditor = instance;
      return instance;
    };
    // listEditors is rebuilt on every boot so Astro view transitions
    // re-attach to the freshly swapped-in DOM nodes.
    let listEditors = new Map();

    // ----- Wire events -----
    const wireForm = () => {
      // Boot is called for both DOMContentLoaded and astro:page-load
      // (and astro:after-swap on transitions), so wireForm runs 2+
      // times per page life. Without a guard, every addEventListener
      // call below stacks up — clicking "Agregar otro …" added two
      // rows because two listeners fired. Mark the form once and
      // skip subsequent runs; listEditors are cached on their root
      // elements so re-querying still works for hydrate(). */
      const wireFormRoot = $("[data-site-form]");
      listEditors = new Map();
      $$("[data-list-editor]").forEach(root => {
        const name = root.getAttribute("data-list-editor");
        if (name) listEditors.set(name, attachListEditor(root));
      });
      if (wireFormRoot?.dataset.wired === "1") return;
      if (wireFormRoot) wireFormRoot.dataset.wired = "1";
      $$("[data-bind]").forEach(el => {
        el.addEventListener("input", renderHeroPreview);
        el.addEventListener("change", renderHeroPreview);
      });
      // Dropdown components emit a "change" event on their hidden input
      // when the user picks an option. Listen at the wrapper level so we
      // catch all of them in one place. The content_source dropdown
      // also drives the manual-fields visibility toggle.
      $$("[data-bind-dd]").forEach(wrap => {
        wrap.addEventListener("change", () => {
          if (wrap.getAttribute("data-bind-dd") === "content_source") {
            updateManualVisibility();
          }
          renderHeroPreview();
        });
      });
      // ColorEditor: wire native picker, X reset, and editable hex
      // for every instance. We listen at the form root so newly
      // hydrated inputs work without per-element wiring.
      const colorRoot = $("[data-site-form]");
      if (colorRoot) {
        // Picker change — sync hidden input, mark editor "set", repaint.
        colorRoot.addEventListener("input", (e) => {
          const inp = e.target.closest?.("[data-color-input]");
          if (!inp) return;
          const editor = inp.closest("[data-color-editor]");
          if (!editor) return;
          editor.dataset.set = "true";
          const hidden = editor.querySelector("[data-color-hidden]");
          if (hidden) hidden.value = inp.value;
          renderColorEditor(editor);
        });
        // X reset.
        colorRoot.addEventListener("click", (e) => {
          const btn = e.target.closest?.("[data-color-reset]");
          if (!btn) return;
          e.preventDefault();
          const editor = btn.closest("[data-color-editor]");
          if (!editor) return;
          const def = editor.getAttribute("data-color-default-value") ?? "";
          const inp = editor.querySelector("[data-color-input]");
          const hidden = editor.querySelector("[data-color-hidden]");
          if (def === "") {
            // "Use site default" mode — clear the hidden input and
            // mark unset; the swatch goes transparent, hex shows
            // "Por defecto", and any preview-frame mirror clears.
            editor.dataset.set = "false";
            if (hidden) hidden.value = "";
            if (inp) inp.value = HERO_BG_DEFAULT_PREVIEW;
          } else {
            // Typed-default mode — restore the documented default hex.
            editor.dataset.set = "true";
            if (hidden) hidden.value = def;
            if (inp) inp.value = def;
          }
          renderColorEditor(editor);
          // Trigger downstream listeners (hero card preview etc.)
          if (inp) {
            inp.dispatchEvent(new Event("input", { bubbles: true }));
            inp.dispatchEvent(new Event("change", { bubbles: true }));
          }
        });
        // Editable hex — typing a valid #abc / #abcdef updates the
        // picker live. Enter blurs to commit; blur normalizes the
        // displayed text.
        colorRoot.addEventListener("input", (e) => {
          const el = e.target.closest?.("[data-color-hex]");
          if (!el || !el.isContentEditable) return;
          const editor = el.closest("[data-color-editor]");
          const inp = editor?.querySelector("[data-color-input]");
          if (!editor || !inp) return;
          const raw = (el.textContent || "").trim();
          const m = HEX_RX.exec(raw);
          if (!m) return;
          const next = "#" + expandHex(m[1]);
          if (inp.value === next && editor.dataset.set === "true") return;
          inp.value = next;
          editor.dataset.set = "true";
          const hidden = editor.querySelector("[data-color-hidden]");
          if (hidden) hidden.value = next;
          // Repaint swatch + propagate to bind listeners (don't
          // rewrite the hex span — the user is editing it).
          const swatch = editor.querySelector("[data-color-swatch]");
          if (swatch) swatch.style.setProperty("--swatch-color", next);
          if (editor.dataset.colorEditorId === "hero-bg") {
            const applyTo = (frame) => { if (frame) frame.style.background = next; };
            applyTo($("[data-preview-frame]"));
            applyTo($("[data-fullscreen-frame]"));
          }
          inp.dispatchEvent(new Event("input", { bubbles: true }));
          inp.dispatchEvent(new Event("change", { bubbles: true }));
        });
        colorRoot.addEventListener("keydown", (e) => {
          const el = e.target.closest?.("[data-color-hex]");
          if (!el || !el.isContentEditable) return;
          if (e.key === "Enter") {
            e.preventDefault();
            el.blur();
          }
        });
        colorRoot.addEventListener("focusout", (e) => {
          const el = e.target.closest?.("[data-color-hex]");
          if (!el || !el.isContentEditable) return;
          const editor = el.closest("[data-color-editor]");
          if (!editor) return;
          renderColorEditor(editor);
        });
      }

      // URL combobox: a single editable input + a dropdown of detected
      // site pages. Type freely (custom routes), or click the chevron
      // (or focus and start typing) to filter and pick a known page.
      // The input itself is the source of truth — selecting a suggestion
      // just fills it.
      const combo = $("[data-url-combo]");
      if (combo && !combo.dataset.wired) {
        combo.dataset.wired = "1";
        const input  = combo.querySelector("[data-url-combo-input]");
        const toggle = combo.querySelector("[data-url-combo-toggle]");
        const list   = combo.querySelector("[data-url-combo-list]");
        let activeIdx = -1;

        const renderList = (q) => {
          const needle = q.trim().toLowerCase();
          const matches = !needle
            ? URL_OPTIONS
            : URL_OPTIONS.filter(o =>
                (o.value || "").toLowerCase().includes(needle) ||
                (o.label || "").toLowerCase().includes(needle) ||
                (o.hint  || "").toLowerCase().includes(needle)
              );
          list.innerHTML = "";
          if (matches.length === 0) {
            const empty = document.createElement("li");
            empty.className = "hcc-url-combo-empty";
            empty.style.cursor = "default";
            empty.textContent = "Sin coincidencias — la ruta que escribiste se usará tal cual.";
            list.appendChild(empty);
            return;
          }
          matches.forEach((o, i) => {
            const li = document.createElement("li");
            li.setAttribute("role", "option");
            li.dataset.value = o.value;
            if (i === activeIdx) li.dataset.active = "1";
            li.innerHTML = `
              <span class="uc-label">${escapeHtml(o.label || o.value)}</span>
              <span class="uc-hint">${escapeHtml(o.value)}</span>
            `;
            list.appendChild(li);
          });
        };

        const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => (
          { "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]
        ));

        const open = () => {
          activeIdx = -1;
          renderList(input.value);
          list.hidden = false;
          combo.dataset.open = "1";
        };
        const close = () => {
          list.hidden = true;
          delete combo.dataset.open;
        };
        const choose = (val) => {
          input.value = val;
          input.dispatchEvent(new Event("input",  { bubbles: true }));
          input.dispatchEvent(new Event("change", { bubbles: true }));
          close();
          input.focus();
        };

        toggle.addEventListener("click", () => {
          if (combo.dataset.open) close();
          else { open(); input.focus(); }
        });
        input.addEventListener("focus", open);
        input.addEventListener("input", () => {
          activeIdx = -1;
          if (!list.hidden) renderList(input.value);
        });
        list.addEventListener("mousedown", (e) => {
          // mousedown (not click) so the input doesn't lose focus first
          // and trigger the focusout-close handler below.
          const li = e.target.closest("li[data-value]");
          if (!li) return;
          e.preventDefault();
          choose(li.dataset.value);
        });
        // Close on click outside.
        document.addEventListener("mousedown", (e) => {
          if (!combo.contains(e.target)) close();
        });
        // Keyboard navigation.
        input.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            if (list.hidden) open();
            const items = list.querySelectorAll("li[data-value]");
            if (!items.length) return;
            activeIdx = (activeIdx + 1) % items.length;
            renderList(input.value);
            const active = list.querySelector('li[data-active="1"]');
            active?.scrollIntoView({ block: "nearest" });
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            const items = list.querySelectorAll("li[data-value]");
            if (!items.length) return;
            activeIdx = (activeIdx - 1 + items.length) % items.length;
            renderList(input.value);
            const active = list.querySelector('li[data-active="1"]');
            active?.scrollIntoView({ block: "nearest" });
          } else if (e.key === "Enter") {
            const items = list.querySelectorAll("li[data-value]");
            if (!list.hidden && activeIdx >= 0 && items[activeIdx]) {
              e.preventDefault();
              choose(items[activeIdx].dataset.value);
            }
          } else if (e.key === "Escape") {
            if (!list.hidden) { e.preventDefault(); close(); }
          }
        });
      }
      // Auto-switch the preview tab when the user focuses or changes a
      // control inside one of the platform-scoped sections. Catches
      // mouse + keyboard interaction.
      $$("[data-platform-section]").forEach(sec => {
        const platform = sec.getAttribute("data-platform-section");
        const trigger = () => switchPreviewTab(platform);
        sec.addEventListener("focusin", trigger);
        sec.addEventListener("input", trigger);
        sec.addEventListener("change", trigger);
      });
      // Scroll-spy for preview platform.
      // The previous IntersectionObserver implementation switched
      // erratically because multiple sections could intersect the
      // band simultaneously and the chosen "best" entry depended on
      // intersection ratio (which fluctuates with scroll velocity).
      // Replaced with a deterministic rAF-throttled scroll handler:
      // the active platform section is the LATEST one whose top has
      // crossed below a fixed trigger line (≈30% from viewport top,
      // skipping the sticky breadcrumb+tabs). A section is picked
      // only when its top is at-or-above that line; the last one to
      // qualify (by largest top value) wins. We only fire
      // switchPreviewTab when the active section actually changes,
      // so a user's explicit Web/Mobile click isn't fought by
      // unrelated micro-scrolls.
      const platformSections = $$("[data-platform-section]");
      // scrollSpyPaused is flipped on programmatic scrolls (e.g.
      // clicking the Web/Mobile preview tab) so the spy doesn't
      // flicker the preview while it scrolls past the OTHER
      // platform's section in transit.
      let scrollSpyPaused = false;
      if (platformSections.length) {
        let lastActive = null;
        let scrollScheduled = false;
        const evaluate = () => {
          scrollScheduled = false;
          if (scrollSpyPaused) return;
          const triggerY = Math.max(140, window.innerHeight * 0.3);
          let active = null;
          let activeTop = -Infinity;
          for (const sec of platformSections) {
            const rect = sec.getBoundingClientRect();
            if (rect.top <= triggerY && rect.top > activeTop) {
              active = sec;
              activeTop = rect.top;
            }
          }
          if (active && active !== lastActive) {
            const platform = active.getAttribute("data-platform-section");
            if (platform) switchPreviewTab(platform);
            lastActive = active;
          }
        };
        const onScroll = () => {
          if (scrollScheduled) return;
          scrollScheduled = true;
          requestAnimationFrame(evaluate);
        };
        // Scroll events don't bubble, but they DO fire in the capture
        // phase. <main> has its own md:overflow-y-auto on desktop, so
        // a window-scoped listener wouldn't see those scrolls. Capture
        // phase catches scroll on any element on the page.
        document.addEventListener("scroll", onScroll, { passive: true, capture: true });
        window.addEventListener("resize", onScroll, { passive: true });
        requestAnimationFrame(evaluate);
      }
      // Web / Mobile preview tab → scroll the matching editor
      // section into view AND switch the preview tab. Pauses the
      // spy long enough for smooth-scroll to settle so the preview
      // doesn't flicker through the other platform on the way.
      // The platform sections carry scroll-margin-top so the sticky
      // tab nav (and mobile header + breadcrumb) don't cover them.
      $$("[data-preview-tab]").forEach(btn => {
        btn.addEventListener("click", () => {
          const platform = btn.getAttribute("data-preview-tab");
          if (!platform) return;
          switchPreviewTab(platform);
          const target = $(`[data-platform-section="${platform}"]`);
          if (target) {
            // Pre-collapse the pagenav to its stuck (compact) form
            // BEFORE scrollIntoView calculates the destination, so the
            // target lines up with the smaller sticky stack instead of
            // ending up partially hidden behind it.
            const pagenav = $("[data-pagenav]");
            pagenav?.setAttribute("data-stuck", "1");
            const pagenavLast = pagenav?.getAttribute("data-stuck-forced");
            pagenav?.setAttribute("data-stuck-forced", "1");
            scrollSpyPaused = true;
            // Wait one frame so the layout reflects the stuck state.
            requestAnimationFrame(() => {
              target.scrollIntoView({ behavior: "smooth", block: "start" });
              setTimeout(() => {
                scrollSpyPaused = false;
                if (!pagenavLast) pagenav?.removeAttribute("data-stuck-forced");
              }, 800);
            });
          }
        });
      });
      // Zoom controls — present once per page; we listen on each
      // matched element so duplicates inside the fullscreen modal
      // (none today, but future-proof) all work.
      $$("[data-preview-zoom-in]").forEach(b => b.addEventListener("click", () => stepZoom(+1)));
      $$("[data-preview-zoom-out]").forEach(b => b.addEventListener("click", () => stepZoom(-1)));
      $$("[data-preview-zoom-reset]").forEach(b => b.addEventListener("click", () => setPreviewZoom(1)));
      // Mini content-preview "Editar editorial" link — switches to
      // the Editorial tab and focuses the Descripción editorial
      // textarea so the editor lands directly on it.
      $$("[data-cp-edit-editorial]").forEach(a => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          switchTab("editorial");
          const textarea = document.querySelector('[name="editorial_description"]');
          if (textarea) {
            textarea.scrollIntoView({ behavior: "smooth", block: "center" });
            requestAnimationFrame(() => textarea.focus());
          }
        });
      });
      document.addEventListener("cas:imageupload:change", (e) => {
        const d = e.detail || {};
        if (d.name === "hero_image_url") {
          updateHeroFallbackStatus();
          renderHeroPreview();
        } else if (d.name === "desktop_bg_image") {
          switchPreviewTab("desktop");
          renderHeroPreview();
        } else if (d.name === "mobile_bg_image") {
          switchPreviewTab("mobile");
          renderHeroPreview();
        }
      });
      // Fullscreen launcher buttons in the tab nav
      $$("[data-fullscreen-tab]").forEach(btn => {
        btn.addEventListener("click", () => openFullscreen(btn.getAttribute("data-fullscreen-tab")));
      });
      const fsClose = $("[data-fullscreen-close]");
      if (fsClose) fsClose.addEventListener("click", closeFullscreen);
      // ESC closes the fullscreen modal
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const modal = $("[data-fullscreen-modal]");
        if (modal && !modal.hasAttribute("hidden")) closeFullscreen();
      });

      // Position steppers: −/+ buttons next to each X/Y input nudge
      // the value by `data-step` (typically ±8px). Click and hold to
      // repeat at ~12 ticks/second after a 350ms initial delay so
      // longer adjustments don't require dozens of taps.
      $$(".hcc-step").forEach(btn => {
        const targetPath = btn.getAttribute("data-step-target");
        const stepBy = Number(btn.getAttribute("data-step")) || 1;
        const input = document.querySelector(`[data-bind="${CSS.escape(targetPath)}"]`);
        if (!input) return;
        const apply = () => {
          const cur = Number(input.value) || 0;
          let next = cur + stepBy;
          const min = input.min !== "" ? Number(input.min) : -Infinity;
          const max = input.max !== "" ? Number(input.max) : Infinity;
          next = Math.max(min, Math.min(max, next));
          input.value = String(next);
          // Find the platform from the bind path (e.g. "desktop.offset_x")
          const platform = targetPath.split(".")[0];
          if (platform === "desktop" || platform === "mobile") switchPreviewTab(platform);
          renderHeroPreview();
        };
        let holdTimer = null;
        let repeatTimer = null;
        const startHold = () => {
          holdTimer = setTimeout(() => {
            repeatTimer = setInterval(apply, 80);
          }, 350);
        };
        const stopHold = () => {
          if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
          if (repeatTimer) { clearInterval(repeatTimer); repeatTimer = null; }
        };
        btn.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          apply();
          startHold();
        });
        btn.addEventListener("pointerup", stopHold);
        btn.addEventListener("pointerleave", stopHold);
        btn.addEventListener("pointercancel", stopHold);
        btn.addEventListener("blur", stopHold);
      });

      // Border-radius "link corners" toggle: when on, editing one corner
      // input mirrors its value into the other 3 of the same platform.
      $$("[data-radius-link]").forEach(toggle => {
        const platform = toggle.getAttribute("data-radius-link");
        const grid = document.querySelector(`[data-radius-platform="${platform}"]`);
        if (!grid) return;
        const inputs = Array.from(grid.querySelectorAll("[data-radius-input]"));
        inputs.forEach(inp => {
          inp.addEventListener("input", () => {
            if (!toggle.checked) return;
            const v = inp.value;
            inputs.forEach(other => {
              if (other !== inp) other.value = v;
            });
            renderHeroPreview();
          });
        });
        // When the toggle is turned ON, snap all four corners to the value
        // of the first corner so they're consistent right away.
        toggle.addEventListener("change", () => {
          if (!toggle.checked) return;
          const v = inputs[0]?.value || "0";
          inputs.forEach(i => { i.value = v; });
          renderHeroPreview();
        });
      });
      const reset = $("[data-reset-hero-btn]");
      if (reset) reset.addEventListener("click", (ev) => {
        ev.preventDefault();
        if (!confirm("¿Restablecer estilos de la card a los defaults?")) return;
        currentHeroCfg = structuredClone(DEFAULT_HERO_CARD);
        writeHeroForm(currentHeroCfg);
        renderHeroPreview();
      });
      // On submit, make sure the JSON hidden input has the latest config.
      const form = $("[data-site-form]");
      if (form) form.addEventListener("submit", () => {
        const cfg = readHeroForm();
        const heroJson = $("[data-hero-json]");
        if (heroJson) heroJson.value = JSON.stringify(cfg);
      });
      window.addEventListener("resize", renderHeroPreview);
    };

    // Page tab switcher: reads ?page= from the URL and toggles which
    // [data-page-tab-panel] is visible. "home" is the default and
    // contains the existing Hero/Editorial/Contacto/SEO controls; the
    // other pages render a "en construcción" placeholder. Clicks on a
    // chip swap panels without a real navigation, replaceState the URL
    // so refresh keeps you on the same page, and dispatch a custom
    // event so the sidebar's sub-nav can highlight the matching item.
    const PAGE_KEYS = ["home", "catalogo", "articulos", "filosofia", "poesia", "autores", "contacto"];
    const currentPageKey = () => {
      const k = (new URL(window.location.href).searchParams.get("page") || "home").toLowerCase();
      return PAGE_KEYS.includes(k) ? k : "home";
    };
    const setPageTab = (key, push) => {
      key = PAGE_KEYS.includes(key) ? key : "home";
      $$("[data-page-tab-panel]").forEach(p => {
        p.hidden = p.getAttribute("data-page-tab-panel") !== key;
      });
      $$("[data-page-tab]").forEach(b => {
        b.classList.toggle("cas-pagechip-active", b.getAttribute("data-page-tab") === key);
      });
      // Bars that only apply to a specific page (e.g. the inner
      // Hero/Editorial/Contacto/SEO tab nav lives outside the panel
      // now so it can stack flush under the page-nav, but it should
      // only be visible while the user is on Home).
      $$("[data-page-only]").forEach(el => {
        el.hidden = el.getAttribute("data-page-only") !== key;
      });
      if (push) {
        const url = new URL(window.location.href);
        if (key === "home") url.searchParams.delete("page");
        else url.searchParams.set("page", key);
        // Switching off Home invalidates ?tab= (only Home has tabs).
        if (key !== "home") url.searchParams.delete("tab");
        window.history.replaceState({}, "", url.toString());
      }
      // Sync the breadcrumb's trailing crumbs.
      const url = new URL(window.location.href);
      const tabKey = (url.searchParams.get("tab") || "hero").toLowerCase();
      updateBreadcrumbCrumbs(key, tabKey);
      window.dispatchEvent(new CustomEvent("cas:page-tab-change", { detail: { key } }));
    };
    const wirePageTabs = () => {
      const nav = $("[data-pagenav]");
      if (!nav || nav.dataset.wired) {
        // Even if already wired, sync visibility on (re)boot.
        setPageTab(currentPageKey(), false);
        return;
      }
      nav.dataset.wired = "1";
      nav.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-page-tab]");
        if (!btn) return;
        e.preventDefault();
        setPageTab(btn.getAttribute("data-page-tab"), true);
      });
      setPageTab(currentPageKey(), false);

      // Expose the sticky stack's current height as a CSS var so
      // any element that needs to clear the stickies (preview-aside,
      // scroll-margin-top of platform sections) can stay below it
      // regardless of expanded/compact state.
      const stack = $("[data-stickystack]");
      const updateStackHeight = () => {
        const target = stack || nav;
        const h = target.getBoundingClientRect().height;
        if (h > 0) {
          document.documentElement.style.setProperty("--cas-stickystack-h", `${h}px`);
        }
      };
      updateStackHeight();
      if (typeof ResizeObserver !== "undefined") {
        const ro = new ResizeObserver(updateStackHeight);
        ro.observe(stack || nav);
      } else {
        window.addEventListener("resize", updateStackHeight);
      }

      // Stuck-state detection. The pagenav is glued to the top of
      // the scroll container from y=0 (negative margin cancels the
      // wrapper padding-top). So "stuck" really means "the user
      // scrolled past a small threshold" — at which point we
      // compact the bar to a single horizontally-scrollable row.
      const main = nav.closest("main");
      const scroller =
        main && window.matchMedia("(min-width: 768px)").matches ? main : window;
      const STUCK_THRESHOLD = 8;
      let rafPending = false;
      const updateStuck = () => {
        rafPending = false;
        const y = scroller === window ? window.scrollY : scroller.scrollTop;
        const stuck = y > STUCK_THRESHOLD;
        const wasStuck = nav.hasAttribute("data-stuck");
        if (stuck && !wasStuck) {
          nav.setAttribute("data-stuck", "1");
          requestAnimationFrame(updateStackHeight);
        } else if (!stuck && wasStuck) {
          nav.removeAttribute("data-stuck");
          requestAnimationFrame(updateStackHeight);
        }
      };
      const onScroll = () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(updateStuck);
      };
      scroller.addEventListener("scroll", onScroll, { passive: true });
      updateStuck();
    };

    const boot = () => {
      wirePageTabs();
      wireTabs();
      wireForm();
      hydrate();
    };

    document.addEventListener("astro:page-load", () => {
      const url = new URL(window.location.href);
      if (url.searchParams.has("saved")) {
        try { sessionStorage.removeItem(cacheKey); } catch {}
      }
      boot();
    });
    document.addEventListener("astro:after-swap", boot);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
