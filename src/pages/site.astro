                  {PUBLICATION_PV?.readingMin != null && (<><dt>Lectura</dt><dd>{PUBLICATION_PV.readingMin} min</dd></>)}
                </dl>
              )}
            </aside>
            <div class="cas-detail-pv-content cas-detail-pv-content--publication" data-pv-publication-body>
              {(PUBLICATION_PV?.body && PUBLICATION_PV.body.length > 0
                ? PUBLICATION_PV.body
                : ["Aquí aparecerá el cuerpo del artículo con la tipografía que elijas. Cada párrafo, lista o cita respetará esta familia.",
                   "Los títulos H2/H3 dentro del contenido también heredan la misma fuente para mantener una voz tipográfica coherente."]
              ).map((para) => (<p>{para}</p>))}
