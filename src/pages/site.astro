  }

  /* === Numeric cell with icon + label + suffix === */
  .hcc-num-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .hcc-num-cell-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
