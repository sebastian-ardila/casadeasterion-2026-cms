---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

// SSR: only auth gate + POST handling. Fields hydrate from /api/page-data?type=site.
const guard = await requirePermission(Astro, "site", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;
const saved = Astro.url.searchParams.get("published") === "1";

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=site");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();

    const rows = [
      { key: "hero_quote",                value: strReq(fd, "hero_quote") as never },
      { key: "hero_quote_author",         value: strReq(fd, "hero_quote_author") as never },
      { key: "editorial_description",     value: strReq(fd, "editorial_description") as never },
      { key: "footer_legal",              value: strReq(fd, "footer_legal") as never },
      { key: "whatsapp_phone",            value: strReq(fd, "whatsapp_phone") as never },
      { key: "whatsapp_message_template", value: strReq(fd, "whatsapp_message_template") as never },
      {
        key: "social_links",
        value: {
          facebook: str(fd, "social_facebook") ?? "",
          instagram: str(fd, "social_instagram") ?? "",
          twitter: str(fd, "social_twitter") ?? "",
        } as never,
      },
    ];

    const { error } = await supabase
      .from("site_configuration")
      .upsert(rows, { onConflict: "key" });
    if (error) throw error;

    return Astro.redirect("/site?published=1&item=" + encodeURIComponent("Configuración del sitio"));
  } catch (err) {
    formError = friendlyError(err);
  }
}
---

<AppLayout title="Configuración">
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Configuración del sitio</h1>
  <p class="text-stone-500 mb-8">Textos, contacto y redes que aparecen en el frontend público.</p>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar la configuración del sitio.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {saved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado. Se disparará un rebuild del sitio público.</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl" data-site-form>
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Cita destacada del homepage</h2>
        <p class="card-section-desc">Aparece en la sección entre el hero y los artículos. Es el centro visual de la portada.</p>
      </div>
      <Field label="Cita" name="hero_quote" type="textarea" rows={3} required description="Frase corta y elocuente. Sin comillas alrededor — el diseño las añade." />
      <Field label="Autor de la cita" name="hero_quote_author" required description="Nombre que firma la cita." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Editorial</h2>
        <p class="card-section-desc">Información general que aparece en footer, meta tags y al compartir el sitio.</p>
      </div>
      <Field label="Descripción de la editorial" name="editorial_description" type="textarea" rows={3} required description="Aparece en el footer y como meta description del sitio. 1-2 frases." />
      <Field label="Línea legal del footer" name="footer_legal" required description="Texto pequeño abajo del footer (ej: '© 2026 Casa de Asterión Ediciones')." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">WhatsApp (compras)</h2>
        <p class="card-section-desc">El botón "Comprar" en cada libro abre WhatsApp con un mensaje pre-llenado a este número.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <Field label="Número en formato E.164" name="whatsapp_phone" required description="Ej: +573117462759 (con + y código país)." />
      </div>
      <Field label="Plantilla del mensaje" name="whatsapp_message_template" type="textarea" rows={3} required description="Variables disponibles: {{title}}, {{author}}, {{isbn}}, {{slug}}. Se usa cuando un libro no define un mensaje propio." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Redes sociales</h2>
        <p class="card-section-desc">URLs completas de los perfiles oficiales. Se enlazan desde el footer.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Field label="Facebook" name="social_facebook" type="url" description="URL pública del perfil." />
        <Field label="Instagram" name="social_instagram" type="url" description="URL pública del perfil." />
        <Field label="Twitter / X" name="social_twitter" type="url" description="URL pública del perfil." />
      </div>
    </section>

    {canEdit && (
      <div class="flex gap-3 pt-4 border-t border-stone-200">
        <button type="submit" class="btn-primary" disabled data-submit-btn>Guardar configuración</button>
      </div>
    )}
    </fieldset>
  </form>
</AppLayout>

<script is:inline>
  (() => {
    if (window.__casSiteInit) return;
    window.__casSiteInit = true;

    const cacheKey = "cas:site";
    const TTL = 60_000;

    const apply = (cfg) => {
      const form = document.querySelector("[data-site-form]");
      if (!form) return;
      const set = (name, value) => {
        const el = form.querySelector(`[name="${name}"]`);
        if (el && typeof value === "string") el.value = value;
      };
      set("hero_quote", cfg.hero_quote ?? "");
      set("hero_quote_author", cfg.hero_quote_author ?? "");
      set("editorial_description", cfg.editorial_description ?? "");
      set("footer_legal", cfg.footer_legal ?? "");
      set("whatsapp_phone", cfg.whatsapp_phone ?? "");
      set("whatsapp_message_template", cfg.whatsapp_message_template ?? "");
      const social = (cfg.social_links ?? {});
      set("social_facebook", social.facebook ?? "");
      set("social_instagram", social.instagram ?? "");
      set("social_twitter", social.twitter ?? "");
      // Enable submit once data is loaded.
      const btn = form.querySelector("[data-submit-btn]");
      if (btn) btn.disabled = false;
    };

    const hydrate = async () => {
      if (!document.querySelector("[data-site-form]")) return;

      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) apply(parsed.cfg);
        }
      } catch {}

      try {
        const res = await fetch("/api/page-data?type=site", {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) return;
        const data = await res.json();
        apply(data.config ?? {});
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), cfg: data.config })); } catch {}
      } catch {}
    };

    document.addEventListener("astro:page-load", () => {
      const url = new URL(window.location.href);
      if (url.searchParams.has("published")) {
        try { sessionStorage.removeItem(cacheKey); } catch {}
      }
      hydrate();
    });
    document.addEventListener("astro:after-swap", hydrate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", hydrate);
    } else {
      hydrate();
    }
  })();
</script>
