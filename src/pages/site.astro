---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import CardHeader from "~/components/CardHeader.astro";
import Dropdown from "~/components/Dropdown.astro";
import ColorEditor from "~/components/ColorEditor.astro";
import PageStub from "~/components/PageStub.astro";
import DetailTypographyPanel from "~/components/DetailTypographyPanel.astro";
import FormActions from "~/components/FormActions.astro";
import { fullName, formatAgo } from "~/lib/relative-time";
import { Icon } from "astro-icon/components";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq, tags as parseTags } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import { FONT_OPTIONS } from "~/lib/fonts";

// Map { value → fontFamily } so the in-page preview JS can swap the
// font of the catalog/article preview card live as the editor picks a
// typeface from the dropdown — without round-tripping to the server.
const FONT_FAMILY_MAP: Record<string, string> = Object.fromEntries(
  FONT_OPTIONS.map((f) => [f.value, f.fontFamily]),
);
const resolveFontFamily = (key: string) =>
  FONT_FAMILY_MAP[key] ?? FONT_FAMILY_MAP.serif;

// Strip the most common markdown noise so the preview shows clean text.
// Returns blocks split by **double** newline (paragraphs in prose).
function stripMd(raw: string | null | undefined): string[] {
  if (!raw) return [];
  return raw
    .replace(/[#*_`>\[\]()]/g, "")
    .split(/\n\s*\n/)
    .map((s) => s.trim())
    .filter(Boolean);
}
// Like stripMd but splits on EVERY newline. For poetry the public
// renderer keeps each line as its own paragraph (the markdown lib
// wraps single newlines as <br /> or treats them as block breaks),
// so the preview matches by doing the same.
function stripMdLines(raw: string | null | undefined): string[] {
  if (!raw) return [];
  return raw
    .replace(/[#*_`>\[\]()]/g, "")
    .split(/\n/)
    .map((s) => s.trim())
    .filter(Boolean);
}
function clip(s: string | undefined, n: number): string {
  if (!s) return "";
  return s.length > n ? s.slice(0, n).trimEnd() + "…" : s;
}

// Surface helpers for the live preview cards. Books and posts come
// back from Supabase with junction rows; flatten them and pick the
// first author. Anything missing falls through to a sensible mock.
type PreviewAuthor = { name: string; photo_url: string | null; bio_md?: string | null };
function pickAuthors<T extends { sort_order: number; author: PreviewAuthor | null }>(
  rows: T[] | null | undefined,
  limit = 2,
): PreviewAuthor[] {
  if (!Array.isArray(rows)) return [];
  return [...rows]
    .sort((a, b) => a.sort_order - b.sort_order)
    .map((r) => r.author)
    .filter((a): a is PreviewAuthor => !!a)
    .slice(0, limit);
}
function formatPriceCOP(amount: number | null | undefined, currency: string | null | undefined): string | null {
  if (amount == null) return null;
  try {
    return new Intl.NumberFormat("es-CO", {
      style: "currency",
      currency: currency || "COP",
      maximumFractionDigits: 0,
    }).format(Number(amount));
  } catch {
    return `${currency || ""} ${amount}`.trim();
  }
}
function formatDateLong(iso: string | null | undefined): string | null {
  if (!iso) return null;
  try {
    return new Intl.DateTimeFormat("es-CO", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(iso));
  } catch {
    return null;
  }
}

// Reads a hidden JSON-encoded list from FormData. Returns [] on
// missing / malformed input so a corrupt list can never block a
// site-config save.
function parseJsonArray(fd: FormData, key: string): unknown[] {
  const raw = fd.get(key)?.toString() ?? "";
  if (!raw) return [];
  try {
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

const CONTENT_SOURCE_OPTIONS = [
  { value: "editorial",   label: "Descripción editorial",   hint: "Default — usa la descripción global del sitio", icon: "lucide:file-text" },
  { value: "manual",      label: "Manual",                  hint: "Define el texto y la URL aquí mismo",            icon: "lucide:pencil" },
  { value: "latest_post", label: "Último artículo publicado", hint: "Se actualiza solo cuando publicas un post",     icon: "lucide:newspaper" },
  { value: "latest_book", label: "Último libro publicado",  hint: "Se actualiza solo cuando publicas un libro",     icon: "lucide:book-open" },
];

// Mirrors apps/web/src/pages/index.astro's HERO_FALLBACK. Keep in sync if
// the public-site default changes.
const HERO_FALLBACK_URL =
  "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=2400&q=80";

// SSR: only auth gate + POST handling. Fields hydrate from /api/page-data?type=site.
const guard = await requirePermission(Astro, "site", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;

// Auto-detected URL options for the manual content's CTA href picker.
// Static routes mirror the file structure of apps/web/src/pages; the
// dynamic ones come from Supabase so the dropdown auto-grows as the
// editor publishes new posts / books / authors. Failures here just
// degrade the picker to the static list — never block the page.
type UrlOpt = { value: string; label: string; hint?: string; icon?: string };
const URL_STATIC: UrlOpt[] = [
  { value: "/",            label: "Inicio",     hint: "Página principal",        icon: "lucide:home" },
  { value: "/catalogo",    label: "Catálogo",   hint: "Lista de libros",         icon: "lucide:book-open" },
  { value: "/articulos",   label: "Artículos",  hint: "Lista de artículos",      icon: "lucide:newspaper" },
  { value: "/autores",     label: "Autores",    hint: "Lista de autores",        icon: "lucide:users" },
  { value: "/#contacto",   label: "Contacto",   hint: "Sección de contacto",     icon: "lucide:phone" },
];
let URL_OPTIONS: UrlOpt[] = [...URL_STATIC];
// The "Contenido de la card" mini preview also wants the latest
// published post + latest published book so editors see the real
// content the public site will resolve. Surface them via define:vars.
// content_md / description_md let the JS-side teaser builder fall
// back to the long-form text when the editor hasn't filled an
// excerpt / subtitle.
type LatestPost = {
  slug: string;
  title: string;
  excerpt: string | null;
  content_md: string | null;
  subtitle?: string | null;
  cover_image_url?: string | null;
  published_at?: string | null;
  reading_time_minutes?: number | null;
  category?: { name: string; icon: string | null } | null;
  post_authors?: { sort_order: number; author: { name: string; photo_url: string | null; bio_md: string | null } | null }[] | null;
} | null;
type LatestBook = {
  slug: string;
  title: string;
  subtitle: string | null;
  description_md: string | null;
  cover_image_url?: string | null;
  isbn?: string | null;
  pages?: number | null;
  format?: string | null;
  price_amount?: number | null;
  price_currency?: string | null;
  book_authors?: { sort_order: number; author: { name: string; photo_url: string | null } | null }[] | null;
} | null;
let LATEST_POST: LatestPost = null;
let LATEST_BOOK: LatestBook = null;
// Most recent site_configuration row + the editor that last touched it
// — shown next to "Guardar configuración" so the team can see at a
// glance who saved last.
let LAST_SITE_EDIT: { updated_at: string; editor: { id: string; full_name: string | null; email: string | null } | null } | null = null;

// Persisted typography for /catalogo/[slug] and /articulos/[slug]. We
// hydrate the two DetailTypographyPanel dropdowns server-side so the
// editor never sees a flash of the default "Cormorant Garamond" while
// the saved choice is fetched.
let BOOK_DETAIL_TYPO: { title_font: string; body_font: string } = { title_font: "serif", body_font: "serif" };
let ARTICLE_DETAIL_TYPO: { title_font: string; body_font: string } = { title_font: "serif", body_font: "serif" };
try {
  const sb = getSupabaseServerClient(Astro.request, Astro.cookies);
  const [postsRes, booksRes, authorsRes, latestPostRes, latestBookRes, siteEditRes, typoRes] = await Promise.all([
    sb.from("posts").select("slug, title").eq("status", "published").order("title").limit(60),
    sb.from("books").select("slug, title").eq("status", "published").order("title").limit(60),
    sb.from("authors").select("slug, name").order("name").limit(40),
    sb.from("posts").select("slug, title, excerpt, content_md, subtitle, cover_image_url, published_at, reading_time_minutes, category:categories(name, icon), post_authors(sort_order, author:authors(name, photo_url, bio_md))").eq("status", "published").order("published_at", { ascending: false }).limit(1).maybeSingle(),
    sb.from("books").select("slug, title, subtitle, description_md, cover_image_url, isbn, pages, format, price_amount, price_currency, book_authors(sort_order, author:authors(name, photo_url))").eq("status", "published").order("created_at", { ascending: false }).limit(1).maybeSingle(),
    sb.from("site_configuration")
      .select("updated_at, editor:profiles!site_configuration_updated_by_fkey(id, full_name, email)")
      .order("updated_at", { ascending: false })
      .limit(1)
      .maybeSingle(),
    sb.from("site_configuration")
      .select("key, value")
      .in("key", ["book_detail_typography", "article_detail_typography"]),
  ]);
  const books = (booksRes.data ?? []).filter((r) => r?.slug);
  const posts = (postsRes.data ?? []).filter((r) => r?.slug);
  const authors = (authorsRes.data ?? []).filter((r) => r?.slug);
  URL_OPTIONS = [
    ...URL_STATIC,
    ...books.map((b) => ({ value: `/catalogo/${b.slug}`,  label: b.title, hint: "Libro",    icon: "lucide:book" as const })),
    ...posts.map((p) => ({ value: `/articulos/${p.slug}`, label: p.title, hint: "Artículo", icon: "lucide:file-text" as const })),
    ...authors.map((a) => ({ value: `/autores/${a.slug}`, label: a.name,  hint: "Autor",    icon: "lucide:user" as const })),
  ];
  if (latestPostRes.data) LATEST_POST = latestPostRes.data as LatestPost;
  if (latestBookRes.data) LATEST_BOOK = latestBookRes.data as LatestBook;
  if (siteEditRes.data) LAST_SITE_EDIT = siteEditRes.data as typeof LAST_SITE_EDIT;
  for (const row of typoRes.data ?? []) {
    const v = row.value as { title_font?: string; body_font?: string } | null;
    if (!v || typeof v !== "object") continue;
    const merged = {
      title_font: typeof v.title_font === "string" && v.title_font ? v.title_font : "serif",
      body_font: typeof v.body_font === "string" && v.body_font ? v.body_font : "serif",
    };
    if (row.key === "book_detail_typography") BOOK_DETAIL_TYPO = merged;
    if (row.key === "article_detail_typography") ARTICLE_DETAIL_TYPO = merged;
  }
} catch {
  // Network / RLS hiccup — keep the static picker only.
}

// Derived view-model for the live previews. Flatten junction rows
// into a small object the template can read without juggling
// sort_orders / null guards.
const BOOK_PV = LATEST_BOOK
  ? {
      title: LATEST_BOOK.title,
      subtitle: LATEST_BOOK.subtitle ?? "",
      // Para el libro mostramos hasta 3 párrafos de la descripción
      // editorial (en lugar de uno solo clipeado a 320). Así el
      // editor ve cómo se ve un cuerpo de texto real con la
      // tipografía elegida — no solo dos renglones de muestra.
      descriptionParagraphs: stripMd(LATEST_BOOK.description_md).slice(0, 3),
      cover: LATEST_BOOK.cover_image_url ?? "",
      authors: pickAuthors(LATEST_BOOK.book_authors, 2),
      isbn: LATEST_BOOK.isbn ?? "",
      pages: LATEST_BOOK.pages ?? null,
      format: LATEST_BOOK.format ?? "",
      price: formatPriceCOP(LATEST_BOOK.price_amount, LATEST_BOOK.price_currency),
    }
  : null;
// Para la publicación elegimos un splitter por línea simple — así
// los poemas (verso por línea) preservan la estructura visual que
// muestra la página pública. En prosa con párrafos dobles cada
// línea queda como un párrafo aparte, lo que también sirve para la
// muestra. Tomamos hasta 12 líneas.
const POST_BODY_LINES = (() => {
  const lines = stripMdLines(LATEST_POST?.content_md).slice(0, 12);
  if (lines.length > 0) return lines;
  return stripMd(LATEST_POST?.content_md).slice(0, 4);
})();
const PUBLICATION_PV = LATEST_POST
  ? {
      title: LATEST_POST.title,
      subtitle: LATEST_POST.subtitle ?? "",
      body: POST_BODY_LINES.length > 0
        ? POST_BODY_LINES
        : [LATEST_POST.excerpt ?? "Aquí aparecerá el cuerpo de la publicación con la tipografía que elijas."],
      cover: LATEST_POST.cover_image_url ?? "",
      author: pickAuthors(LATEST_POST.post_authors, 1)[0] ?? null,
      authorBio: clip(stripMd(pickAuthors(LATEST_POST.post_authors, 1)[0]?.bio_md)[0], 180),
      category: LATEST_POST.category ?? null,
      publishedAt: formatDateLong(LATEST_POST.published_at),
      readingMin: LATEST_POST.reading_time_minutes ?? null,
    }
  : null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=site");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    // Cada panel (home, catalogo, articulos) tiene su propio <form>
    // y envía un hidden _panel para identificarse. El handler escribe
    // SOLO las claves de ese panel — el resto del site_configuration
    // queda intacto.
    const panel = str(fd, "_panel") ?? "home";

    if (panel === "catalogo") {
      const value = {
        title_font: str(fd, "book_detail_title_font") ?? "serif",
        body_font: str(fd, "book_detail_body_font") ?? "serif",
      };
      const { error } = await supabase
        .from("site_configuration")
        .upsert([{ key: "book_detail_typography", value }] as never, { onConflict: "key" });
      if (error) throw error;
      return Astro.redirect("/site?saved=1&action=updated&entity=site&publish=1&page=catalogo");
    }

    if (panel === "articulos") {
      const value = {
        title_font: str(fd, "article_detail_title_font") ?? "serif",
        body_font: str(fd, "article_detail_body_font") ?? "serif",
      };
      const { error } = await supabase
        .from("site_configuration")
        .upsert([{ key: "article_detail_typography", value }] as never, { onConflict: "key" });
      if (error) throw error;
      return Astro.redirect("/site?saved=1&action=updated&entity=site&publish=1&page=articulos");
    }

    // Default: panel === "home" → guarda toda la config de la home.
    const rows: Array<{ key: string; value: unknown }> = [
      { key: "hero_quote",                value: strReq(fd, "hero_quote") },
      { key: "hero_quote_author",         value: strReq(fd, "hero_quote_author") },
      { key: "editorial_description",     value: strReq(fd, "editorial_description") },
      { key: "footer_legal",              value: strReq(fd, "footer_legal") },
      { key: "whatsapp_phone",            value: strReq(fd, "whatsapp_phone") },
      { key: "whatsapp_message_template", value: strReq(fd, "whatsapp_message_template") },
      { key: "contact_email",             value: str(fd, "contact_email") ?? "" },
      { key: "contact_address",           value: str(fd, "contact_address") ?? "" },
      { key: "contact_hours",             value: str(fd, "contact_hours") ?? "" },
      { key: "contact_emails_extra",      value: parseJsonArray(fd, "contact_emails_extra_json") },
      { key: "contact_addresses_extra",   value: parseJsonArray(fd, "contact_addresses_extra_json") },
      { key: "contact_phones",            value: parseJsonArray(fd, "contact_phones_json") },
      { key: "social_accounts",           value: parseJsonArray(fd, "social_accounts_json") },
      {
        key: "social_links",
        value: {
          facebook: str(fd, "social_facebook") ?? "",
          instagram: str(fd, "social_instagram") ?? "",
          twitter: str(fd, "social_twitter") ?? "",
        },
      },
      { key: "default_keywords",      value: parseTags(fd, "default_keywords") },
      { key: "twitter_handle",        value: str(fd, "twitter_handle") ?? "" },
      { key: "og_image_default",      value: str(fd, "og_image_default") ?? "" },
      { key: "organization_logo_url", value: str(fd, "organization_logo_url") ?? "" },
      { key: "hero_image_url",            value: str(fd, "hero_image_url") ?? "" },
      { key: "hero_bg_color",             value: str(fd, "hero_bg_color") ?? "" },
      { key: "hero_title",                value: strReq(fd, "hero_title") },
      { key: "hero_tagline",              value: strReq(fd, "hero_tagline") },
      { key: "hero_cta_primary_label",    value: strReq(fd, "hero_cta_primary_label") },
      { key: "hero_cta_primary_href",     value: strReq(fd, "hero_cta_primary_href") },
      { key: "hero_cta_secondary_label",  value: strReq(fd, "hero_cta_secondary_label") },
      { key: "hero_cta_secondary_href",   value: strReq(fd, "hero_cta_secondary_href") },
      // book_detail_typography / article_detail_typography ya no se
      // tocan desde aquí: cada uno tiene su propio panel + form +
      // botón Guardar y se persiste por separado.
    ];

    const { error } = await supabase
      .from("site_configuration")
      .upsert(rows as never, { onConflict: "key" });
    if (error) throw error;

    return Astro.redirect("/site?saved=1&action=updated&entity=site&publish=1");
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Default hero card config — kept in sync with apps/web/src/lib/site-config.ts
// and migration 0030. Used when no value is persisted yet, and to fill
// missing keys from a partial save.
// Hero card font codes → CSS font-family. Mirror of HERO_CARD_FONTS
// in apps/web/src/lib/hero-card.ts. Used by the live preview.
const HERO_CARD_FONTS_MAP: Record<string, string> = {
  serif:               '"Cormorant Garamond", Georgia, serif',
  "eb-garamond":       '"EB Garamond", Georgia, serif',
  goudy:               '"Sorts Mill Goudy", "EB Garamond", Georgia, serif',
  playfair:            '"Playfair Display", Georgia, serif',
  lora:                '"Lora", Georgia, serif',
  "libre-baskerville": '"Libre Baskerville", Georgia, serif',
  crimson:             '"Crimson Pro", Georgia, serif',
  fraunces:            '"Fraunces", Georgia, serif',
  spectral:            '"Spectral", Georgia, serif',
  sans:                '"Inter", system-ui, -apple-system, sans-serif',
  "dm-sans":           '"DM Sans", "Inter", sans-serif',
  "space-grotesk":     '"Space Grotesk", "Inter", sans-serif',
  manrope:             '"Manrope", "Inter", sans-serif',
  "work-sans":         '"Work Sans", "Inter", sans-serif',
  "plus-jakarta":      '"Plus Jakarta Sans", "Inter", sans-serif',
  outfit:              '"Outfit", "Inter", sans-serif',
  marcellus:           '"Marcellus", "Cormorant Garamond", serif',
};

const DEFAULT_HERO_CARD = {
  content_source: "editorial",
  manual: {
    eyebrow: "Editorial",
    title: "Casa de Asterión Ediciones",
    body: "",
    cta_label: "Explorar el catálogo",
    cta_href: "/catalogo",
  },
  desktop: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    eyebrow_font: "sans",
    body_font: "sans",
    cta_font: "sans",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 760,
    height: 520,
    padding: 56,
    offset_x: 96,
    offset_y: 0,
    shadow: true,
  },
  mobile: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    eyebrow_font: "sans",
    body_font: "sans",
    cta_font: "sans",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 0,
    height: 280,
    padding: 24,
    offset_x: 16,
    offset_y: 32,
    shadow: true,
  },
};

---

<AppLayout title="Webpage" wide>
  {/* Layout 3-pane similar al de Categorías: sidebar (del AppLayout) +
      middle list panel con las sub-páginas + main con el contenido de
      la sub-página seleccionada. Negative margins anulan el padding del
      <main> del AppLayout para que el middle panel quede pegado al
      borde izquierdo y ocupe toda la altura. */}
  <div class="cas-site-shell md:flex -mx-5 md:-mx-8 lg:-mx-10 -my-6 md:-my-10 md:min-h-[calc(100vh-3.5rem)]">

  {/* Middle panel — list-panel style con las sub-páginas como filas. */}
  <aside class="cas-site-listpanel md:w-72 md:shrink-0 md:border-r border-stone-200 bg-white md:overflow-y-auto md:h-[calc(100vh-3.5rem)]">
    <div class="px-5 pt-6 pb-4 md:px-6 md:pt-7 md:pb-4 border-b border-stone-200">
      <h2 class="font-serif text-2xl mb-1">Webpage</h2>
      <p class="text-xs text-stone-500">
        Selecciona una sub-página para editar su contenido.
      </p>
    </div>
    <nav class="cas-pagenav-list" data-pagenav aria-label="Páginas del sitio">
      <button type="button" data-page-tab="home" class="cas-pagerow">
        <Icon name="lucide:home" class="w-4 h-4 shrink-0" aria-hidden="true" />
        <span class="flex-1 text-left">Home</span>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-stone-400 shrink-0" aria-hidden="true" />
      </button>
      <button type="button" data-page-tab="catalogo" class="cas-pagerow">
        <Icon name="lucide:book-open" class="w-4 h-4 shrink-0" aria-hidden="true" />
        <span class="flex-1 text-left">Catálogo</span>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-stone-400 shrink-0" aria-hidden="true" />
      </button>
      <button type="button" data-page-tab="articulos" class="cas-pagerow">
        <Icon name="lucide:newspaper" class="w-4 h-4 shrink-0" aria-hidden="true" />
        <span class="flex-1 text-left">Publicaciones</span>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-stone-400 shrink-0" aria-hidden="true" />
      </button>
      <button type="button" data-page-tab="autores" class="cas-pagerow">
        <Icon name="lucide:users" class="w-4 h-4 shrink-0" aria-hidden="true" />
        <span class="flex-1 text-left">Autores</span>
        <Icon name="lucide:chevron-right" class="w-4 h-4 text-stone-400 shrink-0" aria-hidden="true" />
      </button>
    </nav>
  </aside>

  {/* Right column: contenido de la sub-página activa. */}
  <div class="cas-site-main md:flex-1 md:min-w-0 md:overflow-y-auto md:h-[calc(100vh-3.5rem)]">
    <div class="px-5 py-6 md:px-8 md:py-8 lg:px-10">

  {/* Sticky inner tab nav (Hero / Editorial / Contacto / SEO) — only
      visible when the active sub-page is Home. */}
  <div class="cas-stickystack" data-stickystack>
  <nav class="cas-tabs flex items-stretch gap-1 border-b border-stone-200 overflow-x-auto bg-white" data-tab-nav data-page-only="home">
    <button type="button" data-tab="hero" class="cas-tab cas-tab-active">
      <Icon name="lucide:layout-panel-top" class="w-4 h-4" aria-hidden="true" />
      <span>Hero</span>
    </button>
    <button type="button" data-tab="editorial" class="cas-tab">
      <Icon name="lucide:scroll-text" class="w-4 h-4" aria-hidden="true" />
      <span>Editorial</span>
    </button>
    <button type="button" data-tab="contacto" class="cas-tab">
      <Icon name="lucide:phone" class="w-4 h-4" aria-hidden="true" />
      <span>Contacto</span>
    </button>
    <button type="button" data-tab="seo" class="cas-tab">
      <Icon name="lucide:search" class="w-4 h-4" aria-hidden="true" />
      <span>SEO</span>
    </button>
    <div class="md:hidden ml-auto flex items-center gap-1 pl-2 self-center" data-fullscreen-launchers>
      <button type="button" data-fullscreen-tab="desktop" class="cas-fs-btn" aria-label="Vista web a pantalla completa" title="Vista web a pantalla completa">
        <Icon name="lucide:monitor" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Web</span>
      </button>
      <button type="button" data-fullscreen-tab="mobile" class="cas-fs-btn" aria-label="Vista mobile a pantalla completa" title="Vista mobile a pantalla completa">
        <Icon name="lucide:smartphone" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Mobile</span>
      </button>
    </div>
  </nav>
  </div>{/* /.cas-stickystack */}

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <Icon name="lucide:lock" class="w-4 h-4" aria-hidden="true" />
      <span>Solo lectura — tienes permiso de ver pero no de editar la configuración del sitio.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  {/* Cada panel de "webpage" tiene su PROPIO form + botón Guardar para
      que los cambios sean independientes — guardar tipografía de libro
      no toca la home y viceversa. El handler POST identifica qué panel
      mandó la request leyendo el hidden _panel input y solo actualiza
      las claves relevantes. */}
  <div data-page-tab-panel="home">
  <form method="POST" data-site-form>
    <input type="hidden" name="_panel" value="home">
    <fieldset disabled={!canEdit} class="m-0 p-0 border-0 min-w-0">

      {/* === HERO TAB === */}
      {/* On <lg the aside (preview) goes first so the user sees changes
          immediately without scrolling. On lg+ we reorder so the preview
          sits on the right. */}
      <div data-tab-panel="hero" class="space-y-6 max-w-3xl">
        {/* Imagen y fondo */}
        <section class="card space-y-5">
          <CardHeader icon="lucide:image" title="Imagen del hero" desc="Foto que ocupa la mitad derecha en desktop y aparece debajo del contenido en mobile." />
          <div class="space-y-4">
            <div class="block min-w-0">
              <span class="label flex items-center gap-1.5">
                <Icon name="lucide:paint-bucket" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                Color de fondo del hero
              </span>
              <p class="hcc-hint mb-2">Color visible alrededor de la imagen. Pulsa la X para volver al color por defecto del sitio.</p>
              <ColorEditor
                hiddenName="hero_bg_color"
                defaultValue=""
                ariaLabel="Color de fondo del hero"
                editorId="hero-bg"
              />
            </div>
            <ImageUpload
              name="hero_image_url"
              label="Tu imagen"
              bucket="covers"
              hint="Click o arrastra. Recomendado: 2400×1600px o más, horizontal."
            />
            <div class="block min-w-0">
              <span class="label flex items-center justify-between gap-2">
                <span>Imagen por defecto</span>
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-sm bg-stone-100 text-stone-500 border border-stone-200" title="Esta imagen no se puede modificar desde el CMS">
                  <Icon name="lucide:lock" class="w-3 h-3" aria-hidden="true" />
                  Bloqueado
                </span>
              </span>
              <div class="relative flex items-stretch gap-4 border border-stone-200 bg-stone-50/60 p-3" data-hero-fallback>
                <div class="relative w-24 h-24 shrink-0 bg-stone-100 border border-stone-200 overflow-hidden">
                  <img src={HERO_FALLBACK_URL} alt="Imagen por defecto del hero" loading="lazy" class="w-full h-full object-cover" />
                </div>
                <div class="flex-1 min-w-0 flex flex-col justify-center text-sm text-stone-700">
                  <span class="inline-flex items-center gap-1.5 font-medium text-stone-800">
                    <Icon name="lucide:image" class="w-4 h-4" aria-hidden="true" />
                    <span>Foto editorial de respaldo</span>
                  </span>
                  <span class="text-xs text-stone-500 mt-1 leading-snug">Aparece automáticamente si no defines una propia.</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* Textos del hero */}
        <section class="card space-y-5">
          <CardHeader icon="lucide:type" title="Textos del hero" desc="Lo que se lee en la mitad izquierda del hero de la home." />
          <Field
            label="Título grande"
            name="hero_title"
            type="textarea"
            rows={3}
            required
            description="Una línea por renglón. Tres líneas funcionan bien (ej: Casa de / Asterión / Ediciones)."
          />
          <Field
            label="Frase debajo del título"
            name="hero_tagline"
            type="textarea"
            rows={3}
            required
            description="Frase única en cursiva debajo del título. Se muestra en serif italic."
          />
        </section>

        {/* CTAs */}
        <section class="card space-y-5">
          <CardHeader icon="lucide:mouse-pointer-click" title="Botones del hero" desc="Acciones que invitan al visitante a entrar al catálogo o leer las publicaciones." />
          <div class="space-y-4">
            <p class="label">Botón principal</p>
            <div class="grid sm:grid-cols-2 gap-4">
              <Field
                label="Texto"
                name="hero_cta_primary_label"
                required
                description="Ej: Entrar al catálogo."
              />
              <Field
                label="Enlace"
                name="hero_cta_primary_href"
                required
                description="Ruta interna (ej: /catalogo) o URL completa."
              />
            </div>
          </div>
          <div class="space-y-4 pt-4 border-t border-stone-100">
            <p class="label">Enlace secundario</p>
            <div class="grid sm:grid-cols-2 gap-4">
              <Field
                label="Texto"
                name="hero_cta_secondary_label"
                required
                description="Ej: Leer publicaciones."
              />
              <Field
                label="Enlace"
                name="hero_cta_secondary_href"
                required
                description="Ruta interna o URL completa."
              />
            </div>
          </div>
        </section>

        {/* Vista previa — replica fiel del hero público en formato web
            y mobile. La imagen del hero a la derecha (web) o debajo
            (mobile) viene del mismo input que el sitio público lee, así
            el editor ve exactamente lo que el visitante verá. */}
        <section class="card space-y-4" data-hero-preview>
          <CardHeader icon="lucide:eye" title="Vista previa" desc="Cómo se verá el hero en el sitio público mientras editas." />

          {/* Web (md+ del sitio público) */}
          <div>
            <p class="label flex items-center gap-1.5 mb-2">
              <Icon name="lucide:monitor" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
              Web
            </p>
            <div class="cas-hero-pv-web" data-pv-bg>
              <div class="cas-hero-pv-web-content">
                <h1 class="cas-hero-pv-title" data-pv-web-title></h1>
                <div class="cas-hero-pv-tagline-row">
                  <span class="cas-hero-pv-rule"></span>
                  <p class="cas-hero-pv-tagline" data-pv-web-tagline></p>
                </div>
                <div class="cas-hero-pv-ctas">
                  <a class="cas-hero-pv-cta-primary" data-pv-web-primary tabindex="-1" aria-disabled="true">
                    <span data-pv-web-primary-label></span>
                    <span class="cas-hero-pv-arrow-box">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 5 7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                  <a class="cas-hero-pv-cta-secondary" data-pv-web-secondary tabindex="-1" aria-disabled="true">
                    <span data-pv-web-secondary-label></span>
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="m13 5 7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
              <div class="cas-hero-pv-web-image" data-pv-image-web></div>
            </div>
          </div>

          {/* Mobile */}
          <div>
            <p class="label flex items-center gap-1.5 mb-2 mt-4">
              <Icon name="lucide:smartphone" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
              Mobile
            </p>
            <div class="cas-hero-pv-mobile-wrap">
              <div class="cas-hero-pv-mobile" data-pv-bg-mobile>
                <div class="cas-hero-pv-mobile-content">
                  <h1 class="cas-hero-pv-mobile-title" data-pv-mobile-title></h1>
                  <p class="cas-hero-pv-mobile-tagline" data-pv-mobile-tagline></p>
                  <span class="cas-hero-pv-mobile-closer"></span>
                  <a class="cas-hero-pv-mobile-cta-primary" data-pv-mobile-primary tabindex="-1" aria-disabled="true">
                    <span data-pv-mobile-primary-label></span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="m13 5 7 7-7 7" />
                    </svg>
                  </a>
                  <a class="cas-hero-pv-mobile-cta-secondary" data-pv-mobile-secondary tabindex="-1" aria-disabled="true">
                    <span data-pv-mobile-secondary-label></span>
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="m13 5 7 7-7 7" />
                    </svg>
                  </a>
                </div>
                <div class="cas-hero-pv-mobile-image" data-pv-image-mobile></div>
              </div>
            </div>
          </div>
        </section>
      </div>
      <div data-tab-panel="editorial" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:scroll-text" title="Editorial" desc="Información general que aparece en footer, meta tags y al compartir." />
          <Field label="Descripción de la editorial" name="editorial_description" type="textarea" rows={3} required description="Aparece en el footer y como meta description del sitio. 1-2 frases." />
          <Field label="Línea legal del footer" name="footer_legal" required description="Texto pequeño abajo del footer (ej: '© 2026 Casa de Asterión Ediciones')." />
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:quote" title="Cita destacada" desc="Aparece debajo del hero en la página de inicio, sobre fondo claro." />
          <Field label="Cita" name="hero_quote" type="textarea" rows={3} required description="Frase corta y elocuente. Sin comillas alrededor — el diseño las añade." />
          <Field label="Autor de la cita" name="hero_quote_author" required description="Nombre que firma la cita." />
        </section>
      </div>

      {/* === CONTACTO TAB === */}
      <div data-tab-panel="contacto" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:mail" title="Correos electrónicos" desc="El primer email se considera el principal. Puedes agregar todos los que necesites (prensa, ventas, derechos, etc.)." />
          <Field label="Email principal" name="contact_email" type="email" description="Aparece como primera tarjeta en /contacto." />
          <div class="cl-list" data-list-editor="contact_emails_extra" data-list-template="email">
            <div class="cl-list-rows" data-list-rows></div>
            <button type="button" class="cl-list-add" data-list-add>
              <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              Agregar otro correo
            </button>
            <input type="hidden" name="contact_emails_extra_json" data-list-json />
          </div>
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:map-pin" title="Direcciones" desc="Si tu editorial tiene varias sedes o apartado postal, agrégalos todos aquí." />
          <Field label="Dirección principal" name="contact_address" type="textarea" rows={2} description="Soporta varias líneas." />
          <div class="cl-list" data-list-editor="contact_addresses_extra" data-list-template="address">
            <div class="cl-list-rows" data-list-rows></div>
            <button type="button" class="cl-list-add" data-list-add>
              <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              Agregar otra dirección
            </button>
            <input type="hidden" name="contact_addresses_extra_json" data-list-json />
          </div>
          <Field label="Horario de atención" name="contact_hours" type="textarea" rows={2} description="Opcional. Ej: 'Lun a Vie · 9:00 — 18:00'." />
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:phone" title="Teléfonos y WhatsApp" desc="El número de compras (abajo) se usa en cada libro para abrir WhatsApp; los demás aparecen en /contacto." />
          <div class="cl-list" data-list-editor="contact_phones" data-list-template="phone">
            <div class="cl-list-rows" data-list-rows></div>
            <button type="button" class="cl-list-add" data-list-add>
              <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
              Agregar otro teléfono
            </button>
            <input type="hidden" name="contact_phones_json" data-list-json />
          </div>
          <div class="pt-4 border-t border-stone-100 space-y-4">
            <p class="label flex items-center gap-1.5">
              <Icon name="lucide:shopping-cart" class="w-3.5 h-3.5" aria-hidden="true" />
              WhatsApp dedicado a compras
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              <Field label="Número en formato E.164" name="whatsapp_phone" required description="Ej: +573117462759 (con + y código país)." />
            </div>
            <Field label="Plantilla del mensaje" name="whatsapp_message_template" type="textarea" rows={3} required description="Variables: {{title}}, {{author}}, {{isbn}}, {{slug}}. Se usa cuando un libro no define un mensaje propio." />
          </div>
        </section>

        <section class="card space-y-5">
          <CardHeader icon="lucide:share-2" title="Redes sociales" desc="Las tres principales (Facebook, Instagram, Twitter) se enlazan también desde el footer; las demás solo aparecen en /contacto." />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="block min-w-0">
              <label for="f-social_facebook" class="block">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:facebook" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Facebook
                </span>
              </label>
              <input id="f-social_facebook" type="url" name="social_facebook" class="input" placeholder="https://www.facebook.com/..." />
              <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">URL pública del perfil.</p>
            </div>
            <div class="block min-w-0">
              <label for="f-social_instagram" class="block">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:instagram" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Instagram
                </span>
              </label>
              <input id="f-social_instagram" type="url" name="social_instagram" class="input" placeholder="https://www.instagram.com/..." />
              <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">URL pública del perfil.</p>
            </div>
            <div class="block min-w-0">
              <label for="f-social_twitter" class="block">
                <span class="label flex items-center gap-1.5">
                  <Icon name="lucide:twitter" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
                  Twitter / X
                </span>
              </label>
              <input id="f-social_twitter" type="url" name="social_twitter" class="input" placeholder="https://x.com/..." />
              <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">URL pública del perfil.</p>
            </div>
          </div>
          <div class="pt-4 border-t border-stone-100">
            <p class="label">Otras redes / enlaces</p>
            <p class="hcc-hint mb-3">YouTube, LinkedIn, TikTok, sitio web, etc.</p>
            <div class="cl-list" data-list-editor="social_accounts" data-list-template="social">
              <div class="cl-list-rows" data-list-rows></div>
              <button type="button" class="cl-list-add" data-list-add>
                <Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" />
                Agregar otra red
              </button>
              <input type="hidden" name="social_accounts_json" data-list-json />
            </div>
          </div>
        </section>
      </div>

      {/* === SEO TAB === */}
      <div data-tab-panel="seo" class="space-y-6 max-w-3xl" hidden>
        <section class="card space-y-5">
          <CardHeader icon="lucide:search" title="SEO global y schema.org" desc="Defaults para cada página del sitio público y datos para JSON-LD." />
          <div class="grid sm:grid-cols-2 gap-4">
            <Field label="Palabras clave globales" name="default_keywords" description="Términos que describen la editorial. Separadas por coma." />
            <Field label="Handle de Twitter / X" name="twitter_handle" description="Con la @ inicial (ej: @casadeasterion)." />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <ImageUpload name="og_image_default" label="Imagen al compartir (Open Graph)" bucket="covers" hint="Click o arrastra. 1200×630px recomendado. Se usa cuando un post/libro no tiene portada." />
            <ImageUpload name="organization_logo_url" label="Logo de la editorial (JSON-LD)" bucket="covers" hint="Click o arrastra. Cuadrado o casi cuadrado. Lo lee Google." />
          </div>
        </section>
      </div>

      {canEdit && (
        <div
          class="sticky bottom-0 bg-white border-t border-stone-200 z-10 -mx-5 md:-mx-8 lg:-mx-10 -mb-6 md:-mb-10 mt-8"
          data-cas-form-bar
          data-cas-dirty-aware="1"
        >
          <div class="px-5 md:px-8 lg:px-10 py-3 flex items-center gap-3 flex-wrap">
            <button type="submit" class="btn-primary" disabled data-cas-save-btn data-submit-btn>Guardar configuración</button>
            {LAST_SITE_EDIT && formatAgo(LAST_SITE_EDIT.updated_at) && (
              <div class="text-xs text-stone-500 italic leading-tight">
                {LAST_SITE_EDIT.editor ? (
                  <>
                    <p class="m-0">
                      Editado por{" "}
                      <a
                        href={`/admins/${LAST_SITE_EDIT.editor.id}`}
                        class="underline decoration-stone-400 hover:text-stone-900 hover:decoration-current"
                        data-astro-prefetch
                        data-tooltip={fullName(LAST_SITE_EDIT.editor)}
                      >{fullName(LAST_SITE_EDIT.editor)}</a>
                    </p>
                    <p class="m-0 text-[10.5px] text-stone-400">
                      {formatAgo(LAST_SITE_EDIT.updated_at)}
                    </p>
                  </>
                ) : (
                  <p class="m-0">Última edición {formatAgo(LAST_SITE_EDIT.updated_at)}</p>
                )}
              </div>
            )}
          </div>
        </div>
      )}
      {!canEdit && LAST_SITE_EDIT && formatAgo(LAST_SITE_EDIT.updated_at) && (
        <div class="sticky bottom-0 bg-white border-t border-stone-200 z-10 -mx-5 md:-mx-8 lg:-mx-10 -mb-6 md:-mb-10 mt-8">
          <div class="px-5 md:px-8 lg:px-10 py-3 flex items-center gap-3 flex-wrap">
            <div class="text-xs text-stone-500 italic leading-tight">
              {LAST_SITE_EDIT.editor ? (
                <p class="m-0">
                  Editado por <a href={`/admins/${LAST_SITE_EDIT.editor.id}`} class="underline decoration-stone-400 hover:text-stone-900 hover:decoration-current">{fullName(LAST_SITE_EDIT.editor)}</a> {formatAgo(LAST_SITE_EDIT.updated_at)}
                </p>
              ) : (
                <p class="m-0">Última edición {formatAgo(LAST_SITE_EDIT.updated_at)}</p>
              )}
            </div>
          </div>
        </div>
      )}
    </fieldset>
  </form>

  </div>{/* /[data-page-tab-panel="home"] */}

  {/* === Catálogo > Libro =================================================
       Form independiente con su propio botón Guardar. El POST handler
       lee el hidden _panel para saber que viene de aquí y solo escribe
       book_detail_typography. La home queda intacta. El min-h-[...] +
       flex-col + spacer hacen que la barra del botón quede pegada al
       borde inferior del viewport aunque el contenido sea corto. */}
  <div data-page-tab-panel="catalogo" hidden class="flex flex-col min-h-[calc(100vh-180px)]">
    <form method="POST" class="flex flex-col flex-1 space-y-6">
      <input type="hidden" name="_panel" value="catalogo">
      <fieldset disabled={!canEdit} class="m-0 p-0 border-0 min-w-0">
        <DetailTypographyPanel
          icon="lucide:book-open"
          title="Libro"
          description="Tipografía de la ficha individual de cada libro en /catalogo/[slug]. Aplica al título y a la descripción de TODOS los libros."
          namePrefix="book_detail"
          titleLabel="Tipo de letra del título"
          bodyLabel="Tipo de letra de la descripción"
          titleFont={BOOK_DETAIL_TYPO.title_font}
          bodyFont={BOOK_DETAIL_TYPO.body_font}
          scopeNote="Estos ajustes son globales: cambian la tipografía de todos los libros del catálogo a la vez, no de un libro en particular."
        />
      </fieldset>

      {/* === Preview de la ficha de libro ====================================
           Mirror visual de /catalogo/[slug] con el último libro publicado
           como referencia: breadcrumb, grid 2 columnas (cover + autor +
           metadata a la izq, título + descripción + CTA a la der), CTA
           "Agregar al carrito" con icon. Las fuentes del título y de la
           descripción cambian en vivo cuando el editor toca los
           dropdowns de arriba. */}
      <section
        class="card space-y-3"
        data-book-detail-preview
        style={`--pv-title-font: ${resolveFontFamily(BOOK_DETAIL_TYPO.title_font)}; --pv-body-font: ${resolveFontFamily(BOOK_DETAIL_TYPO.body_font)};`}
      >
        <CardHeader icon="lucide:eye" title="Vista previa" desc={LATEST_BOOK ? `Cómo se verá la ficha del libro «${LATEST_BOOK.title}» con las tipografías que elijas.` : "Mostramos un libro de muestra. Aparecerá uno real cuando haya un libro publicado."} />
        <div class="cas-detail-pv cas-detail-pv-book-frame">
          {/* Breadcrumb */}
