            </p>
            <h1 class="cas-detail-pv-title cas-detail-pv-title--publication" data-pv-publication-title>{PUBLICATION_PV?.title ?? "Título de la publicación"}</h1>
            {PUBLICATION_PV?.subtitle && (
              <p class="cas-detail-pv-subtitle cas-detail-pv-subtitle--publication" data-pv-publication-subtitle>{PUBLICATION_PV.subtitle}</p>
            )}
          </header>
          <hr class="cas-detail-pv-divider" />
          {/* Body row */}
          <div class="cas-detail-pv-publication-row">
            <aside class="cas-detail-pv-publication-aside">
              {PUBLICATION_PV?.cover ? (
                <img src={PUBLICATION_PV.cover} alt="" class="cas-detail-pv-cover cas-detail-pv-cover--publication" />
