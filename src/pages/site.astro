  .hcc-cp-edit-link:hover { color: rgb(28 25 23); }

  /* === Contact list editor (emails / phones / addresses / social) === */
  .cl-list { display: flex; flex-direction: column; gap: 0.625rem; }
  .cl-list-rows { display: flex; flex-direction: column; gap: 0.625rem; }
  .cl-list-rows:empty { display: none; }
  .cl-row {
    display: grid;
    grid-template-columns: 1fr auto;
