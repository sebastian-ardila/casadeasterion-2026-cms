---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import AiSuggest from "~/components/AiSuggest.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import GalleryUpload from "~/components/GalleryUpload.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags, jsonStringArray } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "posts", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/posts");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=posts");
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");
    if (action === "delete") {
      const { data: existingRow } = await supabase.from("posts").select("status").eq("id", id).single();
      const wasPublished = existingRow?.status === "published";
      const { error } = await supabase.from("posts").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect(`/posts?saved=1&action=deleted&entity=post${wasPublished ? "&publish=1" : ""}`);
    }

    const newStatus = str(fd, "status") ?? "draft";
    const content_md = strReq(fd, "content_md");
    const update: Record<string, unknown> = {
      title: strReq(fd, "title"),
      slug: strReq(fd, "slug"),
      subtitle: str(fd, "subtitle"),
      excerpt: str(fd, "excerpt"),
      content_md,
      cover_image_url: str(fd, "cover_image_url"),
      category_id: str(fd, "category_id"),
      author_id: str(fd, "author_id"),
      status: newStatus,
      reading_time_minutes:
        num(fd, "reading_time_minutes") ??
        Math.max(1, Math.round(content_md.split(/\s+/).length / 220)),
      meta_description: str(fd, "meta_description"),
      tags: parseTags(fd, "tags"),
      keywords: parseTags(fd, "keywords"),
      canonical_url: str(fd, "canonical_url"),
      cover_image_alt: str(fd, "cover_image_alt"),
      gallery_urls: jsonStringArray(fd, "gallery_urls"),
    };

    const { data: existing } = await supabase
      .from("posts").select("published_at, status").eq("id", id).single();
    if (newStatus === "published" && !existing?.published_at) {
      update.published_at = new Date().toISOString();
    }

    const { error } = await supabase.from("posts").update(update).eq("id", id);
    if (error) throw error;
    const triggersRebuild = newStatus === "published" || existing?.status === "published";
    return Astro.redirect(`/posts/${id}?saved=1&action=updated&entity=post${triggersRebuild ? "&publish=1" : ""}`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Run all SSR fetches in parallel — single round trip instead of two.
const [postRes, authorsRes, categoriesRes] = await Promise.all([
  supabase.from("posts").select("*").eq("id", id).maybeSingle(),
  supabase.from("authors").select("id, name, photo_url").order("name"),
  supabase.from("categories").select("id, name").order("name"),
]);
const post = postRes.data;
const authors = authorsRes.data;
const categories = categoriesRes.data;
if (!post) return Astro.redirect("/posts");

const authorOptions = [
  { value: "", label: "Sin autor", iconStyle: "person" as const },
  ...(authors ?? []).map((a) => ({
    value: a.id,
    label: a.name,
    imageUrl: a.photo_url ?? null,
    iconStyle: "person" as const,
  })),
];
const categoryOptions = [
  { value: "", label: "Sin categoría" },
  ...(categories ?? []).map((c) => ({ value: c.id, label: c.name })),
];
const statusOptions = [
  { value: "draft", label: "Borrador", hint: "no visible al público" },
  { value: "published", label: "Publicado", hint: "dispara rebuild" },
];
---

<AppLayout title={post.title} resource="posts" activeId={post.id} breadcrumbLabel={post.title}>

  <BackToList href="/posts" label="Artículos" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{post.title}</h1>
    <p class="text-stone-500 text-xs">/{post.slug} · actualizado {new Date(post.updated_at).toLocaleString("es-CO")}</p>
  </header>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar este artículo.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-5xl">
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad del artículo</h2>
        <p class="card-section-desc">Cómo se nombra y se encuentra el artículo en el sitio.</p>
      </div>
      <Field label="Título" name="title" value={post.title} required description="El encabezado principal que verán los lectores." />
      <Field label="Slug" name="slug" value={post.slug} required description="Identificador único en la URL: /articulos/<slug>. Solo minúsculas, números y guiones." />
      <Field label="Subtítulo" name="subtitle" value={post.subtitle} description="Aparece debajo del título en la página del artículo. Opcional." />
      <Field label="Resumen (excerpt)" name="excerpt" type="textarea" rows={3} value={post.excerpt} description="Texto corto que se muestra en tarjetas de listado y en redes sociales." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Imagen y galería</h2>
        <p class="card-section-desc">Visuales del artículo. Las imágenes se convierten automáticamente a WebP.</p>
      </div>
      <ImageUpload name="cover_image_url" value={post.cover_image_url} label="Imagen de portada" bucket="covers" />
      <GalleryUpload name="gallery_urls" value={post.gallery_urls} label="Galería de imágenes" bucket="content" hint="Imágenes adicionales del artículo (aparte de la portada). Arrastra para reordenar." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Clasificación</h2>
        <p class="card-section-desc">Asocia el artículo a un autor y a una categoría del menú.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="cell-stack">
          <span class="label">Autor</span>
          <Dropdown name="author_id" value={post.author_id ?? ""} options={authorOptions} placeholder="Sin autor" />
        </div>
        <div class="cell-stack">
          <span class="label">Categoría</span>
          <Dropdown name="category_id" value={post.category_id ?? ""} options={categoryOptions} placeholder="Sin categoría" />
        </div>
      </div>
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Contenido</h2>
        <p class="card-section-desc">Markdown con barra de herramientas. Pega o arrastra imágenes para subirlas en el momento.</p>
      </div>
      <MarkdownEditor name="content_md" value={post.content_md} label="" required />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Metadatos y estado</h2>
        <p class="card-section-desc">Información complementaria para visibilidad y si el artículo es visible.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <Field label="Tiempo (min)" name="reading_time_minutes" type="number" value={post.reading_time_minutes} description="Vacío = se calcula del contenido." />
        <Field label="Tags" name="tags" value={post.tags?.join(", ")} description="Etiquetas internas para organización en el CMS." />
        <div class="cell-stack">
          <span class="label">Estado</span>
          <Dropdown name="status" value={post.status} options={statusOptions} />
        </div>
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">SEO y redes sociales</h2>
        <p class="card-section-desc">Cómo aparece en Google y al compartir.</p>
      </div>
      <AiSuggest kind="post" contentField="content_md" />
      <Field label="Meta description" name="meta_description" type="textarea" rows={2} value={post.meta_description} description="Descripción que aparece en buscadores y al compartir el enlace. Recomendado: 140-160 caracteres. Si la dejas vacía, se usa el resumen." />
      <Field label="Palabras clave (SEO)" name="keywords" value={post.keywords?.join(", ")} description="Términos por los que esperas que la gente encuentre este artículo. Separadas por coma. Distintas a las tags internas — estas son visibles a buscadores." />
      <Field label="Texto alt de la imagen de portada" name="cover_image_alt" value={post.cover_image_alt} description="Descripción de la imagen para lectores de pantalla y SEO de imágenes. Si la dejas vacía, se usa el título del artículo." />
      <Field label="URL canónica" name="canonical_url" type="url" value={post.canonical_url} description="Solo si publicaste el mismo contenido en otro lado. Apunta a la versión original para evitar penalización por contenido duplicado." />
    </section>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-3 pt-4 border-t border-stone-200">
      {canEdit ? (
        <>
          <button type="submit" class="btn-primary">Guardar</button>
          <a href="/posts" class="btn">Cancelar</a>
        </>
      ) : (
        <a href="/posts" class="btn">Volver a la lista</a>
      )}
    </div>
    </fieldset>
  </form>

  {canEdit && (
  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-5xl"
    onsubmit="return confirm('¿Borrar este artículo? No se puede deshacer.')"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar artículo</button>
  </form>
  )}
</AppLayout>
