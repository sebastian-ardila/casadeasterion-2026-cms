---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import AiSuggest from "~/components/AiSuggest.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import GalleryUpload from "~/components/GalleryUpload.astro";
import MultiAuthorPicker from "~/components/MultiAuthorPicker.astro";
import FormActions from "~/components/FormActions.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags, jsonStringArray, slugify } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import { parseAuthorIds, syncPostAuthors, syncPostCollaborators } from "~/lib/multi-author";

const guard = await requirePermission(Astro, "posts", "edit");
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const title = strReq(fd, "title");
    const slug = str(fd, "slug") ?? slugify(title);
    const status = str(fd, "status") ?? "draft";
    const content_md = strReq(fd, "content_md");

    const reading = Math.max(1, Math.round(content_md.split(/\s+/).length / 220));

    // author_id intentionally omitted: it's set by a Postgres trigger
    // from the post_authors junction (synced below). book_id is the
    // optional parent book link.
    const { data, error } = await supabase
      .from("posts")
      .insert({
        title,
        slug,
        subtitle: str(fd, "subtitle"),
        excerpt: str(fd, "excerpt"),
        content_md,
        cover_image_url: str(fd, "cover_image_url"),
        category_id: str(fd, "category_id"),
        book_id: str(fd, "book_id"),
        status,
        published_at: status === "published" ? new Date().toISOString() : null,
        reading_time_minutes: num(fd, "reading_time_minutes") ?? reading,
        meta_description: str(fd, "meta_description"),
        tags: parseTags(fd, "tags"),
        keywords: parseTags(fd, "keywords"),
        canonical_url: str(fd, "canonical_url"),
        cover_image_alt: str(fd, "cover_image_alt"),
        gallery_urls: jsonStringArray(fd, "gallery_urls"),
      })
      .select("id")
      .single();
    if (error) throw error;
    await syncPostAuthors(supabase, data.id, parseAuthorIds(fd, "author_ids"));
    await syncPostCollaborators(supabase, data.id, parseAuthorIds(fd, "collaborator_ids"));
    const willPublish = status === "published";
    return Astro.redirect(`/posts/${data.id}?saved=1&action=created&entity=post${willPublish ? "&publish=1" : ""}`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const [{ data: authorsData }, { data: collaboratorsData }, { data: categories }, { data: booksData }] = await Promise.all([
  supabase.from("authors").select("id, name, photo_url").order("name"),
  supabase.from("collaborators").select("id, name, photo_url").order("name"),
  supabase.from("categories").select("id, name, icon").order("name"),
  supabase.from("books").select("id, title").eq("status", "published").order("title"),
]);
const authors = authorsData ?? [];
const collaborators = collaboratorsData ?? [];
const books = booksData ?? [];
const categoryOptions = [
  { value: "", label: "Sin categoría" },
  ...(categories ?? []).map((c) => ({
    value: c.id,
    label: c.name,
    icon: c.icon ? `lucide:${c.icon}` : undefined,
  })),
];
const bookOptions = [
  { value: "", label: "No pertenece a un libro" },
  ...books.map((b) => ({ value: b.id, label: b.title, icon: "lucide:book-open" })),
];
const statusOptions = [
  { value: "draft", label: "Borrador", hint: "no visible al público" },
  { value: "published", label: "Publicado", hint: "dispara rebuild" },
];
---

<AppLayout title="Nueva publicación" resource="posts">
  <BackToList href="/posts" label="Publicaciones" />
  <h1 class="font-serif text-3xl md:text-4xl mb-8">Nueva publicación</h1>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad de la publicación</h2>
        <p class="card-section-desc">Cómo se nombra y se encuentra la publicación en el sitio.</p>
      </div>
      <Field label="Título" name="title" required description="El encabezado principal que verán los lectores." />
      <Field label="Slug" name="slug" description="Se autogenera del título si lo dejas vacío. Aparece en la URL: /articulos/<slug>." />
      <Field label="Subtítulo" name="subtitle" description="Aparece debajo del título en la página de la publicación. Opcional." />
      <Field label="Resumen (excerpt)" name="excerpt" type="textarea" rows={3} description="Texto corto que se muestra en tarjetas de listado y al compartir en redes." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Imagen y galería</h2>
        <p class="card-section-desc">Las imágenes se convierten automáticamente a WebP al subirlas.</p>
      </div>
      <ImageUpload name="cover_image_url" label="Imagen de portada" bucket="covers" />
      <GalleryUpload name="gallery_urls" label="Galería de imágenes" bucket="content" hint="Imágenes adicionales (aparte de la portada)." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Clasificación</h2>
        <p class="card-section-desc">Asocia la publicación a autores, colaboradores, una categoría del menú, y opcionalmente a un libro.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="cell-stack">
          <MultiAuthorPicker
            name="author_ids"
            label="Autores"
            authors={authors}
            selectedIds={[]}
          />
        </div>
        <div class="cell-stack">
          <MultiAuthorPicker
            name="collaborator_ids"
            label="Colaboradores"
            authors={collaborators}
            selectedIds={[]}
          />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="cell-stack flex flex-col gap-2">
          <span class="label">Categoría</span>
          <Dropdown name="category_id" options={categoryOptions} placeholder="Sin categoría" />
        </div>
        <div class="cell-stack flex flex-col gap-2">
          <span class="label">Pertenece a un libro</span>
          <Dropdown name="book_id" options={bookOptions} placeholder="No pertenece a un libro" />
        </div>
      </div>
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Contenido</h2>
        <p class="card-section-desc">Markdown con barra de herramientas. Pega o arrastra imágenes para subirlas.</p>
      </div>
      <MarkdownEditor name="content_md" label="" required />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Metadatos y estado</h2>
        <p class="card-section-desc">Información complementaria y si la publicación es visible al público.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <Field label="Tiempo (min)" name="reading_time_minutes" type="number" description="Vacío = se calcula del contenido." />
        <Field label="Tags" name="tags" description="Etiquetas internas para organización en el CMS." />
        <div>
          <span class="label">Estado</span>
          <Dropdown name="status" value="draft" options={statusOptions} />
        </div>
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">SEO y redes sociales</h2>
        <p class="card-section-desc">Cómo aparece en Google y al compartir.</p>
      </div>
      <AiSuggest kind="post" contentField="content_md" />
      <Field label="Meta description" name="meta_description" type="textarea" rows={2} description="Aparece en buscadores y al compartir. 140-160 caracteres recomendado. Vacío = usa el resumen." />
      <Field label="Palabras clave (SEO)" name="keywords" description="Términos por los que esperas que la gente encuentre esta publicación. Separadas por coma." />
      <Field label="Texto alt de la imagen de portada" name="cover_image_alt" description="Descripción de la imagen para lectores de pantalla y SEO." />
      <Field label="URL canónica" name="canonical_url" type="url" description="Solo si publicaste el mismo contenido en otro lado. Apunta a la versión original." />
    </section>

    <FormActions cancelHref="/posts" saveLabel="Crear publicación" />
  </form>
</AppLayout>
