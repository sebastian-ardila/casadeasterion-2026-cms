---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import GalleryUpload from "~/components/GalleryUpload.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags, jsonStringArray, slugify } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "posts", "edit");
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const title = strReq(fd, "title");
    const slug = str(fd, "slug") ?? slugify(title);
    const status = str(fd, "status") ?? "draft";
    const content_md = strReq(fd, "content_md");

    const reading = Math.max(1, Math.round(content_md.split(/\s+/).length / 220));

    const { data, error } = await supabase
      .from("posts")
      .insert({
        title,
        slug,
        subtitle: str(fd, "subtitle"),
        excerpt: str(fd, "excerpt"),
        content_md,
        cover_image_url: str(fd, "cover_image_url"),
        category_id: str(fd, "category_id"),
        author_id: str(fd, "author_id"),
        status,
        published_at: status === "published" ? new Date().toISOString() : null,
        reading_time_minutes: num(fd, "reading_time_minutes") ?? reading,
        meta_description: str(fd, "meta_description"),
        tags: parseTags(fd, "tags"),
        gallery_urls: jsonStringArray(fd, "gallery_urls"),
      })
      .select("id")
      .single();
    if (error) throw error;
    const willPublish = status === "published";
    return Astro.redirect(`/posts/${data.id}${willPublish ? "?published=1" : ""}`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const [{ data: authors }, { data: categories }] = await Promise.all([
  supabase.from("authors").select("id, name").order("name"),
  supabase.from("categories").select("id, name, kind").order("name"),
]);

const authorOptions = [
  { value: "", label: "Sin autor" },
  ...(authors ?? []).map((a) => ({ value: a.id, label: a.name })),
];
const categoryOptions = [
  { value: "", label: "Sin categoría" },
  ...(categories ?? []).map((c) => ({ value: c.id, label: c.name })),
];
const statusOptions = [
  { value: "draft", label: "Borrador", hint: "no visible al público" },
  { value: "published", label: "Publicado", hint: "dispara rebuild" },
];
---

<AppLayout title="Nuevo artículo" resource="posts">
  <BackToList href="/posts" label="Artículos" />
  <h1 class="font-serif text-3xl md:text-4xl mb-8">Nuevo artículo</h1>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-5xl">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad del artículo</h2>
        <p class="card-section-desc">Cómo se nombra y se encuentra el artículo en el sitio.</p>
      </div>
      <Field label="Título" name="title" required description="El encabezado principal que verán los lectores." />
      <Field label="Slug" name="slug" description="Se autogenera del título si lo dejas vacío. Aparece en la URL: /articulos/<slug>." />
      <Field label="Subtítulo" name="subtitle" description="Aparece debajo del título en la página del artículo. Opcional." />
      <Field label="Resumen (excerpt)" name="excerpt" type="textarea" rows={3} description="Texto corto que se muestra en tarjetas de listado y al compartir en redes." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Imagen y galería</h2>
        <p class="card-section-desc">Las imágenes se convierten automáticamente a WebP al subirlas.</p>
      </div>
      <ImageUpload name="cover_image_url" label="Imagen de portada" bucket="covers" />
      <GalleryUpload name="gallery_urls" label="Galería de imágenes" bucket="content" hint="Imágenes adicionales del artículo (aparte de la portada)." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Clasificación</h2>
        <p class="card-section-desc">Asocia el artículo a un autor y a una categoría del menú.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <span class="label">Autor</span>
          <Dropdown name="author_id" options={authorOptions} placeholder="Sin autor" />
        </div>
        <div>
          <span class="label">Categoría</span>
          <Dropdown name="category_id" options={categoryOptions} placeholder="Sin categoría" />
        </div>
      </div>
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Contenido</h2>
        <p class="card-section-desc">Markdown con barra de herramientas. Pega o arrastra imágenes para subirlas.</p>
      </div>
      <MarkdownEditor name="content_md" label="" required />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Metadatos y estado</h2>
        <p class="card-section-desc">Información complementaria para SEO y si el artículo es visible al público.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <Field label="Tiempo (min)" name="reading_time_minutes" type="number" description="Vacío = se calcula del contenido." />
        <Field label="Tags" name="tags" description="Etiquetas, separadas por coma." />
        <div>
          <span class="label">Estado</span>
          <Dropdown name="status" value="draft" options={statusOptions} />
        </div>
      </div>
      <Field label="Meta description (SEO)" name="meta_description" type="textarea" rows={2} description="Aparece en buscadores y al compartir. Máx. 160 caracteres recomendado." />
    </section>

    <div class="flex flex-col sm:flex-row gap-3 pt-4">
      <button type="submit" class="btn-primary">Crear artículo</button>
      <a href="/posts" class="btn">Cancelar</a>
    </div>
  </form>
</AppLayout>
