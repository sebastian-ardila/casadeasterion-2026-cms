---
import AppLayout from "~/layouts/AppLayout.astro";
import { requirePermission } from "~/lib/auth";

const guard = await requirePermission(Astro, "posts", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";
---

<AppLayout title="Artículos" resource="posts">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500">
    <p class="font-serif text-xl mb-2">Artículos</p>
    <p class="text-sm mb-6">Selecciona un artículo de la lista{canEdit && " o crea uno nuevo"}.</p>
    {canEdit && (
      <a href="/posts/new" class="btn-primary">+ Nuevo artículo</a>
    )}
  </div>
</AppLayout>
