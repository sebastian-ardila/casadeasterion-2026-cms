---
import AppLayout from "~/layouts/AppLayout.astro";
import CardHeader from "~/components/CardHeader.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import { Icon } from "astro-icon/components";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "site", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=site");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    const raw = fd.get("hero_card_config_json")?.toString() ?? "{}";
    const cfg = JSON.parse(raw);
    if (!cfg || typeof cfg !== "object" || !cfg.content_source || !cfg.desktop || !cfg.mobile) {
      throw new Error("La configuración no tiene la forma esperada.");
    }
    const { error } = await supabase
      .from("site_configuration")
      .upsert([{ key: "hero_card_config", value: cfg }], { onConflict: "key" });
    if (error) throw error;
    return Astro.redirect("/hero-card?saved=1&action=updated&entity=site&publish=1");
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Renders the per-platform style controls (color, blur, radii, size,
// position, font, shadow). Both "desktop" and "mobile" use the same
// shape so we generate them from a single helper.
function renderPlatformControls(p: "desktop" | "mobile"): string {
  return `
    <div>
      <label class="label">Fondo</label>
      <div class="grid sm:grid-cols-2 gap-3">
        <div class="color-row">
          <input type="color" data-bind="${p}.bg_color" />
          <input type="text" data-bind-mirror="${p}.bg_color" class="cas-input flex-1" placeholder="#1a1715" disabled />
        </div>
        <div>
          <label class="label" style="margin-top:0">Opacidad del color</label>
          <div class="color-row">
            <input type="range" data-bind="${p}.bg_alpha" min="0" max="1" step="0.05" class="flex-1" />
            <input type="number" data-bind-mirror="${p}.bg_alpha" min="0" max="1" step="0.05" class="cas-input w-16" disabled />
          </div>
        </div>
      </div>
      <p class="hint mt-1">Si subes una imagen de fondo abajo, este color actúa como overlay encima.</p>
    </div>

    <div>
      <label class="label">Blur del fondo (px)</label>
      <div class="color-row">
        <input type="range" data-bind="${p}.bg_blur" min="0" max="40" step="1" class="flex-1" />
        <input type="number" data-bind-mirror="${p}.bg_blur" min="0" max="40" step="1" class="cas-input w-16" disabled />
      </div>
      <p class="hint mt-1">Aplica blur a lo que está detrás de la card (efecto frosted glass — útil con opacidad &lt; 1).</p>
    </div>

    <div>
      <label class="label">Color del texto</label>
      <div class="color-row">
        <input type="color" data-bind="${p}.text_color" />
        <input type="text" data-bind-mirror="${p}.text_color" class="cas-input flex-1" placeholder="#f5f1ea" disabled />
      </div>
    </div>

    <div>
      <label class="label">Tipografía del título</label>
      <select data-bind="${p}.title_font" class="cas-input w-full">
        <option value="serif">Serif (Cormorant Garamond)</option>
        <option value="sans">Sans (Inter)</option>
      </select>
    </div>

    <div>
      <label class="label">Bordes redondeados (px) — por esquina</label>
      <div class="num-row">
        <div><label>Sup. izq.</label><input type="number" data-bind="${p}.border_radius_tl" min="0" max="200" class="cas-input w-full" /></div>
        <div><label>Sup. der.</label><input type="number" data-bind="${p}.border_radius_tr" min="0" max="200" class="cas-input w-full" /></div>
        <div><label>Inf. der.</label><input type="number" data-bind="${p}.border_radius_br" min="0" max="200" class="cas-input w-full" /></div>
        <div><label>Inf. izq.</label><input type="number" data-bind="${p}.border_radius_bl" min="0" max="200" class="cas-input w-full" /></div>
      </div>
    </div>

    <div>
      <label class="label">Tamaño y padding (px)</label>
      <div class="num-row">
        <div><label>Ancho</label><input type="number" data-bind="${p}.width" min="0" max="1400" class="cas-input w-full" /></div>
        <div><label>Alto mínimo</label><input type="number" data-bind="${p}.height" min="0" max="1000" class="cas-input w-full" /></div>
        <div><label>Padding interno</label><input type="number" data-bind="${p}.padding" min="0" max="120" class="cas-input w-full" /></div>
        <div></div>
      </div>
      <p class="hint mt-1">Ancho = 0 → la card se adapta al contenedor (recomendado para mobile).</p>
    </div>

    <div>
      <label class="label">Posición (offset desde el centro vertical / borde izquierdo)</label>
      <div class="num-row">
        <div><label>Offset X</label><input type="number" data-bind="${p}.offset_x" min="-400" max="1000" class="cas-input w-full" /></div>
        <div><label>Offset Y</label><input type="number" data-bind="${p}.offset_y" min="-300" max="300" class="cas-input w-full" /></div>
        <div></div>
        <div></div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <input type="checkbox" data-bind="${p}.shadow" id="${p}-shadow" class="w-4 h-4" />
      <label for="${p}-shadow" class="text-sm">Sombra</label>
    </div>
  `;
}

// Default config — kept in sync with apps/web/src/lib/site-config.ts and
// migration 0030_hero_card_config.sql. Used to render the form's initial
// state when no value exists yet, and to fill any missing keys when the
// persisted config is partial.
const DEFAULT_CFG = {
  content_source: "editorial",
  manual: {
    eyebrow: "Editorial",
    title: "Casa de Asterión Ediciones",
    body: "",
    cta_label: "Explorar el catálogo",
    cta_href: "/catalogo",
  },
  desktop: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 760,
    height: 520,
    padding: 56,
    offset_x: 96,
    offset_y: 0,
    shadow: true,
  },
  mobile: {
    bg_color: "#1a1715",
    bg_alpha: 1,
    bg_image_url: "",
    bg_blur: 0,
    text_color: "#f5f1ea",
    title_font: "serif",
    border_radius_tl: 0,
    border_radius_tr: 0,
    border_radius_br: 0,
    border_radius_bl: 0,
    width: 0,
    height: 280,
    padding: 24,
    offset_x: 16,
    offset_y: 32,
    shadow: true,
  },
};
---

<AppLayout title="Card del hero">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl md:text-4xl mb-2">Card del hero</h1>
      <p class="text-stone-500 max-w-2xl">
        Lo que aparece en el recuadro principal del homepage. Cambia el contenido, el color, la
        imagen de fondo, los bordes redondeados, el tamaño y la posición — separado para web y
        mobile. El preview a la izquierda se actualiza en tiempo real.
      </p>
    </div>
    <a href="/site" class="text-stone-500 hover:text-stone-900 transition text-sm flex items-center gap-1.5 shrink-0 mt-1">
      <Icon name="lucide:arrow-left" class="w-4 h-4" aria-hidden="true" />
      <span>Configuración</span>
    </a>
  </div>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <Icon name="lucide:lock" class="w-4 h-4" aria-hidden="true" />
      <span>Solo lectura — no tienes permiso para editar la configuración del sitio.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <div class="grid lg:grid-cols-[minmax(0,1fr)_440px] gap-6 items-start">

    {/* === Preview pane === */}
    <section class="lg:sticky lg:top-6">
      <div class="flex items-center gap-2 mb-3">
        <button type="button" data-preview-tab="desktop" class="cas-preview-tab cas-preview-tab-active inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium uppercase tracking-wider rounded-sm border">
          <Icon name="lucide:monitor" class="w-3.5 h-3.5" aria-hidden="true" />
          Web
        </button>
        <button type="button" data-preview-tab="mobile" class="cas-preview-tab inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium uppercase tracking-wider rounded-sm border">
          <Icon name="lucide:smartphone" class="w-3.5 h-3.5" aria-hidden="true" />
          Mobile
        </button>
        <span class="ml-auto text-[11px] uppercase tracking-wider text-stone-400" data-preview-meta>desktop · 1440 × 720</span>
      </div>

      <div class="cas-preview-frame border border-stone-200 bg-stone-100 overflow-hidden" data-preview-frame>
        {/* Mock public site bg-alt */}
        <div class="relative w-full h-full" data-preview-stage>
          {/* Right-half hero image (desktop) */}
          <div data-preview-bg-image class="absolute top-0 right-0 h-full w-1/2 bg-cover bg-center pointer-events-none"></div>

          {/* Card */}
          <a data-preview-card class="absolute z-10 block flex flex-col justify-between" target="_blank" rel="noopener noreferrer">
            <div>
              <p data-preview-eyebrow class="uppercase tracking-[0.2em] opacity-70 mb-3"></p>
              <h1 data-preview-title class="leading-[1.1] mb-3"></h1>
              <p data-preview-body class="opacity-80 leading-relaxed"></p>
            </div>
            <span data-preview-cta class="uppercase tracking-[0.18em] border-b border-current/60 pb-1 self-start mt-4"></span>
          </a>
        </div>
      </div>
    </section>

    {/* === Control form === */}
    <form method="POST" data-hero-form class="space-y-6">
      <input type="hidden" name="hero_card_config_json" data-hero-json>

      <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

        {/* --- Content --- */}
        <section class="card space-y-4">
          <CardHeader icon="lucide:newspaper" title="Contenido" desc="Qué se muestra dentro del recuadro." />

          <div>
            <label class="label">Fuente del contenido</label>
            <select data-bind="content_source" class="cas-input w-full">
              <option value="editorial">Descripción editorial (default)</option>
              <option value="manual">Manual (definir texto abajo)</option>
              <option value="latest_post">Último artículo publicado</option>
              <option value="latest_book">Último libro publicado</option>
            </select>
            <p class="hint mt-1">Si eliges artículo o libro pero aún no hay nada publicado, se usa la descripción editorial como fallback.</p>
          </div>

          <div data-manual-fields class="space-y-4 pt-2 border-t border-stone-100">
            <p class="text-[11px] uppercase tracking-wider text-stone-400">Sólo cuando "Manual"</p>
            <div>
              <label class="label">Eyebrow (texto pequeño arriba)</label>
              <input type="text" data-bind="manual.eyebrow" class="cas-input w-full" />
            </div>
            <div>
              <label class="label">Título</label>
              <input type="text" data-bind="manual.title" class="cas-input w-full" />
            </div>
            <div>
              <label class="label">Cuerpo</label>
              <textarea data-bind="manual.body" rows="3" class="cas-input w-full"></textarea>
            </div>
            <div class="grid sm:grid-cols-2 gap-3">
              <div>
                <label class="label">Texto del botón</label>
                <input type="text" data-bind="manual.cta_label" class="cas-input w-full" />
              </div>
              <div>
                <label class="label">URL del botón</label>
                <input type="text" data-bind="manual.cta_href" class="cas-input w-full" placeholder="/catalogo" />
              </div>
            </div>
          </div>
        </section>

        {/* --- Style: Desktop --- */}
        <section class="card space-y-4" data-platform-section="desktop">
          <CardHeader icon="lucide:monitor" title="Estilo (Web)" desc="Cómo se ve la card en pantallas medianas y grandes." />
          <Fragment set:html={renderPlatformControls("desktop")} />
        </section>

        {/* --- Style: Mobile --- */}
        <section class="card space-y-4" data-platform-section="mobile">
          <CardHeader icon="lucide:smartphone" title="Estilo (Mobile)" desc="Cómo se ve la card en celulares." />
          <Fragment set:html={renderPlatformControls("mobile")} />
        </section>

        {/* --- Background image uploaders (use real component for upload+preview) --- */}
        <section class="card space-y-4">
          <CardHeader icon="lucide:image" title="Imágenes de fondo" desc="Opcional: imagen como fondo de la card. Se mezcla con el color." />
          <div class="grid sm:grid-cols-2 gap-4">
            <ImageUpload name="desktop_bg_image" label="Web" hint="Click o arrastra. Imagen visible solo en desktop." bucket="covers" />
            <ImageUpload name="mobile_bg_image" label="Mobile" hint="Click o arrastra. Imagen visible solo en mobile." bucket="covers" />
          </div>
        </section>

        {canEdit && (
          <div class="flex gap-3 pt-4 border-t border-stone-200 sticky bottom-0 bg-white py-3 z-10">
            <button type="submit" class="btn-primary" disabled data-submit-btn>Guardar configuración</button>
            <button type="button" class="btn-secondary" data-reset-btn>Restablecer defaults</button>
          </div>
        )}
      </fieldset>
    </form>
  </div>
</AppLayout>

<style is:global>
  .cas-input {
    border: 1px solid rgb(214 211 209);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    background: white;
    transition: border-color 0.15s;
  }
  .cas-input:focus {
    outline: none;
    border-color: rgb(28 25 23);
  }
  .cas-preview-tab {
    border-color: rgb(214 211 209);
    color: rgb(120 113 108);
    background: white;
    cursor: pointer;
  }
  .cas-preview-tab-active {
    background: rgb(28 25 23);
    color: white;
    border-color: rgb(28 25 23);
  }
  .cas-preview-frame {
    height: clamp(420px, 56vh, 720px);
    position: relative;
  }
  [data-platform-section] .num-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    [data-platform-section] .num-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  [data-platform-section] .num-row label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(120 113 108);
    margin-bottom: 0.25rem;
  }
  [data-platform-section] .color-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  [data-platform-section] input[type="color"] {
    width: 44px;
    height: 32px;
    padding: 0;
    border: 1px solid rgb(214 211 209);
    cursor: pointer;
    background: white;
  }
  [data-platform-section] input[type="range"] {
    accent-color: rgb(28 25 23);
  }
  .hint {
    font-size: 0.75rem;
    color: rgb(120 113 108);
  }
  .btn-secondary {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(214 211 209);
    transition: background-color 0.15s;
    cursor: pointer;
  }
  .btn-secondary:hover {
    background: rgb(245 245 244);
  }
</style>

<script is:inline define:vars={{ DEFAULT_CFG }}>
  (() => {
    if (window.__casHeroCardInit) return;
    window.__casHeroCardInit = true;

    const FRAME_DESKTOP_W = 1440;
    const FRAME_DESKTOP_H = 720;
    const FRAME_MOBILE_W = 390;
    const FRAME_MOBILE_H = 720;

    let currentTab = "desktop";
    let currentCfg = structuredClone(DEFAULT_CFG);
    let frameScale = 1;

    // ---------- DOM helpers ----------
    function $(s, p = document) { return p.querySelector(s); }
    function $$(s, p = document) { return Array.from(p.querySelectorAll(s)); }

    function setByPath(obj, path, value) {
      const parts = path.split(".");
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        if (typeof cur[parts[i]] !== "object" || cur[parts[i]] === null) cur[parts[i]] = {};
        cur = cur[parts[i]];
      }
      cur[parts[parts.length - 1]] = value;
    }
    function getByPath(obj, path) {
      const parts = path.split(".");
      let cur = obj;
      for (const p of parts) {
        if (cur == null) return undefined;
        cur = cur[p];
      }
      return cur;
    }

    // ---------- Color util ----------
    function hexToRgba(hex, alpha) {
      const c = String(hex || "").replace("#", "").trim();
      const full = c.length === 3 ? c.split("").map(x => x + x).join("") : c;
      if (full.length !== 6) return `rgba(26,23,21,${alpha})`;
      const r = parseInt(full.slice(0, 2), 16);
      const g = parseInt(full.slice(2, 4), 16);
      const b = parseInt(full.slice(4, 6), 16);
      if ([r, g, b].some(Number.isNaN)) return `rgba(26,23,21,${alpha})`;
      return `rgba(${r},${g},${b},${alpha})`;
    }

    // ---------- Form ↔ Config sync ----------
    function readForm() {
      const cfg = structuredClone(currentCfg); // start from current
      $$("[data-bind]").forEach((el) => {
        const path = el.getAttribute("data-bind");
        let v;
        if (el.type === "checkbox") {
          v = el.checked;
        } else if (el.type === "number" || el.type === "range") {
          v = el.value === "" ? 0 : parseFloat(el.value);
          if (Number.isNaN(v)) v = 0;
        } else {
          v = el.value;
        }
        setByPath(cfg, path, v);
      });
      return cfg;
    }

    function writeForm(cfg) {
      $$("[data-bind]").forEach((el) => {
        const path = el.getAttribute("data-bind");
        const v = getByPath(cfg, path);
        if (v === undefined || v === null) return;
        if (el.type === "checkbox") el.checked = !!v;
        else el.value = String(v);
        // Keep the corresponding range/number siblings in sync
        const sibling = el.parentElement?.querySelector(`[data-bind-mirror="${path}"]`);
        if (sibling) sibling.value = String(v);
      });
      // Also push bg image URLs into the dedicated ImageUpload wrappers.
      const dImg = document.querySelector('[data-image-upload] input[name="desktop_bg_image"]');
      const mImg = document.querySelector('[data-image-upload] input[name="mobile_bg_image"]');
      if (dImg) {
        const wrap = dImg.closest("[data-image-upload]");
        if (wrap?.__casSetImage) wrap.__casSetImage(cfg.desktop?.bg_image_url || "");
      }
      if (mImg) {
        const wrap = mImg.closest("[data-image-upload]");
        if (wrap?.__casSetImage) wrap.__casSetImage(cfg.mobile?.bg_image_url || "");
      }
      // Toggle visibility of manual fields
      const manual = document.querySelector("[data-manual-fields]");
      if (manual) manual.style.opacity = cfg.content_source === "manual" ? "1" : "0.45";
    }

    // ---------- Preview rendering ----------
    function applyLayoutToCard(card, layout) {
      const bg = hexToRgba(layout.bg_color, layout.bg_alpha);
      const bgRule = layout.bg_image_url
        ? `linear-gradient(${bg}, ${bg}), url('${layout.bg_image_url}') center/cover no-repeat`
        : bg;
      const radius = `${layout.border_radius_tl}px ${layout.border_radius_tr}px ${layout.border_radius_br}px ${layout.border_radius_bl}px`;
      card.style.background = bgRule;
      card.style.color = layout.text_color;
      card.style.borderRadius = radius;
      card.style.padding = `${layout.padding}px`;
      card.style.width = layout.width > 0 ? `${layout.width}px` : "auto";
      card.style.maxWidth = layout.width > 0 ? "100%" : `calc(100% - ${layout.offset_x * 2}px)`;
      card.style.minHeight = `${layout.height}px`;
      card.style.left = `${layout.offset_x}px`;
      card.style.top = `calc(50% + ${layout.offset_y}px)`;
      card.style.transform = "translateY(-50%)";
      card.style.boxShadow = layout.shadow ? "0 25px 50px -12px rgba(0,0,0,0.25)" : "none";
      card.style.backdropFilter = layout.bg_blur > 0 ? `blur(${layout.bg_blur}px)` : "none";
      card.style.webkitBackdropFilter = layout.bg_blur > 0 ? `blur(${layout.bg_blur}px)` : "none";
      const titleFont = layout.title_font === "serif"
        ? `"Cormorant Garamond", "EB Garamond", Georgia, serif`
        : `"Inter", system-ui, -apple-system, sans-serif`;
      const titleEl = card.querySelector("[data-preview-title]");
      if (titleEl) titleEl.style.fontFamily = titleFont;
    }

    function applyContentToCard(card, cfg) {
      const eyebrow = card.querySelector("[data-preview-eyebrow]");
      const title = card.querySelector("[data-preview-title]");
      const body = card.querySelector("[data-preview-body]");
      const cta = card.querySelector("[data-preview-cta]");
      let content;
      if (cfg.content_source === "manual") {
        content = cfg.manual;
      } else if (cfg.content_source === "latest_post") {
        content = { eyebrow: "Filosofía", title: "Último artículo publicado", body: "(El sitio mostrará el post más reciente)", cta_label: "Leer artículo", cta_href: "#" };
      } else if (cfg.content_source === "latest_book") {
        content = { eyebrow: "Catálogo", title: "Último libro publicado", body: "(El sitio mostrará el libro más reciente)", cta_label: "Ver libro", cta_href: "#" };
      } else {
        content = { eyebrow: "Editorial", title: "Casa de Asterión Ediciones", body: "(Aquí va la descripción editorial del sitio)", cta_label: "Explorar el catálogo", cta_href: "/catalogo" };
      }
      eyebrow.textContent = content.eyebrow || "";
      eyebrow.style.display = content.eyebrow ? "block" : "none";
      title.textContent = content.title || "";
      body.textContent = content.body || "";
      body.style.display = content.body ? "block" : "none";
      cta.textContent = content.cta_label || "";
      card.href = content.cta_href || "#";
    }

    function applyTitleSize(card) {
      const t = card.querySelector("[data-preview-title]");
      if (!t) return;
      // Match the public site's actual size: text-[1.4rem] mobile, md:text-5xl desktop
      t.style.fontSize = currentTab === "desktop" ? "3rem" : "1.4rem";
    }

    function renderPreview() {
      const stage = $("[data-preview-stage]");
      const card = $("[data-preview-card]");
      const bgImage = $("[data-preview-bg-image]");
      const meta = $("[data-preview-meta]");
      if (!stage || !card) return;

      const cfg = readForm();
      currentCfg = cfg;
      $("[data-hero-json]").value = JSON.stringify(cfg);

      // Mirror inputs (read-only number/text alongside color/range) reflect
      // the current value so users see the literal hex / number.
      $$("[data-bind]").forEach((el) => {
        const path = el.getAttribute("data-bind");
        const v = getByPath(cfg, path);
        const mirror = el.parentElement?.querySelector(`[data-bind-mirror="${path}"]`);
        if (mirror && mirror !== el) mirror.value = String(v);
      });

      const layout = currentTab === "desktop" ? cfg.desktop : cfg.mobile;
      applyLayoutToCard(card, layout);
      applyContentToCard(card, cfg);
      applyTitleSize(card);

      if (currentTab === "desktop") {
        bgImage.style.display = "block";
        bgImage.style.backgroundImage = `url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=1600&q=80')`;
      } else {
        bgImage.style.display = "none";
      }

      // Set the stage's "viewport" dimensions via transform: scale to fit.
      const frame = $("[data-preview-frame]");
      if (frame) {
        const fw = frame.clientWidth - 16;
        const fh = frame.clientHeight - 16;
        const targetW = currentTab === "desktop" ? FRAME_DESKTOP_W : FRAME_MOBILE_W;
        const targetH = currentTab === "desktop" ? FRAME_DESKTOP_H : FRAME_MOBILE_H;
        const sx = fw / targetW;
        const sy = fh / targetH;
        frameScale = Math.min(sx, sy, 1);
        stage.style.width = `${targetW}px`;
        stage.style.height = `${targetH}px`;
        stage.style.transformOrigin = "top left";
        stage.style.transform = `scale(${frameScale})`;
        stage.style.position = "absolute";
        stage.style.top = "8px";
        stage.style.left = "8px";
        // Center horizontally inside the frame
        const scaledW = targetW * frameScale;
        const offsetLeft = (frame.clientWidth - scaledW) / 2;
        stage.style.left = `${Math.max(8, offsetLeft)}px`;
      }
      if (meta) {
        const tw = currentTab === "desktop" ? FRAME_DESKTOP_W : FRAME_MOBILE_W;
        const th = currentTab === "desktop" ? FRAME_DESKTOP_H : FRAME_MOBILE_H;
        meta.textContent = `${currentTab} · ${tw} × ${th}`;
      }
    }

    // ---------- Event wiring ----------
    function wireFormEvents() {
      $$("[data-bind]").forEach((el) => {
        el.addEventListener("input", renderPreview);
        el.addEventListener("change", renderPreview);
      });
      // Sync ImageUpload changes back into the config + preview.
      document.addEventListener("cas:imageupload:change", (e) => {
        const detail = e.detail || {};
        if (detail.name === "desktop_bg_image") {
          currentCfg.desktop = { ...currentCfg.desktop, bg_image_url: detail.url || "" };
          renderPreview();
        } else if (detail.name === "mobile_bg_image") {
          currentCfg.mobile = { ...currentCfg.mobile, bg_image_url: detail.url || "" };
          renderPreview();
        }
      });
    }

    function wireTabs() {
      $$("[data-preview-tab]").forEach((btn) => {
        btn.addEventListener("click", () => {
          currentTab = btn.getAttribute("data-preview-tab");
          $$("[data-preview-tab]").forEach(b => b.classList.toggle("cas-preview-tab-active", b === btn));
          // Highlight the corresponding form section
          $$("[data-platform-section]").forEach((sec) => {
            sec.style.outline = sec.getAttribute("data-platform-section") === currentTab ? "2px solid rgb(28 25 23)" : "";
            sec.style.outlineOffset = "-2px";
          });
          renderPreview();
        });
      });
    }

    function wireReset() {
      const btn = $("[data-reset-btn]");
      if (!btn) return;
      btn.addEventListener("click", () => {
        if (!confirm("¿Restablecer todos los valores a los defaults?")) return;
        currentCfg = structuredClone(DEFAULT_CFG);
        writeForm(currentCfg);
        renderPreview();
      });
    }

    function wireSubmit() {
      const form = $("[data-hero-form]");
      if (!form) return;
      form.addEventListener("submit", () => {
        const cfg = readForm();
        // Make sure ImageUpload values are in the config too
        const dImg = document.querySelector('[data-image-upload] input[name="desktop_bg_image"]');
        const mImg = document.querySelector('[data-image-upload] input[name="mobile_bg_image"]');
        if (dImg) cfg.desktop.bg_image_url = dImg.value || "";
        if (mImg) cfg.mobile.bg_image_url = mImg.value || "";
        $("[data-hero-json]").value = JSON.stringify(cfg);
      });
    }

    // ---------- Hydration ----------
    async function hydrate() {
      try {
        const res = await fetch("/api/page-data?type=site", { credentials: "same-origin", headers: { accept: "application/json" } });
        if (!res.ok) {
          // Fall back to defaults
          writeForm(DEFAULT_CFG);
          renderPreview();
          enableSubmit();
          return;
        }
        const data = await res.json();
        const persisted = data?.config?.hero_card_config;
        const cfg = persisted && typeof persisted === "object"
          ? {
              content_source: persisted.content_source ?? DEFAULT_CFG.content_source,
              manual: { ...DEFAULT_CFG.manual, ...(persisted.manual ?? {}) },
              desktop: { ...DEFAULT_CFG.desktop, ...(persisted.desktop ?? {}) },
              mobile: { ...DEFAULT_CFG.mobile, ...(persisted.mobile ?? {}) },
            }
          : DEFAULT_CFG;
        currentCfg = cfg;
        writeForm(cfg);
        renderPreview();
      } catch {
        writeForm(DEFAULT_CFG);
        renderPreview();
      }
      enableSubmit();
    }

    function enableSubmit() {
      const btn = $("[data-submit-btn]");
      if (btn) btn.disabled = false;
    }

    // ---------- Boot ----------
    function boot() {
      wireFormEvents();
      wireTabs();
      wireReset();
      wireSubmit();
      hydrate();
      window.addEventListener("resize", renderPreview);
    }

    document.addEventListener("astro:page-load", boot);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
