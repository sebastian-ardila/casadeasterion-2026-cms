---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import FormActions from "~/components/FormActions.astro";
import RolePicker from "~/components/RolePicker.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "staff", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/staff");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=staff");
  try {
    const fd = await Astro.request.formData();
    if (str(fd, "_action") === "delete") {
      const { error } = await supabase.from("staff").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/staff?saved=1&action=deleted&entity=author&publish=1");
    }
    const sortRaw = str(fd, "sort_order");
    const sortNum = sortRaw && !Number.isNaN(Number(sortRaw)) ? Number(sortRaw) : undefined;
    const { error } = await supabase
      .from("staff")
      .update({
        name: strReq(fd, "name"),
        slug: strReq(fd, "slug"),
        role: strReq(fd, "role"),
        bio_md: str(fd, "bio_md") ?? null,
        photo_url: str(fd, "photo_url") ?? null,
        email: str(fd, "email") ?? null,
        links: {
          web: str(fd, "link_web") ?? "",
          twitter: str(fd, "link_twitter") ?? "",
          instagram: str(fd, "link_instagram") ?? "",
          linkedin: str(fd, "link_linkedin") ?? "",
        },
        ...(sortNum != null ? { sort_order: sortNum } : {}),
        status: str(fd, "status") === "draft" ? "draft" : "published",
      })
      .eq("id", id);
    if (error) throw error;
    return Astro.redirect(`/staff/${id}?saved=1&action=updated&entity=author&publish=1`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const { data: member } = await supabase.from("staff").select("*").eq("id", id).maybeSingle();
if (!member) return Astro.redirect("/staff");
const links = (member.links as Record<string, string>) ?? {};
---

<AppLayout title={member.name} resource="staff" activeId={member.id} breadcrumbLabel={member.name}>

  <BackToList href="/staff" label="Personal" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{member.name}</h1>
    <p class="text-stone-500 text-xs">{member.role} · /{member.slug}</p>
  </header>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad</h2>
        <p class="card-section-desc">Cómo se presenta esta persona en /nosotros.</p>
      </div>
      <Field label="Nombre" name="name" value={member.name} required description="Nombre completo." />
      <Field label="Slug" name="slug" value={member.slug} required description="Identificador interno." />
      <RolePicker name="role" value={member.role} label="Cargo" required description="Selecciona uno o agrega un cargo nuevo." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Foto</h2>
        <p class="card-section-desc">Retrato vertical. Se convierte a WebP automáticamente.</p>
      </div>
      <ImageUpload name="photo_url" value={member.photo_url} label="Foto" bucket="authors" />
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Biografía</h2>
        <p class="card-section-desc">Texto introductorio. Soporta markdown.</p>
      </div>
      <MarkdownEditor name="bio_md" value={member.bio_md} label="" />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Contacto y enlaces</h2>
        <p class="card-section-desc">Opcional. Aparecen como íconos en /nosotros.</p>
      </div>
      <Field label="Email" name="email" type="email" value={member.email} description="Email profesional." />
      <div class="grid sm:grid-cols-2 gap-4">
        <Field label="Web" name="link_web" type="url" value={links.web} description="Sitio personal o académico." />
        <Field label="LinkedIn" name="link_linkedin" type="url" value={links.linkedin} description="URL del perfil." />
        <Field label="Twitter" name="link_twitter" type="url" value={links.twitter} description="URL del perfil." />
        <Field label="Instagram" name="link_instagram" type="url" value={links.instagram} description="URL del perfil." />
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Orden y publicación</h2>
        <p class="card-section-desc">Controla la posición en /nosotros y si aparece publicado.</p>
      </div>
      <Field label="Orden" name="sort_order" type="number" value={member.sort_order != null ? String(member.sort_order) : "0"} description="Menor sale primero. 0 es el primero." />
      <div class="space-y-2">
        <label class="flex items-start gap-3 text-sm">
          <input type="radio" name="status" value="published" checked={member.status === "published"} class="mt-1" />
          <span>
            <span class="font-medium">Publicado</span>
            <span class="block text-stone-500">Visible en /nosotros.</span>
          </span>
        </label>
        <label class="flex items-start gap-3 text-sm">
          <input type="radio" name="status" value="draft" checked={member.status === "draft"} class="mt-1" />
          <span>
            <span class="font-medium">Borrador</span>
            <span class="block text-stone-500">Oculto en el sitio público.</span>
          </span>
        </label>
      </div>
    </section>

    <FormActions cancelHref="/staff" canEdit={canEdit} />
    </fieldset>
  </form>

  {canEdit && (
  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-3xl"
    data-cas-confirm="Esta persona desaparecerá de /nosotros."
    data-cas-confirm-title="¿Borrar este miembro?"
    data-cas-confirm-subtitle={member.name}
    data-cas-confirm-label="Borrar"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar miembro</button>
  </form>
  )}
</AppLayout>
