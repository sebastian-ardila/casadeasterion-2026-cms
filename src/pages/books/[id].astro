---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import GalleryUpload from "~/components/GalleryUpload.astro";
import AiSuggest from "~/components/AiSuggest.astro";
import MultiAuthorPicker from "~/components/MultiAuthorPicker.astro";
import FormActions from "~/components/FormActions.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags, jsonStringArray } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import { normalizeISBN, isValidISBN } from "~/lib/isbn";
import {
  parseAuthorIds,
  syncBookRole,
  fetchBookRoleIds,
} from "~/lib/multi-author";

const guard = await requirePermission(Astro, "books", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/books");

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=books");
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");

    if (action === "delete") {
      const { data: existingRow } = await supabase.from("books").select("status").eq("id", id).single();
      const wasPublished = existingRow?.status === "published";
      const { error } = await supabase.from("books").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect(`/books?saved=1&action=deleted&entity=book${wasPublished ? "&publish=1" : ""}`);
    }

    const newStatus = str(fd, "status") ?? "draft";
    const rawIsbn = str(fd, "isbn");
    if (!isValidISBN(rawIsbn)) {
      throw new Error("ISBN inválido. Debe tener 10 o 13 dígitos (con o sin guiones).");
    }
    // author_id is no longer set directly from the form: it's a
    // denormalized "primary author" pointer that a Postgres trigger
    // keeps in sync with the book_authors junction. We sync the
    // junction below after the books UPDATE succeeds.
    const update: Record<string, unknown> = {
      title: strReq(fd, "title"),
      slug: strReq(fd, "slug"),
      subtitle: str(fd, "subtitle"),
      description_md: str(fd, "description_md"),
      cover_image_url: str(fd, "cover_image_url"),
      category_id: str(fd, "category_id"),
      collection_id: str(fd, "collection_id") || null,
      isbn: normalizeISBN(rawIsbn),
      pages: num(fd, "pages"),
      format: str(fd, "format"),
      price_amount: num(fd, "price_amount"),
      price_currency: str(fd, "price_currency") ?? "COP",
      keywords: parseTags(fd, "keywords"),
      canonical_url: str(fd, "canonical_url"),
      cover_image_alt: str(fd, "cover_image_alt"),
      publication_date: str(fd, "publication_date"),
      status: newStatus,
      tags: parseTags(fd, "tags"),
      gallery_urls: jsonStringArray(fd, "gallery_urls"),
    };

    const { data: existing } = await supabase
      .from("books").select("published_at, status").eq("id", id).single();
    if (newStatus === "published" && !existing?.published_at) {
      update.published_at = new Date().toISOString();
    }

    const { error } = await supabase.from("books").update(update).eq("id", id);
    if (error) throw error;
    // Sync de las 4 junctions (autores, traductores, prologistas,
    // colaboradores). El trigger sync_primary_author actualiza
    // books.author_id automáticamente con el primer autor.
    await Promise.all([
      syncBookRole(supabase, "author",       id, parseAuthorIds(fd, "author_ids")),
      syncBookRole(supabase, "translator",   id, parseAuthorIds(fd, "translator_ids")),
      syncBookRole(supabase, "prologuist",   id, parseAuthorIds(fd, "prologuist_ids")),
      syncBookRole(supabase, "collaborator", id, parseAuthorIds(fd, "collaborator_ids")),
    ]);
    const triggersRebuild = newStatus === "published" || existing?.status === "published";
    return Astro.redirect(`/books/${id}?saved=1&action=updated&entity=book${triggersRebuild ? "&publish=1" : ""}`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Cargar todas las personas filtradas por rol — cada picker ve solo
// las personas marcadas con ese tag (un autor puro no aparece en el
// picker de traductores, etc.). Junto con las 4 listas, cargamos los
// IDs ya enlazados al libro para hidratar cada picker con selección.
const [
  bookRes, authorsRes, translatorsRes, prologuistsRes, collaboratorsRes,
  categoriesRes, collectionsRes,
  selectedAuthorIds, selectedTranslatorIds, selectedProloguistIds, selectedCollaboratorIds,
] = await Promise.all([
  supabase.from("books").select("*").eq("id", id).maybeSingle(),
  supabase.from("authors").select("id, name, photo_url").contains("role_tags", ["author"]).order("name"),
  supabase.from("authors").select("id, name, photo_url").contains("role_tags", ["translator"]).order("name"),
  supabase.from("authors").select("id, name, photo_url").contains("role_tags", ["prologuist"]).order("name"),
  supabase.from("authors").select("id, name, photo_url").contains("role_tags", ["collaborator"]).order("name"),
  supabase.from("categories").select("id, name, icon").order("name"),
  (supabase.from as any)("collections").select("id, name").eq("status", "published").order("name"),
  fetchBookRoleIds(supabase, "author",       id),
  fetchBookRoleIds(supabase, "translator",   id),
  fetchBookRoleIds(supabase, "prologuist",   id),
  fetchBookRoleIds(supabase, "collaborator", id),
]);
const book = bookRes.data;
const authors      = authorsRes.data ?? [];
const translators  = translatorsRes.data ?? [];
const prologuists  = prologuistsRes.data ?? [];
const collaborators = collaboratorsRes.data ?? [];
const categories = categoriesRes.data;
const collections = (collectionsRes.data ?? []) as Array<{ id: string; name: string }>;
if (!book) return Astro.redirect("/books");
const categoryOptions = [
  { value: "", label: "Sin categoría" },
  ...(categories ?? []).map((c) => ({
    value: c.id,
    label: c.name,
    icon: c.icon ? `lucide:${c.icon}` : undefined,
  })),
];
const collectionOptions = [
  { value: "", label: "Sin colección" },
  ...collections.map((c) => ({
    value: c.id,
    label: c.name,
    icon: "lucide:library",
  })),
];
const formatOptions = [
  { value: "", label: "Sin especificar" },
  { value: "paperback", label: "Tapa blanda" },
  { value: "hardcover", label: "Tapa dura" },
  { value: "ebook", label: "Ebook" },
  { value: "other", label: "Otro" },
];
const currencyOptions = [
  { value: "COP", label: "COP — Peso colombiano" },
  { value: "USD", label: "USD — Dólar" },
  { value: "EUR", label: "EUR — Euro" },
];
const statusOptions = [
  { value: "draft", label: "Borrador", hint: "no visible al público" },
  { value: "published", label: "Publicado", hint: "dispara rebuild" },
];
---

<AppLayout title={book.title} resource="books" activeId={book.id} breadcrumbLabel={book.title}>

  <BackToList href="/books" label="Libros" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{book.title}</h1>
    <p class="text-stone-500 text-xs">/{book.slug} · actualizado {new Date(book.updated_at).toLocaleString("es-CO")}</p>
  </header>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar este libro.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad del libro</h2>
        <p class="card-section-desc">Cómo se nombra y se encuentra en el catálogo.</p>
      </div>
      <Field label="Título" name="title" value={book.title} required description="Título principal de la obra." />
      <Field label="Slug" name="slug" value={book.slug} required description="Identificador único en la URL: /catalogo/<slug>." />
      <Field label="Subtítulo" name="subtitle" value={book.subtitle} description="Subtítulo opcional. Aparece debajo del título." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Portada y galería</h2>
        <p class="card-section-desc">Imágenes del libro. Se convierten automáticamente a WebP.</p>
      </div>
      <ImageUpload name="cover_image_url" value={book.cover_image_url} label="Portada" bucket="covers" />
      <GalleryUpload name="gallery_urls" value={book.gallery_urls} label="Galería del libro" bucket="content" hint="Páginas interiores, contraportada, ilustraciones, etc." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Clasificación</h2>
        <p class="card-section-desc">Categoría y colección del libro en el menú del sitio público.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="flex flex-col gap-2">
          <span class="label">Categoría</span>
          <Dropdown name="category_id" value={book.category_id ?? ""} options={categoryOptions} placeholder="Sin categoría" />
        </div>
        <div class="flex flex-col gap-2">
          <span class="label">Colección</span>
          <Dropdown name="collection_id" value={(book as any).collection_id ?? ""} options={collectionOptions} placeholder="Sin colección" />
        </div>
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Personas vinculadas</h2>
        <p class="card-section-desc">Personas asociadas al libro por rol. Cada picker solo muestra personas marcadas con ese rol; si necesitas que alguien aparezca en otro picker, edítale su ficha en Autores/Traductores/etc. y activa el rol.</p>
      </div>
      <div>
        <MultiAuthorPicker
          name="author_ids"
          label="Autores"
          authors={authors}
          selectedIds={selectedAuthorIds}
        />
      </div>
      <div>
        <MultiAuthorPicker
          name="translator_ids"
          label="Traductores"
          authors={translators}
          selectedIds={selectedTranslatorIds}
        />
      </div>
      <div>
        <MultiAuthorPicker
          name="prologuist_ids"
          label="Prologistas"
          authors={prologuists}
          selectedIds={selectedProloguistIds}
        />
      </div>
      <div>
        <MultiAuthorPicker
          name="collaborator_ids"
          label="Colaboradores"
          authors={collaborators}
          selectedIds={selectedCollaboratorIds}
        />
      </div>
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Descripción</h2>
        <p class="card-section-desc">Sinopsis o descripción larga del libro. Soporta markdown.</p>
      </div>
      <MarkdownEditor name="description_md" value={book.description_md} label="" />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Detalles editoriales</h2>
        <p class="card-section-desc">Datos físicos y comerciales que aparecen en la ficha.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <Field label="ISBN" name="isbn" value={book.isbn} description="10 o 13 dígitos. Acepta guiones." />
        <Field label="Páginas" name="pages" type="number" value={book.pages} description="Número total de páginas." />
        <div>
          <span class="label">Formato</span>
          <Dropdown name="format" value={book.format ?? ""} options={formatOptions} placeholder="Sin especificar" />
        </div>
        <Field label="Publicado" name="publication_date" type="date" value={book.publication_date} description="Fecha de publicación impresa." />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Field label="Precio" name="price_amount" type="number" value={book.price_amount} description="Precio sugerido." />
        <div>
          <span class="label">Moneda</span>
          <Dropdown name="price_currency" value={book.price_currency ?? "COP"} options={currencyOptions} />
        </div>
        <Field label="Tags" name="tags" value={book.tags?.join(", ")} description="Etiquetas, separadas por coma." />
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">SEO y redes sociales</h2>
        <p class="card-section-desc">Cómo aparece en Google y al compartir.</p>
      </div>
      <AiSuggest kind="book" contentField="description_md" />
      <Field label="Palabras clave (SEO)" name="keywords" value={book.keywords?.join(", ")} description="Términos por los que esperas que la gente encuentre el libro. Separadas por coma." />
      <Field label="Texto alt de la portada" name="cover_image_alt" value={book.cover_image_alt} description="Descripción de la portada para lectores de pantalla y SEO. Vacío = se usa el título." />
      <Field label="URL canónica" name="canonical_url" type="url" value={book.canonical_url} description="Si la ficha del libro existe en otro lugar (Goodreads, Amazon, etc.) y quieres apuntar ahí como original." />
    </section>

    <section class="card">
      <div class="mb-4">
        <h2 class="card-section-title">Estado de publicación</h2>
        <p class="card-section-desc">Borrador queda oculto. Publicado dispara un rebuild del sitio público.</p>
      </div>
      <div class="max-w-xs">
        <Dropdown name="status" value={book.status} options={statusOptions} />
      </div>
    </section>

    <FormActions cancelHref="/books" canEdit={canEdit} />
    </fieldset>
  </form>

  {canEdit && (
  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-3xl"
    data-cas-confirm="Esta acción es permanente. El libro y todas sus relaciones se eliminan."
    data-cas-confirm-title="¿Borrar este libro?"
    data-cas-confirm-subtitle={book.title}
    data-cas-confirm-label="Borrar"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar libro</button>
  </form>
  )}
</AppLayout>
