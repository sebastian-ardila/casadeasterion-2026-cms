---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import GalleryUpload from "~/components/GalleryUpload.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, tags as parseTags, jsonStringArray, slugify } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import { normalizeISBN, isValidISBN } from "~/lib/isbn";

const guard = await requirePermission(Astro, "books", "edit");
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const title = strReq(fd, "title");
    const slug = str(fd, "slug") ?? slugify(title);
    const status = str(fd, "status") ?? "draft";
    const published_at = status === "published" ? new Date().toISOString() : null;
    const rawIsbn = str(fd, "isbn");
    if (!isValidISBN(rawIsbn)) {
      throw new Error("ISBN inválido. Debe tener 10 o 13 dígitos (con o sin guiones).");
    }
    const isbn = normalizeISBN(rawIsbn);

    const { data, error } = await supabase
      .from("books")
      .insert({
        title,
        slug,
        subtitle: str(fd, "subtitle"),
        description_md: str(fd, "description_md"),
        cover_image_url: str(fd, "cover_image_url"),
        author_id: str(fd, "author_id"),
        category_id: str(fd, "category_id"),
        isbn,
        pages: num(fd, "pages"),
        format: str(fd, "format"),
        price_amount: num(fd, "price_amount"),
        price_currency: str(fd, "price_currency") ?? "COP",
        whatsapp_message_override: str(fd, "whatsapp_message_override"),
        publication_date: str(fd, "publication_date"),
        status,
        published_at,
        tags: parseTags(fd, "tags"),
        gallery_urls: jsonStringArray(fd, "gallery_urls"),
      })
      .select("id")
      .single();

    if (error) throw error;
    const willPublish = status === "published";
    const label = encodeURIComponent("Libro: " + title);
    return Astro.redirect(`/books/${data.id}${willPublish ? `?published=1&item=${label}` : ""}`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const [{ data: authors }, { data: categories }] = await Promise.all([
  supabase.from("authors").select("id, name, photo_url").order("name"),
  supabase.from("categories").select("id, name, kind").order("name"),
]);

const authorOptions = [
  { value: "", label: "Sin autor", iconStyle: "person" as const },
  ...(authors ?? []).map((a) => ({
    value: a.id,
    label: a.name,
    imageUrl: a.photo_url ?? null,
    iconStyle: "person" as const,
  })),
];
const categoryOptions = [
  { value: "", label: "Sin categoría" },
  ...(categories ?? []).map((c) => ({ value: c.id, label: c.name, hint: c.kind })),
];
const formatOptions = [
  { value: "", label: "Sin especificar" },
  { value: "paperback", label: "Tapa blanda" },
  { value: "hardcover", label: "Tapa dura" },
  { value: "ebook", label: "Ebook" },
  { value: "other", label: "Otro" },
];
const currencyOptions = [
  { value: "COP", label: "COP — Peso colombiano" },
  { value: "USD", label: "USD — Dólar" },
  { value: "EUR", label: "EUR — Euro" },
];
const statusOptions = [
  { value: "draft", label: "Borrador", hint: "no visible al público" },
  { value: "published", label: "Publicado", hint: "dispara rebuild" },
];
---

<AppLayout title="Nuevo libro" resource="books">
  <BackToList href="/books" label="Libros" />
  <h1 class="font-serif text-3xl md:text-4xl mb-8">Nuevo libro</h1>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad del libro</h2>
        <p class="card-section-desc">Cómo se nombra y se encuentra en el catálogo.</p>
      </div>
      <Field label="Título" name="title" required description="Título principal de la obra." />
      <Field label="Slug" name="slug" description="Se autogenera del título si lo dejas vacío." />
      <Field label="Subtítulo" name="subtitle" description="Subtítulo opcional. Aparece debajo del título." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Portada y galería</h2>
        <p class="card-section-desc">Imágenes del libro. Se convierten automáticamente a WebP.</p>
      </div>
      <ImageUpload name="cover_image_url" label="Portada" bucket="covers" />
      <GalleryUpload name="gallery_urls" label="Galería del libro" bucket="content" hint="Páginas interiores, contraportada, ilustraciones, etc." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Clasificación</h2>
        <p class="card-section-desc">Asocia el libro a un autor y a una categoría del menú.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <span class="label">Autor</span>
          <Dropdown name="author_id" options={authorOptions} placeholder="Sin autor" />
        </div>
        <div>
          <span class="label">Categoría</span>
          <Dropdown name="category_id" options={categoryOptions} placeholder="Sin categoría" />
        </div>
      </div>
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Descripción</h2>
        <p class="card-section-desc">Sinopsis del libro. Soporta markdown.</p>
      </div>
      <MarkdownEditor name="description_md" label="" />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Detalles editoriales</h2>
        <p class="card-section-desc">Datos físicos y comerciales.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <Field label="ISBN" name="isbn" description="10 o 13 dígitos. Acepta guiones." />
        <Field label="Páginas" name="pages" type="number" description="Total de páginas." />
        <div>
          <span class="label">Formato</span>
          <Dropdown name="format" options={formatOptions} placeholder="Sin especificar" />
        </div>
        <Field label="Publicado" name="publication_date" type="date" description="Fecha de impresión." />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <Field label="Precio" name="price_amount" type="number" description="Precio sugerido." />
        <div>
          <span class="label">Moneda</span>
          <Dropdown name="price_currency" value="COP" options={currencyOptions} />
        </div>
        <Field label="Tags" name="tags" description="Separados por coma." />
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Compra por WhatsApp</h2>
        <p class="card-section-desc">Mensaje específico para este libro. Si lo dejas vacío, se usa la plantilla global.</p>
      </div>
      <Field
        label="Mensaje WhatsApp (opcional)"
        name="whatsapp_message_override"
        type="textarea"
        rows={3}
        description="Variables disponibles: {{title}}, {{author}}, {{isbn}}, {{slug}}."
      />
    </section>

    <section class="card">
      <div class="mb-4">
        <h2 class="card-section-title">Estado de publicación</h2>
        <p class="card-section-desc">Borrador queda oculto. Publicado dispara un rebuild del sitio público.</p>
      </div>
      <div class="max-w-xs">
        <Dropdown name="status" value="draft" options={statusOptions} />
      </div>
    </section>

    <div class="flex flex-col sm:flex-row gap-3 pt-4">
      <button type="submit" class="btn-primary">Crear libro</button>
      <a href="/books" class="btn">Cancelar</a>
    </div>
  </form>
</AppLayout>
