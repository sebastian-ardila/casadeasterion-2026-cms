---
import AppLayout from "~/layouts/AppLayout.astro";
import { requirePermission } from "~/lib/auth";

const guard = await requirePermission(Astro, "categories", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";
---

<AppLayout title="Categorías" resource="categories">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500">
    <p class="font-serif text-xl mb-2">Categorías</p>
    <p class="text-sm mb-2 max-w-md">
      Selecciona una categoría de la lista{canEdit && " o crea una nueva"}.
    </p>
    <p class="text-xs mb-6 max-w-md">
      Arrastra una categoría o usa los botones <span class="font-mono">↑</span> <span class="font-mono">↓</span> en el panel izquierdo para reordenarlas. El orden se guarda al instante.
    </p>
    {canEdit && (
      <a href="/categories/new" class="btn-primary">+ Nueva categoría</a>
    )}
  </div>
</AppLayout>
