---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq, slugify } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

// SSR: only auth gate + POST writes (update / delete / insert). Reordering
// happens client-side and persists via /api/categories/reorder.
const guard = await requirePermission(Astro, "categories", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

let formError: string | null = null;
const saved = Astro.url.searchParams.get("published") === "1";

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=categories");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");

    let label = "Categorías";
    if (action === "delete") {
      const id = strReq(fd, "id");
      const { error } = await supabase.from("categories").delete().eq("id", id);
      if (error) throw error;
      label = "Categoría eliminada";
    } else if (action === "update") {
      const id = strReq(fd, "id");
      const name = strReq(fd, "name");
      const { error } = await supabase.from("categories").update({
        slug: strReq(fd, "slug"),
        name,
        kind: strReq(fd, "kind"),
        description: str(fd, "description"),
        // sort_order intentionally omitted — managed by the reorder endpoint.
      }).eq("id", id);
      if (error) throw error;
      label = "Categoría: " + name;
    } else {
      // Insert: place new category at the end with sort_order = max + 10.
      const name = strReq(fd, "name");
      const { data: maxRow } = await supabase
        .from("categories")
        .select("sort_order")
        .order("sort_order", { ascending: false })
        .limit(1)
        .maybeSingle();
      const next = ((maxRow?.sort_order ?? 0) as number) + 10;
      const { error } = await supabase.from("categories").insert({
        slug: str(fd, "slug") ?? slugify(name),
        name,
        kind: strReq(fd, "kind"),
        description: str(fd, "description"),
        sort_order: num(fd, "sort_order") ?? next,
      });
      if (error) throw error;
      label = "Categoría: " + name;
    }
    return Astro.redirect(`/categories?published=1&item=${encodeURIComponent(label)}`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const kindOptions = [
  { value: "philosophy", label: "Filosofía", hint: "ensayo, pensamiento" },
  { value: "poetry", label: "Poesía", hint: "verso, antología" },
  { value: "book", label: "Libro", hint: "para libros del catálogo" },
  { value: "other", label: "Otro", hint: "narrativa, varios" },
];
---

<AppLayout title="Categorías">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="min-w-0 flex-1">
      <h1 class="font-serif text-3xl md:text-4xl mb-2">Categorías</h1>
      <p class="text-stone-500 max-w-2xl text-sm md:text-base">
        Las categorías agrupan los artículos y libros por tema. Las de tipo <em>Filosofía</em> y <em>Poesía</em> alimentan los menús del navbar; las de tipo <em>Libro</em> sirven para clasificar el catálogo.
      </p>
      <p class="text-xs text-stone-500 mt-2 max-w-2xl">
        Arrastra una categoría o usa los botones <span class="font-mono">↑</span> <span class="font-mono">↓</span> para reordenarlas. El orden determina cómo aparecen en el sitio público y se guarda al instante.
      </p>
    </div>
    {canEdit && (
      <a href="#new-category" class="hidden sm:inline-flex btn-primary shrink-0">+ Nueva</a>
    )}
  </div>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {saved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Cambios guardados.</p>
  )}

  <div class="mb-12 max-w-5xl" data-categories-root data-can-edit={canEdit ? "1" : "0"}>
    <div data-categories-skeleton>
      {Array.from({ length: 3 }).map(() => (
        <div class="bg-white border border-stone-200 px-4 py-3 mb-2 flex items-center gap-3 animate-pulse">
          <div class="w-5 h-5 bg-stone-100 rounded shrink-0"></div>
          <div class="w-9 h-9 rounded-full bg-stone-200 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="h-3.5 bg-stone-200 rounded w-1/3"></div>
            <div class="h-2.5 bg-stone-100 rounded w-1/2"></div>
          </div>
          <div class="w-16 h-7 bg-stone-100 rounded shrink-0"></div>
        </div>
      ))}
    </div>
    <ul data-categories-list class="hidden flex flex-col gap-2"></ul>
    <p class="hidden text-sm text-red-700 px-2" data-categories-error>No se pudieron cargar las categorías.</p>
    <div data-categories-empty class="hidden border border-dashed border-stone-300 bg-white text-center py-14 px-6">
      <div class="text-4xl mb-3 text-stone-300">◇</div>
      <p class="text-stone-700 font-medium mb-1">Aún no hay categorías</p>
      <p class="text-xs text-stone-500">Crea la primera abajo para empezar a clasificar contenido.</p>
    </div>
    <p class="hidden text-xs text-stone-500 mt-3" data-reorder-hint>
      <span class="cas-loading-mini"><span></span><span></span><span></span></span>
      Guardando nuevo orden…
    </p>
  </div>

  {canEdit && (
  <form method="POST" id="new-category" class="bg-white border-2 border-dashed border-stone-300 max-w-5xl scroll-mt-24">
    <div class="px-4 sm:px-5 py-5 border-b border-dashed border-stone-300 flex items-center gap-3">
      <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-stone-100 text-stone-500 border border-stone-200 text-lg">+</span>
      <div>
        <h2 class="font-serif text-lg leading-tight">Nueva categoría</h2>
        <p class="text-xs text-stone-500">Se agrega al final de la lista. Después puedes arrastrarla a la posición que quieras.</p>
      </div>
    </div>
    <div class="px-4 sm:px-5 py-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4">
      <div class="lg:col-span-5">
        <Field label="Nombre" name="name" required description="Como se mostrará al público." />
      </div>
      <div class="lg:col-span-4">
        <Field label="Slug" name="slug" description="Auto-generado del nombre si lo dejas vacío." />
      </div>
      <div class="lg:col-span-3">
        <span class="label">Tipo</span>
        <p class="text-xs text-stone-500 mt-0 mb-2 leading-relaxed">Determina dónde aparece.</p>
        <Dropdown name="kind" value="philosophy" options={kindOptions} />
      </div>
      <div class="lg:col-span-12">
        <Field label="Descripción" name="description" type="textarea" rows={2} description="Opcional. Se muestra en la cabecera de la sección." />
      </div>
    </div>
    <div class="flex justify-end px-4 sm:px-5 py-3 bg-stone-50 border-t border-dashed border-stone-300">
      <button type="submit" class="btn-primary w-full sm:w-auto">Crear categoría</button>
    </div>
  </form>
  )}
</AppLayout>

<style is:global>
  .cas-cat-row {
    display: flex;
    align-items: stretch;
    background: #fff;
    border: 1px solid #e7e5e4;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s, opacity 0.15s;
  }
  .cas-cat-row:hover {
    border-color: #d6d3d1;
  }
  .cas-cat-row.cas-cat-dragging {
    opacity: 0.4;
  }
  .cas-cat-row.cas-cat-drop-above {
    box-shadow: 0 -2px 0 0 #1c1917 inset;
  }
  .cas-cat-row.cas-cat-drop-below {
    box-shadow: 0 2px 0 0 #1c1917 inset;
  }
  .cas-cat-row.cas-cat-saving {
    border-color: #1c1917;
  }

  .cas-cat-grip {
    flex-shrink: 0;
    width: 32px;
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a8a29e;
    border-right: 1px solid #f5f5f4;
    transition: background 0.15s, color 0.15s;
    user-select: none;
    touch-action: none;
  }
  .cas-cat-grip:hover {
    background: #fafaf9;
    color: #44403c;
  }
  .cas-cat-grip:active {
    cursor: grabbing;
  }

  .cas-cat-emoji {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    margin: 12px 12px 12px 14px;
  }
  .cas-cat-body {
    flex: 1 1 0%;
    min-width: 0;
    padding: 12px 0;
  }
  .cas-cat-arrows {
    display: flex;
    flex-direction: column;
    border-left: 1px solid #f5f5f4;
  }
  .cas-cat-arrow-btn {
    width: 32px;
    flex: 1 1 0%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a8a29e;
    transition: background 0.15s, color 0.15s;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .cas-cat-arrow-btn:hover:not(:disabled) {
    background: #fafaf9;
    color: #1c1917;
  }
  .cas-cat-arrow-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }
  .cas-cat-arrow-btn + .cas-cat-arrow-btn {
    border-top: 1px solid #f5f5f4;
  }

  .cas-cat-actions {
    display: flex;
    align-items: stretch;
    border-left: 1px solid #f5f5f4;
  }
  .cas-cat-toggle {
    width: 36px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a8a29e;
    background: transparent;
    border: 0;
    transition: background 0.15s, color 0.15s;
  }
  .cas-cat-toggle:hover { background: #fafaf9; color: #1c1917; }
  .cas-cat-row.cas-cat-open .cas-cat-toggle svg { transform: rotate(180deg); }

  .cas-cat-edit {
    border-top: 1px solid #f5f5f4;
    background: #fafaf9;
    padding: 16px;
    display: none;
  }
  .cas-cat-row.cas-cat-open .cas-cat-edit { display: block; }

  /* Mini three-dot loading indicator (used in the "saving" hint). */
  .cas-loading-mini {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 8px;
    margin-right: 4px;
    color: currentColor;
  }
  .cas-loading-mini span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
    animation: cas-mini-dot 1.2s ease-in-out infinite;
  }
  .cas-loading-mini span:nth-child(2) { animation-delay: 0.18s; }
  .cas-loading-mini span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes cas-mini-dot {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.3; }
    40%           { transform: scale(1.2); opacity: 1; }
  }
</style>

<script is:inline>
  (() => {
    if (window.__casCategoriesInit) return;
    window.__casCategoriesInit = true;

    const KIND_META = {
      philosophy: { label: "Filosofía", emoji: "✦", color: "background:#eef2ff;color:#3730a3;border-color:#e0e7ff;" },
      poetry:     { label: "Poesía",    emoji: "❀", color: "background:#fff1f2;color:#9f1239;border-color:#ffe4e6;" },
      book:       { label: "Libro",     emoji: "❑", color: "background:#fffbeb;color:#92400e;border-color:#fef3c7;" },
      other:      { label: "Otro",      emoji: "◇", color: "background:#f5f5f4;color:#44403c;border-color:#e7e5e4;" },
    };
    const KIND_OPTIONS = [
      { value: "philosophy", label: "Filosofía" },
      { value: "poetry",     label: "Poesía" },
      { value: "book",       label: "Libro" },
      { value: "other",      label: "Otro" },
    ];

    const escape = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    const renderRow = (c, canEdit) => {
      const meta = KIND_META[c.kind] || KIND_META.other;
      const kindOpts = KIND_OPTIONS.map(
        (o) => `<option value="${o.value}"${o.value === c.kind ? " selected" : ""}>${o.label}</option>`
      ).join("");

      const arrows = canEdit ? `
        <div class="cas-cat-arrows">
          <button type="button" class="cas-cat-arrow-btn" data-move="up" aria-label="Subir">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>
          </button>
          <button type="button" class="cas-cat-arrow-btn" data-move="down" aria-label="Bajar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>` : "";

      const grip = canEdit ? `
        <div class="cas-cat-grip" draggable="true" aria-label="Arrastrar para reordenar" title="Arrastrar para reordenar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/>
            <circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/>
            <circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/>
          </svg>
        </div>` : "";

      const editForm = canEdit ? `
        <div class="cas-cat-edit">
          <form method="POST" class="space-y-4">
            <input type="hidden" name="_action" value="update" />
            <input type="hidden" name="id" value="${escape(c.id)}" />
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4">
              <div class="lg:col-span-5">
                <label class="label">Nombre</label>
                <input type="text" name="name" class="input" value="${escape(c.name)}" required />
              </div>
              <div class="lg:col-span-4">
                <label class="label">Slug</label>
                <input type="text" name="slug" class="input" value="${escape(c.slug)}" required />
              </div>
              <div class="lg:col-span-3">
                <label class="label">Tipo</label>
                <select name="kind" class="input">${kindOpts}</select>
              </div>
              <div class="lg:col-span-12">
                <label class="label">Descripción</label>
                <textarea name="description" class="input" rows="2">${escape(c.description ?? "")}</textarea>
              </div>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2 border-t border-stone-200">
              <button type="submit" formnovalidate name="_action" value="delete" class="btn-danger sm:mr-auto" onclick="return confirm('¿Borrar la categoría &quot;${escape(c.name)}&quot;? Los artículos y libros asociados quedarán sin categoría.')">Borrar</button>
              <button type="submit" class="btn-primary">Guardar cambios</button>
            </div>
          </form>
        </div>` : "";

      return `
        <li class="cas-cat-row" data-id="${escape(c.id)}">
          ${grip}
          <span class="cas-cat-emoji" style="${meta.color}">${meta.emoji}</span>
          <div class="cas-cat-body">
            <p class="font-serif text-lg leading-tight truncate">${escape(c.name)}</p>
            <p class="text-[11px] text-stone-500 mt-0.5">
              <span class="uppercase tracking-[0.1em]">${meta.label}</span>
              <span class="text-stone-300 mx-1">·</span>
              <span class="text-stone-400">/${escape(c.slug)}</span>
              ${c.description ? `<span class="text-stone-300 mx-1">·</span><span class="truncate">${escape(c.description)}</span>` : ""}
            </p>
          </div>
          ${arrows}
          <div class="cas-cat-actions">
            <button type="button" class="cas-cat-toggle" data-toggle aria-label="Editar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
          </div>
          ${editForm}
        </li>`;
    };

    const cacheKey = "cas:categories";
    const TTL = 60_000;

    let listEl = null;
    let hint = null;

    const updateArrowDisabled = () => {
      if (!listEl) return;
      const rows = Array.from(listEl.querySelectorAll(".cas-cat-row"));
      rows.forEach((row, idx) => {
        const upBtn = row.querySelector('[data-move="up"]');
        const downBtn = row.querySelector('[data-move="down"]');
        if (upBtn) upBtn.disabled = idx === 0;
        if (downBtn) downBtn.disabled = idx === rows.length - 1;
      });
    };

    const persistOrder = async () => {
      if (!listEl) return;
      const ids = Array.from(listEl.querySelectorAll(".cas-cat-row")).map((r) => r.dataset.id);
      if (hint) hint.classList.remove("hidden");
      listEl.querySelectorAll(".cas-cat-row").forEach((r) => r.classList.add("cas-cat-saving"));
      try {
        const res = await fetch("/api/categories/reorder", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ order: ids }),
        });
        if (!res.ok) throw new Error("http_" + res.status);
        // Bust the categories cache so the next /api/page-data?type=categories
        // reflects the new order.
        try { sessionStorage.removeItem(cacheKey); } catch {}
        // Surface a build toast so the user sees the rebuild propagate.
        if (typeof window.__casAddBuildToast === "function") {
          window.__casAddBuildToast("Categorías reordenadas");
        }
      } catch (e) {
        if (hint) {
          hint.classList.remove("hidden");
          hint.innerHTML = "<span style='color:#b91c1c'>No se pudo guardar el orden. Inténtalo otra vez.</span>";
          setTimeout(() => { if (hint) hint.innerHTML = restoreHintHtml; }, 4000);
        }
      } finally {
        listEl.querySelectorAll(".cas-cat-row").forEach((r) => r.classList.remove("cas-cat-saving"));
        if (hint) {
          setTimeout(() => hint.classList.add("hidden"), 800);
        }
      }
    };
    let restoreHintHtml = "";

    const move = (id, direction) => {
      if (!listEl) return;
      const row = listEl.querySelector(`.cas-cat-row[data-id="${id}"]`);
      if (!row) return;
      const sibling = direction === "up" ? row.previousElementSibling : row.nextElementSibling;
      if (!sibling) return;
      if (direction === "up") listEl.insertBefore(row, sibling);
      else listEl.insertBefore(sibling, row);
      updateArrowDisabled();
      persistOrder();
    };

    // ── Drag & drop ──
    let draggedRow = null;

    const wireDragHandlers = (row) => {
      const grip = row.querySelector(".cas-cat-grip");
      if (!grip) return;
      grip.addEventListener("dragstart", (e) => {
        draggedRow = row;
        row.classList.add("cas-cat-dragging");
        try {
          e.dataTransfer.effectAllowed = "move";
          e.dataTransfer.setData("text/plain", row.dataset.id || "");
        } catch {}
      });
      grip.addEventListener("dragend", () => {
        row.classList.remove("cas-cat-dragging");
        listEl?.querySelectorAll(".cas-cat-drop-above, .cas-cat-drop-below")
          .forEach((r) => r.classList.remove("cas-cat-drop-above", "cas-cat-drop-below"));
      });
    };

    const wireListDragOver = () => {
      if (!listEl) return;
      listEl.addEventListener("dragover", (e) => {
        if (!draggedRow) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = "move";
        const target = e.target instanceof Element ? e.target.closest(".cas-cat-row") : null;
        listEl.querySelectorAll(".cas-cat-drop-above, .cas-cat-drop-below")
          .forEach((r) => r.classList.remove("cas-cat-drop-above", "cas-cat-drop-below"));
        if (!target || target === draggedRow) return;
        const rect = target.getBoundingClientRect();
        const before = e.clientY < rect.top + rect.height / 2;
        target.classList.add(before ? "cas-cat-drop-above" : "cas-cat-drop-below");
      });
      listEl.addEventListener("drop", (e) => {
        if (!draggedRow) return;
        e.preventDefault();
        const target = e.target instanceof Element ? e.target.closest(".cas-cat-row") : null;
        listEl.querySelectorAll(".cas-cat-drop-above, .cas-cat-drop-below")
          .forEach((r) => r.classList.remove("cas-cat-drop-above", "cas-cat-drop-below"));
        if (!target || target === draggedRow) {
          draggedRow = null;
          return;
        }
        const rect = target.getBoundingClientRect();
        const before = e.clientY < rect.top + rect.height / 2;
        if (before) listEl.insertBefore(draggedRow, target);
        else listEl.insertBefore(draggedRow, target.nextElementSibling);
        draggedRow = null;
        updateArrowDisabled();
        persistOrder();
      });
    };

    const wireRow = (row) => {
      // Toggle edit form
      const toggleBtn = row.querySelector("[data-toggle]");
      toggleBtn?.addEventListener("click", () => row.classList.toggle("cas-cat-open"));
      // Move arrows
      row.querySelectorAll("[data-move]").forEach((btn) => {
        btn.addEventListener("click", () => move(row.dataset.id, btn.dataset.move));
      });
      wireDragHandlers(row);
    };

    const render = (root, categories) => {
      const skeleton = root.querySelector("[data-categories-skeleton]");
      const list = root.querySelector("[data-categories-list]");
      const empty = root.querySelector("[data-categories-empty]");
      const errEl = root.querySelector("[data-categories-error]");
      const canEdit = root.dataset.canEdit === "1";
      skeleton?.classList.add("hidden");
      errEl?.classList.add("hidden");
      if (!categories || categories.length === 0) {
        empty?.classList.remove("hidden");
        list?.classList.add("hidden");
        return;
      }
      empty?.classList.add("hidden");
      list.classList.remove("hidden");
      list.innerHTML = categories.map((c) => renderRow(c, canEdit)).join("");

      listEl = list;
      hint = root.querySelector("[data-reorder-hint]");
      if (hint) restoreHintHtml = hint.innerHTML;
      list.querySelectorAll(".cas-cat-row").forEach(wireRow);
      wireListDragOver();
      updateArrowDisabled();
    };

    const showError = (root) => {
      root.querySelector("[data-categories-skeleton]")?.classList.add("hidden");
      root.querySelector("[data-categories-error]")?.classList.remove("hidden");
    };

    const hydrate = async () => {
      const root = document.querySelector("[data-categories-root]");
      if (!root) return;
      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) render(root, parsed.categories);
        }
      } catch {}
      try {
        const res = await fetch("/api/page-data?type=categories", {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) {
          if (root.querySelector("[data-categories-list]").classList.contains("hidden")) showError(root);
          return;
        }
        const data = await res.json();
        render(root, data.categories);
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), categories: data.categories })); } catch {}
      } catch {
        if (root.querySelector("[data-categories-list]").classList.contains("hidden")) showError(root);
      }
    };

    const run = () => {
      if (document.querySelector("[data-categories-root]")) hydrate();
    };

    document.addEventListener("astro:page-load", () => {
      const url = new URL(window.location.href);
      if (url.searchParams.has("published")) {
        try { sessionStorage.removeItem(cacheKey); } catch {}
      }
      run();
    });
    document.addEventListener("astro:after-swap", run);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", run);
    } else {
      run();
    }
  })();
</script>
