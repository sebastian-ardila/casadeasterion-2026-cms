---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import Dropdown from "~/components/Dropdown.astro";
import BackToList from "~/components/BackToList.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { num, str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "categories", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/categories");

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=categories");
  try {
    const fd = await Astro.request.formData();
    const action = str(fd, "_action");

    if (action === "delete") {
      const { error } = await supabase.from("categories").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect(`/categories?saved=1&action=deleted&entity=category&publish=1`);
    }

    const name = strReq(fd, "name");
    const { error } = await supabase
      .from("categories")
      .update({
        name,
        slug: strReq(fd, "slug"),
        kind: strReq(fd, "kind"),
        description: str(fd, "description"),
        // sort_order intentionally omitted — managed via /api/categories/reorder.
      })
      .eq("id", id);
    if (error) throw error;
    return Astro.redirect(`/categories/${id}?saved=1&action=updated&entity=category&publish=1`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const { data: category } = await supabase.from("categories").select("*").eq("id", id).maybeSingle();
if (!category) return Astro.redirect("/categories");

const kindOptions = [
  { value: "philosophy", label: "Filosofía", hint: "ensayo, pensamiento" },
  { value: "poetry", label: "Poesía", hint: "verso, antología" },
  { value: "book", label: "Libro", hint: "para libros del catálogo" },
  { value: "other", label: "Otro", hint: "narrativa, varios" },
];
---

<AppLayout title={category.name} resource="categories" activeId={category.id} breadcrumbLabel={category.name}>
  <BackToList href="/categories" label="Categorías" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{category.name}</h1>
    <p class="text-stone-500 text-xs">/{category.slug} · orden {category.sort_order ?? 0}</p>
  </header>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar esta categoría.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">
    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad</h2>
        <p class="card-section-desc">Cómo se nombra y se encuentra la categoría en el sitio.</p>
      </div>
      <Field label="Nombre" name="name" value={category.name} required description="Como se mostrará al público." />
      <Field label="Slug" name="slug" value={category.slug} required description="Solo minúsculas, números y guiones." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Tipo</h2>
        <p class="card-section-desc">Determina dónde aparece la categoría en el sitio público.</p>
      </div>
      <Dropdown name="kind" value={category.kind} options={kindOptions} />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Descripción</h2>
        <p class="card-section-desc">Texto opcional que puede aparecer en la cabecera de la sección y en meta tags SEO.</p>
      </div>
      <Field label="Descripción" name="description" type="textarea" rows={3} value={category.description} description="Opcional." />
    </section>

    <p class="text-xs text-stone-500">
      El <strong>orden</strong> se ajusta arrastrando categorías en el panel de la izquierda o con los botones <span class="font-mono">↑</span> <span class="font-mono">↓</span>. No es un campo editable aquí.
    </p>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-3 pt-4 border-t border-stone-200">
      {canEdit ? (
        <>
          <button type="submit" class="btn-primary">Guardar cambios</button>
          <a href="/categories" class="btn">Cancelar</a>
        </>
      ) : (
        <a href="/categories" class="btn">Volver a la lista</a>
      )}
    </div>
    </fieldset>
  </form>

  {canEdit && (
  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-3xl"
    onsubmit={`return confirm('¿Borrar la categoría "${category.name}"? Los artículos y libros asociados quedarán sin categoría.')`}
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar categoría</button>
  </form>
  )}
</AppLayout>
