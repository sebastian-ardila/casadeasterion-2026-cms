---
import AppLayout from "~/layouts/AppLayout.astro";
import BackToList from "~/components/BackToList.astro";
import Dropdown from "~/components/Dropdown.astro";
import { Icon } from "astro-icon/components";
import { requirePermission, CONFIGURABLE_RESOURCES, RESOURCE_LABEL, invalidateAuthCache, type Resource, type Level } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "admins", "view");
if (guard instanceof Response) return guard;
const owner = guard.user;
const isOwner = owner.role === "owner";
const grantedEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admins");

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");

    if (action === "remove_admin") {
      const email = strReq(fd, "email").toLowerCase();
      if (email === owner.email.toLowerCase()) throw new Error("no puedes quitarte a ti mismo");
      // A non-owner manager (admin) cannot revoke another admin or owner.
      if (!isOwner) {
        const { data: target } = await supabase.from("profiles").select("role").eq("id", id).maybeSingle();
        if (!target || target.role !== "editor") throw new Error("solo el owner puede revocar a otro admin");
      }
      // Drop from the allowlist AND demote the profile in the same flow so
      // their next request lands on requireAdmin → not_admin instead of
      // staying logged-in until they manually re-auth.
      const { error: delErr } = await supabase.from("admin_emails").delete().eq("email", email);
      if (delErr) throw delErr;
      const { error: updErr } = await supabase
        .from("profiles")
        .update({ role: "viewer" })
        .eq("id", id)
        .neq("role", "owner");
      if (updErr) throw updErr;
      // Bust the cached auth state so the change takes effect on the next
      // request from the affected user.
      invalidateAuthCache(Astro, id);
      return Astro.redirect(`/admins?saved=1&action=deleted&msg=${encodeURIComponent(`Acceso revocado: ${email}`)}`);
    }
    throw new Error("acción desconocida");
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Load profile + current permissions
const [{ data: profile }, { data: permRows }] = await Promise.all([
  supabase
    .from("profiles")
    .select("id, email, full_name, avatar_url, role")
    .eq("id", id)
    .maybeSingle(),
  supabase
    .from("admin_permissions")
    .select("resource, level")
    .eq("profile_id", id),
]);

if (!profile) return Astro.redirect("/admins");

const isOwnerRow = profile.role === "owner";
const isAdminRow = profile.role === "admin";
const isEditorRow = profile.role === "editor";
const isSelf = profile.id === owner.id;
// Non-owner managers (admins) can only edit editors. They can VIEW other
// admins/owner but cannot change permissions or revoke them.
const canEdit = grantedEdit && (isOwner || isEditorRow);

// Build current permissions map. Only "admins" (user management) stays
// role-derived; everything else — including orders and subscribers — is
// stored per-user in admin_permissions and editable from this page.
type ConfigurableResource = (typeof CONFIGURABLE_RESOURCES)[number];
const perms: Record<ConfigurableResource, Level> = {
  posts: "none", books: "none", authors: "none", collaborators: "none",
  translators: "none", prologuists: "none",
  staff: "none", collections: "none", categories: "none", site: "none",
  orders: "none", subscribers: "none",
};
if (isOwnerRow) {
  for (const r of CONFIGURABLE_RESOURCES) perms[r] = "edit";
} else {
  for (const row of permRows ?? []) {
    if ((CONFIGURABLE_RESOURCES as string[]).includes(row.resource)) {
      perms[row.resource as ConfigurableResource] = row.level as Level;
    }
  }
}

const initials = (s: string | null, fallback: string) =>
  ((s ?? fallback).trim().split(/\s+/).slice(0, 2).map((p) => p[0]).join("") || "?").toUpperCase();

const LEVELS: { value: Level; label: string; hint?: string; icon: string }[] = [
  { value: "none", label: "Sin acceso", icon: "lucide:ban" },
  { value: "view", label: "Ver",    icon: "lucide:eye",     hint: "solo lectura" },
  { value: "edit", label: "Editar", icon: "lucide:pencil",  hint: "lectura + escritura" },
];

const RESOURCE_ICON: Record<ConfigurableResource, string> = {
  posts: "lucide:newspaper",
  books: "lucide:book-open",
  authors: "lucide:users",
  collaborators: "lucide:user-plus",
  translators: "lucide:languages",
  prologuists: "lucide:quote",
  staff: "lucide:building",
  collections: "lucide:library",
  categories: "lucide:folder-tree",
  site: "lucide:settings",
  orders: "lucide:shopping-bag",
  subscribers: "lucide:mail",
};
---

<AppLayout title={profile.full_name ?? profile.email} resource="admins" activeId={profile.id} breadcrumbLabel={profile.full_name ?? profile.email}>
  <BackToList href="/admins" label="Usuarios" />

  {/* Header card with avatar */}
  <header class="flex flex-col sm:flex-row sm:items-center gap-5 mb-8 max-w-3xl">
    {profile.avatar_url ? (
      <img
        src={profile.avatar_url}
        alt=""
        referrerpolicy="no-referrer"
        class="w-20 h-20 rounded-full object-cover shrink-0 border border-stone-200"
      />
    ) : (
      <div class="w-20 h-20 rounded-full bg-stone-200 shrink-0 flex items-center justify-center text-stone-700 text-xl font-medium">
        {initials(profile.full_name, profile.email)}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <h1 class="font-serif text-3xl md:text-4xl leading-tight">{profile.full_name ?? profile.email}</h1>
      <p class="text-stone-500 text-sm mt-1 truncate">{profile.email}</p>
      <div class="flex items-center gap-2 mt-2">
        <span class:list={[
          "inline-flex items-center text-[10px] uppercase tracking-[0.14em] px-2 py-0.5",
          isOwnerRow ? "bg-violet-100 text-violet-900"
            : isAdminRow ? "bg-stone-900 text-white"
            : "bg-stone-100 text-stone-700",
        ]}>
          {isOwnerRow ? "Owner" : isAdminRow ? "Admin" : "Editor"}
        </span>
        {isSelf && (
          <span class="text-[11px] text-stone-500 italic">— tú</span>
        )}
      </div>
    </div>
  </header>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6 max-w-3xl">{formError}</p>
  )}

  {/* Permissions editor */}
  <form
    class="card max-w-3xl mb-12"
    data-perms-form
    data-profile-id={profile.id}
    data-original={JSON.stringify(perms)}
  >
    <div class="mb-5">
      <h2 class="card-section-title">Permisos por sección</h2>
      <p class="card-section-desc">
        {isOwnerRow
          ? "El owner siempre tiene acceso completo a todas las secciones."
          : `Define qué puede ver y editar este ${isAdminRow ? "admin" : "editor"} en cada sección del CMS.`}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {CONFIGURABLE_RESOURCES.map((r) => (
        <div class="flex flex-col">
          <label class="flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] text-stone-500 mb-1.5">
            <Icon name={RESOURCE_ICON[r]} class="w-3.5 h-3.5" aria-hidden="true" />
            <span>{RESOURCE_LABEL[r]}</span>
          </label>
          <Dropdown
            name={`level_${r}`}
            value={perms[r]}
            options={LEVELS}
            disabled={isOwnerRow || !canEdit}
          />
        </div>
      ))}
    </div>

    {!isOwnerRow && canEdit && (
      <div class="flex items-center justify-end gap-3 mt-5 pt-5 border-t border-stone-100" data-perms-savebar>
        <span class="text-xs text-stone-500 hidden" data-perms-status>Sin cambios pendientes.</span>
        <button type="button" class="btn cursor-pointer hidden" data-perms-revert>Descartar</button>
        <button type="submit" class="btn-primary" disabled data-perms-save>Guardar cambios</button>
      </div>
    )}

    {!canEdit && (
      <p class="text-xs text-stone-500 mt-5 italic">Solo lectura — no tienes permiso de editar.</p>
    )}
  </form>

  {/* Danger zone — revoke (anyone with edit) or fully delete (owner only).
      Hidden for owner row and for the logged-in user editing themselves. */}
  {!isOwnerRow && !isSelf && (canEdit || isOwner) && (
    <section class="mt-12 pt-6 border-t border-red-200 max-w-3xl">
      <p class="text-sm text-stone-600 mb-1">Zona de peligro</p>
      <p class="text-xs text-stone-500 mb-4 max-w-2xl">
        Revocar el acceso quita al usuario del CMS pero conserva sus datos
        (perfil, permisos previos) por si quieres restaurarle el acceso luego.
        {isOwner && " Eliminar borra todo del usuario sin posibilidad de recuperar."}
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        {canEdit && (
          <form
            method="POST"
            class="inline-block"
            data-cas-confirm="El usuario deja de tener acceso al CMS. Sus datos se conservan y podrás restaurarlo desde la lista de revocados."
            data-cas-confirm-title="¿Revocar acceso?"
            data-cas-confirm-subtitle={profile.email}
            data-cas-confirm-label="Revocar"
          >
            <input type="hidden" name="_action" value="remove_admin" />
            <input type="hidden" name="email" value={profile.email} />
            <button type="submit" class="btn-danger w-full sm:w-auto">Revocar acceso</button>
          </form>
        )}
        {isOwner && (
          <button
            type="button"
            class="btn-danger w-full sm:w-auto"
            data-delete-user
            data-profile-id={profile.id}
            data-profile-email={profile.email}
          >
            Eliminar usuario completamente
          </button>
        )}
      </div>
    </section>
  )}
</AppLayout>

<script is:inline>
  // Detect-changes + save handler. Identical pattern to the bulk admins page
  // it replaces, but scoped to a single profile.
  (() => {
    if (window.__casAdminDetailInit) return;
    window.__casAdminDetailInit = true;

    const decodeOriginal = (form) => {
      try {
        const txt = document.createElement("textarea");
        txt.innerHTML = form.dataset.original || "{}";
        return JSON.parse(txt.value);
      } catch {
        return {};
      }
    };
    const collectCurrent = (form) => {
      const cur = {};
      form.querySelectorAll('[data-dropdown]').forEach((dd) => {
        const name = dd.dataset.name || "";
        if (!name.startsWith("level_")) return;
        const r = name.slice("level_".length);
        const input = dd.querySelector('[data-dd-input]');
        cur[r] = input ? input.value : "";
      });
      return cur;
    };
    const diff = (orig, cur) => {
      const changes = {};
      let count = 0;
      for (const k of Object.keys(cur)) {
        if (cur[k] !== orig[k]) {
          changes[k] = cur[k];
          count++;
        }
      }
      return { changes, count };
    };

    const updateBar = (form) => {
      const saveBtn = form.querySelector("[data-perms-save]");
      const revertBtn = form.querySelector("[data-perms-revert]");
      const status = form.querySelector("[data-perms-status]");
      if (!saveBtn) return;
      const { count } = diff(decodeOriginal(form), collectCurrent(form));
      saveBtn.disabled = count === 0;
      revertBtn?.classList.toggle("hidden", count === 0);
      if (status) {
        status.classList.toggle("hidden", count === 0);
        status.textContent = count === 0
          ? ""
          : `${count} ${count === 1 ? "cambio sin guardar" : "cambios sin guardar"}`;
        status.classList.toggle("text-amber-700", count > 0);
        status.classList.toggle("font-medium", count > 0);
      }
    };

    const submitPerms = async (form) => {
      const profileId = form.dataset.profileId;
      const orig = decodeOriginal(form);
      const cur = collectCurrent(form);
      const { changes, count } = diff(orig, cur);
      if (count === 0 || !profileId) return;

      const saveBtn = form.querySelector("[data-perms-save]");
      const status = form.querySelector("[data-perms-status]");
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = "Guardando…";
      }
      try {
        const res = await fetch("/api/admins/permissions", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ profileId, permissions: changes }),
        });
        if (!res.ok) throw new Error("http_" + res.status);
        form.dataset.original = JSON.stringify(cur);
        if (typeof window.casToast === "function") {
          window.casToast({ type: "success", message: "Permisos guardados." });
        }
      } catch {
        if (typeof window.casToast === "function") {
          window.casToast({ type: "error", message: "No se pudo guardar." });
        }
      } finally {
        if (saveBtn) saveBtn.textContent = "Guardar cambios";
        updateBar(form);
      }
    };

    const revert = (form) => {
      const orig = decodeOriginal(form);
      form.querySelectorAll('[data-dropdown]').forEach((dd) => {
        const name = dd.dataset.name || "";
        if (!name.startsWith("level_")) return;
        const r = name.slice("level_".length);
        const target = orig[r];
        if (!target) return;
        const opt = dd.querySelector(`[data-dd-option][data-value="${target}"]`);
        if (opt instanceof HTMLElement) opt.click();
      });
      updateBar(form);
    };

    const wire = () => {
      const form = document.querySelector("[data-perms-form]");
      if (!form || form.dataset.casWired) return;
      form.dataset.casWired = "1";
      // Dropdowns dispatch a 'change' event on their hidden input when the
      // user picks an option. The hidden input has name="level_<resource>".
      form.addEventListener("change", (e) => {
        const t = e.target;
        if (t instanceof HTMLInputElement && t.name?.startsWith("level_")) updateBar(form);
      });
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        submitPerms(form);
      });
      form.addEventListener("click", (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest("[data-perms-revert]")) {
          e.preventDefault();
          revert(form);
        }
      });
      updateBar(form);
    };

    // Delete-user button: confirms loudly, then POSTs to /api/admins/delete-user.
    const wireDelete = () => {
      const btn = document.querySelector("[data-delete-user]");
      if (!btn || btn.dataset.casWired) return;
      btn.dataset.casWired = "1";
      btn.addEventListener("click", async () => {
        const email = btn.dataset.profileEmail || "este usuario";
        const id = btn.dataset.profileId;
        if (!id) return;
        const ok = await window.casConfirm?.({
          title: "¿Eliminar usuario completamente?",
          subtitle: email,
          message:
            "Se borra su perfil, sus permisos, su sesión y cualquier suscripción al newsletter asociada al mismo correo. NO SE PUEDE DESHACER.",
          label: "Eliminar definitivamente",
          typed: email,
        });
        if (!ok) return;
        btn.disabled = true;
        btn.textContent = "Eliminando…";
        try {
          const res = await fetch("/api/admins/delete-user", {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json", accept: "application/json" },
            body: JSON.stringify({ profileId: id }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error ?? `http_${res.status}`);
          }
          if (typeof window.casToast === "function") {
            window.casToast({ type: "success", message: `Usuario ${email} eliminado.` });
          }
          window.location.href = "/admins";
        } catch (err) {
          btn.disabled = false;
          btn.textContent = "Eliminar usuario completamente";
          if (typeof window.casToast === "function") {
            window.casToast({
              type: "error",
              message: err instanceof Error ? err.message : "No se pudo eliminar.",
            });
          }
        }
      });
    };

    document.addEventListener("astro:page-load", () => { wire(); wireDelete(); });
    document.addEventListener("astro:after-swap", () => { wire(); wireDelete(); });
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => { wire(); wireDelete(); });
    } else {
      wire();
      wireDelete();
    }
  })();
</script>
