---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import BackToList from "~/components/BackToList.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "admins", "edit");
if (guard instanceof Response) return guard;
const owner = guard.user;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");

    if (action === "add_email") {
      const email = strReq(fd, "email").trim().toLowerCase();
      const note = str(fd, "note");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error("email inválido");
      const { error } = await supabase
        .from("admin_emails")
        .insert({ email, note, added_by: owner.id });
      if (error) throw error;
      return Astro.redirect(`/admins/new?saved=1&msg=${encodeURIComponent(`Email pre-aprobado: ${email}`)}`);
    } else if (action === "remove_pending") {
      const email = strReq(fd, "email").toLowerCase();
      const { error } = await supabase.from("admin_emails").delete().eq("email", email);
      if (error) throw error;
      return Astro.redirect(`/admins/new?saved=1&action=deleted&msg=${encodeURIComponent(`Eliminado de la lista: ${email}`)}`);
    }
    throw new Error("acción desconocida");
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Pending allowlist: emails pre-aprobados que aún no se han logueado.
// Revoked: profiles role='viewer' that have admin_permissions rows (signal
// that they were once admins) and aren't in admin_emails anymore.
const [{ data: profiles }, { data: allowlist }, { data: revokedRaw }] = await Promise.all([
  supabase.from("profiles").select("email").in("role", ["owner", "admin"]),
  supabase.from("admin_emails").select("email, added_at, note").order("added_at", { ascending: false }),
  supabase
    .from("profiles")
    .select("id, email, full_name, avatar_url, role, admin_permissions(profile_id)")
    .eq("role", "viewer"),
]);
const profileEmails = new Set((profiles ?? []).map((p) => p.email.toLowerCase()));
const pending = (allowlist ?? []).filter((a) => !profileEmails.has(a.email.toLowerCase()));

const allowlistSet = new Set((allowlist ?? []).map((a: any) => a.email.toLowerCase()));
const revoked = (revokedRaw ?? [])
  .filter((p: any) => Array.isArray(p.admin_permissions) && p.admin_permissions.length > 0)
  .filter((p: any) => !allowlistSet.has(p.email.toLowerCase()))
  .sort((a: any, b: any) => (a.full_name ?? a.email).localeCompare(b.full_name ?? b.email));

const isOwner = guard.user.role === "owner";

const initials = (s: string | null, fallback: string) =>
  ((s ?? fallback).trim().split(/\s+/).slice(0, 2).map((p) => p[0]).join("") || "?").toUpperCase();
---

<AppLayout title="Nuevo administrador" resource="admins">
  <BackToList href="/admins" label="Administradores" />
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Nuevo administrador</h1>
  <p class="text-stone-500 text-sm mb-8 max-w-2xl">
    Agrega el correo de Google que quieres autorizar. La persona podrá iniciar sesión en el CMS apenas la apruebes; entrará sin permisos en ninguna sección y podrás darle acceso desde su perfil.
  </p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6 max-w-3xl">{formError}</p>
  )}

  <form method="POST" class="card max-w-3xl mb-12">
    <input type="hidden" name="_action" value="add_email" />
    <div>
      <h2 class="card-section-title">Pre-aprobar email</h2>
      <p class="card-section-desc">Google verifica el correo al iniciar sesión. Solo correos en esta lista pueden entrar al CMS.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end mt-5">
      <div class="sm:col-span-5">
        <Field label="Email de Google" name="email" type="email" required description="Ej: alguien@dominio.com" />
      </div>
      <div class="sm:col-span-5">
        <Field label="Nota (opcional)" name="note" description="Rol o quién es esta persona." />
      </div>
      <div class="sm:col-span-2 flex justify-end">
        <button type="submit" class="btn-primary w-full sm:w-auto">Agregar</button>
      </div>
    </div>
  </form>

  {pending.length > 0 && (
    <section class="max-w-3xl mb-12">
      <h2 class="font-serif text-xl mb-2">Pre-aprobados</h2>
      <p class="text-sm text-stone-500 mb-4">
        Estos correos pueden iniciar sesión en el CMS pero aún no se han logueado por primera vez. Cuando lo hagan, aparecerán en la lista de la izquierda.
      </p>
      <div class="card p-0 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-stone-50 text-xs uppercase tracking-[0.12em] text-stone-600">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">Email</th>
              <th class="text-left px-4 py-3 font-semibold">Nota</th>
              <th class="text-left px-4 py-3 font-semibold">Agregado</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {pending.map((e) => (
              <tr class="border-t border-stone-100">
                <td class="px-4 py-3">{e.email}</td>
                <td class="px-4 py-3 text-stone-600">{e.note ?? "—"}</td>
                <td class="px-4 py-3 text-stone-500 text-xs">{new Date(e.added_at).toLocaleDateString()}</td>
                <td class="px-4 py-3 text-right">
                  <form method="POST" onsubmit={`return confirm('¿Quitar ${e.email} de la lista?')`}>
                    <input type="hidden" name="_action" value="remove_pending" />
                    <input type="hidden" name="email" value={e.email} />
                    <button class="cursor-pointer text-xs text-red-700 hover:underline">Quitar</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {revoked.length > 0 && (
    <section class="max-w-3xl">
      <h2 class="font-serif text-xl mb-2">Acceso revocado</h2>
      <p class="text-sm text-stone-500 mb-4">
        Estas personas tuvieron acceso al CMS y ya no lo tienen. Su perfil y permisos previos siguen guardados — puedes restaurarles el acceso o (solo el owner) borrar todos sus datos definitivamente.
      </p>
      <ul class="space-y-3">
        {revoked.map((p: any) => (
          <li
            class="card flex flex-col sm:flex-row sm:items-center gap-4 p-4"
            data-revoked-row
            data-profile-id={p.id}
            data-profile-email={p.email}
          >
            {p.avatar_url ? (
              <img
                src={p.avatar_url}
                alt=""
                referrerpolicy="no-referrer"
                class="w-11 h-11 rounded-full object-cover shrink-0 border border-stone-200"
              />
            ) : (
              <div class="w-11 h-11 rounded-full bg-stone-200 shrink-0 flex items-center justify-center text-stone-700 text-sm font-medium">
                {initials(p.full_name, p.email)}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <p class="font-medium text-stone-900 text-sm truncate">{p.full_name ?? p.email}</p>
              <p class="text-xs text-stone-500 truncate">{p.email}</p>
              <p class="text-[10px] uppercase tracking-[0.12em] text-stone-400 mt-0.5">Revocado</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2 shrink-0">
              <button type="button" class="btn cursor-pointer" data-grant-btn>Dar acceso</button>
              {isOwner && (
                <button type="button" class="btn-danger cursor-pointer" data-delete-btn>Eliminar</button>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</AppLayout>

<script is:inline>
  (() => {
    if (window.__casRevokedInit) return;
    window.__casRevokedInit = true;

    const wireRow = (li) => {
      if (li.dataset.casWired) return;
      li.dataset.casWired = "1";

      const id = li.dataset.profileId;
      const email = li.dataset.profileEmail;
      const grantBtn = li.querySelector("[data-grant-btn]");
      const deleteBtn = li.querySelector("[data-delete-btn]");

      grantBtn?.addEventListener("click", async () => {
        if (!confirm(`¿Restaurar acceso de ${email}?`)) return;
        grantBtn.disabled = true;
        grantBtn.textContent = "Dando acceso…";
        try {
          const res = await fetch("/api/admins/grant-access", {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json", accept: "application/json" },
            body: JSON.stringify({ email, profileId: id }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error ?? `http_${res.status}`);
          }
          if (typeof window.casToast === "function") {
            window.casToast({ type: "success", message: `Acceso restaurado: ${email}` });
          }
          window.location.reload();
        } catch (err) {
          grantBtn.disabled = false;
          grantBtn.textContent = "Dar acceso";
          if (typeof window.casToast === "function") {
            window.casToast({
              type: "error",
              message: err instanceof Error ? err.message : "No se pudo restaurar el acceso.",
            });
          }
        }
      });

      deleteBtn?.addEventListener("click", async () => {
        if (!confirm(
          `¿Eliminar definitivamente a ${email}?\n\n` +
          "Se borrará su perfil, sus permisos, sus sesiones, y cualquier suscripción al newsletter asociada. NO SE PUEDE DESHACER."
        )) return;
        const second = window.prompt(`Para confirmar, escribe el correo: ${email}`);
        if (second?.trim().toLowerCase() !== email.toLowerCase()) {
          if (typeof window.casToast === "function") {
            window.casToast({ type: "error", message: "Correo no coincide. Cancelado." });
          }
          return;
        }
        deleteBtn.disabled = true;
        deleteBtn.textContent = "Eliminando…";
        try {
          const res = await fetch("/api/admins/delete-user", {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json", accept: "application/json" },
            body: JSON.stringify({ profileId: id }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error ?? `http_${res.status}`);
          }
          if (typeof window.casToast === "function") {
            window.casToast({ type: "success", message: `Usuario ${email} eliminado.` });
          }
          li.remove();
        } catch (err) {
          deleteBtn.disabled = false;
          deleteBtn.textContent = "Eliminar";
          if (typeof window.casToast === "function") {
            window.casToast({
              type: "error",
              message: err instanceof Error ? err.message : "No se pudo eliminar.",
            });
          }
        }
      });
    };

    const wireAll = () => {
      document.querySelectorAll("[data-revoked-row]").forEach(wireRow);
    };

    document.addEventListener("astro:page-load", wireAll);
    document.addEventListener("astro:after-swap", wireAll);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wireAll);
    } else {
      wireAll();
    }
  })();
</script>
