---
import AppLayout from "~/layouts/AppLayout.astro";
import { requirePermission } from "~/lib/auth";

const guard = await requirePermission(Astro, "collections", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";
---

<AppLayout title="Colecciones" resource="collections">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500">
    <p class="font-serif text-xl mb-2">Colecciones</p>
    <p class="text-sm mb-6">Selecciona una colección de la lista{canEdit && " o crea una nueva"}.</p>
    {canEdit && (
      <a href="/collections/new" class="btn-primary">+ Nueva colección</a>
    )}
  </div>
</AppLayout>
