---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import FormActions from "~/components/FormActions.astro";
import Dropdown from "~/components/Dropdown.astro";
import MultiBookPicker from "~/components/MultiBookPicker.astro";
import { Icon } from "astro-icon/components";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import {
  parseIds,
  syncCollectionBooks,
  fetchCollectionBookIds,
} from "~/lib/collections-sync";

const guard = await requirePermission(Astro, "collections", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/collections");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=collections");
  try {
    const fd = await Astro.request.formData();
    if (str(fd, "_action") === "delete") {
      // El FK books.collection_id es ON DELETE SET NULL, así que los
      // libros de la colección quedan disponibles automáticamente.
      const { error } = await (supabase.from as any)("collections").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/collections?saved=1&action=deleted&entity=book&publish=1");
    }
    const sortRaw = str(fd, "sort_order");
    const sortNum = sortRaw && !Number.isNaN(Number(sortRaw)) ? Number(sortRaw) : undefined;
    const { error } = await (supabase.from as any)("collections")
      .update({
        name: strReq(fd, "name"),
        slug: strReq(fd, "slug"),
        description_md: str(fd, "description_md") ?? null,
        cover_image_url: str(fd, "cover_image_url") ?? null,
        category_id: str(fd, "category_id") || null,
        ...(sortNum != null ? { sort_order: sortNum } : {}),
        status: str(fd, "status") === "draft" ? "draft" : "published",
      })
      .eq("id", id);
    if (error) throw error;

    // Reconciliar libros asignados (set/clear books.collection_id).
    const bookIds = parseIds(fd, "book_ids");
    await syncCollectionBooks(supabase, id, bookIds);

    return Astro.redirect(`/collections/${id}?saved=1&action=updated&entity=book&publish=1`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const { data: collection } = await (supabase.from as any)("collections")
  .select("*")
  .eq("id", id)
  .maybeSingle();
if (!collection) return Astro.redirect("/collections");

// Datos para los pickers
const [{ data: categories }, { data: books }, currentBookIds] = await Promise.all([
  supabase.from("categories").select("id, name, icon").order("name"),
  supabase.from("books").select("id, title, cover_image_url").order("title"),
  fetchCollectionBookIds(supabase, id),
]);

const categoryOptions = [
  { value: "", label: "Sin categoría" },
  ...(categories ?? []).map((c) => ({
    value: c.id,
    label: c.name,
    icon: c.icon ? `lucide:${c.icon}` : "lucide:folder",
  })),
];
---

<AppLayout title={collection.name} resource="collections" activeId={collection.id} breadcrumbLabel={collection.name}>

  <BackToList href="/collections" label="Colecciones" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{collection.name}</h1>
    <p class="text-stone-500 text-xs">/colecciones/{collection.slug}</p>
  </header>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad</h2>
        <p class="card-section-desc">Cómo se presenta esta colección en /colecciones.</p>
      </div>
      <Field label="Nombre" name="name" value={collection.name} required description="Nombre completo de la colección." />
      <Field label="Slug" name="slug" value={collection.slug} required description="Identificador único: /colecciones/<slug>." />
      <div>
        <span class="label flex items-center gap-1.5 mb-1.5">
          <Icon name="lucide:folder-tree" class="w-3.5 h-3.5 text-stone-500" aria-hidden="true" />
          Categoría
        </span>
        <Dropdown
          name="category_id"
          value={collection.category_id ?? ""}
          options={categoryOptions}
          placeholder="Sin categoría"
        />
        <p class="text-stone-500 text-xs mt-1.5">Opcional. Permite filtrar las colecciones en el sitio público.</p>
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Portada</h2>
        <p class="card-section-desc">Imagen representativa.</p>
      </div>
      <ImageUpload name="cover_image_url" value={collection.cover_image_url} label="Portada" bucket="authors" />
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Descripción</h2>
        <p class="card-section-desc">Texto introductorio. Soporta markdown.</p>
      </div>
      <MarkdownEditor name="description_md" value={collection.description_md} label="" />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Libros de la colección</h2>
        <p class="card-section-desc">Cada libro puede estar en una sola colección a la vez — si añades uno, se quitará de cualquier otra colección donde estuviera.</p>
      </div>
      <MultiBookPicker name="book_ids" books={books ?? []} selectedIds={currentBookIds} />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Orden y publicación</h2>
        <p class="card-section-desc">Controla la posición en /colecciones y si aparece publicada.</p>
      </div>
      <Field label="Orden" name="sort_order" type="number" value={collection.sort_order != null ? String(collection.sort_order) : "0"} description="Menor sale primero. 0 es el primero." />
      <div class="space-y-2">
        <label class="flex items-start gap-3 text-sm">
          <input type="radio" name="status" value="published" checked={collection.status === "published"} class="mt-1" />
          <span>
            <span class="font-medium">Publicado</span>
            <span class="block text-stone-500">Visible en /colecciones.</span>
          </span>
        </label>
        <label class="flex items-start gap-3 text-sm">
          <input type="radio" name="status" value="draft" checked={collection.status === "draft"} class="mt-1" />
          <span>
            <span class="font-medium">Borrador</span>
            <span class="block text-stone-500">Oculto en el sitio público.</span>
          </span>
        </label>
      </div>
    </section>

    <FormActions cancelHref="/collections" canEdit={canEdit} />
    </fieldset>
  </form>

  {canEdit && (
  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-3xl"
    data-cas-confirm="Los libros de esta colección quedarán sin colección asignada (no se borran)."
    data-cas-confirm-title="¿Borrar esta colección?"
    data-cas-confirm-subtitle={collection.name}
    data-cas-confirm-label="Borrar"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar colección</button>
  </form>
  )}
</AppLayout>
