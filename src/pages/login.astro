---
import AuthLayout from "~/layouts/AuthLayout.astro";

const error = Astro.url.searchParams.get("error");
const reason = Astro.url.searchParams.get("reason");
const detail = Astro.url.searchParams.get("detail");
const next = Astro.url.searchParams.get("next") ?? "/";

// Map common OAuth error reasons to friendly Spanish copy.
const FRIENDLY_REASON: Record<string, string> = {
  access_denied: "Cancelaste o rechazaste la autorización.",
  admin_policy_enforced: "Tu organización (Google Workspace) bloquea el acceso a esta app. Pídele al admin de tu cuenta que la autorice.",
  org_internal: "Esta app solo permite cuentas de la organización autorizada.",
  invalid_request: "La solicitud a Google fue inválida. Refresca la página e intenta de nuevo.",
  redirect_uri_mismatch: "La URL de redirección no está autorizada en Google Cloud Console.",
  missing_code: "Google no devolvió código de autorización. Refresca y reintenta.",
  exchange_failed: "Tu sesión no pudo completarse. Si sigues viendo este error, intenta cerrar sesión en Google y volver a entrar.",
};
const friendlyReason = reason ? (FRIENDLY_REASON[reason] ?? reason) : null;
---

<AuthLayout title="Acceder">
  <div class="text-center mb-10">
    <span class="cas-logo-swap w-16 h-16 mx-auto mb-4 block">
      <img
        src="/casadeasterion4.webp"
        alt=""
        width="64"
        height="64"
        class="cas-logo-default w-full h-full object-contain"
      />
      <img
        src="/casadeasterion5.webp"
        alt=""
        width="64"
        height="64"
        loading="lazy"
        class="cas-logo-hover w-full h-full object-contain"
      />
    </span>
    <p class="font-serif uppercase tracking-[0.18em] text-sm">Casa de Asterión</p>
    <p class="text-[11px] uppercase tracking-[0.18em] text-stone-500 mt-1">CMS</p>
  </div>

  <div class="bg-white border border-stone-200 p-8">
    <h1 class="font-serif text-2xl mb-6">Iniciar sesión</h1>

    {error === "not_admin" && (
      <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-5">
        Tu cuenta no tiene permisos de administrador. Contacta al dueño del sitio.
      </p>
    )}
    {error === "oauth_failed" && (
      <div class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-5 space-y-1">
        <p class="font-medium">No se pudo completar el login.</p>
        {friendlyReason && <p class="text-[13px]">{friendlyReason}</p>}
        {detail && <p class="text-[11px] text-red-700/80 break-words">{detail}</p>}
      </div>
    )}

    <button
      id="google-login"
      class="btn w-full flex items-center justify-center gap-3 py-3"
      data-next={next}
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.205c0-.639-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.836.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
      </svg>
      <span>Continuar con Google</span>
    </button>

    <p
      id="login-error-msg"
      class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mt-5 hidden"
    ></p>

    <p class="text-xs text-stone-500 mt-6 text-center">
      Solo correos autorizados pueden administrar el sitio.
    </p>
  </div>

  <script>
    import { createBrowserClient } from "@supabase/ssr";

    const url = import.meta.env.PUBLIC_SUPABASE_URL;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    const init = () => {
      const btn = document.getElementById("google-login") as HTMLButtonElement | null;
      const msgEl = document.getElementById("login-error-msg");
      if (!btn || btn.dataset.casWired) return;
      btn.dataset.casWired = "1";

      // After a logout, supabase-js' storage may still hold a stale PKCE
      // verifier — wipe any leftover sb-* / supabase.* keys so the next
      // signInWithOAuth gets a clean slate.
      try {
        const stale: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && (k.startsWith("sb-") || k.startsWith("supabase."))) stale.push(k);
        }
        stale.forEach((k) => localStorage.removeItem(k));
      } catch {}

      const supabase = createBrowserClient(url, key);

      const showError = (text: string) => {
        if (!msgEl) return;
        msgEl.textContent = text;
        msgEl.classList.remove("hidden");
      };

      btn.addEventListener("click", async () => {
        if (msgEl) msgEl.classList.add("hidden");
        btn.disabled = true;
        const next = btn.dataset.next ?? "/";
        const redirectTo = `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}`;

        // Watchdog: if the redirect to Google really fails to start (popup
        // blocker, network down) we should tell the user. Cancel it as soon
        // as the page actually starts unloading — that means the redirect
        // *did* start, just slowly. iOS Safari over 5G can take 6-8s to
        // commit the navigation; we give it 12s before complaining.
        let unloaded = false;
        const onPageHide = () => { unloaded = true; };
        window.addEventListener("pagehide", onPageHide, { once: true });
        window.addEventListener("beforeunload", onPageHide, { once: true });

        const watchdog = setTimeout(() => {
          if (unloaded || document.visibilityState === "hidden") return;
          showError("La redirección está tardando. Si no carga, permite ventanas emergentes y reintenta.");
          btn.disabled = false;
        }, 12000);

        try {
          // `prompt=select_account consent` forces both prompts in order:
          //  1. account picker (so signing out of the CMS does not silently
          //     auto-login as the same Google account on the next click —
          //     the CMS signOut can't touch accounts.google.com's cookie),
          //  2. consent screen (required the first time a user authorizes
          //     this app).
          //
          // Sending only `select_account` triggered a 400 the first time a
          // Workspace account (e.g. user@empresa.com) tried to sign in:
          // Google jumped from the picker to the consent screen with
          // `authuser=unknown` and choked. Including `consent` keeps the
          // authuser context alive across both screens. Mobile is most
          // affected because there's no second tab to fall back on.
          const { error } = await supabase.auth.signInWithOAuth({
            provider: "google",
            options: {
              redirectTo,
              queryParams: { prompt: "select_account consent" },
            },
          });
          if (error) {
            console.error("[login] signInWithOAuth error:", error);
            clearTimeout(watchdog);
            showError(error.message ?? "No se pudo iniciar sesión.");
            btn.disabled = false;
            return;
          }
          // signInWithOAuth has set window.location.href to the Google URL.
          // The browser will commit the navigation any moment now — pagehide
          // will fire and the watchdog will short-circuit on its own.
        } catch (err) {
          console.error("[login] unexpected error:", err);
          clearTimeout(watchdog);
          showError(
            err instanceof Error ? err.message : "Error inesperado. Intenta de nuevo.",
          );
          btn.disabled = false;
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  </script>
</AuthLayout>
