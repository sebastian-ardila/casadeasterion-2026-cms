---
import AppLayout from "~/layouts/AppLayout.astro";
import { requirePermission } from "~/lib/auth";

const guard = await requirePermission(Astro, "authors", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";
---

<AppLayout title="Autores" resource="authors">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500">
    <p class="font-serif text-xl mb-2">Autores</p>
    <p class="text-sm mb-6">Selecciona un autor de la lista{canEdit && " o crea uno nuevo"}.</p>
    {canEdit && (
      <a href="/authors/new" class="btn-primary">+ Nuevo autor</a>
    )}
  </div>
</AppLayout>
