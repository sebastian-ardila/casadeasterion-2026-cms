---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "authors", "edit");
if (guard instanceof Response) return guard;

const { id } = Astro.params;
if (!id) return Astro.redirect("/authors");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;
const justSaved = Astro.url.searchParams.get("published") === "1";

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    if (str(fd, "_action") === "delete") {
      const { error } = await supabase.from("authors").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/authors?published=1");
    }
    const { error } = await supabase
      .from("authors")
      .update({
        name: strReq(fd, "name"),
        slug: strReq(fd, "slug"),
        bio_md: str(fd, "bio_md"),
        photo_url: str(fd, "photo_url"),
        links: {
          twitter: str(fd, "link_twitter") ?? "",
          web: str(fd, "link_web") ?? "",
          instagram: str(fd, "link_instagram") ?? "",
        },
      })
      .eq("id", id);
    if (error) throw error;
    return Astro.redirect(`/authors/${id}?published=1`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const { data: author } = await supabase.from("authors").select("*").eq("id", id).maybeSingle();
if (!author) return Astro.redirect("/authors");
const links = (author.links as Record<string, string>) ?? {};
---

<AppLayout title={author.name} resource="authors" activeId={author.id} breadcrumbLabel={author.name}>

  <BackToList href="/authors" label="Autores" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{author.name}</h1>
    <p class="text-stone-500 text-xs">/{author.slug}</p>
  </header>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {justSaved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">Guardado.</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad</h2>
        <p class="card-section-desc">Cómo se nombra al autor en el sitio.</p>
      </div>
      <Field label="Nombre" name="name" value={author.name} required description="Nombre completo del autor." />
      <Field label="Slug" name="slug" value={author.slug} required description="Identificador único en la URL: /autores/<slug>." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Foto</h2>
        <p class="card-section-desc">Imagen cuadrada que aparece en el listado y la ficha del autor.</p>
      </div>
      <ImageUpload name="photo_url" value={author.photo_url} label="Foto" bucket="authors" />
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Biografía</h2>
        <p class="card-section-desc">Texto introductorio. Soporta markdown.</p>
      </div>
      <MarkdownEditor name="bio_md" value={author.bio_md} label="" />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Enlaces</h2>
        <p class="card-section-desc">Páginas externas vinculadas al autor (opcional).</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <Field label="Web" name="link_web" type="url" value={links.web} description="Sitio personal." />
        <Field label="Twitter" name="link_twitter" type="url" value={links.twitter} description="URL del perfil completo." />
        <Field label="Instagram" name="link_instagram" type="url" value={links.instagram} description="URL del perfil completo." />
      </div>
    </section>

    <div class="flex flex-col sm:flex-row sm:justify-between gap-3 pt-4 border-t border-stone-200">
      <button type="submit" class="btn-primary">Guardar</button>
      <a href="/authors" class="btn">Cancelar</a>
    </div>
  </form>

  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-3xl"
    onsubmit="return confirm('¿Borrar este autor? Los libros y artículos quedarán sin autor asignado.')"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar autor</button>
  </form>
</AppLayout>
