---
import AppLayout from "~/layouts/AppLayout.astro";
import Dropdown from "~/components/Dropdown.astro";
import { requireOwner } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requireOwner(Astro);
if (guard instanceof Response) return guard;

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
let formError: string | null = null;
let saved: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");

    if (action === "delete") {
      const id = strReq(fd, "id");
      const { error } = await supabase.from("subscribers").delete().eq("id", id);
      if (error) throw error;
      saved = "Suscriptor eliminado.";
    } else if (action === "unsubscribe") {
      const id = strReq(fd, "id");
      const { error } = await supabase
        .from("subscribers")
        .update({ unsubscribed_at: new Date().toISOString() })
        .eq("id", id);
      if (error) throw error;
      saved = "Suscriptor marcado como dado de baja.";
    } else {
      throw new Error("acción desconocida");
    }
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Filter via query string ?status=confirmed|pending|unsub|all
const filter = (Astro.url.searchParams.get("status") ?? "all").toLowerCase();

let query = supabase
  .from("subscribers")
  .select("id, email, source, confirmed_at, unsubscribed_at, created_at")
  .order("created_at", { ascending: false });

if (filter === "confirmed") {
  query = query.not("confirmed_at", "is", null).is("unsubscribed_at", null);
} else if (filter === "pending") {
  query = query.is("confirmed_at", null);
} else if (filter === "unsub") {
  query = query.not("unsubscribed_at", "is", null);
}

const { data: subscribers, error: fetchError } = await query;

const all = subscribers ?? [];
const counts = {
  total: all.length,
  confirmed: all.filter((s) => s.confirmed_at && !s.unsubscribed_at).length,
  pending: all.filter((s) => !s.confirmed_at).length,
  unsubscribed: all.filter((s) => s.unsubscribed_at).length,
};

const filterOptions = [
  { value: "all", label: "Todos" },
  { value: "confirmed", label: "Confirmados" },
  { value: "pending", label: "Pendientes" },
  { value: "unsub", label: "Dados de baja" },
];

const fmtDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString("es-CO", { year: "numeric", month: "short", day: "numeric" }) : "—";

const statusOf = (s: { confirmed_at: string | null; unsubscribed_at: string | null }) => {
  if (s.unsubscribed_at) return { label: "dado de baja", cls: "bg-stone-200 text-stone-600" };
  if (s.confirmed_at) return { label: "confirmado", cls: "bg-green-100 text-green-900" };
  return { label: "pendiente", cls: "bg-amber-100 text-amber-900" };
};
---

<AppLayout title="Suscriptores">
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Suscriptores</h1>
  <p class="text-stone-500 mb-8">Lista de personas que se han registrado al newsletter del sitio.</p>

  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}
  {saved && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">{saved}</p>
  )}
  {fetchError && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6">
      No se pudieron cargar los suscriptores: {fetchError.message}.
      Si el error persiste, puede que falte aplicar la migración <code>0018_subscribers_owner_access.sql</code> que extiende la RLS al rol owner.
    </p>
  )}

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8 max-w-3xl">
    <div class="card p-4">
      <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Total</p>
      <p class="font-serif text-3xl mt-1">{counts.total}</p>
    </div>
    <div class="card p-4">
      <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Confirmados</p>
      <p class="font-serif text-3xl mt-1 text-green-900">{counts.confirmed}</p>
    </div>
    <div class="card p-4">
      <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Pendientes</p>
      <p class="font-serif text-3xl mt-1 text-amber-800">{counts.pending}</p>
    </div>
    <div class="card p-4">
      <p class="text-xs uppercase tracking-[0.12em] text-stone-500">De baja</p>
      <p class="font-serif text-3xl mt-1 text-stone-500">{counts.unsubscribed}</p>
    </div>
  </div>

  <form method="GET" class="flex items-end gap-3 mb-6 max-w-md">
    <div class="flex-1">
      <span class="label">Filtrar</span>
      <Dropdown name="status" value={filter} options={filterOptions} submitOnChange />
    </div>
  </form>

  <div class="card p-0 overflow-x-auto max-w-5xl">
    {all.length === 0 ? (
      <p class="text-sm text-stone-500 px-5 py-8 text-center">
        {fetchError ? "—" : "Aún no hay suscriptores con este filtro."}
      </p>
    ) : (
      <table class="w-full text-sm">
        <thead class="bg-stone-50 text-xs uppercase tracking-[0.12em] text-stone-600">
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Email</th>
            <th class="text-left px-4 py-3 font-semibold">Estado</th>
            <th class="text-left px-4 py-3 font-semibold">Origen</th>
            <th class="text-left px-4 py-3 font-semibold">Registrado</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {all.map((s) => {
            const st = statusOf(s);
            return (
              <tr class="border-t border-stone-100">
                <td class="px-4 py-3 font-medium text-stone-900">{s.email}</td>
                <td class="px-4 py-3">
                  <span class={`inline-flex text-[10px] uppercase tracking-[0.1em] px-1.5 py-0.5 ${st.cls}`}>
                    {st.label}
                  </span>
                </td>
                <td class="px-4 py-3 text-stone-600 text-xs">{s.source ?? "—"}</td>
                <td class="px-4 py-3 text-stone-500 text-xs whitespace-nowrap">{fmtDate(s.created_at)}</td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  {!s.unsubscribed_at && (
                    <form method="POST" class="inline-block mr-3" onsubmit={`return confirm('¿Marcar a ${s.email} como dado de baja?')`}>
                      <input type="hidden" name="_action" value="unsubscribe" />
                      <input type="hidden" name="id" value={s.id} />
                      <button class="cursor-pointer text-xs text-stone-700 hover:underline">Dar de baja</button>
                    </form>
                  )}
                  <form method="POST" class="inline-block" onsubmit={`return confirm('¿Borrar definitivamente a ${s.email}? No se puede deshacer.')`}>
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="id" value={s.id} />
                    <button class="cursor-pointer text-xs text-red-700 hover:underline">Borrar</button>
                  </form>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>

  <p class="text-xs text-stone-400 mt-6 max-w-2xl">
    El newsletter usa doble opt-in: cuando alguien se registra, recibe un email de confirmación. Solo los confirmados deberían recibir correos. Esta vista por ahora es de solo lectura y baja manual; las campañas se envían fuera del CMS.
  </p>
</AppLayout>
