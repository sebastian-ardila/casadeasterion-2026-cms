---
import AppLayout from "~/layouts/AppLayout.astro";
import { requirePermission } from "~/lib/auth";

const guard = await requirePermission(Astro, "prologuists", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";
---

<AppLayout title="Prologistas" resource="prologuists">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500">
    <p class="font-serif text-xl mb-2">Prologistas</p>
    <p class="text-sm mb-2 max-w-md">Personas que han escrito prólogos para libros o publicaciones de Casa de Asterión.</p>
    <p class="text-sm mb-6">Selecciona un prologista de la lista{canEdit && " o crea uno nuevo"}.</p>
    {canEdit && (
      <a href="/prologuists/new" class="btn-primary">+ Nuevo prologista</a>
    )}
  </div>
</AppLayout>
