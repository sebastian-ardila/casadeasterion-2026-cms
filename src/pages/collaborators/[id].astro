---
import AppLayout from "~/layouts/AppLayout.astro";
import Field from "~/components/Field.astro";
import BackToList from "~/components/BackToList.astro";
import MarkdownEditor from "~/components/MarkdownEditor.astro";
import AiSuggest from "~/components/AiSuggest.astro";
import ImageUpload from "~/components/ImageUpload.astro";
import FormActions from "~/components/FormActions.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { str, strReq, tags as parseTags } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

const guard = await requirePermission(Astro, "collaborators", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";

const { id } = Astro.params;
if (!id) return Astro.redirect("/collaborators");
const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=collaborators");
  try {
    const fd = await Astro.request.formData();
    if (str(fd, "_action") === "delete") {
      const { error } = await supabase.from("collaborators").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/collaborators?saved=1&action=deleted&entity=collaborator&publish=1");
    }
    const name = strReq(fd, "name");
    const { error } = await supabase
      .from("collaborators")
      .update({
        name,
        slug: strReq(fd, "slug"),
        bio_md: str(fd, "bio_md"),
        photo_url: str(fd, "photo_url"),
        links: {
          twitter: str(fd, "link_twitter") ?? "",
          web: str(fd, "link_web") ?? "",
          instagram: str(fd, "link_instagram") ?? "",
        },
        keywords: parseTags(fd, "keywords"),
      })
      .eq("id", id);
    if (error) throw error;
    return Astro.redirect(`/collaborators/${id}?saved=1&action=updated&entity=collaborator&publish=1`);
  } catch (err) {
    formError = friendlyError(err);
  }
}

const { data: collaborator } = await supabase.from("collaborators").select("*").eq("id", id).maybeSingle();
if (!collaborator) return Astro.redirect("/collaborators");
const links = (collaborator.links as Record<string, string>) ?? {};
---

<AppLayout title={collaborator.name} resource="collaborators" activeId={collaborator.id} breadcrumbLabel={collaborator.name}>

  <BackToList href="/collaborators" label="Colaboradores" />

  <header class="mb-8">
    <h1 class="font-serif text-3xl md:text-4xl mb-2 leading-tight">{collaborator.name}</h1>
    <p class="text-stone-500 text-xs">/{collaborator.slug}</p>
  </header>

  {!canEdit && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Solo lectura — tienes permiso de ver pero no de editar este colaborador.</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="POST" class="space-y-6 max-w-3xl">
    <fieldset disabled={!canEdit} class="space-y-6 m-0 p-0 border-0 min-w-0">

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Identidad</h2>
        <p class="card-section-desc">Cómo se nombra al colaborador en el sitio.</p>
      </div>
      <Field label="Nombre" name="name" value={collaborator.name} required description="Nombre completo del colaborador." />
      <Field label="Slug" name="slug" value={collaborator.slug} required description="Identificador único en la URL: /colaboradores/<slug>." />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Foto</h2>
        <p class="card-section-desc">Imagen cuadrada que aparece en el listado y la ficha del colaborador.</p>
      </div>
      <ImageUpload name="photo_url" value={collaborator.photo_url} label="Foto" bucket="authors" />
    </section>

    <section class="card space-y-3">
      <div>
        <h2 class="card-section-title">Biografía</h2>
        <p class="card-section-desc">Texto introductorio. Soporta markdown.</p>
      </div>
      <MarkdownEditor name="bio_md" value={collaborator.bio_md} label="" />
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">Enlaces</h2>
        <p class="card-section-desc">Páginas externas vinculadas al colaborador (opcional).</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <Field label="Web" name="link_web" type="url" value={links.web} description="Sitio personal." />
        <Field label="Twitter" name="link_twitter" type="url" value={links.twitter} description="URL del perfil completo." />
        <Field label="Instagram" name="link_instagram" type="url" value={links.instagram} description="URL del perfil completo." />
      </div>
    </section>

    <section class="card space-y-5">
      <div>
        <h2 class="card-section-title">SEO</h2>
        <p class="card-section-desc">Términos para que la ficha aparezca en buscadores.</p>
      </div>
      <AiSuggest kind="author" contentField="bio_md" />
      <Field label="Palabras clave (SEO)" name="keywords" value={collaborator.keywords?.join(", ")} description="Separadas por coma." />
    </section>

    <FormActions cancelHref="/collaborators" canEdit={canEdit} />
    </fieldset>
  </form>

  {canEdit && (
  <form
    method="POST"
    class="mt-12 pt-6 border-t border-red-200 max-w-3xl"
    data-cas-confirm="Las publicaciones asociadas se quedarán sin este colaborador."
    data-cas-confirm-title="¿Borrar este colaborador?"
    data-cas-confirm-subtitle={collaborator.name}
    data-cas-confirm-label="Borrar"
  >
    <input type="hidden" name="_action" value="delete" />
    <p class="text-sm text-stone-600 mb-3">Zona de peligro</p>
    <button type="submit" class="btn-danger">Borrar colaborador</button>
  </form>
  )}
</AppLayout>
