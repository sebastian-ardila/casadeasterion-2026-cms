---
import AppLayout from "~/layouts/AppLayout.astro";
import { requirePermission } from "~/lib/auth";

const guard = await requirePermission(Astro, "collaborators", "view");
if (guard instanceof Response) return guard;
const canEdit = guard.permission === "edit";
---

<AppLayout title="Colaboradores" resource="collaborators">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500">
    <p class="font-serif text-xl mb-2">Colaboradores</p>
    <p class="text-sm mb-2 max-w-md">Personas que han aportado a la editorial sin ser autoras de libro: artículos, poemas, ilustraciones, lecturas críticas, etc. Para traducciones y prólogos hay secciones dedicadas (Traductores, Prologistas).</p>
    <p class="text-sm mb-6">Selecciona un colaborador de la lista{canEdit && " o crea uno nuevo"}.</p>
    {canEdit && (
      <a href="/collaborators/new" class="btn-primary">+ Nuevo colaborador</a>
    )}
  </div>
</AppLayout>
