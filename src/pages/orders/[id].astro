---
import AppLayout from "~/layouts/AppLayout.astro";
import BackToList from "~/components/BackToList.astro";
import { requirePermission } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import { formatAgo, fullName } from "~/lib/relative-time";

const guard = await requirePermission(Astro, "orders", "view");
if (guard instanceof Response) return guard;

const { id } = Astro.params;
if (!id) return Astro.redirect("/orders");

let formError: string | null = null;

if (Astro.request.method === "POST") {
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");

    if (action === "set_status") {
      const status = strReq(fd, "status");
      if (!["pending", "sent", "cancelled", "completed"].includes(status)) {
        throw new Error("estado inválido");
      }
      const { error } = await supabase
        .from("purchase_intents")
        .update({ status })
        .eq("id", id);
      if (error) throw error;
      return Astro.redirect(
        `/orders/${id}?saved=1&msg=${encodeURIComponent("Estado actualizado.")}`,
      );
    }

    if (action === "delete") {
      // Acknowledged-warning gate: the client form must include
      // _confirmed=yes (set after the user dismisses the warning).
      const confirmed = fd.get("_confirmed");
      if (confirmed !== "yes") throw new Error("eliminación no confirmada");
      // Ask for the deleted rows back so we can verify the delete
      // actually affected something. Postgres RLS silently returns
      // 0 rows on a policy mismatch (no error), and we don't want
      // to redirect with "Pedido eliminado" if nothing was removed.
      const { data: deleted, error } = await supabase
        .from("purchase_intents")
        .delete()
        .eq("id", id)
        .select("id");
      if (error) throw error;
      if (!deleted || deleted.length === 0) {
        throw new Error(
          "No se pudo eliminar el pedido — verifica tu permiso o que la fila exista.",
        );
      }
      return Astro.redirect(
        `/orders?saved=1&msg=${encodeURIComponent("Pedido eliminado.")}`,
      );
    }

    throw new Error("acción desconocida");
  } catch (err) {
    formError = friendlyError(err);
  }
}

const sb = getSupabaseServerClient(Astro.request, Astro.cookies);
const { data: order, error: orderErr } = await sb
  .from("purchase_intents")
  .select(
    "id, profile_id, email, full_name, phone, notes, total_amount, currency, status, whatsapp_message, created_at, updated_at, updated_by, items:purchase_intent_items(id, book_title, book_slug, book_isbn, cover_image_url, unit_price, currency, quantity, position), editor:profiles!purchase_intents_updated_by_fkey(id, full_name, email)",
  )
  .eq("id", id)
  .maybeSingle();

if (orderErr || !order) {
  return Astro.redirect("/orders?error=not_found");
}

const items = ((order.items ?? []) as any[])
  .slice()
  .sort((a, b) => (a.position ?? 0) - (b.position ?? 0));

const STATUS_LABEL: Record<string, string> = {
  pending: "Pendiente",
  sent: "Enviado",
  completed: "Completado",
  cancelled: "Cancelado",
};
const STATUS_BG: Record<string, string> = {
  pending: "bg-amber-50 text-amber-900 border-amber-200",
  sent: "bg-blue-50 text-blue-900 border-blue-200",
  completed: "bg-green-50 text-green-900 border-green-200",
  cancelled: "bg-stone-100 text-stone-600 border-stone-200",
};

const formatMoney = (amount: number | null | undefined, currency: string) => {
  if (amount == null) return "—";
  return new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: currency || "COP",
    maximumFractionDigits: 0,
  }).format(Number(amount));
};

const itemCount = items.reduce((s, it: any) => s + (it.quantity ?? 0), 0);
const itemsLabel = itemCount === 1 ? "1 libro" : `${itemCount} libros`;

const savedMsg = Astro.url.searchParams.get("msg");
const editorName = order.editor ? fullName(order.editor) : null;

// WhatsApp deep-link. Normaliza el phone del pedido: si trae `+`,
// respetamos el código país; si son 10 dígitos sin código, asumimos
// Colombia (+57) — la mayoría de pedidos vienen de allí. wa.me
// requiere el número sin el `+` ni espacios.
function buildWaHref(): string | null {
  const raw = (order.phone ?? "").toString();
  if (!raw.trim()) return null;
  const cleaned = raw.replace(/[^\d+]/g, "");
  const digits = cleaned.startsWith("+")
    ? cleaned.slice(1)
    : cleaned.length === 10
      ? `57${cleaned}`
      : cleaned;
  if (!digits) return null;
  const firstName = (order.full_name ?? "").trim().split(/\s+/)[0] ?? "";
  const greeting = firstName
    ? `Hola ${firstName}, te escribo de Casa de Asterión Ediciones sobre tu pedido.`
    : "Hola, te escribo de Casa de Asterión Ediciones sobre tu pedido.";
  return `https://wa.me/${digits}?text=${encodeURIComponent(greeting)}`;
}
const waHref = buildWaHref();
---

<AppLayout title={order.full_name} resource="orders" activeId={order.id} breadcrumbLabel={order.full_name}>
  <BackToList href="/orders" label="Pedidos" />

  {savedMsg && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6">
      {savedMsg}
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <header class="mb-6 flex items-start justify-between gap-4 flex-wrap">
    <div class="min-w-0">
      <h1 class="font-serif text-3xl md:text-4xl mb-1.5 leading-tight">
        {order.profile_id ? (
          <a href={`/admins/${order.profile_id}`} class="hover:underline">{order.full_name}</a>
        ) : order.full_name}
      </h1>
      <p class="text-stone-500 text-sm">
        {order.email}{order.phone ? ` · ${order.phone}` : ""}
      </p>
      <p class="text-xs text-stone-400 mt-1">
        Creado {formatAgo(order.created_at)}
        {editorName && order.updated_by && order.updated_by !== order.profile_id && (
          <> · estado cambiado por <a href={`/admins/${order.updated_by}`} class="underline">{editorName}</a> {formatAgo(order.updated_at)}</>
        )}
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <span class:list={["text-[10px] uppercase tracking-[0.16em] px-2.5 py-1 border", STATUS_BG[order.status] ?? STATUS_BG.pending]}>
        {STATUS_LABEL[order.status] ?? order.status}
      </span>
      <p class="font-serif text-3xl tabular-nums">{formatMoney(order.total_amount, order.currency)}</p>
    </div>
  </header>

  {/* WhatsApp contact button — prominent CTA so el operador puede
      escribirle al cliente con un solo click. */}
  {waHref && (
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2.5 mb-6 px-5 py-3 border border-stone-300 bg-white text-stone-900 text-sm font-medium hover:border-stone-900 hover:bg-stone-50 transition-colors"
    >
      {/* Icono en verde apagado (#128C7E, el dark teal de WhatsApp en
          lugar del #25D366 brillante) para conservar la identidad de
          marca sin chillar contra el fondo editorial. */}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#128C7E" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      <span>Contactar por WhatsApp</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ml-0.5 transition-transform group-hover:translate-x-0.5">
        <path d="M5 12h14"/>
        <path d="m13 5 7 7-7 7"/>
      </svg>
    </a>
  )}

  {/* Items */}
  <section class="card mb-6">
    <header class="flex items-baseline justify-between mb-4">
      <h2 class="card-section-title">Libros pedidos</h2>
      <p class="text-xs text-stone-500">{itemsLabel}</p>
    </header>
    <ul class="divide-y divide-stone-100">
      {items.map((it: any) => (
        <li class="py-3 flex items-center gap-3">
          {it.cover_image_url ? (
            <img src={it.cover_image_url} alt="" loading="lazy" class="w-12 h-16 object-cover bg-stone-100 shrink-0" />
          ) : (
            <div class="w-12 h-16 bg-stone-100 shrink-0"></div>
          )}
          <div class="flex-1 min-w-0">
            <a href={`/catalogo/${it.book_slug}`} class="text-sm font-medium hover:underline" target="_blank" rel="noopener">
              {it.book_title}
            </a>
            <p class="text-xs text-stone-500">
              Cantidad: {it.quantity}
              {it.book_isbn && <> · ISBN {it.book_isbn}</>}
            </p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-sm tabular-nums">{formatMoney(it.unit_price, it.currency)}</p>
            <p class="text-[11px] text-stone-500 tabular-nums">
              ×{it.quantity} = {formatMoney((it.unit_price ?? 0) * (it.quantity ?? 0), it.currency)}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <div class="flex items-baseline justify-between pt-4 mt-3 border-t border-stone-200">
      <span class="text-xs uppercase tracking-[0.14em] text-stone-500">Total</span>
      <span class="font-serif text-2xl tabular-nums">{formatMoney(order.total_amount, order.currency)}</span>
    </div>
  </section>

  {/* Customer notes */}
  {order.notes && (
    <section class="card mb-6">
      <h2 class="card-section-title mb-3">Notas del cliente</h2>
      <p class="text-sm text-stone-700 whitespace-pre-wrap">{order.notes}</p>
    </section>
  )}

  {/* WhatsApp message preview */}
  {order.whatsapp_message && (
    <section class="card mb-6">
      <h2 class="card-section-title mb-3">Mensaje que se envió a WhatsApp</h2>
      <pre class="text-xs text-stone-700 bg-stone-50 border border-stone-100 p-3 whitespace-pre-wrap font-sans leading-relaxed">{order.whatsapp_message}</pre>
    </section>
  )}

  {/* Status change */}
  <section class="card mb-6">
    <h2 class="card-section-title mb-3">Cambiar estado</h2>
    <p class="text-xs text-stone-500 mb-4">
      Marca el pedido a medida que avanza la conversación con el cliente.
      Si se canceló, prefiere <strong>Cancelado</strong> antes que eliminar
      (mantiene el rastro para análisis).
    </p>
    <form method="POST" class="flex flex-wrap items-center gap-2">
      <input type="hidden" name="_action" value="set_status" />
      <input type="hidden" name="id" value={order.id} />
      {(["pending","sent","completed","cancelled"] as const).map((s) => {
        const isCurrent = s === order.status;
        return (
          <button
            type="submit"
            name="status"
            value={s}
            disabled={isCurrent}
            class:list={[
              "text-xs px-3 py-2 border uppercase tracking-[0.14em] transition-colors",
              isCurrent
                ? "border-stone-300 bg-stone-100 text-stone-400 cursor-not-allowed"
                : "border-stone-300 hover:border-stone-900 hover:bg-stone-900 hover:text-white cursor-pointer",
            ]}
          >
            {STATUS_LABEL[s]}
          </button>
        );
      })}
    </form>
  </section>

  {/* Delete — uses the shared ConfirmModal mounted in AppLayout. */}
  <section class="card border-red-100">
    <h2 class="card-section-title mb-2 text-red-900">Eliminar pedido</h2>
    <p class="text-xs text-stone-500 leading-relaxed mb-4 max-w-prose">
      Casi nunca conviene — el registro es la única huella de la
      demanda. Si la conversación se canceló, prefiere
      <strong>Cancelado</strong> arriba.
    </p>
    <form
      method="POST"
      data-cas-confirm="Borrarlo destruye la única traza de demanda de este cliente — análisis, recontacto y métricas de conversión se pierden para siempre."
      data-cas-confirm-title="¿Eliminar este pedido?"
      data-cas-confirm-subtitle={order.full_name}
      data-cas-confirm-label="Eliminar"
    >
      <input type="hidden" name="_action" value="delete" />
      <input type="hidden" name="id" value={order.id} />
      <input type="hidden" name="_confirmed" value="yes" />
      <button
        type="submit"
        class="text-xs px-3 py-2 border border-red-300 text-red-700 hover:bg-red-50 hover:border-red-700 transition-colors cursor-pointer uppercase tracking-[0.14em]"
      >
        Eliminar pedido…
      </button>
    </form>
  </section>
</AppLayout>
