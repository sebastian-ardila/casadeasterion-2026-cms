---
import AppLayout from "~/layouts/AppLayout.astro";
import Dropdown from "~/components/Dropdown.astro";
import { Icon } from "astro-icon/components";
import { requireUserManager } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";
import { formatAgo } from "~/lib/relative-time";

// Owner / admin only — the page lists every customer's purchase
// intent (cart submission). Editors don't see it.
const guard = await requireUserManager(Astro);
if (guard instanceof Response) return guard;
const canEdit = true;

let formError: string | null = null;
if (Astro.request.method === "POST") {
  if (!canEdit) return Astro.redirect("/?error=no_permission&section=orders");
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");
    if (action !== "set_status") throw new Error("acción desconocida");
    const id = strReq(fd, "id");
    const status = strReq(fd, "status");
    if (!["pending", "sent", "cancelled", "completed"].includes(status)) {
      throw new Error("estado inválido");
    }
    const { error } = await supabase
      .from("purchase_intents")
      .update({ status })
      .eq("id", id);
    if (error) throw error;
    return Astro.redirect(
      `/orders?saved=1&msg=${encodeURIComponent("Estado actualizado.")}`,
    );
  } catch (err) {
    formError = friendlyError(err);
  }
}

// Filter from query string (default: all).
const filter = (Astro.url.searchParams.get("status") ?? "all").toLowerCase();
const filterOptions = [
  { value: "all", label: "Todos" },
  { value: "pending", label: "Pendientes" },
  { value: "sent", label: "Enviados" },
  { value: "completed", label: "Completados" },
  { value: "cancelled", label: "Cancelados" },
];

const sb = getSupabaseServerClient(Astro.request, Astro.cookies);
let query = sb
  .from("purchase_intents")
  .select(
    "id, profile_id, email, full_name, phone, notes, total_amount, currency, status, created_at, items:purchase_intent_items(book_title, book_slug, cover_image_url, unit_price, currency, quantity, position)",
  )
  .order("created_at", { ascending: false });
if (filter !== "all") query = query.eq("status", filter);
const { data: orders, error: ordersErr } = await query;

const STATUS_LABEL: Record<string, string> = {
  pending: "Pendiente",
  sent: "Enviado",
  completed: "Completado",
  cancelled: "Cancelado",
};
const STATUS_BG: Record<string, string> = {
  pending: "bg-amber-50 text-amber-900 border-amber-200",
  sent: "bg-blue-50 text-blue-900 border-blue-200",
  completed: "bg-green-50 text-green-900 border-green-200",
  cancelled: "bg-stone-100 text-stone-600 border-stone-200",
};

const formatMoney = (amount: number | null | undefined, currency: string) => {
  if (amount == null) return "—";
  if (currency === "COP") {
    return new Intl.NumberFormat("es-CO", {
      style: "currency",
      currency: "COP",
      maximumFractionDigits: 0,
    }).format(Number(amount));
  }
  return new Intl.NumberFormat("es-CO", { style: "currency", currency }).format(Number(amount));
};

const savedMsg = Astro.url.searchParams.get("msg");
---

<AppLayout title="Pedidos" wide breadcrumbLabel="Pedidos">
  <div class="mb-6">
    <h1 class="font-serif text-3xl md:text-4xl mb-2">Pedidos</h1>
    <p class="text-stone-500 max-w-2xl">
      Cada vez que un cliente confirma su carrito, queda un registro
      aquí. La compra se cierra por WhatsApp; este panel sirve para
      seguimiento, contacto y análisis.
    </p>
  </div>

  {savedMsg && (
    <p class="bg-green-50 border border-green-200 text-green-900 text-sm p-3 mb-6 inline-flex items-center gap-2">
      <Icon name="lucide:check" class="w-4 h-4" aria-hidden="true" />
      <span>{savedMsg}</span>
    </p>
  )}
  {formError && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">{formError}</p>
  )}

  <form method="GET" class="flex items-end gap-3 mb-6 max-w-md">
    <div class="flex-1">
      <span class="label">Filtrar por estado</span>
      <Dropdown name="status" value={filter} options={filterOptions} submitOnChange />
    </div>
  </form>

  {ordersErr && (
    <p class="bg-red-50 border border-red-200 text-red-900 text-sm p-3 mb-6">No se pudieron cargar los pedidos: {ordersErr.message}</p>
  )}

  {orders && orders.length === 0 ? (
    <div class="card p-10 text-center max-w-3xl">
      <Icon name="lucide:shopping-bag" class="w-10 h-10 mx-auto text-stone-400 mb-3" aria-hidden="true" />
      <p class="text-stone-500">No hay pedidos {filter !== "all" ? "con ese estado" : "todavía"}.</p>
    </div>
  ) : (
    <div class="space-y-5 max-w-5xl">
      {(orders ?? []).map((o: any) => {
        const items = (o.items ?? []).slice().sort((a: any, b: any) => (a.position ?? 0) - (b.position ?? 0));
        return (
          <article class="card p-5 sm:p-6">
            <header class="flex items-start justify-between gap-4 mb-4 flex-wrap">
              <div class="min-w-0">
                <p class="font-serif text-lg leading-tight">
                  {o.profile_id ? (
                    <a href={`/admins/${o.profile_id}`} class="hover:underline">{o.full_name}</a>
                  ) : (
                    <span>{o.full_name}</span>
                  )}
                </p>
                <p class="text-xs text-stone-500 mt-0.5">{o.email}{o.phone ? ` · ${o.phone}` : ""}</p>
                <p class="text-[11px] text-stone-400 mt-0.5 italic">{formatAgo(o.created_at)}</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class:list={["text-[10px] uppercase tracking-[0.16em] px-2 py-1 border", STATUS_BG[o.status] ?? STATUS_BG.pending]}>
                  {STATUS_LABEL[o.status] ?? o.status}
                </span>
                <p class="font-serif text-2xl tabular-nums">{formatMoney(o.total_amount, o.currency)}</p>
              </div>
            </header>

            <ul class="divide-y divide-stone-100 mb-4">
              {items.map((it: any) => (
                <li class="py-2 flex items-center gap-3">
                  {it.cover_image_url ? (
                    <img src={it.cover_image_url} alt="" loading="lazy" class="w-10 h-12 object-cover bg-stone-100 shrink-0" />
                  ) : (
                    <div class="w-10 h-12 bg-stone-100 shrink-0"></div>
                  )}
                  <div class="flex-1 min-w-0">
                    <a href={`/catalogo/${it.book_slug}`} class="text-sm hover:underline" target="_blank" rel="noopener">
                      {it.book_title}
                    </a>
                    <p class="text-xs text-stone-500">Cantidad: {it.quantity}</p>
                  </div>
                  <p class="text-sm tabular-nums text-stone-700 shrink-0">{formatMoney(it.unit_price, it.currency)}</p>
                </li>
              ))}
            </ul>

            {o.notes && (
              <div class="border-t border-stone-100 pt-3 mb-4">
                <p class="text-[11px] uppercase tracking-[0.14em] text-stone-500 mb-1">Notas del cliente</p>
                <p class="text-sm text-stone-700 whitespace-pre-wrap">{o.notes}</p>
              </div>
            )}

            {canEdit && (
              <form method="POST" class="flex items-center gap-3 pt-3 border-t border-stone-100 flex-wrap">
                <input type="hidden" name="_action" value="set_status" />
                <input type="hidden" name="id" value={o.id} />
                <span class="text-xs text-stone-500">Cambiar estado:</span>
                {(["pending","sent","completed","cancelled"] as const).filter((s) => s !== o.status).map((s) => (
                  <button type="submit" name="status" value={s} class="text-xs px-3 py-1 border border-stone-300 hover:bg-stone-100 hover:border-stone-500 transition-colors uppercase tracking-[0.14em]">
                    {STATUS_LABEL[s]}
                  </button>
                ))}
              </form>
            )}
          </article>
        );
      })}
    </div>
  )}
</AppLayout>
