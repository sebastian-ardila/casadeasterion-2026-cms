---
import AppLayout from "~/layouts/AppLayout.astro";
import { requireUserManager } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";
import { strReq } from "~/lib/forms";
import { friendlyError } from "~/lib/errors";

// Owner / admin only — the page lists every customer's purchase
// intent (cart submission). Editors don't see it.
const guard = await requireUserManager(Astro);
if (guard instanceof Response) return guard;

let formError: string | null = null;
if (Astro.request.method === "POST") {
  const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);
  try {
    const fd = await Astro.request.formData();
    const action = strReq(fd, "_action");
    const id = strReq(fd, "id");

    if (action === "set_status") {
      const status = strReq(fd, "status");
      if (!["pending", "sent", "cancelled", "completed"].includes(status)) {
        throw new Error("estado inválido");
      }
      const { error } = await supabase
        .from("purchase_intents")
        .update({ status })
        .eq("id", id);
      if (error) throw error;
      return Astro.redirect(
        `/orders/${id}?saved=1&msg=${encodeURIComponent("Estado actualizado.")}`,
      );
    }

    if (action === "delete") {
      // We let the FK ON DELETE CASCADE clean up purchase_intent_items.
      const { error } = await supabase
        .from("purchase_intents")
        .delete()
        .eq("id", id);
      if (error) throw error;
      return Astro.redirect(
        `/orders?saved=1&msg=${encodeURIComponent("Pedido eliminado.")}`,
      );
    }

    throw new Error("acción desconocida");
  } catch (err) {
    formError = friendlyError(err);
  }
}

const savedMsg = Astro.url.searchParams.get("msg");
---

<AppLayout title="Pedidos" resource="orders" breadcrumbLabel="Pedidos">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center text-stone-500 px-6">
    <p class="font-serif text-xl mb-2">Pedidos</p>
    <p class="text-sm mb-2">Selecciona un pedido de la lista para ver los detalles.</p>
    <p class="text-xs text-stone-400 max-w-md mt-3 leading-relaxed">
      Cada entrada es una intención de compra registrada desde el sitio
      público. El cliente continuó por WhatsApp; este panel guarda la
      pista para hacer seguimiento, recontactar y medir conversión.
    </p>
    {savedMsg && (
      <p class="mt-6 text-xs text-green-700 border border-green-200 bg-green-50 px-3 py-1.5 inline-block">
        {savedMsg}
      </p>
    )}
    {formError && (
      <p class="mt-6 text-xs text-red-700 border border-red-200 bg-red-50 px-3 py-1.5 inline-block">
        {formError}
      </p>
    )}
  </div>
</AppLayout>
