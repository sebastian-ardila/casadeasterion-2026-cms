---
import AppLayout from "~/layouts/AppLayout.astro";
import { requireAdmin, getAllPermissions, RESOURCE_LABEL } from "~/lib/auth";
import { getSupabaseServerClient } from "~/lib/supabase-server";

const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;
const user = guard;
const perms = await getAllPermissions(Astro, user);
const isOwner = user.role === "owner";

const error = Astro.url.searchParams.get("error");
const section = Astro.url.searchParams.get("section");

const supabase = getSupabaseServerClient(Astro.request, Astro.cookies);

const fetches = await Promise.all([
  perms.books !== "none" ? supabase.from("books").select("id,status") : Promise.resolve({ data: null }),
  perms.posts !== "none" ? supabase.from("posts").select("id,status") : Promise.resolve({ data: null }),
  perms.authors !== "none" ? supabase.from("authors").select("id", { count: "exact", head: true }) : Promise.resolve({ count: null }),
  perms.categories !== "none" ? supabase.from("categories").select("id", { count: "exact", head: true }) : Promise.resolve({ count: null }),
  isOwner ? supabase.from("subscribers").select("id,confirmed_at,unsubscribed_at") : Promise.resolve({ data: null }),
]);
const [books, posts, authors, categories, subs] = fetches as any[];

const stats = {
  books_total: books.data?.length ?? 0,
  books_published: books.data?.filter((b: any) => b.status === "published").length ?? 0,
  posts_total: posts.data?.length ?? 0,
  posts_published: posts.data?.filter((p: any) => p.status === "published").length ?? 0,
  authors: authors.count ?? 0,
  categories: categories.count ?? 0,
  subs_confirmed: subs.data?.filter((s: any) => s.confirmed_at && !s.unsubscribed_at).length ?? 0,
  subs_pending: subs.data?.filter((s: any) => !s.confirmed_at).length ?? 0,
};
---

<AppLayout title="Inicio">
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Buenas, {user.full_name?.split(" ")[0] ?? "admin"}.</h1>
  <p class="text-stone-500 mb-10">Resumen del catálogo.</p>

  {error === "no_permission" && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6">
      No tienes permiso para acceder a la sección {section ? RESOURCE_LABEL[section as keyof typeof RESOURCE_LABEL] ?? section : ""}. Contacta al owner del sitio.
    </p>
  )}
  {error === "owner_only" && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6">
      Esa sección es solo para el owner del sitio.
    </p>
  )}

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-10">
    {perms.books !== "none" && (
      <a href="/books" class="card p-5 hover:border-stone-900 transition">
        <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Libros</p>
        <p class="font-serif text-3xl mt-1">{stats.books_total}</p>
        <p class="text-xs text-stone-500 mt-1">{stats.books_published} publicados</p>
      </a>
    )}
    {perms.posts !== "none" && (
      <a href="/posts" class="card p-5 hover:border-stone-900 transition">
        <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Artículos</p>
        <p class="font-serif text-3xl mt-1">{stats.posts_total}</p>
        <p class="text-xs text-stone-500 mt-1">{stats.posts_published} publicados</p>
      </a>
    )}
    {perms.authors !== "none" && (
      <a href="/authors" class="card p-5 hover:border-stone-900 transition">
        <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Autores</p>
        <p class="font-serif text-3xl mt-1">{stats.authors}</p>
      </a>
    )}
    {perms.categories !== "none" && (
      <a href="/categories" class="card p-5 hover:border-stone-900 transition">
        <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Categorías</p>
        <p class="font-serif text-3xl mt-1">{stats.categories}</p>
      </a>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl">
    {isOwner && (
      <a href="/subscribers" class="card block p-6 hover:border-stone-900 transition">
        <p class="text-xs uppercase tracking-[0.12em] text-stone-500 mb-2">Newsletter</p>
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
          <p class="text-stone-900">
            <span class="font-serif text-3xl">{stats.subs_confirmed}</span>
            <span class="text-sm text-stone-500 ml-1">confirmados</span>
          </p>
          {stats.subs_pending > 0 && (
            <p class="text-stone-700 text-sm">
              <span class="font-medium">{stats.subs_pending}</span>
              <span class="text-stone-500 ml-1">pendientes</span>
            </p>
          )}
        </div>
      </a>
    )}

    <a
      href="https://casadeasterionediciones.com"
      target="_blank"
      rel="noopener noreferrer"
      class="relative overflow-hidden block p-6 transition group bg-stone-900 text-stone-50 border border-stone-900 hover:bg-stone-800 hover:shadow-2xl hover:shadow-stone-900/20"
    >
      <div class="absolute -top-12 -right-10 w-44 h-44 rounded-full bg-stone-700/30 blur-2xl pointer-events-none"></div>
      <div class="relative flex items-start justify-between gap-3 mb-3">
        <p class="text-[10px] uppercase tracking-[0.18em] text-stone-400">Sitio público</p>
        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-stone-50 text-stone-900 group-hover:rotate-12 transition-transform">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </span>
      </div>
      <p class="relative font-serif text-2xl md:text-3xl leading-tight mb-2">Ver el sitio público</p>
      <p class="relative text-sm text-stone-300 mb-4">casadeasterionediciones.com</p>
      <span class="relative inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.18em] border-b border-stone-50/40 group-hover:border-stone-50 pb-0.5 transition">
        Abrir en nueva pestaña
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/>
          <path d="M13 5l7 7-7 7"/>
        </svg>
      </span>
    </a>
  </div>
</AppLayout>
