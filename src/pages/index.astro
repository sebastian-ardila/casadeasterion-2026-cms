---
import AppLayout from "~/layouts/AppLayout.astro";
import { Icon } from "astro-icon/components";
import { requireAdmin, getAllPermissions, RESOURCE_LABEL } from "~/lib/auth";

// SSR: only auth gate + permissions for which cards to show. Stats are loaded
// client-side from /api/page-data?type=home so the shell paints instantly.
const guard = await requireAdmin(Astro);
if (guard instanceof Response) return guard;
const user = guard;
const perms = await getAllPermissions(Astro, user);
const isOwner = user.role === "owner";
const isManager = isOwner || user.role === "admin";

const error = Astro.url.searchParams.get("error");
const section = Astro.url.searchParams.get("section");

interface StatCard {
  href: string;
  label: string;
  icon: string;
  primary: string;        // data-stat key for the big number
  detailKey?: string;     // optional secondary data-stat key
  detailSuffix?: string;  // text after the secondary number ("publicados", etc.)
  show: boolean;
  highlight?: boolean;    // destaca la tarjeta (Pedidos = señal de venta)
}

// Orden pensado: primero las áreas de contenido editorial (Libros,
// Artículos, Colecciones), luego las personas (Autores, Colaboradores),
// y al final Pedidos destacado — la única que pide acción inmediata —
// seguido por Categorías, Usuarios, Suscriptores.
const cards: StatCard[] = [
  { href: "/orders",        label: "Pedidos",       icon: "lucide:shopping-bag", primary: "orders_total",      detailKey: "orders_pending",     detailSuffix: "por atender", show: perms.orders !== "none", highlight: true },
  { href: "/books",         label: "Libros",        icon: "lucide:book-open",    primary: "books_total",       detailKey: "books_published",    detailSuffix: "publicados",  show: perms.books !== "none" },
  { href: "/posts",         label: "Artículos",     icon: "lucide:newspaper",    primary: "posts_total",       detailKey: "posts_published",    detailSuffix: "publicados",  show: perms.posts !== "none" },
  { href: "/collections",   label: "Colecciones",   icon: "lucide:library",      primary: "collections_total", detailKey: "collections_published", detailSuffix: "publicadas", show: perms.collections !== "none" },
  { href: "/authors",       label: "Autores",       icon: "lucide:users",        primary: "authors",                                                                          show: perms.authors !== "none" },
  { href: "/collaborators", label: "Colaboradores", icon: "lucide:user-plus",    primary: "collaborators",                                                                    show: perms.collaborators !== "none" },
  { href: "/categories",    label: "Categorías",    icon: "lucide:folder-tree",  primary: "categories",                                                                       show: perms.categories !== "none" },
  { href: "/admins",        label: "Usuarios",      icon: "lucide:users-round",  primary: "users_total",       detailKey: "users_editors",      detailSuffix: "editores",   show: isManager },
  { href: "/subscribers",   label: "Suscriptores",  icon: "lucide:mail",         primary: "subs_confirmed",    detailKey: "subs_pending",       detailSuffix: "pendientes", show: isOwner },
];

const visibleCards = cards.filter((c) => c.show);
---

<AppLayout title="Inicio">
  <h1 class="font-serif text-3xl md:text-4xl mb-2">Buenas, {user.full_name?.split(" ")[0] ?? "admin"}.</h1>
  <p class="text-stone-500 mb-10">Resumen del catálogo y la comunidad.</p>

  {error === "no_permission" && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6">
      No tienes permiso para acceder a la sección {section ? RESOURCE_LABEL[section as keyof typeof RESOURCE_LABEL] ?? section : ""}. Contacta al owner del sitio.
    </p>
  )}
  {error === "owner_only" && (
    <p class="bg-amber-50 border border-amber-200 text-amber-900 text-sm p-3 mb-6">
      Esa sección es solo para el owner del sitio.
    </p>
  )}

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4 mb-10" data-home-stats>
    {visibleCards.map((c) => (
      <a
        href={c.href}
        data-astro-prefetch
        class:list={[
          "card p-4 md:p-5 transition flex flex-col relative",
          c.highlight
            ? "border-orange-200 bg-orange-50/60 hover:border-orange-400 hover:bg-orange-50"
            : "hover:border-stone-900",
        ]}
      >
        {c.highlight && (
          <span class="absolute inset-x-0 top-0 h-[3px] bg-orange-500" aria-hidden="true"></span>
        )}
        <div class="flex items-center justify-between mb-3">
          <p class:list={["text-[11px] uppercase tracking-[0.12em]", c.highlight ? "text-orange-700 font-semibold" : "text-stone-500"]}>{c.label}</p>
          <Icon name={c.icon} class:list={["w-4 h-4", c.highlight ? "text-orange-500" : "text-stone-400"]} aria-hidden="true" />
        </div>
        <p class:list={["font-serif text-3xl leading-none", c.highlight && "text-orange-700"]} data-stat={c.primary}>
          <span class="inline-block bg-stone-100 rounded w-10 h-7 align-middle animate-pulse"></span>
        </p>
        <p class:list={["text-[11px] mt-2 min-h-[1rem]", c.highlight ? "text-orange-700/80" : "text-stone-500"]}>
          {c.detailKey ? (
            <><span data-stat={c.detailKey}>…</span> {c.detailSuffix}</>
          ) : (
            <span>&nbsp;</span>
          )}
        </p>
      </a>
    ))}
  </div>

  {isManager && (
    <div class="card p-5 mb-10 max-w-3xl">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs uppercase tracking-[0.12em] text-stone-500">Composición de usuarios</p>
        <Icon name="lucide:users-round" class="w-4 h-4 text-stone-400" aria-hidden="true" />
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div class="border-l-4 border-violet-500 pl-3">
          <p class="font-serif text-2xl" data-stat="users_owners">…</p>
          <p class="text-[11px] uppercase tracking-[0.12em] text-stone-500">Owner</p>
        </div>
        <div class="border-l-4 border-stone-900 pl-3">
          <p class="font-serif text-2xl" data-stat="users_admins">…</p>
          <p class="text-[11px] uppercase tracking-[0.12em] text-stone-500">Admins</p>
        </div>
        <div class="border-l-4 border-stone-300 pl-3">
          <p class="font-serif text-2xl" data-stat="users_editors">…</p>
          <p class="text-[11px] uppercase tracking-[0.12em] text-stone-500">Editores</p>
        </div>
      </div>
    </div>
  )}

  <a
    href="https://casadeasterionediciones.com"
    target="_blank"
    rel="noopener noreferrer"
    class="relative overflow-hidden block p-6 transition group bg-stone-900 text-stone-50 border border-stone-900 hover:bg-stone-800 hover:shadow-2xl hover:shadow-stone-900/20 max-w-3xl"
  >
    <div class="absolute -top-12 -right-10 w-44 h-44 rounded-full bg-stone-700/30 blur-2xl pointer-events-none"></div>
    <div class="relative flex items-start justify-between gap-3 mb-3">
      <p class="text-[10px] uppercase tracking-[0.18em] text-stone-400">Sitio público</p>
      <span class="flex items-center justify-center w-8 h-8 rounded-full bg-stone-50 text-stone-900 group-hover:rotate-12 transition-transform">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7"/>
          <path d="M7 7h10v10"/>
        </svg>
      </span>
    </div>
    <p class="relative font-serif text-2xl md:text-3xl leading-tight mb-2">Ver el sitio público</p>
    <p class="relative text-sm text-stone-300 mb-4">casadeasterionediciones.com</p>
    <span class="relative inline-flex items-center gap-1.5 text-xs uppercase tracking-[0.18em] border-b border-stone-50/40 group-hover:border-stone-50 pb-0.5 transition">
      Abrir en nueva pestaña
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/>
        <path d="M13 5l7 7-7 7"/>
      </svg>
    </span>
  </a>
</AppLayout>

<script is:inline>
  (() => {
    if (window.__casHomeInit) return;
    window.__casHomeInit = true;

    const setStat = (key, value) => {
      document.querySelectorAll(`[data-stat="${key}"]`).forEach((el) => {
        el.textContent = String(value);
      });
    };

    const cacheKey = "cas:home";
    const TTL = 60_000;

    const apply = (stats) => {
      Object.entries(stats).forEach(([k, v]) => setStat(k, v));
    };

    const hydrate = async () => {
      if (!document.querySelector("[data-home-stats]")) return;

      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.t < TTL) apply(parsed.stats);
        }
      } catch {}

      try {
        const res = await fetch("/api/page-data?type=home", {
          credentials: "same-origin",
          headers: { accept: "application/json" },
        });
        if (!res.ok) return;
        const data = await res.json();
        apply(data.stats);
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), stats: data.stats })); } catch {}
      } catch {}
    };

    document.addEventListener("astro:page-load", hydrate);
    document.addEventListener("astro:after-swap", hydrate);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", hydrate);
    } else {
      hydrate();
    }
  })();
</script>
